go_library(
    name = "working",
    srcs = [
        "divergence.go",
        "result.go",
        "working.go",
    ],
    importpath = "github.com/nexteggapp/taxcalcs/working",
    visibility = ["//visibility:public"],
)

go_test(
    name = "working_test",
    size = "small",
    srcs = ["result_test.go"],
    deps = [":working"],
)
