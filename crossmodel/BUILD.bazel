# gazelle:ignore

load("@rules_go//go:def.bzl", "go_binary")

# The cross-model harness: `bazel run //crossmodel:report`. Tagged manual so
# `bazel test //...` neither builds it nor needs Python; PolicyEngine-US comes
# from the dev-only module in policyengine/.
go_binary(
    name = "report",
    srcs = [
        "figures.go",
        "households.go",
        "main.go",
    ],
    args = ["-runner=$(rlocationpath @taxcalcs_policyengine//:runner)"],
    data = [
        "triage.tsv",
        "@taxcalcs_policyengine//:runner",
    ],
    tags = ["manual"],
    deps = [
        "//returns/rules/federal",
        "//returns/v1",
        "//taxprotosgo:common_go_proto",
        "//taxprotosgo:form_1099_int_go_proto",
        "//taxprotosgo:form_1099_r_go_proto",
        "//taxprotosgo:form_ssa_1099_go_proto",
        "//taxprotosgo:form_w2_go_proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@rules_go//go/runfiles",
    ],
)
