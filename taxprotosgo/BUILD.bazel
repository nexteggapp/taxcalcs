# gazelle:ignore

load("@rules_go//proto:def.bzl", "go_proto_library")

# Go bindings for the taxprotos schemas that //scenarios/v1 uses.
#
# taxprotos ships schemas only: its own Go bindings sit under its go/ tree,
# which loads rules_go as a development dependency and so can't be built from
# another root module. A consumer generates its own bindings from the
# proto_library targets, which is what this package does. The import paths
# are the ones taxprotos' go/ tree gives the same schemas, so code written
# against either compiles against both.

go_proto_library(
    name = "common_go_proto",
    importpath = "github.com/nexteggapp/taxprotos/go/common/v1",
    proto = "@nexteggapp_taxprotos//common/v1:common_proto",
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "form_w2_go_proto",
    importpath = "github.com/nexteggapp/taxprotos/go/us/federal/v1/form_w2",
    proto = "@nexteggapp_taxprotos//us/federal/v1/form_w2:form_w2_proto",
    visibility = ["//visibility:public"],
    deps = [":common_go_proto"],
)

