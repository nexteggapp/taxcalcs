load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "taxyearwasm_lib",
    srcs = [
        "api.go",
        "js.go",
        "other.go",
    ],
    importpath = "github.com/nexteggapp/taxcalcs/cmd/taxyearwasm",
    visibility = ["//visibility:private"],
    deps = [
        "//scenarios/v1",
        "//taxyear",
        "//taxyear/federal",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# The browser build: `bazel build //cmd/taxyearwasm:taxyearwasm_wasm`, then
# `node cmd/taxyearwasm/measure.mjs` times it. goos and goarch are on the
# binary, so `bazel build //...` checks that taxyear builds for js/wasm.
go_binary(
    name = "taxyearwasm_wasm",
    embed = [":taxyearwasm_lib"],
    gc_linkopts = [
        "-s",
        "-w",
    ],
    goarch = "wasm",
    goos = "js",
    visibility = ["//visibility:public"],
)

go_test(
    name = "taxyearwasm_test",
    size = "small",
    srcs = ["api_test.go"],
    data = ["//taxyear:testdata/cases/full-everything.jsonc"],
    embed = [":taxyearwasm_lib"],
    deps = [
        "//scenarios/v1",
        "//taxprotosgo:common_go_proto",
        "@org_golang_google_protobuf//proto",
    ],
)
