# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "sources_proto",
    srcs = ["source.proto"],
    import_prefix = "taxcalcs",
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "sources_go_proto",
    importpath = "github.com/nexteggapp/taxcalcs/sources/v1",
    protos = [":sources_proto"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "v1",
    embed = [":sources_go_proto"],
    importpath = "github.com/nexteggapp/taxcalcs/sources/v1",
    visibility = ["//visibility:public"],
)
