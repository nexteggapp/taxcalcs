# proto-file: sources/v1/source.proto
# proto-message: nexteggapp.taxcalcs.sources.v1.Source
#
# The Oregon Revised Statutes, 2025 Edition. Its sections are addressed by
# citation. The sections the rules cite are listed with their headings as the
# Legislature's site prints them in the 2025 Edition. No copy is kept: the
# sections are read on the Legislature's site, which prints a chapter per page
# (https://www.oregonlegislature.gov/bills_laws/ors/ors316.html for chapter
# 316) with no link to a single section, so the template is the index of
# chapters.

id: "or-ors-2025"
publisher {
  jurisdiction: "OR"
  agency: "Oregon Legislature"
  reuse_note: "Not yet checked. No copy is kept."
}
kind: KIND_STATUTE
title: "Oregon Revised Statutes"
designation: "Or. Rev. Stat."
revision: "2025 Edition"
tax_years: 2025
series: "or-ors"
anchor_scheme {
  unit: "section"
  url_template: "https://www.oregonlegislature.gov/bills_laws/Pages/ORS.aspx"
  cited { number: "291.349" heading: "Revenue estimate; disposition of revenue in excess of estimate" }
  cited { number: "315.650" heading: "Higher education savings account or ABLE account contributions" }
  cited { number: "316.037" heading: "Imposition and rate of tax" }
  cited { number: "316.085" heading: "Personal exemption credit" }
  cited { number: "316.102" heading: "Credit for political contributions" }
  cited { number: "316.680" heading: "Modification of taxable income" }
  cited { number: "316.685" heading: "Federal income tax deductions; accrual method of accounting required; adjustment for federal earned income credit" }
  cited { number: "316.695" heading: "Additional modifications of taxable income; rules" }
}
