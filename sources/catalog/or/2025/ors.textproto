# proto-file: sources/v1/source.proto
# proto-message: nexteggapp.taxcalcs.sources.v1.Source
#
# The Oregon Revised Statutes as in force for 2025. Its sections are
# addressed by citation, so none is declared here. No copy is kept yet: the
# sections are read on the Legislative Assembly's site.

id: "or-ors-2025"
publisher {
  jurisdiction: "OR"
  agency: "Oregon Legislative Assembly"
}
kind: KIND_STATUTE
title: "Oregon Revised Statutes"
designation: "Or. Rev. Stat."
revision: "2023 edition with 2024 additions, in force for 2025"
tax_years: 2025
series: "or-ors"
anchor_scheme {
  unit: "section"
  url_template: "https://oregon.public.law/statutes/ors_{section}"
}
