# proto-file: sources/v1/source.proto
# proto-message: nexteggapp.taxcalcs.sources.v1.Source
#
# Form N-210 (Rev. 2025), the penalty for underpaying Hawaii estimated tax.
# The 2026 form is not published, so the 2026 rules use this form's
# arithmetic with the 2026 dates. One anchor per part, and one per line the
# rules compute; Schedule A's are prefixed to keep them apart from Part IV's.

id: "hi-dotax-form-n-210-2025"
publisher {
  jurisdiction: "HI"
  agency: "Hawaii Department of Taxation"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Hawaii Department of Taxation website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "Form N-210, Underpayment of Estimated Tax by Individuals, Estates, and Trusts"
designation: "Form N-210"
revision: "Form N-210 (Rev. 2025)"
tax_years: 2025
series: "hi-dotax-form-n-210"
copies {
  url: "https://files.hawaii.gov/tax/forms/2025/n210_i.pdf"
  retrieved: "2026-10-20"
  sha256: "61511c4353a2024caea1fcca29931b39ea6dcc5b3bf29c557399b64d6a6c03cc"
  media_type: "application/pdf"
}
