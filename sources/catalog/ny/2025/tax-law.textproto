#
# The New York Tax Law as in force for 2025. Its sections are addressed by
# citation, so none is declared here. Article 22 (sections 601 to 697) is the
# personal income tax; section 1304, in Article 30, sets New York City's.

id: "ny-tax-law-2025"
publisher {
  jurisdiction: "NY"
  agency: "New York State Legislature"
}
kind: KIND_STATUTE
title: "New York Tax Law"
designation: "N.Y. Tax Law"
revision: "In force for 2025"
tax_years: 2025
series: "ny-tax-law"
anchor_scheme {
  unit: "section"
  url_template: "https://www.nysenate.gov/legislation/laws/TAX/{section}"
}
