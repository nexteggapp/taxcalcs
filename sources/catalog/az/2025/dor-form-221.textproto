publisher {
  jurisdiction: "AZ"
  agency: "Arizona Department of Revenue"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Arizona Department of Revenue website conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "2025 Underpayment of Estimated Tax by Individuals"
designation: "Form 221"
