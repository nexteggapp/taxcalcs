#
# The 2025 individual income tax booklet: the Form ND-EZ and Form ND-1
# instructions, the tax table and the tax rate schedules. Page numbers count
# the PDF's pages from 1, two more than the printed page numbers. Regions are
# approximate.

id: "nd-tax-booklet-2025"
publisher {
  jurisdiction: "ND"
  agency: "North Dakota Office of State Tax Commissioner"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Office of State Tax Commissioner website's conditions of use have not yet been reviewed."
}
kind: KIND_INSTRUCTIONS
title: "2025 North Dakota Individual Income Tax Instructions"
designation: "Form ND-1 Instructions"
tax_years: 2025
series: "nd-tax-booklet"
copies {
  url: "https://www.tax.nd.gov/sites/www/files/documents/forms/individual/2025-iit/2025-individual-income-tax-booklet.pdf"
  retrieved: "2026-11-12"
  sha256: "cea20eda0416339cdd2b049c67c772ca62665eafe2f0384795204c4197b4d75b"
  media_type: "application/pdf"
  path: "nd/2025/2025-individual-income-tax-booklet.pdf"
}

anchors {
  id: "line-6"
  title: "Line 6 – Worksheet for net long-term capital gain exclusion"
  at { page: 15 region { x: 0.05 y: 0.55 width: 0.90 height: 0.40 } }
  implemented_by: "nd-capital-gain-exclusion"
}
anchors {
  id: "line-22"
  title: "Line 22 – Marriage penalty credit and its worksheet"
  at { page: 16 region { x: 0.35 y: 0.05 width: 0.62 height: 0.90 } }
  implemented_by: "nd-marriage-penalty-credit"
}
anchors {
  id: "tax-table"
  title: "2025 Tax Table"
  at { page: 22 region { x: 0.05 y: 0.05 width: 0.90 height: 0.90 } }
  implemented_by: "nd-tax"
}
anchors {
  id: "rate-schedules"
  title: "2025 Tax Rate Schedules"
  at { page: 29 region { x: 0.05 y: 0.05 width: 0.90 height: 0.80 } }
  implemented_by: "nd-tax"
}
