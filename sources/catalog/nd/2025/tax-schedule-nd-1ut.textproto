# proto-file: sources/v1/source.proto
# proto-message: nexteggapp.taxcalcs.sources.v1.Source
#
# Schedule ND-1UT for 2025, SFN 28704 (12-2025), North Dakota's underpayment
# of estimated tax form, the latest published: the schedule on page 1 and its
# instructions on page 2. One anchor per line the estimated tax rules fill,
# and one per instruction they follow. Item A, the qualified farmer
# exception, is not filled: the rules refuse farmers. Page numbers count the
# PDF's pages from 1.

id: "nd-tax-schedule-nd-1ut-2025"
publisher {
  jurisdiction: "ND"
  agency: "North Dakota Office of State Tax Commissioner"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Office of State Tax Commissioner website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "Underpayment or Late Payment of Estimated Income Tax for Individuals, 2025"
designation: "Schedule ND-1UT"
revision: "SFN 28704 (12-2025)"
tax_years: 2025
series: "nd-tax-schedule-nd-1ut"
copies {
  url: "https://www.tax.nd.gov/sites/www/files/documents/forms/individual/2025-iit/28704-schedule-nd-1ut-2025.pdf"
  retrieved: "2026-10-20"
  sha256: "3d6950869900148794caa94e612b701320e7efd83923ca24e0ecf12deaac5529"
  media_type: "application/pdf"
}
