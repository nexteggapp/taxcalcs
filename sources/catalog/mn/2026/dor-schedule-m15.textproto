  agency: "Minnesota Department of Revenue"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Minnesota Department of Revenue website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "2026 Schedule M15, Underpayment of Estimated Income Tax"
designation: "Schedule M15"
tax_years: 2026
series: "mn-dor-schedule-m15"
