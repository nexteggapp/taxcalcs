}
anchors { id: "line-3" title: "Line 3: tax less withholding and credits under $500" implemented_by: "mn-estimated-assess" }
anchors { id: "line-4" title: "Line 4: 90% of this year's tax" implemented_by: "mn-estimated-assess" }
anchors { id: "line-5" title: "Line 5 and its instructions: last year's tax, and 110% above $150,000 of AGI" implemented_by: "mn-estimated-assess" }
anchors { id: "avoid-the-penalty" title: "How do I avoid the penalty?" implemented_by: "mn-estimated-assess" }
anchors { id: "line-13" title: "Line 13: 25% of the required annual payment by each due date" implemented_by: "mn-estimated-assess" }
anchors { id: "annualized-worksheet" title: "Worksheet - Annualized Income Installment" implemented_by: "mn-estimated-assess" }
anchors { id: "line-14" title: "Line 14: credits, and a return filed and paid by January 31" implemented_by: "mn-estimated-credits" }
anchors { id: "line-17" title: "Line 17: the date the underpayment was paid in full, or April 15, 2027" implemented_by: "mn-penalty-lines" }
