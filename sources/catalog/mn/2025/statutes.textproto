#
# Minnesota Statutes chapter 290, the individual income tax, as in force for
# 2025. Its sections are addressed by citation, so none is declared here. No
# copy is kept yet: the sections are read on the Revisor of Statutes' site.

id: "mn-statutes-2025"
publisher {
  jurisdiction: "MN"
  agency: "Minnesota Office of the Revisor of Statutes"
}
kind: KIND_STATUTE
title: "Minnesota Statutes"
designation: "Minn. Stat."
revision: "In force for taxable years beginning in 2025"
tax_years: 2025
series: "mn-statutes"
anchor_scheme {
  unit: "section"
  url_template: "https://www.revisor.mn.gov/statutes/cite/{section}"
  cited { number: "290.01" heading: "DEFINITIONS" }
  cited { number: "290.06" heading: "RATES OF TAX; CREDITS" }
  cited { number: "290.0121" heading: "DEPENDENT EXEMPTION" }
  cited { number: "290.0123" heading: "STANDARD DEDUCTION" }
}
