#
# The Official Code of Georgia Annotated, Title 48, Chapter 7, as in force for
# 2025. Its sections are addressed by citation, so none is declared here. The
# State publishes the Code only through LexisNexis, so no copy is kept and no
# URL is templated: the rules follow the Department of Revenue's IT-511
# booklet, catalogued beside this file.

id: "ga-ocga-2025"
publisher {
  jurisdiction: "GA"
  agency: "Georgia General Assembly"
}
kind: KIND_STATUTE
title: "Official Code of Georgia Annotated"
designation: "O.C.G.A."
revision: "In force for taxable years beginning in 2025"
tax_years: 2025
series: "ga-ocga"
anchor_scheme {
  unit: "section"
  cited { number: "48-7-20" heading: "Individual tax rates; credit for withholding and other payments; applicability to estates and trusts" }
  cited { number: "48-7-26" heading: "Personal exemptions" }
  cited { number: "48-7-27" heading: "Computation of taxable net income" }
  cited { number: "48-7-114" heading: "Estimated tax" }
}
