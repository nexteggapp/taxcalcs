#
# The Nebraska Revised Statutes as in force for 2025: the income tax is
# chapter 77, article 27. Its sections are addressed by citation, so none is
# declared here. No copy is kept: the sections are read on the Legislature's
# site.

id: "ne-neb-rev-stat-2025"
publisher {
  jurisdiction: "NE"
  agency: "Nebraska Legislature"
}
kind: KIND_STATUTE
title: "Nebraska Revised Statutes"
designation: "Neb. Rev. Stat."
revision: "In force for taxable years beginning in 2025"
tax_years: 2025
series: "ne-neb-rev-stat"
anchor_scheme {
  unit: "section"
  url_template: "https://nebraskalegislature.gov/laws/statutes.php?statute={section}"
}
