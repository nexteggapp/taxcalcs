#
# Form AR2210A for 2025, the latest published: the annualized installments
# (lines 1 to 30) and the penalty at a printed daily factor (lines 31 to
# 46). The anchors are one per part and one per line the rules compute.

id: "ar-dfa-ar2210a-2025"
publisher {
  jurisdiction: "AR"
  agency: "Arkansas Department of Finance and Administration"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Department of Finance and Administration website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "AR2210A, Arkansas Individual Income Tax Annualized Penalty for Underpayment of Estimated Income Tax, 2025"
designation: "AR2210A"
revision: "R 4/28/2025"
tax_years: 2025
series: "ar-dfa-ar2210a"
copies {
  url: "https://www.dfa.arkansas.gov/wp-content/uploads/2025_AR2210A_AnnualizedPenalty_for_Underpayment_of_EstimatedTax.pdf"
