#
# The South Carolina Code of Laws as in force for 2025. Its sections are
# addressed by citation, so none is declared here. No copy is kept: the
# sections are read on the General Assembly's site.

id: "sc-code-2025"
publisher {
  jurisdiction: "SC"
  agency: "South Carolina General Assembly"
}
kind: KIND_STATUTE
title: "South Carolina Code of Laws"
designation: "S.C. Code Ann."
revision: "As in force for 2025"
tax_years: 2025
series: "sc-code"
anchor_scheme {
  unit: "section"
  url_template: "https://law.justia.com/codes/south-carolina/title-12/chapter-6/section-{section}/"
  cited { number: "12-6-510" heading: "Tax rates for individuals, estates, and trusts for taxable years after 1994" }
  cited { number: "12-6-560" heading: "Computation of resident individual's gross, adjusted gross, and taxable income" }
  cited { number: "12-6-1170" heading: "Retirement income deduction from taxable income for individual; Section 12-6-1171 deduction" }
  cited { number: "12-6-3910" heading: "Estimated tax payments form; due dates; treatment of excess where estimated payments or withholdings more than tax liability; waiver of penalties" }
  cited { number: "12-54-25" heading: "Interest due on late taxes; applicable interest rate" }
  cited { number: "12-54-55" heading: "Interest on underpayment of declaration of estimated tax" }
}
