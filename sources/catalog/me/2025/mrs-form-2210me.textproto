# proto-file: sources/v1/source.proto
# proto-message: nexteggapp.taxcalcs.sources.v1.Source
#
# Form 2210ME for 2025, Maine's underpayment of estimated tax form and its
# instructions, the latest published. Maine Revenue Services' site refuses
# automated downloads, so the copy hashed is the Internet Archive's capture
# of the published URL, of 2026-02-12. One anchor per line the estimated tax
# rules fill, and one for the penalty computation. Page numbers count the
# PDF's pages from 1.

id: "me-mrs-form-2210me-2025"
publisher {
  jurisdiction: "ME"
  agency: "Maine Revenue Services"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Maine.gov website's terms of use have not yet been reviewed."
}
kind: KIND_FORM
title: "2025 Form 2210ME Underpayment of Estimated Tax by Individuals, Estates, or Trusts"
designation: "Form 2210ME"
tax_years: 2025
series: "me-mrs-form-2210me"
copies {
  url: "https://www.maine.gov/revenue/sites/maine.gov.revenue/files/inline-files/25_form_2210_fillable.pdf"
  retrieved: "2026-11-16"
  sha256: "94575b40b384f7ae552eef83b081e4cd10f68ecf06c0ebbd4d3e85883920eb35"
  media_type: "application/pdf"
}
