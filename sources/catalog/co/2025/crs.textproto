#
# The Colorado Revised Statutes as in force for 2025. Its sections are
# addressed by citation, so none is declared here.

id: "co-crs-2025"
publisher {
  jurisdiction: "CO"
  agency: "Colorado General Assembly"
}
kind: KIND_STATUTE
title: "Colorado Revised Statutes"
designation: "Colo. Rev. Stat."
revision: "As in force for 2025"
tax_years: 2025
series: "co-crs"
anchor_scheme {
  unit: "section"
  url_template: "https://colorado.public.law/statutes/crs_{section}"
}
