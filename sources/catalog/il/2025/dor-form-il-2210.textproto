#
# The 2025 Form IL-2210, Computation of Penalties for Individuals. The 2026
# form is not published, so the 2026 rules use this form's arithmetic with
# the 2026 figures. One anchor per step the rules follow, and one per line
# they compute; Penalty Worksheet 1's columns are lines 21B to 21I.

id: "il-dor-form-il-2210-2025"
publisher {
  jurisdiction: "IL"
  agency: "Illinois Department of Revenue"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Illinois Department of Revenue website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "2025 IL-2210, Computation of Penalties for Individuals"
designation: "Form IL-2210"
