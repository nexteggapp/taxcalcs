#
# The Code of Virginia, Title 58.1, Chapter 3 (income tax), as in force for
# 2025. Its sections are addressed by citation, so none is declared here. No
# copy is kept yet: the sections are read on the Virginia Law site.

id: "va-code-2025"
publisher {
  jurisdiction: "VA"
  agency: "Virginia General Assembly"
}
kind: KIND_STATUTE
title: "Code of Virginia"
designation: "Va. Code"
revision: "In force for taxable years beginning in 2025"
tax_years: 2025
series: "va-code"
anchor_scheme {
  unit: "section"
  url_template: "https://law.lis.virginia.gov/vacode/title58.1/chapter3/section{section}/"
  cited { number: "58.1-320" heading: "Imposition of tax" }
  cited { number: "58.1-322" heading: "Virginia taxable income of residents" }
  cited { number: "58.1-322.03" heading: "Virginia taxable income; deductions" }
}
