#
# Title 30 of the Delaware Code as in force for 2025. Its sections are
# addressed by citation, so none is declared here. No copy is kept yet: the
# sections are read on the Delaware Code Online, which prints chapter 11's
# personal income tax sections by subchapter.

id: "de-delcode-2025"
publisher {
  jurisdiction: "DE"
  agency: "Delaware General Assembly"
}
kind: KIND_STATUTE
title: "Delaware Code, Title 30"
designation: "30 Del. C."
revision: "In force for taxable years beginning in 2025"
tax_years: 2025
series: "de-delcode"
anchor_scheme {
  unit: "section"
  url_template: "https://delcode.delaware.gov/title30/c011/index.html#{section}"
  cited { number: "1102" heading: "Imposition and rate of tax; separate tax on lump-sum distributions" }
  cited { number: "1105" heading: "Taxable income" }
  cited { number: "1108" heading: "Standard deduction" }
  cited { number: "1110" heading: "Personal exemptions and credits" }
  cited { number: "1117" heading: "Earned income tax credit" }
}
