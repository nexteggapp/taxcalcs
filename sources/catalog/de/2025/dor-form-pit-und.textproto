# proto-file: sources/v1/source.proto
# proto-message: nexteggapp.taxcalcs.sources.v1.Source
#
# Form PIT-UND, the penalty for underpaying Delaware estimated tax. The 2026
# form is not published, so the 2026 rules use this form's arithmetic with
# the 2026 dates. One anchor per part; no page is given, as the copy has not
# been paged.

id: "de-dor-form-pit-und-2025"
publisher {
  jurisdiction: "DE"
  agency: "Delaware Division of Revenue"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Delaware Division of Revenue website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "2025 Form PIT-UND Delaware Underpayment of Estimated Taxes"
designation: "Form PIT-UND"
revision: "Revision 20250724"
tax_years: 2025
series: "de-dor-form-pit-und"
copies {
  url: "https://revenuefiles.delaware.gov/2025/PITForms_Instructions/PIT-UND_2025-01_PaperInteractiveIPM.pdf"
  retrieved: "2026-10-20"
  sha256: "a485b8212e24a1b0faee8f5ffba2a3d7245d66cc92ab592d31084b6a9baf6654"
  media_type: "application/pdf"
}
anchors { id: "part-1" title: "Part 1, Required Annual Payment" implemented_by: "de-pit-und" }
anchors { id: "part-2" title: "Part 2, Short Method" implemented_by: "de-short-method" }
anchors { id: "part-3" title: "Part 3, Annualized Installment Method" implemented_by: "de-pit-und-annualised" }
anchors { id: "part-4" title: "Part 4, Computing the Over/Under Payment" implemented_by: "de-pit-und-column" }
anchors { id: "part-5" title: "Part 5, Computing the Penalty" implemented_by: "de-estimated-penalty" }
anchors { id: "line-a" title: "Line A – 90% of this year's Delaware tax liability"
  at { page: 1 line: "A" }
  implemented_by: "de-pit-und:A" }
anchors { id: "line-b" title: "Line B – 100% or 110% of last year's Delaware tax liability"
  at { page: 1 line: "B" }
  implemented_by: "de-pit-und:B" }
anchors { id: "line-c" title: "Line C – The smaller of line A or line B, the required annual amount"
  at { page: 1 line: "C" }
  implemented_by: "de-pit-und:C" }
anchors { id: "line-d" title: "Line D – Delaware withholding"
  at { page: 1 line: "D" }
  implemented_by: "de-pit-und:D" }
