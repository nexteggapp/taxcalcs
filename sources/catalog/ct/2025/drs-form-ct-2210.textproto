#
# Form CT-2210 (Rev. 12/25), Connecticut's underpayment of estimated income
# tax form, for 2025, the latest published: Parts 1 to 3 on pages 1 and 2,
# Schedule A on page 3 and Schedule B on page 4. One anchor per line the
# estimated tax rules fill. Schedule B's lines a to h repeat for each month
# of each worksheet; line a stands for each month's underpayment. Page
# numbers count the PDF's pages from 1.

id: "ct-drs-form-ct-2210-2025"
publisher {
  jurisdiction: "CT"
  agency: "Connecticut Department of Revenue Services"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Connecticut Department of Revenue Services website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "Underpayment of Estimated Income Tax by Individuals, Trusts, and Estates (Rev. 12/25)"
