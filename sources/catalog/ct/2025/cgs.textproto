#
# The General Statutes of Connecticut, Title 12, Chapter 229 (income tax), as
# in force for 2025. Sections are addressed by citation; the anchors below are
# the rate schedules of § 12-700(a) the rules hold as figures. No copy is kept:
# the sections are read on the General Assembly's site.

id: "ct-cgs-2025"
publisher {
  jurisdiction: "CT"
  agency: "Connecticut General Assembly"
}
kind: KIND_STATUTE
title: "General Statutes of Connecticut"
designation: "Conn. Gen. Stat."
revision: "In force for taxable years beginning in 2025"
tax_years: 2025
series: "ct-cgs"
anchor_scheme {
  unit: "section"
  url_template: "https://www.cga.ct.gov/current/pub/chap_229.htm#sec_{section}"
}
anchors { id: "section-12-700-a-single"
  title: "§ 12-700(a) – Rates for a single filer or married individual filing separately"
  implemented_by: "ct-schedule" }
anchors { id: "section-12-700-a-joint"
  title: "§ 12-700(a) – Rates for married individuals filing jointly and a surviving spouse"
  implemented_by: "ct-schedule" }
anchors { id: "section-12-700-a-head-of-household"
  title: "§ 12-700(a) – Rates for a head of household"
  implemented_by: "ct-schedule" }
