#
# The Mississippi Code of 1972, Title 27, Chapter 7 (Income Tax), as in force
# for 2025. Its sections are addressed by citation, so none is declared here.
# No copy is kept yet: the sections are read on the Legislature's site.

id: "ms-code-2025"
publisher {
  jurisdiction: "MS"
  agency: "Mississippi Legislature"
}
kind: KIND_STATUTE
title: "Mississippi Code of 1972 Annotated"
designation: "Miss. Code Ann."
revision: "In force for taxable years beginning in 2025"
tax_years: 2025
series: "ms-code"
anchor_scheme {
  unit: "section"
  url_template: "https://law.justia.com/codes/mississippi/title-27/chapter-7/section-{section}/"
}
