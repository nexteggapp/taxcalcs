# Form REV-1630, Pennsylvania's underpayment of estimated tax form, for 2025,
# the latest published: the form on pages 1 and 2 and its instructions on
# pages 3 to 6. One anchor per line the estimated tax rules fill, and one per
# instruction they follow. Page numbers count the PDF's pages from 1.

id: "pa-dor-form-rev-1630-2025"
publisher {
  jurisdiction: "PA"
  agency: "Pennsylvania Department of Revenue"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Pennsylvania Department of Revenue website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "REV-1630, Underpayment of Estimated Tax by Individuals, 2025"
