#
# Article III of the Tax Reform Code of 1971, the personal income tax, as
# printed in Purdon's Pennsylvania Statutes (72 P.S. §§ 7301-7361) and in force
# for 2025. Its sections are addressed by citation; those the rules cite are
# listed with their headings as the General Assembly's site prints them. The
# site addresses a section by the act's own numbering (72 P.S. § 7302 is
# section 302), so the template is Article III as a whole. No copy is kept.

id: "pa-ps-2025"
publisher {
  jurisdiction: "PA"
  agency: "Pennsylvania General Assembly"
}
kind: KIND_STATUTE
title: "Tax Reform Code of 1971, Article III"
designation: "72 P.S."
revision: "In force for taxable years beginning in 2025"
tax_years: 2025
series: "pa-ps"
anchor_scheme {
  unit: "section"
  url_template: "https://www.palegis.us/statutes/unconsolidated/law-information/view-statute?SESSYR=1971&SESSIND=0&ACTNUM=2&CHPT=3"
  cited { number: "7302" heading: "Imposition of Tax" }
  cited { number: "7303" heading: "Classes of Income" }
  cited { number: "7304" heading: "Special Tax Provisions for Poverty" }
}
