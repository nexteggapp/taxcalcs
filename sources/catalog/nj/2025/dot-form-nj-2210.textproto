#
# Form NJ-2210, New Jersey's underpayment of estimated tax form, for 2025,
# the latest published: Parts I and II on page 1, the worksheets for
# Exceptions II to IV on page 2, and the instructions with Calculating the
# Interest on page 3. One anchor per line the estimated tax rules fill, and
# one per part of the interest they follow. Page numbers count the PDF's
# pages from 1.

id: "nj-dot-form-nj-2210-2025"
publisher {
  jurisdiction: "NJ"
  agency: "New Jersey Division of Taxation"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The New Jersey Division of Taxation website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "2025 Underpayment of Estimated Tax by Individuals, Estates, or Trusts"
designation: "Form NJ-2210"
tax_years: 2025
series: "nj-dot-form-nj-2210"
copies {
  url: "https://www.nj.gov/treasury/taxation/pdf/current/2210.pdf"
  retrieved: "2026-10-20"
  sha256: "376d6913ab27304556a95d242f34c972c386ad16758ce35a0eee68fa172bbb14"
  media_type: "application/pdf"
}
