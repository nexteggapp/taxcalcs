  jurisdiction: "MA"
  agency: "Massachusetts Department of Revenue"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Massachusetts Department of Revenue website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "2025 Form M-2210, Underpayment of Massachusetts Estimated Income Tax, and its instructions"
