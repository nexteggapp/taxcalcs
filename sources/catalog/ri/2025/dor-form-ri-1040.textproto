#
# One anchor per line of the return's first two pages, which the rules
# compute. Page 3 (RI Schedules I and II, the checkoffs and RI Schedule EIC)
# and the RI Schedules W and E that follow are not anchored here; the
# instructions describe them. The line numbers match the instructions'.

id: "ri-dor-form-ri-1040-2025"
publisher {
  jurisdiction: "RI"
  agency: "Rhode Island Division of Taxation"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Division of Taxation website's conditions of use have not yet been reviewed."
}
kind: KIND_FORM
title: "2025 Form RI-1040 Resident Individual Income Tax Return"
designation: "Form RI-1040"
revision: "Revised 07/2025"
tax_years: 2025
series: "ri-dor-form-ri-1040"
copies {
  url: "https://tax.ri.gov/sites/g/files/xkgbur541/files/2026-01/2025_1040WE_w.pdf"
  retrieved: "2026-11-14"
  sha256: "ac024a0d865fd08ca8cc6a907ae78b0aa74a3f3bd3b6c35d845f4294ba4d9f52"
  media_type: "application/pdf"
  path: "ri/2025/2025-form-ri-1040.pdf"
}
