# proto-file: sources/v1/source.proto
# proto-message: nexteggapp.taxcalcs.sources.v1.Source
#
# A one-page sheet the Division of Taxation publishes beside the RI-1040: the
# 2025 tax rate schedule, and the Standard Deduction and Exemption Worksheets
# that the form's lines 4 and 6 send filers to above $254,250 of modified
# federal AGI. Page numbers count the PDF's pages from 1. Regions were read
# from the PDF's text layout and are approximate.

id: "ri-dor-tax-rate-and-worksheets-2025"
publisher {
  jurisdiction: "RI"
  agency: "Rhode Island Division of Taxation"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Division of Taxation website's conditions of use have not yet been reviewed."
}
kind: KIND_INSTRUCTIONS
title: "Rhode Island Tax Rate Schedule and Worksheets 2025"
designation: "RI Tax Rate Schedule and Worksheets"
revision: "2025"
tax_years: 2025
series: "ri-dor-tax-rate-and-worksheets"
copies {
  url: "https://tax.ri.gov/sites/g/files/xkgbur541/files/2026-01/2025%20Tax%20Rate%20and%20Worksheets.pdf"
  retrieved: "2026-11-14"
  sha256: "1d33746ace050d28a83e3d96bca6f515049b41d2aeaff80e5347325125309a60"
  media_type: "application/pdf"
  path: "ri/2025/2025-ri-tax-rate-and-worksheets.pdf"
}
anchors {
  id: "tax-rate-schedule"
  title: "2025 Tax Rate Schedule - For All Filing Status Types"
  at { page: 1 region { x: 0.05 y: 0.02 width: 0.90 height: 0.13 } }
  implemented_by: "ri-schedule-tax"
}
anchors {
  id: "standard-deduction-worksheet"
  title: "Standard Deduction Worksheet for RI-1040 or RI-1040NR, Page 1, line 4"
  at { page: 1 region { x: 0.05 y: 0.15 width: 0.90 height: 0.45 } }
  implemented_by: "ri-standard-deduction-worksheet"
}
anchors {
  id: "exemption-worksheet"
  title: "Exemption Worksheet for RI-1040 or RI-1040NR, Page 1, line 6"
  at { page: 1 region { x: 0.05 y: 0.60 width: 0.90 height: 0.38 } }
  implemented_by: "ri-exemption-worksheet"
}
