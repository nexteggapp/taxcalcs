#
# The Form IT-140 and its instructions are published together in one
# booklet. Page numbers count the PDF's pages from 1, not the printed folio.
# The form is on pages 3 and 4 and Schedule M on pages 5 and 6. Regions are
# whole-page approximations.

id: "wv-tax-it-140-booklet-2025"
publisher {
  jurisdiction: "WV"
  agency: "West Virginia Tax Division"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The West Virginia Tax Division website's conditions of use have not yet been reviewed."
}
kind: KIND_INSTRUCTIONS
title: "2025 West Virginia Personal Income Tax Forms and Instructions"
designation: "Form IT-140 Booklet"
tax_years: 2025
series: "wv-tax-it-140-booklet"
copies {
