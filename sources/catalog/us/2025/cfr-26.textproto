#
# Title 26 of the Code of Federal Regulations, the Treasury regulations on
# internal revenue. Its sections are addressed by citation. The sections the
# rules cite are listed with their headings as the eCFR printed them on
# 2026-11-08 (Title 26 up to date as of 2026-11-05). No copy is kept: the
# sections are read on the eCFR.

id: "us-cfr-26-2025"
publisher {
  jurisdiction: "US"
  agency: "Office of the Federal Register"
  reuse: REUSE_PUBLIC_DOMAIN
  reuse_note: "A work of the United States government, not subject to copyright (17 U.S.C. § 105)."
}
kind: KIND_REGULATION
title: "Title 26 – Internal Revenue"
designation: "26 C.F.R."
revision: "As in force for taxable years beginning in 2025"
tax_years: 2025
series: "us-cfr-26"
anchor_scheme {
  unit: "section"
  url_template: "https://www.ecfr.gov/current/title-26/section-{section}"
  cited { number: "1.25A-5" heading: "Special rules relating to characterization and timing of payments" }
  cited { number: "1.152-1" heading: "General definition of a dependent" }
  cited { number: "1.179-2" heading: "Limitations on amount subject to section 179 election" }
  cited { number: "1.199A-3" heading: "Qualified business income, qualified REIT dividends, and qualified PTP income" }
  cited { number: "1.1231-1" heading: "Gains and losses from the sale or exchange of certain property used in the trade or business" }
}
