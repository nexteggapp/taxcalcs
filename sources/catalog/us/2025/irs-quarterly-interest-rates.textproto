# proto-file: sources/v1/source.proto
# proto-message: nexteggapp.taxcalcs.sources.v1.Source
#
# The IRS page of quarterly interest rates, as a snapshot. The page changes each
# quarter, so its sha256 is of the snapshot fetched. It lists the 2025 rates and
# the 2026 rates, which the 2025 Form 2210 uses for underpayments still unpaid
# in 2026.

id: "us-irs-quarterly-interest-rates-2025"
publisher {
  jurisdiction: "US"
  agency: "Internal Revenue Service"
  reuse: REUSE_PUBLIC_DOMAIN
  reuse_note: "A work of the United States government, not subject to copyright (17 U.S.C. § 105)."
}
kind: KIND_WEB_PAGE
title: "Quarterly interest rates"
designation: "Quarterly interest rates"
revision: "Page Last Reviewed or Updated: 10-Sep-2026"
tax_years: 2025
series: "us-irs-quarterly-interest-rates"
copies {
  url: "https://www.irs.gov/payments/quarterly-interest-rates"
  retrieved: "2026-11-08"
  sha256: "0a6233fd96b17bbbea07fd1619858bc0fdaba17e0566e193e0667e3b76eea76d"
  media_type: "text/html"
}
anchors {
  id: "rates-2025"
  title: "2025 interest rates by category"
  implemented_by: "underpayment-rate"
}
anchors {
  id: "rates-2026"
  title: "2026 interest rates by category"
  implemented_by: "underpayment-rate"
}
