#
# The Iowa Code as in force for 2025. Its sections are addressed by citation,
# so none is declared here. No copy is kept yet: the sections are read on the
# Legislature's site.

id: "ia-iowa-code-2025"
publisher {
  jurisdiction: "IA"
  agency: "Iowa Legislature"
}
kind: KIND_STATUTE
title: "Iowa Code"
designation: "Iowa Code"
revision: "In force for tax years beginning in 2025"
tax_years: 2025
series: "ia-iowa-code"
anchor_scheme {
  unit: "section"
  url_template: "https://www.legis.iowa.gov/docs/code/{section}.pdf"
  cited { number: "422.5" heading: "Tax imposed — exclusions — alternate tax rate" }
  cited { number: "422.7" heading: "“Net income” — how computed" }
  cited { number: "422.12" heading: "Deductions from computed tax" }
}
