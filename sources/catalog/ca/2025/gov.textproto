# proto-file: sources/v1/source.proto
# proto-message: nexteggapp.taxcalcs.sources.v1.Source
#
# The Government Code as in force for 2025, for the Individual Shared
# Responsibility Penalty. Its sections are addressed by citation. California's
# sections have no headings, so the section the rules cite is listed with the
# heading of the title it is in, as the Legislature's site prints it.

id: "ca-gov-2025"
publisher {
  jurisdiction: "CA"
  agency: "California Legislature"
}
kind: KIND_STATUTE
title: "Government Code"
designation: "Cal. Gov. Code"
revision: "As in force for 2025"
tax_years: 2025
series: "ca-gov"
anchor_scheme {
  unit: "section"
  url_template: "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=GOV&sectionNum={section}"
  cited { number: "100705" heading: "Title 24. Minimum Essential Coverage Individual Mandate" }
}
