#
# The Revenue and Taxation Code as in force for 2025. Its sections are
# addressed by citation. California's sections have no headings, so the
# sections the rules cite are listed with the heading of the chapter, article
# or part each is in, as the Legislature's site prints it. No copy is kept yet: the
# sections are read on the Legislature's site.

id: "ca-rtc-2025"
publisher {
  jurisdiction: "CA"
  agency: "California Legislature"
}
kind: KIND_STATUTE
title: "Revenue and Taxation Code"
designation: "Cal. Rev. & Tax. Code"
revision: "As in force for taxable years beginning in 2025"
tax_years: 2025
series: "ca-rtc"
anchor_scheme {
  unit: "section"
  url_template: "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=RTC&sectionNum={section}"
  cited { number: "17041" heading: "Chapter 2. Imposition of Tax" }
  cited { number: "17043" heading: "Chapter 2. Imposition of Tax" }
  cited { number: "17053.5" heading: "Chapter 2. Imposition of Tax" }
  cited { number: "17054" heading: "Chapter 2. Imposition of Tax" }
  cited { number: "17054.1" heading: "Chapter 2. Imposition of Tax" }
  cited { number: "17073.5" heading: "Article 1. Definition of Gross Income, Adjusted Gross Income, Taxable Income, etc." }
  cited { number: "17077" heading: "Article 1. Definition of Gross Income, Adjusted Gross Income, Taxable Income, etc." }
  cited { number: "17087" heading: "Article 2. Items Specifically Included in Gross Income" }
  cited { number: "17220" heading: "Article 6. Deductions" }
  cited { number: "61015" heading: "Part 32. Individual Shared Responsibility Penalty" }
}
