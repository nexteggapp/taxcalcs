#
# The Revenue and Taxation Code as in force for 2025. Its sections are
# addressed by citation, so none is declared here. No copy is kept yet: the
# sections are read on the Legislature's site.

id: "ca-rtc-2025"
publisher {
  jurisdiction: "CA"
  agency: "California Legislature"
}
kind: KIND_STATUTE
title: "Revenue and Taxation Code"
designation: "Cal. Rev. & Tax. Code"
revision: "As in force for taxable years beginning in 2025"
tax_years: 2025
series: "ca-rtc"
anchor_scheme {
  unit: "section"
  url_template: "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=RTC&sectionNum={section}"
}
