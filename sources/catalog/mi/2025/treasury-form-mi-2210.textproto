#
# The 2025 MI-2210 (Rev. 10-25), Michigan's underpayment of estimated income
# tax form, its Annualized Income Worksheet and its instructions, the latest
# published. Treasury's site refuses automated downloads, so the copy hashed
# is the Internet Archive's capture of the published URL, of 2026-05-17. One
# anchor per line the estimated tax rules fill, and one for the worksheet.
# Page numbers count the PDF's pages from 1.

id: "mi-treasury-form-mi-2210-2025"
publisher {
  jurisdiction: "MI"
  agency: "Michigan Department of Treasury"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Michigan.gov website's terms of use have not yet been reviewed."
}
kind: KIND_FORM
title: "2025 MI-2210 Underpayment of Estimated Income Tax"
designation: "MI-2210"
tax_years: 2025
series: "mi-treasury-form-mi-2210"
