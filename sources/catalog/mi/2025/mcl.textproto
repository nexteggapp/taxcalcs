#
# The Income Tax Act of 1967 (MCL 206) as in force for 2025. Its sections are
# addressed by citation, so none is declared here. No copy is kept yet: the
# sections are read on the Legislature's site.

id: "mi-mcl-2025"
publisher {
  jurisdiction: "MI"
  agency: "Michigan Legislature"
}
kind: KIND_STATUTE
title: "Michigan Compiled Laws"
designation: "MCL"
revision: "In force for tax years beginning in 2025"
tax_years: 2025
series: "mi-mcl"
anchor_scheme {
  unit: "section"
  url_template: "https://www.legislature.mi.gov/Laws/MCL?objectName=mcl-{section}"
}
