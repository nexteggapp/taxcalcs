#
# The Income Tax Act of 1967 (MCL 206) as in force for 2025. Its sections are
# addressed by citation, so none is declared here. No copy is kept yet: the
# sections are read on the Legislature's site.

id: "mi-mcl-2025"
publisher {
  jurisdiction: "MI"
  agency: "Michigan Legislature"
}
kind: KIND_STATUTE
title: "Michigan Compiled Laws"
designation: "MCL"
revision: "In force for tax years beginning in 2025"
tax_years: 2025
series: "mi-mcl"
anchor_scheme {
  unit: "section"
  url_template: "https://www.legislature.mi.gov/Laws/MCL?objectName=mcl-{section}"
  cited { number: "205.23" heading: "Determination of tax liability; notice; payment of deficiency; interest and penalties" }
  cited { number: "205.24" heading: "Failure or refusal to file return or pay tax; assessment; notice; penalty; interest; waiver; penalty for failure or refusal to file informational report; failure to pay estimated tax payment; waiver of interest and penalty" }
  cited { number: "206.30" heading: "\"Taxable income\" defined; personal exemption; additional exemptions; deduction not considered allowable federal exemption for purposes of subsection (2); adjusted personal exemption; \"retirement or pension benefits\" defined; limitations, restrictions, and options; treatment of surviving spouses; definitions" }
  cited { number: "206.301" heading: "Estimated tax; installment payments; due dates; amount; credit; payment of estimated annual tax instead of quarterly payments; filing and payment by farmer, fisherman, or seafarer; information submitted by bank or financial institution; computations; “taxable trust” defined" }
  cited { number: "206.51" heading: "Tax rate on taxable income of person other than corporation; percentages of collections deposited in state school aid fund; farmland credits; renew Michigan fund; imposition of annualized rate; computation of taxable income of nonresident; resident beneficiary of trust; tax credit; including items of income and deductions from trust in taxable income; intent of section; definitions" }
  cited { number: "8.6" heading: "Statutes and rules; time; computation" }
}
