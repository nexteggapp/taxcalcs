# proto-file: sources/v1/source.proto
# proto-message: nexteggapp.taxcalcs.sources.v1.Source
#
# The 2025 D-40 booklet prints the form (PDF pages 42 to 44) and its
# instructions together. Anchors named form-line-* are the form's own lines;
# page numbers count the PDF's pages from 1. No copy is vendored: the booklet is 8 MB.

id: "dc-otr-form-d-40-booklet-2025"
publisher {
  jurisdiction: "DC"
  agency: "Office of Tax and Revenue"
  reuse: REUSE_PUBLIC_RECORD
  reuse_note: "Treated as a public record. The Office of Tax and Revenue website's conditions of use have not yet been reviewed."
}
kind: KIND_INSTRUCTIONS
title: "2025 D-40 Individual Income Tax Forms and Instructions"
designation: "Form D-40 Booklet"
revision: "D-40 revised 11/2025"
tax_years: 2025
series: "dc-otr-form-d-40-booklet"
copies {
  url: "https://otr.cfo.dc.gov/sites/default/files/dc/sites/otr/publication/attachments/2025_D40_Book_082026_v1.pdf"
  retrieved: "2026-11-14"
  sha256: "6c1df426c2a6b4cdbe5182f7b83b3f9c0cf31011ce177f1ce404ed566d1754d0"
  media_type: "application/pdf"
}
anchors {
  id: "standard-deduction"
  title: "Standard Deduction: the District's basic and additional amounts for 2025"
  implemented_by: "dc-standard-deduction"
}
anchors {
  id: "line-18"
  title: "Line 18 – DC deduction amount, and the 5% limit on itemized deductions"
  implemented_by: "dc-itemized-deduction"
}
anchors {
  id: "line-20"
  title: "Line 20 – Tax, from the tax tables at $100,000 or less"
  implemented_by: "dc-tax"
}
