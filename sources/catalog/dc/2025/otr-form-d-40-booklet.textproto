  implemented_by: "dc-form-d40:21"
}
anchors {
  id: "line-27"
  title: "Lines 27a to 27d – DC Earned Income Tax Credit, 100% of the federal credit"
  implemented_by: "dc-form-d40:27d"
}
anchors {
  id: "line-27e"
  title: "Line 27e – DC EITC for filers without qualifying children"
