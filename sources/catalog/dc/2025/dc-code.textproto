#
# The District of Columbia Official Code, Title 47 (Taxation), as in force for
# 2025. Its sections are addressed by citation, so none is declared here. No
# copy is kept: the sections are read on the Council's site.

id: "dc-code-2025"
publisher {
  jurisdiction: "DC"
  agency: "Council of the District of Columbia"
}
kind: KIND_STATUTE
title: "District of Columbia Official Code"
designation: "D.C. Code"
revision: "In force for taxable years beginning in 2025"
tax_years: 2025
series: "dc-code"
anchor_scheme {
  unit: "section"
  url_template: "https://code.dccouncil.gov/us/dc/council/code/sections/{section}"
  cited { number: "47-1801.04" heading: "General definitions" }
  cited { number: "47-1803.02" heading: "Gross income — Items included and excluded; “adjusted gross income” defined" }
  cited { number: "47-1803.04" heading: "Gross income — Individual, estate, and trust deductions" }
  cited { number: "47-1806.03" heading: "Tax on residents and nonresidents — Imposition and rates" }
  cited { number: "47-1812.08" heading: "Returns and payment of tax" }
  cited { number: "47-4201" heading: "Interest on underpayment, nonpayment, or extensions of time for payment, of tax" }
  cited { number: "47-4203" heading: "Underpayment of estimated tax by individuals" }
}
