load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

# Oregon personal income tax, and estimated tax with its underpayment interest.
#
# No dependency on //ustaxcalc. Oregon needs two federal figures — adjusted
# gross income and the federal tax itself — and takes both as plain amounts.
go_library(
    name = "oregontaxcalc",
    srcs = [
        "doc.go",
        "estimated.go",
        "estimated_y2026.go",
        "income.go",
        "tables.go",
        "tax.go",
        "y2025.go",
    ],
    importpath = "github.com/nexteggapp/taxcalcs/oregontaxcalc",
    visibility = ["//visibility:public"],
    deps = [
        "//estimated",
        "//filing",
        "//money",
        "//working",
    ],
)

# export_test.go is in the package itself, so that the external tests can run
# the Form OR-10 worksheet on 2025's published example.
go_test(
    name = "oregontaxcalc_test",
    size = "small",
    srcs = [
        "estimated_test.go",
        "example_test.go",
        "export_test.go",
        "positions_test.go",
        "tables_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":oregontaxcalc"],
    deps = [
        "//estimated",
        "//filing",
        "//money",
        "//working",
    ],
)

# The estimated-tax copy, which //estimated/all checks sentence by sentence.
filegroup(
    name = "estimated_srcs",
    srcs = glob(["estimated*.go"], exclude = ["*_test.go"]),
    visibility = ["//estimated/all:__pkg__"],
)
