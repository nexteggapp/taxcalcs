# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "taxlisp_proto",
    import_prefix = "taxcalcs",
    srcs = ["taxlisp.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "@nexteggapp_taxprotos//common/v1:common_proto",
    ],
)

go_proto_library(
    name = "taxlisp_go_proto",
    importpath = "github.com/nexteggapp/taxcalcs/taxlisp/v1",
    protos = [":taxlisp_proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//taxprotosgo:common_go_proto",
    ],
)

go_library(
    name = "v1",
    embed = [":taxlisp_go_proto"],
    importpath = "github.com/nexteggapp/taxcalcs/taxlisp/v1",
    visibility = ["//visibility:public"],
)

go_test(
    name = "v1_test",
    size = "small",
    srcs = ["taxlisp_test.go"],
    embedsrcs = ["taxlisp.proto"],
    deps = [
        ":v1",
        "@com_github_bufbuild_protocompile//:protocompile",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
    ],
)
