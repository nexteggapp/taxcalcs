load("@rules_go//go:def.bzl", "go_library", "go_test")

# Computes a tax year from a TaxYearScenarios file. See docs/results.md.
go_library(
    name = "taxyear",
    srcs = [
        "cache.go",
        "canadd.go",
        "compute.go",
        "dependents.go",
        "models.go",
        "overrides.go",
        "parse.go",
        "path.go",
        "prune.go",
        "resolve.go",
        "result.go",
        "round.go",
        "summary.go",
        "validate.go",
        "working.go",
    ],
    importpath = "github.com/nexteggapp/taxcalcs/taxyear",
    visibility = ["//visibility:public"],
    deps = [
        "//money",
        "//scenarios/v1",
        "//taxprotosgo:common_go_proto",
        "//taxprotosgo:facts_go_proto",
        "//taxprotosgo:form_1040_go_proto",
        "//taxyear/federal",
        "//taxyear/internal/civil",
        "//taxyear/model",
        "//taxyear/model/account",
        "//taxyear/model/broker",
        "//taxyear/model/business",
        "//taxyear/model/employer",
        "//taxyear/model/itemised",
        "//taxyear/model/otherincome",
        "//taxyear/model/retirement",
        "//taxyear/model/taxpaid",
        "//taxyear/paid",
        "//ustaxcalc",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@protodiffgen//apply",
        "@protodiffgen//v1:config_go_proto",
    ],
)

go_test(
    name = "taxyear_test",
    size = "small",
    srcs = [
        "cache_test.go",
        "models_test.go",
        "override_test.go",
        "property_test.go",
        "round_test.go",
        "taxyear_test.go",
    ],
    data = glob(["testdata/cases/*.jsonc"]),
    embed = [":taxyear"],
    embedsrcs = ["testdata/example.jsonc"],
    deps = [
        "//scenarios/v1",
        "//taxprotosgo:common_go_proto",
        "//taxprotosgo:facts_go_proto",
        "//taxprotosgo:form_1040_go_proto",
        "//taxprotosgo:form_1099_b_go_proto",
        "//taxprotosgo:form_1099_nec_go_proto",
        "//taxprotosgo:form_540_go_proto",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//proto",
    ],
)
