# gazelle:ignore

load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_file")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protodiffgen//bazel:defs.bzl", "proto_diff_library")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")

# TaxYearScenarios, the whole input for one tax year, in
# three proto libraries because the middle one is generated from the first
# and the last holds it: ScenarioInputs and the models, ScenarioInputsDiff,
# then TaxYearScenarios and Scenario. See docs/scenarios.md and
# docs/models.md.

# ScenarioInputs, TaxYearModel and every model, with Actual and Match.
proto_library(
    name = "inputs_proto",
    # Imported as taxcalcs/scenarios/v1/..., as //us/v1 is.
    import_prefix = "taxcalcs",
    srcs = [
        "account.proto",
        "actual.proto",
        "broker.proto",
        "business.proto",
        "inputs.proto",
        "itemised.proto",
        "model.proto",
        "other_income.proto",
        "retirement.proto",
        "tax_paid.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@nexteggapp_taxprotos//common/v1:common_proto",
        "@nexteggapp_taxprotos//facts/v1:facts_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1098:form_1098_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_div:form_1099_div_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_g:form_1099_g_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_int:form_1099_int_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_k:form_1099_k_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_nec:form_1099_nec_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_r:form_1099_r_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_ssa_1099:form_ssa_1099_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_w2:form_w2_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_w2g:form_w2g_proto",
    ],
)

# ScenarioInputsDiff, a change to ScenarioInputs, by the rules in
# inputs.diff.textproto. Imported as scenarios/v1/inputs_diff.proto.
proto_diff_library(
    name = "inputs_diff_proto",
    config = "inputs.diff.textproto",
    visibility = ["//visibility:public"],
    deps = [":inputs_proto"],
)

# Keeps a copy of the generated file in the source tree, for reading and
# review: `bazel run //scenarios/v1:write_inputs_diff`, from this module's
# root, updates it.
#
# write_source_files' own test is turned off and inputs_diff_test does its
# job. That test names the copy as a label in the main repository, so it fails
# to analyse when another module is the root.
write_source_file(
    name = "write_inputs_diff",
    diff_test = False,
    in_file = ":inputs_diff_proto",
    out_file = "inputs_diff.proto",
)

# Fails when the checked-in inputs_diff.proto is stale.
diff_test(
    name = "inputs_diff_test",
    failure_message = "Run `bazel run //scenarios/v1:write_inputs_diff`.",
    file1 = ":inputs_diff_proto",
    file2 = "inputs_diff.proto",
)

# TaxYearScenarios and Scenario.
proto_library(
    name = "scenarios_proto",
    import_prefix = "taxcalcs",
    srcs = ["scenarios.proto"],
    visibility = ["//visibility:public"],
    deps = [
        ":inputs_diff_proto",
        ":inputs_proto",
        "@nexteggapp_taxprotos//common/v1:common_proto",
    ],
)

# TaxYearResult and YearProjection: what taxyear computes from a
# TaxYearScenarios file. See docs/results.md.
proto_library(
    name = "result_proto",
    import_prefix = "taxcalcs",
    srcs = [
        "projection.proto",
        "result.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":inputs_proto",
        "//us/v1:us_proto",
        "@nexteggapp_taxprotos//common/v1:common_proto",
        "@nexteggapp_taxprotos//facts/v1:facts_proto",
    ],
)

# One Go package for all four, since they share a proto package.
go_proto_library(
    name = "scenarios_go_proto",
    importpath = "github.com/nexteggapp/taxcalcs/scenarios/v1",
    protos = [
        ":inputs_diff_proto",
        ":inputs_proto",
        ":result_proto",
        ":scenarios_proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//us/v1:us_go_proto",
        "//taxprotosgo:common_go_proto",
        "//taxprotosgo:facts_go_proto",
        "//taxprotosgo:form_1040_go_proto",
        "//taxprotosgo:form_1098_go_proto",
        "//taxprotosgo:form_1099_div_go_proto",
        "//taxprotosgo:form_1099_g_go_proto",
        "//taxprotosgo:form_1099_int_go_proto",
        "//taxprotosgo:form_1099_k_go_proto",
        "//taxprotosgo:form_1099_nec_go_proto",
        "//taxprotosgo:form_1099_r_go_proto",
        "//taxprotosgo:form_ssa_1099_go_proto",
        "//taxprotosgo:form_w2_go_proto",
        "//taxprotosgo:form_w2g_go_proto",
        "@protodiffgen//v1:config_go_proto",
    ],
)

go_library(
    name = "v1",
    embed = [":scenarios_go_proto"],
    importpath = "github.com/nexteggapp/taxcalcs/scenarios/v1",
    visibility = ["//visibility:public"],
)

# Parses the example in docs/scenarios.md, testdata/example.jsonc,
# strictly; resolves its scenarios with apply.Apply down the parent chain;
# round-trips the result; and fails on any element of these protos without a
# doc comment.
go_test(
    name = "v1_test",
    size = "small",
    srcs = ["scenarios_test.go"],
    embedsrcs = glob(["*.proto"]) + ["testdata/example.jsonc"],
    deps = [
        ":v1",
        "@com_github_bufbuild_protocompile//:protocompile",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
        "@protodiffgen//apply",
    ],
)
