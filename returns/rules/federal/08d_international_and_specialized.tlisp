; International Tax (Form 2555 Foreign Earned Income Exclusion & Foreign Earned
; Income Tax Worksheet under 26 U.S.C. § 911; Form 1116 Multi-Basket Foreign Tax
; Credit under 26 U.S.C. §§ 901, 904), Specialized Returns (Schedule F Farming,
; Schedule J 3-Year Farm Income Averaging under 26 U.S.C. § 1301, Schedule H
; Household Employment Taxes, Form 8615 Kiddie Tax & Form 8814 Parent's Election
; under 26 U.S.C. § 1(g), Form 4684 Disaster Casualties under 26 U.S.C. § 165(h),
; Form 5329 Parts I-IX Additional Taxes on Qualified Plans/IRAs/ESAs/MSAs/HSAs/
; ABLE/RMDs under 26 U.S.C. §§ 72(t), 4973, 4974), Form 8962 Premium Tax Credit
; & Pub. 974 Iterative SEHI-PTC Loop, and Form 2210 Estimated Tax Penalty &
; Schedule AI Annualized Income Installment Method under 26 U.S.C. § 6654.

; =============================================================================
; 1. Form 2555: Foreign Earned Income Exclusion & Housing Exclusion/Deduction
;    (26 U.S.C. § 911) + Foreign Earned Income Tax Worksheet (§ 911(f))
; =============================================================================

(def max-foreign-earned-income-exclusion ((tax-year Int)) Money
  :cite ((law "26 U.S.C." "911" "(b)(2)(D)") (doc "us-irs-rev-proc-2024-40") (doc "us-irs-rev-proc-2025-32"))
  (if (is tax-year 2026)
      #usd"132900.00"
      #usd"130000.00"))

(def qualifies-for-form-2555? ((fei ret/ForeignEarnedIncome)) Bool
  :cite ((law "26 U.S.C." "911" "(d)(1)"))
  (any-of (. fei 'bona_fide_residence)
      (>= (. fei 'physical_presence_days) 330)))

; Form 2555 Parts IV and VI-IX for one person. The inputs give foreign earned
; income as one amount, entered on line 19.
(def compute-one-form-2555
  ((hh ret/Household)
   (tax-year Int)
   (docs ret/Documents)
   (fei ret/ForeignEarnedIncome))
  fed/Form2555
  :cite ((law "26 U.S.C." "911" "(a)-(c)") (doc "us-irs-2555-instructions-2025"))
  (withs (person (lookup-person-by-id hh (. fei 'person))
          max-feie (max-foreign-earned-income-exclusion tax-year)
          raw-days (. fei 'qualifying_days_in_tax_year)
          days (if (> raw-days 0) (min 365 raw-days) 365)
          proration (/ (int-to-float days) 365.0)
          max-excl (round-dollar (* max-feie proration))
          earned (round-dollar (. fei 'foreign_earned_wages))
          ; Part VI: Foreign Housing Exclusion
          housing-exp (round-dollar (. fei 'qualified_housing_expenses))
          base-housing (round-dollar (* (* max-feie 0.16) proration))
          std-30-cap (round-dollar (* (* max-feie 0.30) proration))
          high-cost (round-dollar (. fei 'high_cost_locality_housing_limit))
          housing-cap (if (> high-cost #usd"0.00")
                          (round-dollar (* high-cost proration))
                          std-30-cap)
          qual-housing (min housing-exp housing-cap)
          housing-amt (clamp-zero (- qual-housing base-housing))
          ; Line 34: employer-provided amounts include wages from an
          ; employer. When the input is unset, the person's W-2 wages stand
          ; in for them; a self-employed person without a W-2 gets the Part
          ; IX deduction.
          person-w2 (round-dollar
                      (sum (fn ((w ret/W2Document)) Money
                             (if (is (. w 'person) (. fei 'person))
                                 (. w 'form.wages_tips_other_compensation)
                                 #usd"0.00"))
                           (. docs 'w2s)))
          emp-amounts (if (has? fei 'employer_provided_housing_amounts)
                          (round-dollar (. fei 'employer_provided_housing_amounts))
                          person-w2)
          emp-fraction (if (> earned #usd"0.00")
                           (min 1.0 (round-rate4 (/ emp-amounts earned)))
                           0.0)
          housing-excl (min emp-amounts (round-dollar (* housing-amt emp-fraction)))
          ; Part VII: Foreign Earned Income Exclusion
          earned-less-housing (clamp-zero (- earned housing-excl))
          feie-allowed (min earned-less-housing max-excl)
          ; Part VIII
          total-excl (+ housing-excl feie-allowed)
          ; Part IX: Housing Deduction
          unexcl-housing (clamp-zero (- housing-amt housing-excl))
          unexcl-earned (clamp-zero (- earned total-excl))
          housing-ded (min unexcl-housing unexcl-earned)
          form (proto 'fed/Form2555
                 :tax_year tax-year
                 :individual_name (person-full-name person)
                 :individual_tin (. person 'tin.number)
                 :foreign_wages_salaries_bonuses earned
                 :subtotal_foreign_earned_income earned
                 :total_foreign_earned_income earned
                 :part_v_foreign_earned_income earned
                 :claims_housing_exclusion_or_deduction (> housing-exp #usd"0.00")
                 :maximum_foreign_earned_income_exclusion max-feie
                 :feie_qualifying_days days
                 :qualifying_days_fraction (round-rate4 proration)
                 :prorated_maximum_exclusion max-excl
                 :foreign_earned_income_less_housing_exclusion earned-less-housing
                 :foreign_earned_income_exclusion feie-allowed
                 :combined_housing_and_foreign_earned_income_exclusions total-excl
                 :net_exclusion_carried_to_schedule_1 total-excl))
    (if (<= housing-exp #usd"0.00")
        form
        (proto-with form
          :qualified_housing_expenses housing-exp
          :housing_expense_limit housing-cap
          :capped_housing_expenses qual-housing
          :qualifying_days_in_tax_year days
          :base_housing_amount base-housing
          :housing_expenses_over_base housing-amt
          :employer_provided_amounts emp-amounts
          :employer_provided_fraction emp-fraction
          :foreign_housing_exclusion housing-excl
          :unexcluded_housing_expenses unexcl-housing
          :unexcluded_foreign_earned_income unexcl-earned
          :current_year_housing_deduction housing-ded
          :foreign_housing_deduction housing-ded))))

; One Form 2555 per person who meets the bona fide residence or physical
; presence test.
(def compute-form-2555s
  ((hh ret/Household)
   (tax-year Int)
   (docs ret/Documents)
   (feis (Slice ret/ForeignEarnedIncome)))
  (Slice fed/Form2555)
  :cite ((law "26 U.S.C." "911") (doc "us-irs-2555-instructions-2025"))
  (map (fn ((f ret/ForeignEarnedIncome)) fed/Form2555
         (compute-one-form-2555 hh tax-year docs f))
       (keep qualifies-for-form-2555? feis)))

; Form 2555 line 45, for all Forms 2555 (Schedule 1 line 8d).
(def form-2555-total-exclusion ((forms (Slice fed/Form2555))) Money
  (sum (fn ((f fed/Form2555)) Money (. f 'net_exclusion_carried_to_schedule_1)) forms))

; Form 2555 line 50, for all Forms 2555 (Schedule 1 line 24j).
(def form-2555-total-housing-deduction ((forms (Slice fed/Form2555))) Money
  (sum (fn ((f fed/Form2555)) Money (. f 'foreign_housing_deduction)) forms))

(def compute-regular-or-qdcgt-tax
  ((tax-year Int)
   (status fed/FilingStatus)
   (taxable-income Money)
   (qual-div Money)
   (sched-d fed/ScheduleD)
   (form4952-elected Money))
  Money
  :cite ((law "26 U.S.C." "1" "(h)") (doc "us-irs-1040-instructions-2025" "line-16"))
  (withs (ti (clamp-zero taxable-income)
          has-pref (or (> qual-div #usd"0.00")
                       (> (min (. sched-d 'net_long_term_gain_or_loss)
                               (. sched-d 'net_gain_or_loss))
                          #usd"0.00")))
    (if has-pref
        (. (compute-qdcgt-worksheet tax-year status ti qual-div sched-d form4952-elected)
           'line_25_tax_on_all_taxable_income)
        (compute-bracket-tax tax-year status ti))))

(def compute-foreign-earned-income-tax-worksheet
  ((tax-year Int)
   (status fed/FilingStatus)
   (forms (Slice fed/Form2555))
   (taxable-income Money)
   (qual-div Money)
   (sched-d fed/ScheduleD)
   (form4952-elected Money))
  ret/ForeignEarnedIncomeTaxWorksheet
  :cite ((law "26 U.S.C." "911" "(f)") (doc "us-irs-1040-instructions-2025" "foreign-earned-income-tax-worksheet"))
  (withs (line2a (+ (form-2555-total-exclusion forms)
                    (form-2555-total-housing-deduction forms)))
    (if (<= line2a #usd"0.00")
        (proto 'ret/ForeignEarnedIncomeTaxWorksheet)
        (withs (line1 (clamp-zero taxable-income)
                line3 (+ line1 line2a)
                line4 (compute-regular-or-qdcgt-tax
                        tax-year status line3 qual-div sched-d form4952-elected)
                line5 (compute-bracket-tax tax-year status line2a))
          (proto 'ret/ForeignEarnedIncomeTaxWorksheet
            :line_1_taxable_income line1
            :line_2a_exclusions_and_housing_deduction line2a
            :line_3_taxable_income_with_exclusions line3
            :line_4_tax_on_line_3 line4
            :line_5_tax_on_line_2c line5
            :line_6_tax (clamp-zero (- line4 line5)))))))

; =============================================================================
; 2. Form 1116: Multi-Basket Foreign Tax Credit & 10-Year Carryover
;    (26 U.S.C. §§ 901, 904)
; =============================================================================

(def passive-foreign-basket? ((b ret/ForeignIncomeBasket)) Bool
  (any-of (is b 'ret/FOREIGN_INCOME_BASKET_UNSPECIFIED)
      (is b 'ret/FOREIGN_INCOME_BASKET_PASSIVE)))

; Start of the 32% bracket: the Form 1116 adjustment exception threshold
; for QDCGT worksheet line 5 ($197,300 single / $394,600 MFJ for 2025).
(def thirty-two-percent-bracket-floor ((tax-year Int) (status fed/FilingStatus)) Money
  :cite ((doc "us-irs-1116-instructions-2025" "adjustment-exception"))
  (. (elt (brackets-for-status tax-year status) 4) 'floor))

; A prior-year carryover, numbered in input order. An unknown year is 0.
(defstruct FtcCarryoverEntry
  (idx Int)
  (year Int)
  (passive Money)
  (general Money))

(def index-ftc-carryovers ((cfs (Slice ret/ForeignTaxCreditCarryover))) (Slice FtcCarryoverEntry)
  (fold (fn ((acc (Slice FtcCarryoverEntry)) (c ret/ForeignTaxCreditCarryover)) (Slice FtcCarryoverEntry)
          (append acc [(FtcCarryoverEntry (len acc)
                                          (max 0 (. c 'origin_tax_year))
                                          (round-dollar (. c 'passive_basket_carryover))
                                          (round-dollar (. c 'general_basket_carryover)))]))
        ((inst empty-slice FtcCarryoverEntry))
        cfs))

; Carryovers are used oldest year first; an unknown year counts as oldest.
(def ftc-entry-used-before? ((a FtcCarryoverEntry) (b FtcCarryoverEntry)) Bool
  (any-of (< (. a 'year) (. b 'year))
      (all-of (is (. a 'year) (. b 'year)) (< (. a 'idx) (. b 'idx)))))

(def ftc-entry-amount ((e FtcCarryoverEntry) (passive Bool)) Money
  (if passive (. e 'passive) (. e 'general)))

; What is left of one carryover once `used` of the category's carryovers
; has been taken, oldest first.
(def ftc-entry-left
  ((entries (Slice FtcCarryoverEntry))
   (e FtcCarryoverEntry)
   (used Money)
   (passive Bool))
  Money
  (withs (amt (ftc-entry-amount e passive)
          earlier (sum (fn ((o FtcCarryoverEntry)) Money
                         (if (ftc-entry-used-before? o e)
                             (ftc-entry-amount o passive)
                             #usd"0.00"))
                       entries))
    (- amt (min amt (clamp-zero (- used earlier))))))

; Form 1116 Schedule B: what carries to next year. This year's taxes are used
; before carryovers, and a carryover lapses 10 years after the year it arose.
(def compute-ftc-carryforward
  ((tax-year Int)
   (entries (Slice FtcCarryoverEntry))
   (pass-cf-used Money)
   (gen-cf-used Money)
   (pass-current-left Money)
   (gen-current-left Money))
  ret/ForeignTaxCreditCarryforwardWorksheet
  :cite ((law "26 U.S.C." "904" "(c)") (doc "us-irs-form-1116-schedule-b-2025"))
  (withs (kept (keep (fn ((e FtcCarryoverEntry)) Bool
                       (or (<= (. e 'year) 0) (> (+ (. e 'year) 10) tax-year)))
                     entries)
          older (map (fn ((e FtcCarryoverEntry)) ret/ForeignTaxCreditCarryover
                       (proto 'ret/ForeignTaxCreditCarryover
                         :origin_tax_year (. e 'year)
                         :passive_basket_carryover (ftc-entry-left entries e pass-cf-used true)
                         :general_basket_carryover (ftc-entry-left entries e gen-cf-used false)))
                     kept)
          current (proto 'ret/ForeignTaxCreditCarryover
                    :origin_tax_year tax-year
                    :passive_basket_carryover pass-current-left
                    :general_basket_carryover gen-current-left)
          carried (keep (fn ((c ret/ForeignTaxCreditCarryover)) Bool
                          (or (> (. c 'passive_basket_carryover) #usd"0.00")
                              (> (. c 'general_basket_carryover) #usd"0.00")))
                        (append older [current])))
    (proto 'ret/ForeignTaxCreditCarryforwardWorksheet
      :carryovers_to_next_year carried
      :total_passive_carried_to_next_year
        (sum (fn ((c ret/ForeignTaxCreditCarryover)) Money (. c 'passive_basket_carryover)) carried)
      :total_general_carried_to_next_year
        (sum (fn ((c ret/ForeignTaxCreditCarryover)) Money (. c 'general_basket_carryover)) carried))))

; Part I and Part II columns for one foreign tax item. Foreign qualified
; dividends and capital gains are reduced on line 1a by the rate
; differential adjustment.
(def form-1116-country-column ((f ret/ForeignTaxItem) (adj-fraction Float)) fed/Form1116.CountryColumn
  :cite ((law "26 U.S.C." "904" "(b)(2)(B)") (doc "us-irs-1116-instructions-2025" "lines-1a-and-1b"))
  (withs (adj (round-dollar (* (round-dollar (. f 'foreign_qualified_dividends_and_ltcg)) adj-fraction)))
    (proto 'fed/Form1116.CountryColumn
      :country_or_territory_name (. f 'country)
      :gross_foreign_income (- (round-dollar (. f 'gross_foreign_income)) adj)
      :definitely_related_expenses (round-dollar (. f 'definitely_related_expenses))
      :total_foreign_taxes (round-dollar (. f 'foreign_taxes_paid)))))

; Form 1116 Parts I-III for one category. The deduction is apportioned to
; the category's gross foreign income over all gross income (lines 3a-3g)
; as one amount, so it appears only in the line 6 total. Taxes from payee
; statements (1099-INT/DIV) have no country and appear only in the line 8
; total.
(def compute-form-1116-category
  ((hh ret/Household)
   (tax-year Int)
   (category fed/Form1116.IncomeCategory)
   (items (Slice ret/ForeignTaxItem))
   (statement-taxes Money)
   (carryover Money)
   (adj-fraction Float)
   (ratable-denom Money)
   (chosen-deduction Money)
   (worldwide-ti Money)
   (regular-tax Money))
  fed/Form1116
  :cite ((law "26 U.S.C." "904" "(a)-(b)") (doc "us-irs-1116-instructions-2025"))
  (withs (cols (map (fn ((f ret/ForeignTaxItem)) fed/Form1116.CountryColumn
                      (form-1116-country-column f adj-fraction))
                    items)
          gross (sum (fn ((f ret/ForeignTaxItem)) Money (round-dollar (. f 'gross_foreign_income))) items)
          line1a (sum (fn ((c fed/Form1116.CountryColumn)) Money (. c 'gross_foreign_income)) cols)
          def-exp (sum (fn ((c fed/Form1116.CountryColumn)) Money (. c 'definitely_related_expenses)) cols)
          ratable (if (> gross #usd"0.00")
                      (round-dollar (* chosen-deduction (/ gross ratable-denom)))
                      #usd"0.00")
          line6 (+ def-exp ratable)
          line7 (- line1a line6)
          line8 (+ statement-taxes
                   (sum (fn ((c fed/Form1116.CountryColumn)) Money (. c 'total_foreign_taxes)) cols))
          line11 (+ line8 carryover)
          line19 (if (> line7 #usd"0.00")
                     (min 1.0 (/ line7 (max #usd"1.00" worldwide-ti)))
                     0.0)
          line21 (round-dollar (* regular-tax line19)))
    (proto 'fed/Form1116
      :tax_year tax-year
      :filer_name (person-full-name (. hh 'taxpayer))
      :filer_tin (. hh 'taxpayer.tin.number)
      :category category
      :countries cols
      :total_gross_foreign_income line1a
      :total_foreign_deductions_and_losses line6
      :net_foreign_source_taxable_income line7
      :total_foreign_taxes_paid_or_accrued line8
      :part_iii_foreign_taxes line8
      :foreign_tax_carryback_or_carryover carryover
      :total_foreign_taxes_before_reductions line11
      :net_foreign_taxes_available_for_credit line11
      :foreign_source_income_before_adjustments line7
      :adjusted_foreign_source_taxable_income line7
      :worldwide_taxable_income worldwide-ti
      :limitation_fraction line19
      :regular_us_income_tax regular-tax
      :category_foreign_tax_credit_limitation line21
      :total_category_limitation line21
      :category_foreign_tax_credit (min line11 line21))))

(defstruct Form1116Result
  ; One Form 1116 per category with foreign taxes; Part IV is on the first.
  (forms (Slice fed/Form1116))
  ; Foreign tax credit for Schedule 3 line 1.
  (total_credit Money)
  (carryforward ret/ForeignTaxCreditCarryforwardWorksheet))

(def compute-form-1116
  ((hh ret/Household)
   (tax-year Int)
   (status fed/FilingStatus)
   (docs ret/Documents)
   (credits ret/Credits)
   (prior ret/PriorYear)
   (elections ret/Elections)
   (gross-income Money)
   (chosen-deduction Money)
   (taxable-income Money)
   (qdcgt-ws ret/QDCGTWorksheet)
   (regular-tax Money))
  Form1116Result
  :cite ((law "26 U.S.C." "901") (law "26 U.S.C." "904" "(b)-(d)") (law "26 U.S.C." "904" "(j)") (doc "us-irs-1116-instructions-2025"))
  (withs (valid-cfs (keep (fn ((c ret/ForeignTaxCreditCarryover)) Bool
                            (or (<= (. c 'origin_tax_year) 0)
                                (and (> (. c 'origin_tax_year) 0)
                                     (<= (- tax-year (. c 'origin_tax_year)) 10))))
                          (. prior 'foreign_tax_credit_carryovers))
          entries (index-ftc-carryovers valid-cfs)
          no-forms ((inst empty-slice fed/Form1116))
          untouched (compute-ftc-carryforward tax-year entries #usd"0.00" #usd"0.00" #usd"0.00" #usd"0.00"))
    (if (is (. elections 'foreign_tax) 'ret/FOREIGN_TAX_ELECTION_ITEMIZED_DEDUCTION)
        (Form1116Result no-forms #usd"0.00" untouched)
        (withs (int-ft (round-dollar
                         (sum (fn ((d ret/Form1099INTDocument)) Money (. d 'form.foreign_tax_paid))
                              (. docs 'interest)))
                div-ft (round-dollar
                         (sum (fn ((d ret/Form1099DIVDocument)) Money (. d 'form.foreign_tax_paid))
                              (. docs 'dividends)))
                items (. credits 'foreign_taxes)
                pass-items (keep (fn ((f ret/ForeignTaxItem)) Bool
                                   (passive-foreign-basket? (. f 'basket)))
                                 items)
                gen-items (keep (fn ((f ret/ForeignTaxItem)) Bool
                                  (not (passive-foreign-basket? (. f 'basket))))
                                items)
                pass-cf (sum (fn ((e FtcCarryoverEntry)) Money (. e 'passive)) entries)
                gen-cf (sum (fn ((e FtcCarryoverEntry)) Money (. e 'general)) entries)
                pass-avail (+ int-ft div-ft pass-cf
                              (sum (fn ((f ret/ForeignTaxItem)) Money (round-dollar (. f 'foreign_taxes_paid)))
                                   pass-items))
                all-gross (sum (fn ((f ret/ForeignTaxItem)) Money (round-dollar (. f 'gross_foreign_income)))
                               items)
                ; § 904(b)(2)(B) rate differential. The QDCGT worksheet splits
                ; worldwide preferential income into 0%, 15% and 20% portions
                ; (lines 9, 17, 20). The inputs give foreign QDCG as one amount,
                ; so it is split in the same proportions.
                all-qdcg (sum (fn ((f ret/ForeignTaxItem)) Money
                                (round-dollar (. f 'foreign_qualified_dividends_and_ltcg)))
                              items)
                pref (. qdcgt-ws 'line_4_total_preferential_income)
                pref-0 (. qdcgt-ws 'line_9_taxed_at_zero_percent)
                pref-15 (. qdcgt-ws 'line_17_taxed_at_fifteen_percent)
                pref-20 (. qdcgt-ws 'line_20_taxed_at_twenty_percent)
                ; Worksheet for Line 18: 0% income is removed in full, 15% income
                ; times 0.5946, 20% income times 0.4595.
                worldwide-adj (round-dollar (+ pref-0 (* pref-15 0.5946) (* pref-20 0.4595)))
                ; Adjustment exception: QDCGT line 5 not above the start of the
                ; 32% bracket and foreign QDCG under $20,000. Taken whenever it
                ; is available. No adjustment either when the preferential rates
                ; do not lower the tax (QDCGT line 23 not below line 24).
                adj-exception (and (<= (. qdcgt-ws 'line_5_ordinary_taxable_income)
                                       (thirty-two-percent-bracket-floor tax-year status))
                                   (< all-qdcg #usd"20000.00"))
                rate-lowers-tax (< (. qdcgt-ws 'line_23_combined_preferential_and_ordinary_tax)
                                   (. qdcgt-ws 'line_24_regular_tax_on_all_taxable_income))
                adjust (and (> pref #usd"0.00") rate-lowers-tax (not adj-exception))
                adj-fraction (if adjust (/ worldwide-adj pref) 0.0)
                ratable-denom (max #usd"1.00" (max gross-income all-gross))
                ; Line 18: taxable income less the worldwide adjustment.
                worldwide-ti (clamp-zero (- (clamp-zero taxable-income)
                                            (if adjust worldwide-adj #usd"0.00")))
                ; Line 20: the tax the credit can offset.
                reg-tax-cap (clamp-zero regular-tax)
                ; § 904(j) election: passive taxes only, all from payee
                ; statements (1099-INT/DIV), at most $300 ($600 MFJ), and no
                ; Form 1116. Outside it, passive taxes without passive gross
                ; income get no credit this year (line 15 is $0), and carry
                ; forward.
                de-minimis-cap (if (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
                                   #usd"600.00"
                                   #usd"300.00")
                use-de-minimis (and (empty? items)
                                    (<= (+ pass-cf gen-cf) #usd"0.00")
                                    (<= pass-avail de-minimis-cap)))
          (if use-de-minimis
              (Form1116Result no-forms (min pass-avail reg-tax-cap) untouched)
              (withs (pass-form (compute-form-1116-category
                                  hh tax-year 'fed/Form1116.INCOME_CATEGORY_PASSIVE
                                  pass-items (+ int-ft div-ft) pass-cf adj-fraction
                                  ratable-denom chosen-deduction worldwide-ti reg-tax-cap)
                      gen-form (compute-form-1116-category
                                 hh tax-year 'fed/Form1116.INCOME_CATEGORY_GENERAL
                                 gen-items #usd"0.00" gen-cf adj-fraction
                                 ratable-denom chosen-deduction worldwide-ti reg-tax-cap)
                      pass-24 (. pass-form 'category_foreign_tax_credit)
                      gen-24 (. gen-form 'category_foreign_tax_credit)
                      ; Part IV: lines 32, 33 and 35.
                      line32 (+ pass-24 gen-24)
                      line33 (min reg-tax-cap line32)
                      filed (keep (fn ((f fed/Form1116)) Bool
                                    (> (. f 'net_foreign_taxes_available_for_credit) #usd"0.00"))
                                  [pass-form gen-form])
                      forms (if (empty? filed)
                                filed
                                (append [(proto-with (elt filed 0)
                                           :summary_passive_category_credit pass-24
                                           :summary_general_category_credit gen-24
                                           :total_combined_category_credits line32
                                           :capped_combined_foreign_tax_credit line33
                                           :foreign_tax_credit line33)]
                                        (subslice filed 1 (len filed))))
                      ; When line 33 limits the credit, the general category's
                      ; taxes are the ones left over.
                      gen-used (min gen-24 (clamp-zero (- reg-tax-cap pass-24)))
                      pass-current (. pass-form 'part_iii_foreign_taxes)
                      gen-current (. gen-form 'part_iii_foreign_taxes)
                      pass-current-used (min pass-current pass-24)
                      gen-current-used (min gen-current gen-used))
                (Form1116Result
                  forms
                  line33
                  (compute-ftc-carryforward
                    tax-year entries
                    (- pass-24 pass-current-used)
                    (- gen-used gen-current-used)
                    (- pass-current pass-current-used)
                    (- gen-current gen-current-used)))))))))

; =============================================================================
; 3. Schedule J (3-Year Farm Income Averaging, 26 U.S.C. § 1301)
;    (Schedule F net farm profit & SE earnings are in 05d_schedule_se_and_qbi.tlisp)
; =============================================================================

(def filing-status-or ((s fed/FilingStatus) (default-status fed/FilingStatus)) fed/FilingStatus
  (if (is s 'fed/FILING_STATUS_UNSPECIFIED) default-status s))

; Schedule J lines 1-23. Lines 2b and 2c, the capital gain part of elected
; farm income, are not figured.
(def compute-schedule-j
  ((hh ret/Household)
   (tax-year Int)
   (status fed/FilingStatus)
   (prior ret/PriorYear)
   (taxable-income Money)
   (qual-div Money)
   (sched-d fed/ScheduleD)
   (form4952-elected Money))
  fed/ScheduleJ
  :cite ((law "26 U.S.C." "1301") (doc "us-irs-schedule-j-instructions-2025"))
  (withs (hist (. prior 'schedule_j_history)
          raw-elected (round-dollar (. hist 'elected_farm_income)))
    (if (<= raw-elected #usd"0.00")
        (proto 'fed/ScheduleJ)
        (withs (ti (clamp-zero taxable-income)
                elected (min ti raw-elected)
                one-third (round-dollar (/ elected 3.0))
                reduced-ti (clamp-zero (- ti elected))
                tax-reduced (compute-regular-or-qdcgt-tax
                              tax-year status reduced-ti qual-div sched-d form4952-elected)
                ; Lines 5, 9, 13: a base year's own Schedule J amount, when it
                ; filed one, replaces its taxable income and may be negative.
                st-3 (filing-status-or (. hist 'year_minus_3_filing_status) status)
                st-2 (filing-status-or (. hist 'year_minus_2_filing_status) status)
                st-1 (filing-status-or (. hist 'year_minus_1_filing_status) status)
                ti-3 (if (has? hist 'year_minus_3_schedule_j_amount)
                         (round-dollar (. hist 'year_minus_3_schedule_j_amount))
                         (clamp-zero (round-dollar (. hist 'year_minus_3_taxable_income))))
                ti-2 (if (has? hist 'year_minus_2_schedule_j_amount)
                         (round-dollar (. hist 'year_minus_2_schedule_j_amount))
                         (clamp-zero (round-dollar (. hist 'year_minus_2_taxable_income))))
                ti-1 (if (has? hist 'year_minus_1_schedule_j_amount)
                         (round-dollar (. hist 'year_minus_1_schedule_j_amount))
                         (clamp-zero (round-dollar (. hist 'year_minus_1_taxable_income))))
                re-3 (+ ti-3 one-third)
                re-2 (+ ti-2 one-third)
                re-1 (+ ti-1 one-third)
                ; Lines 8, 12, 16 and 19-21 at each base year's own rates.
                tax-re-3 (compute-bracket-tax (- tax-year 3) st-3 re-3)
                tax-re-2 (compute-bracket-tax (- tax-year 2) st-2 re-2)
                tax-re-1 (compute-bracket-tax (- tax-year 1) st-1 re-1)
                prior-3 (compute-bracket-tax (- tax-year 3) st-3 ti-3)
                prior-2 (compute-bracket-tax (- tax-year 2) st-2 ti-2)
                prior-1 (compute-bracket-tax (- tax-year 1) st-1 ti-1)
                line17 (+ tax-reduced tax-re-3 tax-re-2 tax-re-1)
                line22 (+ prior-3 prior-2 prior-1))
          (proto 'fed/ScheduleJ
            :tax_year tax-year
            :filer_name (person-full-name (. hh 'taxpayer))
            :filer_tin (. hh 'taxpayer.tin.number)
            :current_year_taxable_income ti
            :elected_farm_income elected
            :taxable_income_less_elected_farm_income reduced-ti
            :tax_on_non_averaged_current_year_income tax-reduced
            :base_year_minus_3_taxable_income ti-3
            :one_third_of_elected_farm_income one-third
            :base_year_minus_3_recomputed_taxable_income re-3
            :base_year_minus_3_recomputed_tax tax-re-3
            :base_year_minus_2_taxable_income ti-2
            :base_year_minus_2_elected_farm_income_share one-third
            :base_year_minus_2_recomputed_taxable_income re-2
            :base_year_minus_2_recomputed_tax tax-re-2
            :base_year_minus_1_taxable_income ti-1
            :base_year_minus_1_elected_farm_income_share one-third
            :base_year_minus_1_recomputed_taxable_income re-1
            :base_year_minus_1_recomputed_tax tax-re-1
            :combined_current_and_recomputed_base_year_taxes line17
            :combined_taxes_carried_to_page_2 line17
            :base_year_minus_3_prior_tax prior-3
            :base_year_minus_2_prior_tax prior-2
            :base_year_minus_1_prior_tax prior-1
            :total_prior_base_year_taxes line22
            :averaged_income_tax (- line17 line22))))))

; =============================================================================
; 4. Schedule H: Household Employment Taxes (26 U.S.C. §§ 3121(a)(7), 3301)
; =============================================================================

; Schedule H when the household paid or withheld anything. Section B takes
; the state credit as the contributions paid, without the column (g)
; experience-rate credit.
(def compute-schedule-h ((hh ret/Household) (tax-year Int)) fed/ScheduleH
  :cite ((law "26 U.S.C." "3121" "(a)(7)") (law "26 U.S.C." "3301") (doc "us-irs-schedule-h-instructions-2025"))
  (withs (he (. hh 'household_employment)
          tp (. hh 'taxpayer)
          ss-wages (round-dollar (. he 'social_security_wages))
          med-wages (round-dollar (. he 'medicare_wages))
          addl-med-wages (round-dollar (. he 'additional_medicare_wages))
          fed-withheld (round-dollar (. he 'federal_income_tax_withheld))
          futa-wages (round-dollar (. he 'futa_taxable_wages))
          sui-paid (round-dollar (. he 'state_unemployment_contributions_paid))
          full-futa (if (has? he 'qualifies_for_full_futa_credit)
                        (. he 'qualifies_for_full_futa_credit)
                        true)
          ; Part I
          ss-tax (round-dollar (* ss-wages 0.124))
          med-tax (round-dollar (* med-wages 0.029))
          addl-med-tax (round-dollar (* addl-med-wages 0.009))
          line8 (+ ss-tax med-tax addl-med-tax fed-withheld)
          paid-fica (or (> ss-wages #usd"0.00") (> med-wages #usd"0.00"))
          ; Part II
          gross-futa (round-dollar (* futa-wages 0.060))
          max-credit (round-dollar (* futa-wages 0.054))
          state-credit (min max-credit sui-paid)
          section-b-futa (clamp-zero (- gross-futa state-credit))
          section-a-futa (round-dollar (* futa-wages 0.006))
          futa-tax (if full-futa section-a-futa section-b-futa)
          base (proto 'fed/ScheduleH
                 :tax_year tax-year
                 :employer_name (person-full-name tp)
                 :employer_tin (. tp 'tin.number)
                 :paid_cash_wages_above_fica_threshold paid-fica
                 :withheld_federal_income_tax (> fed-withheld #usd"0.00")
                 :paid_quarterly_cash_wages_above_futa_threshold (> futa-wages #usd"0.00")
                 :cash_wages_subject_to_social_security ss-wages
                 :social_security_tax ss-tax
                 :cash_wages_subject_to_medicare med-wages
                 :medicare_tax med-tax
                 :cash_wages_subject_to_additional_medicare addl-med-wages
                 :additional_medicare_tax_withholding addl-med-tax
                 :federal_income_tax_withheld fed-withheld
                 :total_fica_and_withheld_income_taxes line8
                 :owes_futa_tax (> futa-wages #usd"0.00")
                 :part_iii_fica_and_income_taxes line8
                 :total_household_employment_taxes (+ line8 futa-tax)
                 :required_to_file_form_1040 true)
          with-futa (cond
                      ((<= futa-wages #usd"0.00") base)
                      (full-futa
                       (proto-with base
                         :paid_contributions_to_one_state true
                         :paid_state_unemployment_timely true
                         :futa_wages_taxable_for_state true
                         :state_unemployment_contributions sui-paid
                         :cash_wages_subject_to_futa futa-wages
                         :section_a_futa_tax section-a-futa))
                      (else
                       (proto-with base
                         :total_contributions_paid sui-paid
                         :total_state_credit sui-paid
                         :section_b_cash_wages_subject_to_futa futa-wages
                         :gross_futa_tax gross-futa
                         :maximum_state_credit max-credit
                         :state_unemployment_credit state-credit
                         :section_b_futa_tax section-b-futa))))
    (if (or paid-fica
            (> fed-withheld #usd"0.00")
            (> futa-wages #usd"0.00"))
        with-futa
        (proto 'fed/ScheduleH))))

; =============================================================================
; 5. Form 8814 (Parent's Election To Report Child's Interest and Dividends) &
;    Form 8615 (Tax for Certain Children Who Have Unearned Income, 26 U.S.C. § 1(g))
; =============================================================================

; § 1(g)(7) amounts: the § 63(c)(5)(A) amount ($1,350 for 2025 and 2026,
; Rev. Proc. 2024-40 § 3.02 and Rev. Proc. 2025-32 § 4.02) and twice it.
(def kiddie-base-amount ((p FederalYear)) Money
  :cite ((law "26 U.S.C." "1" "(g)(4)(A)(ii)(I)") (doc "us-irs-rev-proc-2024-40") (doc "us-irs-rev-proc-2025-32"))
  (. p 'dep_std_ded_min))

; § 1(g)(7)(A): the election is open only when the child's gross income is
; under 10 times the base amount ($13,500) and comes only from interest and
; dividends, and no tax was withheld or paid as estimated tax.
(def child-8814-eligible? ((c ret/ChildDividendInclusion) (p FederalYear)) Bool
  :cite ((law "26 U.S.C." "1" "(g)(7)(A)") (doc "us-irs-8814-instructions-2025" "purpose-of-form"))
  (withs (gross (+ (round-dollar (. c 'taxable_interest))
                   (round-dollar (. c 'ordinary_dividends))
                   (round-dollar (. c 'capital_gain_distributions))))
    (all-of (< gross (* (kiddie-base-amount p) 10.0))
         (<= (round-dollar (. c 'other_gross_income)) #usd"0.00")
         (<= (round-dollar (. c 'federal_income_tax_withheld)) #usd"0.00")
         (<= (round-dollar (. c 'estimated_tax_payments)) #usd"0.00"))))

(def compute-one-child-8814
  ((hh ret/Household)
   (tax-year Int)
   (c ret/ChildDividendInclusion)
   (multiple Bool)
   (p FederalYear))
  fed/Form8814
  :cite ((law "26 U.S.C." "1" "(g)(7)") (doc "us-irs-8814-instructions-2025"))
  (withs (tp (. hh 'taxpayer)
          child (lookup-dependent-by-id hh (. c 'dependent))
          base (kiddie-base-amount p)
          twice-base (* base 2.0)
          int-inc (round-dollar (. c 'taxable_interest))
          ord-div (round-dollar (. c 'ordinary_dividends))
          qual-div (min ord-div (round-dollar (. c 'qualified_dividends)))
          cap-dist (round-dollar (. c 'capital_gain_distributions))
          total-inc (+ int-inc ord-div cap-dist)
          excess (clamp-zero (- total-inc twice-base))
          above-not-taxed (clamp-zero (- total-inc base))
          lines (proto 'fed/Form8814
                  :tax_year tax-year
                  :parent_name (person-full-name tp)
                  :parent_tin (. tp 'tin.number)
                  :child_name (dependent-full-name child)
                  :child_tin (. child 'tin.number)
                  :multiple_forms_8814_filed multiple
                  :child_taxable_interest int-inc
                  :child_tax_exempt_interest (round-dollar (. c 'tax_exempt_interest))
                  :child_ordinary_dividends ord-div
                  :child_qualified_dividends qual-div
                  :child_capital_gain_distributions cap-dist
                  :total_child_income total-inc
                  :base_amount twice-base
                  :income_above_base_amount excess
                  :amount_not_taxed base
                  :child_income_above_amount_not_taxed above-not-taxed
                  :tax_on_child_income (round-dollar (* (min above-not-taxed base) 0.10))))
    ; Lines 7-12 only when line 6 is above zero.
    (if (<= excess #usd"0.00")
        lines
        (withs (qual-frac (/ qual-div total-inc)
                cap-frac (/ cap-dist total-inc)
                inc-qual (round-dollar (* excess qual-frac))
                inc-cap (round-dollar (* excess cap-frac)))
          (proto-with lines
            :qualified_dividends_fraction qual-frac
            :capital_gain_distributions_fraction cap-frac
            :parent_included_qualified_dividends inc-qual
            :parent_included_capital_gain_distributions inc-cap
            :total_preferential_income_included (+ inc-qual inc-cap)
            :parent_included_ordinary_income (clamp-zero (- excess (+ inc-qual inc-cap))))))))

; One Form 8814 per eligible child.
(def compute-form-8814s ((hh ret/Household) (tax-year Int) (p FederalYear)) (Slice fed/Form8814)
  :cite ((law "26 U.S.C." "1" "(g)(7)") (doc "us-irs-8814-instructions-2025"))
  (withs (children (keep (fn ((c ret/ChildDividendInclusion)) Bool (child-8814-eligible? c p))
                         (. hh 'form_8814_children))
          multiple (> (len children) 1))
    (map (fn ((c ret/ChildDividendInclusion)) fed/Form8814
           (compute-one-child-8814 hh tax-year c multiple p))
         children)))

; Tax on taxable income with the given qualified dividends and net capital
; gain, through the QDCGT worksheet when there is any.
(def tax-with-preferential-income
  ((tax-year Int)
   (status fed/FilingStatus)
   (taxable-income Money)
   (qual-div Money)
   (net-cap-gain Money))
  Money
  (compute-regular-or-qdcgt-tax
    tax-year status taxable-income qual-div
    (proto 'fed/ScheduleD
      :net_long_term_gain_or_loss net-cap-gain
      :net_gain_or_loss net-cap-gain)
    #usd"0.00"))

; The Form 8615 line C box for a filing status.
(def filing-status-label ((s fed/FilingStatus)) String
  (cond
    ((is s 'fed/FILING_STATUS_SINGLE) "Single")
    ((is s 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY) "Married filing jointly")
    ((is s 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY) "Married filing separately")
    ((is s 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD) "Head of household")
    ((is s 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE) "Qualifying surviving spouse")
    (else "")))

; Form 8615 when the child has net unearned income (line 5 above zero);
; otherwise an empty message.
(def compute-form-8615
  ((hh ret/Household)
   (tax-year Int)
   (status fed/FilingStatus)
   (total-income Money)
   (earned-income Money)
   (taxable-income Money)
   (qual-div Money)
   (sched-d fed/ScheduleD)
   (regular-tax Money)
   (p FederalYear))
  fed/Form8615
  :cite ((law "26 U.S.C." "1" "(g)") (doc "us-irs-8615-instructions-2025"))
  (withs (kt (. hh 'kiddie_tax)
          parent-ti (round-dollar (. kt 'parent_taxable_income))
          unearned (clamp-zero (- total-income earned-income))
          thresh (* (kiddie-base-amount p) 2.0)
          above-thresh (clamp-zero (- unearned thresh))
          child-ti (clamp-zero taxable-income)
          net-unearned (min child-ti above-thresh))
    (if (or (and (<= parent-ti #usd"0.00") (is (. kt 'parent_name) ""))
            (<= net-unearned #usd"0.00"))
        (proto 'fed/Form8615)
        ; Line C needs the parent's filing status. When it is unset, single
        ; is used: its brackets are never wider than the joint ones, so the
        ; parent's rate is not understated.
        (withs (tp (. hh 'taxpayer)
                p-status (filing-status-or
                           (. kt 'parent_filing_status)
                           'fed/FILING_STATUS_SINGLE)
                other-kids (round-dollar (. kt 'other_children_net_unearned_income))
                all-kids (+ net-unearned other-kids)
                ; Child's qualified dividends and net capital gain are
                ; split between net unearned income and the rest in
                ; proportion (Form 8615 Instructions, line 9 worksheet).
                child-qd (clamp-zero qual-div)
                child-cg (clamp-zero (min (. sched-d 'net_long_term_gain_or_loss)
                                          (. sched-d 'net_gain_or_loss)))
                nui-share (if (> unearned #usd"0.00") (min 1.0 (/ net-unearned unearned)) 0.0)
                nui-qd (round-dollar (* child-qd nui-share))
                nui-cg (round-dollar (* child-cg nui-share))
                parent-qd (round-dollar (. kt 'parent_qualified_dividends))
                parent-cg (round-dollar (. kt 'parent_net_capital_gain))
                combined-ti (+ parent-ti all-kids)
                combined-pref (> (+ parent-qd nui-qd parent-cg nui-cg) #usd"0.00")
                parent-pref (> (+ parent-qd parent-cg) #usd"0.00")
                line9 (tax-with-preferential-income
                        tax-year p-status combined-ti
                        (+ parent-qd nui-qd) (+ parent-cg nui-cg))
                line10 (tax-with-preferential-income
                         tax-year p-status parent-ti parent-qd parent-cg)
                line11 (clamp-zero (- line9 line10))
                line12b (/ net-unearned all-kids)
                line13 (round-dollar (* line11 line12b))
                line14 (clamp-zero (- taxable-income net-unearned))
                rest-qd (clamp-zero (- child-qd nui-qd))
                rest-cg (clamp-zero (- child-cg nui-cg))
                line15 (tax-with-preferential-income tax-year status line14 rest-qd rest-cg)
                line16 (+ line13 line15))
          (proto 'fed/Form8615
            :tax_year tax-year
            :child_name (person-full-name tp)
            :child_tin (. tp 'tin.number)
            :parent_name (. kt 'parent_name)
            :parent_tin (. kt 'parent_tin.number)
            :parent_filing_status (filing-status-label (. kt 'parent_filing_status))
            :child_unearned_income unearned
            :unearned_income_threshold_or_deductions thresh
            :unearned_income_above_threshold above-thresh
            :child_taxable_income child-ti
            :net_unearned_income net-unearned
            :parent_taxable_income parent-ti
            :other_children_net_unearned_income other-kids
            :combined_taxable_income combined-ti
            :tax_on_combined_taxable_income line9
            :combined_tax_used_worksheet_or_schedule_j combined-pref
            :parent_tax line10
            :parent_tax_used_worksheet_or_schedule_j parent-pref
            :total_parental_tax_on_children_unearned_income line11
            :total_children_net_unearned_income all-kids
            :child_share_of_net_unearned_income line12b
            :child_share_of_parental_tax line13
            :child_taxable_income_less_net_unearned_income line14
            :tax_on_child_taxable_income_less_net_unearned_income line15
            :child_rate_tax_used_worksheet_or_schedule_j (> (+ rest-qd rest-cg) #usd"0.00")
            :combined_kiddie_tax line16
            :regular_tax_on_child_taxable_income regular-tax
            :child_tax (max regular-tax line16))))))

; =============================================================================
; 6. Form 4684: Casualties and Thefts (Section A, 26 U.S.C. § 165(h))
; =============================================================================

; Section A lines 1-12 for one casualty. Each input loss is its own event,
; so the $100 or $500 floor applies to it alone.
(def compute-one-form-4684
  ((hh ret/Household)
   (tax-year Int)
   (c ret/CasualtyLoss))
  fed/Form4684
  :cite ((law "26 U.S.C." "165" "(h)(1)") (doc "us-irs-form-4684-2025" "lines-1-12"))
  (withs (tp (. hh 'taxpayer)
          basis (round-dollar (. c 'cost_basis))
          insurance (round-dollar (. c 'insurance_reimbursement))
          fmv-before (round-dollar (. c 'fmv_before))
          fmv-after (round-dollar (. c 'fmv_after))
          decrease (clamp-zero (- fmv-before fmv-after))
          smaller (min basis decrease)
          loss (clamp-zero (- smaller insurance)))
    (proto 'fed/Form4684
      :tax_year tax-year
      :filer_name (person-full-name tp)
      :filer_tin (. tp 'tin.number)
      :federally_declared_disaster (casualty-federally-declared? tax-year c)
      :fema_disaster_declaration_number (. c 'fema_disaster_number)
      :personal_properties [(proto 'fed/Form4684.PersonalPropertyItem
                              :property_type (. c 'description)
                              :cost_or_other_basis basis
                              :insurance_or_other_reimbursement insurance
                              :gain_from_casualty_or_theft (casualty-gain c)
                              :fmv_before fmv-before
                              :fmv_after fmv-after
                              :decrease_in_fmv decrease
                              :smaller_of_basis_or_decrease_in_fmv smaller
                              :unadjusted_property_loss loss)]
      :total_event_loss_before_floor loss
      :per_event_dollar_floor (if (. c 'qualified_disaster_loss) #usd"500.00" #usd"100.00")
      :event_loss_after_dollar_floor (casualty-loss-after-floor c))))

; One Form 4684 per casualty, with lines 13-18 for all of them on the first.
; Line 14 counts a loss outside a federally declared disaster only up to the
; casualty gains. A net gain (line 13 above line 14) is not carried to
; Schedule D, so lines 15-18 are left unset then.
(def compute-form-4684s
  ((hh ret/Household)
   (tax-year Int)
   (losses (Slice ret/CasualtyLoss))
   (agi Money))
  (Slice fed/Form4684)
  :cite ((law "26 U.S.C." "165" "(h)") (doc "us-irs-4684-instructions-2025"))
  (if (empty? losses)
      ((inst empty-slice fed/Form4684))
      (withs (forms (map (fn ((c ret/CasualtyLoss)) fed/Form4684
                           (compute-one-form-4684 hh tax-year c))
                         losses)
              totals (compute-casualty-totals tax-year losses)
              line13 (sum casualty-gain losses)
              other (sum casualty-loss-after-floor
                         (keep (fn ((c ret/CasualtyLoss)) Bool
                                 (not (casualty-federally-declared? tax-year c)))
                               losses))
              line14 (+ (- (. totals 'losses_after_floor) other) (min other line13))
              summary (if (> line13 line14)
                          (proto-with (elt forms 0)
                            :total_casualty_or_theft_gains line13
                            :total_losses_from_all_events line14)
                          (withs (line16 (. totals 'federal_net)
                                  line17 (round-dollar (* (clamp-zero agi) 0.10)))
                            (proto-with (elt forms 0)
                              :total_casualty_or_theft_gains line13
                              :total_losses_from_all_events line14
                              :net_gain_or_qualified_disaster_loss (. totals 'qualified_net)
                              :losses_subject_to_agi_floor line16
                              :agi_floor line17
                              :deductible_personal_casualty_loss (clamp-zero (- line16 line17))))))
        (append [summary] (subslice forms 1 (len forms))))))

; =============================================================================
; 7. Form 5329 Parts I-IX: Additional Taxes on Qualified Plans, IRAs, ESAs,
;    MSAs, HSAs, ABLE Accounts, and RMD Shortfalls (26 U.S.C. §§ 72(t), 4973, 4974)
; =============================================================================

(def roth-ira-allowed-contribution
  ((tax-year Int)
   (status fed/FilingStatus)
   (lived-with-spouse Bool)
   (person ret/Person)
   (trad-contrib Money)
   (magi Money)
   (compensation Money)
   (p FederalYear))
  Money
  :cite ((law "26 U.S.C." "408A" "(c)") (doc "us-irs-rev-proc-2024-40") (doc "us-irs-rev-proc-2025-32"))
  (withs (age (person-age-end-of-year (. person 'date_of_birth) tax-year)
          stat-cap (if (>= age 50)
                       (+ (. p 'ira_limit_under_50) (. p 'ira_catchup_50))
                       (. p 'ira_limit_under_50))
          start (cond
                  ((or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
                       (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
                   (if (is tax-year 2026) #usd"242000.00" #usd"236000.00"))
                  ((and (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
                        lived-with-spouse)
                   #usd"0.00")
                  (else
                   (if (is tax-year 2026) #usd"153000.00" #usd"150000.00")))
          width (cond
                  ((or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
                       (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
                   #usd"10000.00")
                  ((and (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
                        lived-with-spouse)
                   #usd"10000.00")
                  (else #usd"15000.00"))
          phased (ira-allowed-after-phaseout stat-cap magi start width)
          rem-after-trad (clamp-zero (- stat-cap trad-contrib)))
    (min phased (min rem-after-trad (clamp-zero compensation)))))

; 6% of the excess, but not of more than the account's year-end value when
; that is known.
(def excess-contribution-tax ((excess Money) (year-end-value Money)) Money
  :cite ((law "26 U.S.C." "4973" "(b)"))
  (round-dollar (* (if (> year-end-value #usd"0.00") (min excess year-end-value) excess) 0.06)))

; Form 5329 for one person. Lines 10-13 and the matching lines in Parts
; IV-VII, which reduce a prior year's excess, are not figured: the prior
; excess is carried in full. The ESA, Archer MSA and ABLE inputs are the
; year's total excess (lines 32, 40 and 50).
(def compute-form-5329-for-person
  ((tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (docs ret/Documents)
   (retire ret/Retirement)
   (health ret/Health)
   (person ret/Person)
   (magi Money)
   (earned-income Money)
   (p FederalYear))
  fed/Form5329
  :cite ((law "26 U.S.C." "72" "(t)") (law "26 U.S.C." "72" "(q)") (law "26 U.S.C." "529") (law "26 U.S.C." "529A") (law "26 U.S.C." "530") (law "26 U.S.C." "4973") (law "26 U.S.C." "4974") (doc "us-irs-5329-instructions-2025"))
  (withs (pid (. person 'id)
          is-tp (is pid (. hh 'taxpayer.id))
          ; Part I: 10% tax on early distributions
          r-docs (keep (fn ((d ret/Form1099RDocument)) Bool
                         (or (is (. d 'person) pid)
                             (and is-tp (is (. d 'person) ""))))
                       (. docs 'retirement_distributions))
          line1 (sum (fn ((d ret/Form1099RDocument)) Money (early-distribution-includible d tax-year)) r-docs)
          line2 (sum (fn ((d ret/Form1099RDocument)) Money (early-distribution-exempt d tax-year)) r-docs)
          line3 (clamp-zero (- line1 line2))
          pr (fold (fn ((acc ret/PersonRetirement) (r ret/PersonRetirement)) ret/PersonRetirement
                     (if (is (. r 'person) pid) r acc))
                   (proto 'ret/PersonRetirement)
                   (. retire 'persons))
          f5329 (. pr 'form_5329)
          ; Part II: 10% tax on taxable education or ABLE distributions
          line5 (round-dollar (. f5329 'taxable_education_or_able_distributions))
          ; Part III: excess traditional IRA contributions
          age (person-age-end-of-year (. person 'date_of_birth) tax-year)
          stat-cap (if (>= age 50)
                       (+ (. p 'ira_limit_under_50) (. p 'ira_catchup_50))
                       (. p 'ira_limit_under_50))
          max-ira (min stat-cap (clamp-zero earned-income))
          trad-contrib (round-dollar (. pr 'traditional_ira_contributions))
          line9 (round-dollar (. f5329 'prior_excess_traditional_ira))
          line15 (clamp-zero (- trad-contrib max-ira))
          line16 (+ line9 line15)
          ; Part IV: excess Roth IRA contributions
          roth-allowed (roth-ira-allowed-contribution
                         tax-year status (. hh 'lived_with_spouse_any_time)
                         person trad-contrib magi earned-income p)
          line18 (round-dollar (. f5329 'prior_excess_roth_ira))
          line23 (clamp-zero (- (round-dollar (. pr 'roth_ira_contributions)) roth-allowed))
          line24 (+ line18 line23)
          ; Parts V, VI and VIII: Coverdell ESA, Archer MSA and ABLE excess
          line32 (round-dollar (. f5329 'excess_coverdell_esa_contributions))
          line40 (round-dollar (. f5329 'excess_archer_msa_contributions))
          line50 (round-dollar (. f5329 'excess_able_contributions))
          ; Part VII: excess HSA contributions, from each HSA's Form 8889
          hsas (keep (fn ((h ret/PersonHSA)) Bool
                       (or (is (. h 'person) pid)
                           (and is-tp (is (. h 'person) ""))))
                     (. health 'hsa_accounts))
          hsa-current (fn ((h ret/PersonHSA)) Money
                        (withs (f (compute-one-form-8889 tax-year hh docs h p))
                          (clamp-zero (- (+ (. f 'personal_hsa_contributions)
                                            (. f 'total_employer_and_funding_contributions))
                                         (. f 'total_contribution_limitation)))))
          line42 (sum (fn ((h ret/PersonHSA)) Money (round-dollar (. h 'prior_excess_contributions))) hsas)
          line47 (sum hsa-current hsas)
          line49 (sum (fn ((h ret/PersonHSA)) Money
                        (excess-contribution-tax
                          (+ (hsa-current h) (round-dollar (. h 'prior_excess_contributions)))
                          (round-dollar (. h 'year_end_fair_market_value))))
                      hsas)
          ; Part IX: 10% on shortfalls corrected within the correction window
          ; (line 54a), 25% on all others (line 54b). The single
          ; reasonable-cause waiver reduces the 25% shortfall first.
          req-a (round-dollar (. f5329 'rmd_required_corrected_plans))
          req-b (round-dollar (. f5329 'rmd_required_other_plans))
          dist-a (round-dollar (. f5329 'rmd_distributed_corrected_plans))
          dist-b (round-dollar (. f5329 'rmd_distributed_other_plans))
          short-a (clamp-zero (- req-a dist-a))
          short-b (clamp-zero (- req-b dist-b))
          rmd-waiver (round-dollar (. f5329 'rmd_shortfall_waiver_requested))
          waiver-b (min short-b rmd-waiver)
          waiver-a (min short-a (clamp-zero (- rmd-waiver waiver-b)))
          line54a (round-dollar (* (- short-a waiver-a) 0.10))
          line54b (round-dollar (* (- short-b waiver-b) 0.25)))
    (proto 'fed/Form5329
      :tax_year tax-year
      :individual_name (person-full-name person)
      :individual_tin (. person 'tin.number)
      :early_distributions_includible_in_income line1
      :early_distributions_exempt_from_tax line2
      :early_distributions_subject_to_tax line3
      :additional_tax_on_early_distributions (round-dollar (* line3 0.10))
      :taxable_education_or_able_distributions line5
      :education_or_able_distributions_subject_to_tax line5
      :additional_tax_on_education_or_able_distributions (round-dollar (* line5 0.10))
      :prior_year_traditional_ira_excess_contributions line9
      :remaining_prior_traditional_ira_excess line9
      :current_year_traditional_ira_excess_contributions line15
      :total_traditional_ira_excess_contributions line16
      :additional_tax_on_traditional_ira_excess
        (excess-contribution-tax line16 (round-dollar (. pr 'ira_basis.year_end_traditional_ira_value)))
      :prior_year_roth_ira_excess_contributions line18
      :remaining_prior_roth_ira_excess line18
      :current_year_roth_ira_excess_contributions line23
      :total_roth_ira_excess_contributions line24
      :additional_tax_on_roth_ira_excess
        (excess-contribution-tax line24 (round-dollar (. f5329 'year_end_roth_ira_value)))
      :total_coverdell_esa_excess_contributions line32
      :additional_tax_on_coverdell_esa_excess (excess-contribution-tax line32 #usd"0.00")
      :total_archer_msa_excess_contributions line40
      :additional_tax_on_archer_msa_excess (excess-contribution-tax line40 #usd"0.00")
      :prior_year_hsa_excess_contributions line42
      :remaining_prior_hsa_excess line42
      :current_year_hsa_excess_contributions line47
      :total_hsa_excess_contributions (+ line42 line47)
      :additional_tax_on_hsa_excess line49
      :current_year_able_excess_contributions line50
      :additional_tax_on_able_excess (excess-contribution-tax line50 #usd"0.00")
      :rmd_from_corrected_plans req-a
      :rmd_from_other_plans req-b
      :distributed_from_corrected_plans dist-a
      :distributed_from_other_plans dist-b
      :tax_on_corrected_rmd_shortfall line54a
      :tax_on_other_rmd_shortfall line54b
      :additional_tax_on_excess_accumulation (+ line54a line54b))))

; The additional taxes on one Form 5329 (lines 4, 8, 17, 25, 33, 41, 49, 51
; and 55), carried to Schedule 2 lines 8 and 17.
(def form-5329-total-tax ((f fed/Form5329)) Money
  (+ (. f 'additional_tax_on_early_distributions)
     (. f 'additional_tax_on_education_or_able_distributions)
     (. f 'additional_tax_on_traditional_ira_excess)
     (. f 'additional_tax_on_roth_ira_excess)
     (. f 'additional_tax_on_coverdell_esa_excess)
     (. f 'additional_tax_on_archer_msa_excess)
     (. f 'additional_tax_on_hsa_excess)
     (. f 'additional_tax_on_able_excess)
     (. f 'additional_tax_on_excess_accumulation)))

; One Form 5329 per spouse with an additional tax or an excess contribution
; to carry to next year (lines 16, 24, 32, 40, 48 and 50).
(def compute-form-5329s
  ((tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (docs ret/Documents)
   (retire ret/Retirement)
   (health ret/Health)
   (magi Money)
   (earned-income Money)
   (p FederalYear))
  (Slice fed/Form5329)
  :cite ((law "26 U.S.C." "72" "(t)") (law "26 U.S.C." "4973") (law "26 U.S.C." "4974") (doc "us-irs-5329-instructions-2025"))
  (withs (people (if (is (. hh 'spouse.id) "")
                     [(. hh 'taxpayer)]
                     [(. hh 'taxpayer) (. hh 'spouse)])
          forms (map (fn ((person ret/Person)) fed/Form5329
                       (compute-form-5329-for-person
                         tax-year status hh docs retire health person magi earned-income p))
                     people))
    (keep (fn ((f fed/Form5329)) Bool
            (or (> (form-5329-total-tax f) #usd"0.00")
                (> (+ (. f 'total_traditional_ira_excess_contributions)
                      (. f 'total_roth_ira_excess_contributions)
                      (. f 'total_coverdell_esa_excess_contributions)
                      (. f 'total_archer_msa_excess_contributions)
                      (. f 'total_hsa_excess_contributions)
                      (. f 'current_year_able_excess_contributions))
                   #usd"0.00")))
          forms)))

; =============================================================================
; 8. Form 8962: Premium Tax Credit (26 U.S.C. § 36B) & Pub. 974 Iterative
;    SEHI <-> PTC Convergence
; =============================================================================

(defstruct PTCResult
  (net_ptc Money)
  (excess_aptc_repayment Money))

(def fpl-for-household-size ((tax-year Int) (family-size Int)) Money
  :cite ((law "26 U.S.C." "36B" "(d)(3)") (doc "us-hhs-poverty-guidelines-2024" "contiguous-states"))
  (withs (n (max 1 family-size)
          extra (int-to-float (- n 1)))
    (if (is tax-year 2026)
        (round-dollar (+ #usd"15650.00" (* #usd"5500.00" extra)))
        (round-dollar (+ #usd"15060.00" (* #usd"5380.00" extra))))))

(def ptc-interpolate ((fpl-pct Float) (lo Float) (hi Float) (initial Float) (final Float)) Float
  (+ initial (* (/ (- fpl-pct lo) (- hi lo)) (- final initial))))

(def ptc-applicable-percentage ((tax-year Int) (fpl-pct Float)) Float
  :cite ((law "26 U.S.C." "36B" "(b)(3)(A)") (doc "us-irs-rev-proc-2025-25" "section-3-01"))
  (if (is tax-year 2026)
      ; Rev. Proc. 2025-25: the ARPA/IRA enhancement ended after 2025.
      (cond
        ((< fpl-pct 133.0) 0.0210)
        ((< fpl-pct 150.0) (ptc-interpolate fpl-pct 133.0 150.0 0.0314 0.0419))
        ((< fpl-pct 200.0) (ptc-interpolate fpl-pct 150.0 200.0 0.0419 0.0660))
        ((< fpl-pct 250.0) (ptc-interpolate fpl-pct 200.0 250.0 0.0660 0.0844))
        ((< fpl-pct 300.0) (ptc-interpolate fpl-pct 250.0 300.0 0.0844 0.0996))
        (else 0.0996))
      ; 2025: ARPA/IRA table, § 36B(b)(3)(A)(iii) (0% to 150% FPL, 8.5% at
      ; 400% and above).
      (cond
        ((<= fpl-pct 150.0) 0.0000)
        ((<= fpl-pct 200.0) (* (/ (- fpl-pct 150.0) 50.0) 0.0200))
        ((<= fpl-pct 250.0) (+ 0.0200 (* (/ (- fpl-pct 200.0) 50.0) 0.0200)))
        ((<= fpl-pct 300.0) (+ 0.0400 (* (/ (- fpl-pct 250.0) 50.0) 0.0200)))
        ((<= fpl-pct 400.0) (+ 0.0600 (* (/ (- fpl-pct 300.0) 100.0) 0.0250)))
        (else 0.0850))))

; From 2026 household income above 400% of FPL allows no credit (§ 36B(c)(1)(A)).
(def ptc-income-eligible? ((tax-year Int) (fpl-pct Float)) Bool
  :cite ((law "26 U.S.C." "36B" "(c)(1)(A)") (law "26 U.S.C." "36B" "(c)(1)(E)"))
  (if (is tax-year 2026) (<= fpl-pct 400.0) true))

(def ptc-repayment-cap ((tax-year Int) (status fed/FilingStatus) (fpl-pct Float)) Money
  :cite ((law "26 U.S.C." "36B" "(f)(2)(B)") (doc "us-irs-rev-proc-2024-40") (law "P.L. 119-21" "71305"))
  ; P.L. 119-21 § 71305 repeals the cap for tax years after 2025.
  (if (or (is tax-year 2026) (>= fpl-pct 400.0))
      #usd"10000000.00"
      (withs (single? (is status 'fed/FILING_STATUS_SINGLE))
        (cond
          ((< fpl-pct 200.0) (if single? #usd"375.00" #usd"750.00"))
          ((< fpl-pct 300.0) (if single? #usd"975.00" #usd"1950.00"))
          (else              (if single? #usd"1625.00" #usd"3250.00"))))))

(def policy-allocation-factor ((d ret/Form1095ADocument)) Float
  (withs (pct (. d 'allocation_percent))
    (if (and (> pct 0.0) (<= pct 100.0))
        (/ pct 100.0)
        (if (and (> pct 0.0) (<= pct 1.0))
            pct
            1.0))))

(def doc-1095a-total-premium ((d ret/Form1095ADocument)) Money
  (withs (f (. d 'form)
          mult (policy-allocation-factor d)
          ann (round-dollar (. f 'total_monthly_enrollment_premiums))
          m-sum (round-dollar
                  (sum (fn ((m fed/MonthlyCoverage)) Money (. m 'enrollment_premiums))
                       (. f 'monthly_coverage))))
    (round-dollar (* (if (> ann #usd"0.00") ann m-sum) mult))))

(def doc-1095a-total-slcsp ((d ret/Form1095ADocument)) Money
  (withs (f (. d 'form)
          mult (policy-allocation-factor d)
          ann (round-dollar (. f 'total_second_lowest_cost_silver_plan_premium))
          m-sum (round-dollar
                  (sum (fn ((m fed/MonthlyCoverage)) Money (. m 'second_lowest_cost_silver_plan_premium))
                       (. f 'monthly_coverage))))
    (round-dollar (* (if (> ann #usd"0.00") ann m-sum) mult))))

(def doc-1095a-total-aptc ((d ret/Form1095ADocument)) Money
  (withs (f (. d 'form)
          mult (policy-allocation-factor d)
          ann (round-dollar (. f 'total_advance_payment_of_premium_tax_credit))
          m-sum (round-dollar
                  (sum (fn ((m fed/MonthlyCoverage)) Money (. m 'advance_payment_of_premium_tax_credit))
                       (. f 'monthly_coverage))))
    (round-dollar (* (if (> ann #usd"0.00") ann m-sum) mult))))

(def compute-form-8962-ptc
  ((tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (docs ret/Documents)
   (agi Money)
   (tax-exempt-int Money)
   (ss-untaxed Money)
   (feie-total Money))
  PTCResult
  :cite ((law "26 U.S.C." "36B") (doc "us-irs-8962-instructions-2025"))
  (withs (policies (. docs 'marketplace_coverage))
    (if (empty? policies)
        (PTCResult #usd"0.00" #usd"0.00")
        (withs (has-spouse (and (!= (. hh 'spouse.id) "")
                                (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY))
                num-deps (len (keep (fn ((d ret/Dependent)) Bool
                                      (claimed-dependent? d tax-year (year-params tax-year)))
                                    (. hh 'dependents)))
                fam-size (+ (if has-spouse 2 1) num-deps)
                fpl (fpl-for-household-size tax-year fam-size)
                household-inc (clamp-zero (+ agi tax-exempt-int ss-untaxed feie-total))
                fpl-pct (* (/ (money-to-float household-inc) (money-to-float fpl)) 100.0)
                app-pct (ptc-applicable-percentage tax-year fpl-pct)
                annual-contrib (round-dollar (* household-inc app-pct))
                total-prem (sum doc-1095a-total-premium policies)
                total-slcsp (sum doc-1095a-total-slcsp policies)
                total-aptc (sum doc-1095a-total-aptc policies)
                max-assist (clamp-zero (- total-slcsp annual-contrib))
                ; § 36B(c)(1)(C): married filing separately allows no credit.
                ; The inputs carry no domestic abuse or abandonment flag
                ; (Treas. Reg. § 1.36B-2(b)(2)(ii)), so no MFS filer qualifies.
                eligible (and (not (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY))
                              (ptc-income-eligible? tax-year fpl-pct))
                total-ptc (if eligible (min total-prem max-assist) #usd"0.00")
                net-ptc (clamp-zero (- total-ptc total-aptc))
                raw-repay (clamp-zero (- total-aptc total-ptc))
                repay-cap (ptc-repayment-cap tax-year status fpl-pct)
                repay (min raw-repay repay-cap))
          (PTCResult net-ptc repay)))))

; Pub. 974 Iterative Method for Self-Employed Health Insurance Deduction and
; Premium Tax Credit when Marketplace 1095-A coverage is present:
; Each iteration refines `se-health-ded` = min(net_se_profit_limit, max_se_health - ptc).
(def iterate-pub974-sehi-step
  ((tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (docs ret/Documents)
   (max-se-health Money)
   (base-agi-without-sehi Money)
   (tax-exempt-int Money)
   (ss-untaxed Money)
   (feie-total Money)
   (curr-sehi Money))
  Money
  :cite ((doc "us-irs-pub-974-2025" "iterative-calculation-method"))
  (withs (trial-agi (- base-agi-without-sehi curr-sehi)
          ptc-res (compute-form-8962-ptc
                    tax-year status hh docs trial-agi tax-exempt-int ss-untaxed feie-total)
          total-aptc (sum doc-1095a-total-aptc (. docs 'marketplace_coverage))
          total-ptc (- (+ total-aptc (. ptc-res 'net_ptc)) (. ptc-res 'excess_aptc_repayment)))
    (clamp-zero (- max-se-health total-ptc))))

(def compute-pub974-se-health-deduction
  ((tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (docs ret/Documents)
   (max-se-health Money)
   (base-agi-without-sehi Money)
   (tax-exempt-int Money)
   (ss-untaxed Money)
   (feie-total Money))
  Money
  :cite ((doc "us-irs-pub-974-2025") (law "26 U.S.C." "162" "(l)(4)") (law "26 U.S.C." "36B"))
  (if (or (<= max-se-health #usd"0.00")
          (empty? (. docs 'marketplace_coverage)))
      max-se-health
      (withs (s1 (iterate-pub974-sehi-step tax-year status hh docs max-se-health base-agi-without-sehi tax-exempt-int ss-untaxed feie-total max-se-health)
              s2 (iterate-pub974-sehi-step tax-year status hh docs max-se-health base-agi-without-sehi tax-exempt-int ss-untaxed feie-total s1)
              s3 (iterate-pub974-sehi-step tax-year status hh docs max-se-health base-agi-without-sehi tax-exempt-int ss-untaxed feie-total s2)
              s4 (iterate-pub974-sehi-step tax-year status hh docs max-se-health base-agi-without-sehi tax-exempt-int ss-untaxed feie-total s3))
        (min max-se-health s4))))

; =============================================================================
; 9. Form 2210: Underpayment of Estimated Tax by Individuals & Schedule AI
;    Annualized Income Installment Method (26 U.S.C. § 6654)
; =============================================================================

(def estimated-payment-quarter ((ep ret/EstimatedPayment) (tax-year Int)) Int
  (withs (dt (. ep 'date_paid)
          yr (date-year dt)
          mo (date-month dt)
          dy (date-day dt))
    (cond
      ((> yr tax-year) 4)
      ((< yr tax-year) 1)
      ((or (< mo 4) (and (is mo 4) (<= dy 15))) 1)
      ((or (< mo 6) (and (is mo 6) (<= dy 15))) 2)
      ((or (< mo 9) (and (is mo 9) (<= dy 15))) 3)
      (else 4))))

(def quarter-estimated-payments ((payments ret/Payments) (tax-year Int) (qtr Int)) Money
  (round-dollar
    (sum (fn ((ep ret/EstimatedPayment)) Money
           (if (and (or (is (. ep 'jurisdiction) "US")
                        (is (. ep 'jurisdiction) ""))
                    (or (is (. ep 'designated_tax_year) tax-year)
                        (<= (. ep 'designated_tax_year) 0))
                    (is (estimated-payment-quarter ep tax-year) qtr))
               (. ep 'amount)
               #usd"0.00"))
         (. payments 'estimated_payments))))

(def underpayment-rate ((year Int) (quarter Int)) Float
  :cite ((law "26 U.S.C." "6621" "(a)(2)") (law "26 U.S.C." "6654" "(a)") (doc "us-irs-quarterly-interest-rates-2025" "rates-2025") (doc "us-irs-quarterly-interest-rates-2025" "rates-2026"))
  ; 7% for every quarter of 2025 and for Q1, Q3 and Q4 2026; 6% for Q2 2026
  ; (Rev. Rul. 2026-5). 2027 rates are not announced yet; the Q4 2026 rate
  ; stands in for them.
  (if (and (is year 2026) (is quarter 2))
      0.06
      0.07))

; Interest factor for an underpayment outstanding from one installment due
; date to the next, splitting the days at calendar quarters (Form 2210
; Penalty Worksheet rate periods). Days: Apr 15-Jun 15 = 61; Jun 15-Sep 15 =
; 15 + 77; Sep 15-Jan 15 = 15 + 92 + 15; Jan 15-Apr 15 = 75 + 15.
(def installment-interest-factor ((tax-year Int) (installment Int)) Float
  :cite ((law "26 U.S.C." "6654" "(a)") (doc "us-irs-2210-instructions-2025" "penalty-worksheet"))
  (withs (y tax-year
          y1 (+ tax-year 1))
    (/ (cond
         ((is installment 1) (* 61.0 (underpayment-rate y 2)))
         ((is installment 2) (+ (* 15.0 (underpayment-rate y 2))
                                (* 77.0 (underpayment-rate y 3))))
         ((is installment 3) (+ (* 15.0 (underpayment-rate y 3))
                                (* 92.0 (underpayment-rate y 4))
                                (* 15.0 (underpayment-rate y1 1))))
         (else (+ (* 75.0 (underpayment-rate y1 1))
                  (* 15.0 (underpayment-rate y1 2)))))
       365.0)))

; Penalty on cumulative required installments against cumulative timely
; payments: each period's unpaid balance accrues interest until the next due
; date, which equals applying payments to the oldest installment first.
(def installment-penalty
  ((tax-year Int)
   (cum-req (Slice Money))
   (cum-pay (Slice Money)))
  Money
  :cite ((law "26 U.S.C." "6654" "(a)-(c)") (doc "us-irs-2210-instructions-2025" "penalty-worksheet"))
  (round-dollar
    (+ (* (clamp-zero (- (elt cum-req 0) (elt cum-pay 0))) (installment-interest-factor tax-year 1))
       (* (clamp-zero (- (elt cum-req 1) (elt cum-pay 1))) (installment-interest-factor tax-year 2))
       (* (clamp-zero (- (elt cum-req 2) (elt cum-pay 2))) (installment-interest-factor tax-year 3))
       (* (clamp-zero (- (elt cum-req 3) (elt cum-pay 3))) (installment-interest-factor tax-year 4)))))

; Schedule AI lines 1-19 and Part II for one period. Period AGI, itemized
; deductions, QBI deduction and self-employment profit are the cumulative
; amounts for the period; each is annualized here. Line 10 also takes the
; Schedule 1-A deductions, unannualized. Part II lines 29-31 use the year's
; wages rather than the period's, so they are left unset.
(def compute-annualized-period
  ((tax-year Int)
   (status fed/FilingStatus)
   (period Int)
   (period-agi Money)
   (period-ded Money)
   (ann-factor Float)
   (std-ded Money)
   (period-qbi-ded Money)
   (sched-1a-ded Money)
   (period-se-profit Money)
   (other-taxes Money)
   (total-credits Money)
   (wage-base Money)
   (w2-ss-wages Money))
  fed/Form2210.AnnualizationPeriod
  :cite ((law "26 U.S.C." "6654" "(d)(2)") (doc "us-irs-form-2210-2025" "schedule-ai"))
  (withs (ann-agi (round-dollar (* period-agi ann-factor))
          ann-item (round-dollar (* period-ded ann-factor))
          ann-qbi (round-dollar (* period-qbi-ded ann-factor))
          ded-used (max std-ded ann-item)
          total-ded (+ ded-used ann-qbi sched-1a-ded)
          ann-ti (clamp-zero (- ann-agi total-ded))
          ann-reg-tax (compute-bracket-tax tax-year status ann-ti)
          ; Part II: line 36 is the period's net earnings times 92.35%,
          ; annualized. The prorated wage base times the annualization
          ; amount equals the annual base, so the annualized net earnings
          ; are compared with the base less the year's W-2 wages.
          ne (round-dollar (* period-se-profit 0.9235))
          ann-ne (round-dollar (* ne ann-factor))
          has-se (>= ne #usd"400.00")
          ss-tax (if has-se
                     (round-dollar (* (min ann-ne (clamp-zero (- wage-base w2-ss-wages))) 0.124))
                     #usd"0.00")
          med-tax (if has-se (round-dollar (* ann-ne 0.029)) #usd"0.00")
          se-tax (+ ss-tax med-tax)
          total-tax (+ ann-reg-tax se-tax other-taxes))
    (proto 'fed/Form2210.AnnualizationPeriod
      :period period
      :adjusted_gross_income period-agi
      :annualized_income ann-agi
      :itemized_deductions period-ded
      :annualized_itemized_deductions ann-item
      :standard_deduction std-ded
      :deduction ded-used
      :qualified_business_income_deduction ann-qbi
      :total_deductions total-ded
      :income_less_deductions (- ann-agi total-ded)
      :annualized_taxable_income ann-ti
      :tax ann-reg-tax
      :self_employment_tax se-tax
      :other_taxes other-taxes
      :total_tax total-tax
      :credits total-credits
      :tax_after_credits (clamp-zero (- total-tax total-credits))
      :net_earnings_from_self_employment ne
      :annualized_social_security_tax ss-tax
      :annualized_medicare_tax med-tax
      :annualized_self_employment_tax se-tax)))

; Schedule AI lines 20-27 across the periods, in order.
(defstruct ScheduleAIRunning
  (rows (Slice fed/Form2210.AnnualizationPeriod))
  ; Total of line 27 so far (line 22 of the next column).
  (installments_so_far Money)
  ; Line 26 less line 27 of the previous column (line 25).
  (regular_left Money))

(def schedule-ai-applicable-percentage ((period Int)) Float
  (cond
    ((is period 1) 0.225)
    ((is period 2) 0.45)
    ((is period 3) 0.675)
    (else 0.90)))

(def complete-schedule-ai
  ((periods (Slice fed/Form2210.AnnualizationPeriod))
   (regular-installment Money))
  (Slice fed/Form2210.AnnualizationPeriod)
  :cite ((doc "us-irs-form-2210-2025" "schedule-ai-lines-20-27"))
  (. (fold (fn ((acc ScheduleAIRunning) (ap fed/Form2210.AnnualizationPeriod)) ScheduleAIRunning
             (withs (line21 (round-dollar (* (. ap 'tax_after_credits)
                                             (schedule-ai-applicable-percentage (. ap 'period))))
                     line22 (. acc 'installments_so_far)
                     line23 (clamp-zero (- line21 line22))
                     line25 (. acc 'regular_left)
                     line26 (+ regular-installment line25)
                     line27 (min line23 line26))
               (ScheduleAIRunning
                 (append (. acc 'rows)
                         [(proto-with ap
                            :applicable_tax line21
                            :prior_installments line22
                            :annualized_installment line23
                            :regular_installment regular-installment
                            :prior_regular_installment_excess line25
                            :available_regular_installment line26
                            :required_installment line27)])
                 (+ line22 line27)
                 (- line26 line27))))
           (ScheduleAIRunning ((inst empty-slice fed/Form2210.AnnualizationPeriod)) #usd"0.00" #usd"0.00")
           periods)
     'rows))

; Part III, Section A, lines 10-18, column by column.
(defstruct PaymentRunning
  (rows (Slice fed/Form2210.PaymentPeriod))
  ; Lines 16 and 17 of the previous column (line 14 of the next).
  (shortfall Money)
  ; Line 18 of the previous column (line 12 of the next).
  (overpayment Money))

(def compute-payment-periods
  ((installments (Slice Money))
   (payments (Slice Money)))
  (Slice fed/Form2210.PaymentPeriod)
  :cite ((doc "us-irs-form-2210-2025" "part-iii-section-a"))
  (. (fold (fn ((acc PaymentRunning) (i Int)) PaymentRunning
             (withs (line10 (elt installments i)
                     line11 (elt payments i)
                     first (is i 0)
                     line12 (. acc 'overpayment)
                     line13 (+ line11 line12)
                     line14 (. acc 'shortfall)
                     line15 (if first line11 (clamp-zero (- line13 line14)))
                     line16 (if (and (not first) (<= line15 #usd"0.00"))
                                (clamp-zero (- line14 line13))
                                #usd"0.00")
                     line17 (clamp-zero (- line10 line15))
                     line18 (clamp-zero (- line15 line10))
                     row (proto 'fed/Form2210.PaymentPeriod
                           :period (+ i 1)
                           :required_installment line10
                           :estimated_tax_paid_and_withheld line11
                           :net_timely_payments line15
                           :underpayment line17
                           :overpayment line18))
               (PaymentRunning
                 (append (. acc 'rows)
                         [(if first
                              row
                              (proto-with row
                                :prior_period_overpayment line12
                                :payments_with_prior_overpayment line13
                                :prior_period_shortfall line14
                                :shortfall_carried_forward line16))])
                 (+ line16 line17)
                 line18)))
           (PaymentRunning ((inst empty-slice fed/Form2210.PaymentPeriod)) #usd"0.00" #usd"0.00")
           [0 1 2 3])
     'rows))

(def running-totals ((xs (Slice Money))) (Slice Money)
  (fold (fn ((acc (Slice Money)) (x Money)) (Slice Money)
          (append acc [(+ x (if (empty? acc) #usd"0.00" (elt acc (- (len acc) 1))))]))
        ((inst empty-slice Money))
        xs))

(defstruct Form2210Result
  (form fed/Form2210)
  ; Whether Form 2210 is filed: there is a penalty before any waiver, and
  ; the filer is not a qualified farmer or fisherman (who files Form 2210-F).
  (filed Bool)
  ; Penalty after the requested waiver, for Form 1040 line 38.
  (penalty Money))

(def compute-form-2210
  ((hh ret/Household)
   (tax-year Int)
   (status fed/FilingStatus)
   (payments ret/Payments)
   (prior ret/PriorYear)
   (std-ded Money)
   (sched-1a-ded Money)
   (line21-nonref-credits Money)
   (line22-tax-after-nonref-credits Money)
   (line23-other-taxes Money)
   (se-tax Money)
   (se-w2-ss-wages Money)
   (wage-base Money)
   (line25d-withholding Money)
   (refundable-credits Money))
  Form2210Result
  :cite ((law "26 U.S.C." "6654") (doc "us-irs-2210-instructions-2025"))
  (withs (curr-tax (clamp-zero (- (+ line22-tax-after-nonref-credits line23-other-taxes)
                                  refundable-credits))
          pct90 (round-dollar (* curr-tax 0.90))
          farmer (. payments 'penalty_waiver.qualified_farmer_or_fisherman)
          pct-farmer (round-dollar (* curr-tax 0.6667))
          curr-req (if farmer pct-farmer pct90)
          prior-tax (round-dollar (. prior 'prior_year_total_tax))
          prior-agi (round-dollar (. prior 'prior_year_agi))
          high-inc-thresh (if (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
                              #usd"75000.00"
                              #usd"150000.00")
          prior-mult (if (and (not farmer) (> prior-agi high-inc-thresh)) 1.10 1.00)
          prior-req (round-dollar (* prior-tax prior-mult))
          has-prior (> prior-tax #usd"0.00")
          req-annual (if has-prior (min curr-req prior-req) curr-req)
          ; § 6654(e)(2): no penalty when the prior year was a full 12-month
          ; year as a U.S. citizen or resident with no tax.
          no-prior-tax (and (. prior 'prior_year_full_year_citizen_or_resident)
                            (has? prior 'prior_year_total_tax)
                            (<= prior-tax #usd"0.00"))
          ; Quarterly timely payments and withholding
          ai (. payments 'annualized_income)
          has-actual-wh (or (> (round-dollar (. ai 'q1_actual_withholding)) #usd"0.00")
                            (> (round-dollar (. ai 'q2_actual_withholding)) #usd"0.00")
                            (> (round-dollar (. ai 'q3_actual_withholding)) #usd"0.00")
                            (> (round-dollar (. ai 'q4_actual_withholding)) #usd"0.00"))
          wh-q1 (if has-actual-wh (round-dollar (. ai 'q1_actual_withholding)) (round-dollar (* line25d-withholding 0.25)))
          wh-q2 (if has-actual-wh (round-dollar (. ai 'q2_actual_withholding)) (round-dollar (* line25d-withholding 0.25)))
          wh-q3 (if has-actual-wh (round-dollar (. ai 'q3_actual_withholding)) (round-dollar (* line25d-withholding 0.25)))
          wh-q4 (if has-actual-wh (round-dollar (. ai 'q4_actual_withholding)) (- line25d-withholding (+ wh-q1 wh-q2 wh-q3)))
          prior-overpay (round-dollar (. payments 'prior_year_federal_overpayment_applied))
          pays [(+ prior-overpay wh-q1 (quarter-estimated-payments payments tax-year 1))
                (+ wh-q2 (quarter-estimated-payments payments tax-year 2))
                (+ wh-q3 (quarter-estimated-payments payments tax-year 3))
                (+ wh-q4 (quarter-estimated-payments payments tax-year 4))]
          cum-pay (running-totals pays)
          total-timely (elt cum-pay 3)
          net-balance-after-wh (clamp-zero (- curr-tax line25d-withholding))
          waiver (round-dollar (. payments 'penalty_waiver.requested_waiver_amount))
          ; Parts I and II
          part-1 (proto 'fed/Form2210
                   :tax_year tax-year
                   :filer_name (person-full-name (. hh 'taxpayer))
                   :filer_tin (. hh 'taxpayer.tin.number)
                   :current_year_tax_after_credits line22-tax-after-nonref-credits
                   :other_taxes line23-other-taxes
                   :refundable_credits refundable-credits
                   :total_current_year_tax curr-tax
                   :current_year_safe_harbor_tax curr-req
                   :total_tax_withheld line25d-withholding
                   :net_tax_after_withholding net-balance-after-wh
                   :required_annual_payment req-annual
                   :required_payment_exceeds_withholding (> req-annual line25d-withholding)
                   :requests_partial_waiver (> waiver #usd"0.00")
                   :treats_withholding_as_paid_when_withheld has-actual-wh)
          part-2 (if has-prior (proto-with part-1 :prior_year_safe_harbor_tax prior-req) part-1))
    ; Under IRC § 6654(e)(1), no penalty if tax minus withholding < $1,000
    (if (or (< net-balance-after-wh #usd"1000.00")
            no-prior-tax
            (>= line25d-withholding req-annual))
        (Form2210Result part-2 false #usd"0.00")
        (withs (; Regular method: 25% of line 9 in each column.
                q-req (round-dollar (* req-annual 0.25))
                reg-installments [q-req q-req q-req q-req]
                ; A qualified farmer or fisherman has one installment, due
                ; January 15.
                reg-pen (if farmer
                            (round-dollar (* (clamp-zero (- req-annual total-timely))
                                             (installment-interest-factor tax-year 4)))
                            (installment-penalty tax-year (running-totals reg-installments) cum-pay))
                ; Schedule AI Annualized Income Installment Method, columns
                ; (a)-(c). Column (d) is not figured: the last installment is
                ; what is left of four regular installments.
                has-ai (or (> (round-dollar (. ai 'period_1_agi)) #usd"0.00")
                           (> (round-dollar (. ai 'period_2_agi)) #usd"0.00")
                           (> (round-dollar (. ai 'period_3_agi)) #usd"0.00"))
                other-non-se (clamp-zero (- line23-other-taxes se-tax))
                ; Schedule AI line 18 takes the credits behind Form 2210
                ; lines 1 and 3.
                ai-credits (+ line21-nonref-credits refundable-credits)
                ai-periods (complete-schedule-ai
                             [(compute-annualized-period
                                tax-year status 1
                                (round-dollar (. ai 'period_1_agi)) (round-dollar (. ai 'period_1_deductions))
                                4.0 std-ded (round-dollar (. ai 'period_1_qbi_deduction)) sched-1a-ded
                                (round-dollar (. ai 'period_1_self_employment_income))
                                other-non-se ai-credits wage-base se-w2-ss-wages)
                              (compute-annualized-period
                                tax-year status 2
                                (round-dollar (. ai 'period_2_agi)) (round-dollar (. ai 'period_2_deductions))
                                2.4 std-ded (round-dollar (. ai 'period_2_qbi_deduction)) sched-1a-ded
                                (round-dollar (. ai 'period_2_self_employment_income))
                                other-non-se ai-credits wage-base se-w2-ss-wages)
                              (compute-annualized-period
                                tax-year status 3
                                (round-dollar (. ai 'period_3_agi)) (round-dollar (. ai 'period_3_deductions))
                                1.5 std-ded (round-dollar (. ai 'period_3_qbi_deduction)) sched-1a-ded
                                (round-dollar (. ai 'period_3_self_employment_income))
                                other-non-se ai-credits wage-base se-w2-ss-wages)]
                             q-req)
                ai-first-three (map (fn ((ap fed/Form2210.AnnualizationPeriod)) Money
                                      (. ap 'required_installment))
                                    ai-periods)
                ai-installments (append ai-first-three
                                        [(clamp-zero (- (* q-req 4.0) (sum-money ai-first-three)))])
                ai-pen (installment-penalty tax-year (running-totals ai-installments) cum-pay)
                use-ai (and has-ai (not farmer) (< ai-pen reg-pen))
                best-pen (if use-ai ai-pen reg-pen)
                net-pen (clamp-zero (- best-pen waiver))
                part-4 (proto-with part-2
                         :uses_annualized_income_method use-ai
                         :payment_periods (compute-payment-periods
                                            (if use-ai ai-installments reg-installments)
                                            pays)
                         :estimated_tax_penalty net-pen))
          (Form2210Result
            (if use-ai (proto-with part-4 :annualization_periods ai-periods) part-4)
            (and (not farmer) (> best-pen #usd"0.00"))
            net-pen)))))
