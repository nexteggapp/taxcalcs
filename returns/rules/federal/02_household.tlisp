; Household, age attainment (January 1 rule), filing status eligibility and
; resolution (26 U.S.C. §§ 1, 2, 7703), and Section 152 dependency and Child
; Tax Credit / Other Dependent Credit tests (26 U.S.C. §§ 24, 152).

(def person-age-end-of-year ((dob Date) (tax-year Int)) Int
  :cite ((law "26 C.F.R." "1.152-1") (doc "us-irs-rev-rul-2003-72"))
  (withs (yr (date-year dob)
          mo (date-month dob)
          dy (date-day dob))
    (if (<= yr 0)
        0
        (if (and (is mo 1) (is dy 1))
            (+ (- tax-year yr) 1)
            (- tax-year yr)))))

(def born-before-65-cutoff? ((dob Date) (tax-year Int)) Bool
  :cite ((law "26 U.S.C." "63" "(f)(1)"))
  (>= (person-age-end-of-year dob tax-year) 65))

(def valid-employment-ssn? ((tin ret/TaxpayerID)) Bool
  :cite ((law "26 U.S.C." "24" "(h)(7)"))
  (all-of (is (. tin 'kind) 'ret/TAXPAYER_ID_KIND_SSN)
       (. tin 'valid_for_employment)))

(def valid-dependent-tin? ((tin ret/TaxpayerID)) Bool
  :cite ((law "26 U.S.C." "24" "(h)(4)") (law "26 U.S.C." "151" "(e)"))
  (any-of (is (. tin 'kind) 'ret/TAXPAYER_ID_KIND_SSN)
      (is (. tin 'kind) 'ret/TAXPAYER_ID_KIND_ITIN)
      (is (. tin 'kind) 'ret/TAXPAYER_ID_KIND_ATIN)))

(def qualifying-child-relationship? ((rel ret/Relationship)) Bool
  :cite ((law "26 U.S.C." "152" "(c)(2)"))
  (any-of (is rel 'ret/RELATIONSHIP_CHILD)
      (is rel 'ret/RELATIONSHIP_STEPCHILD)
      (is rel 'ret/RELATIONSHIP_FOSTER_CHILD)
      (is rel 'ret/RELATIONSHIP_GRANDCHILD)
      (is rel 'ret/RELATIONSHIP_SIBLING)
      (is rel 'ret/RELATIONSHIP_HALF_SIBLING)
      (is rel 'ret/RELATIONSHIP_STEPSIBLING)
      (is rel 'ret/RELATIONSHIP_NIECE_OR_NEPHEW)
      (is rel 'ret/RELATIONSHIP_OTHER_DESCENDANT_OF_SIBLING)))

(def qualifying-relative-relationship-or-household? ((dep ret/Dependent)) Bool
  :cite ((law "26 U.S.C." "152" "(d)(2)"))
  (withs (rel (. dep 'relationship))
    (any-of (qualifying-child-relationship? rel)
        (is rel 'ret/RELATIONSHIP_PARENT)
        (is rel 'ret/RELATIONSHIP_STEPPARENT)
        (is rel 'ret/RELATIONSHIP_GRANDPARENT)
        (is rel 'ret/RELATIONSHIP_AUNT_OR_UNCLE)
        (is rel 'ret/RELATIONSHIP_IN_LAW)
        (all-of (is rel 'ret/RELATIONSHIP_NOT_RELATED)
             (is (. dep 'months_lived_with_you) 12)))))

(def passes-joint-return-test? ((dep ret/Dependent)) Bool
  :cite ((law "26 U.S.C." "152" "(b)(2)"))
  (any-of (not (. dep 'files_joint_return))
      (. dep 'joint_return_only_for_refund)))

(def passes-citizen-test? ((dep ret/Dependent)) Bool
  :cite ((law "26 U.S.C." "152" "(b)(3)"))
  (. dep 'citizen_or_resident_of_north_america))

(def qualifying-child-core? ((dep ret/Dependent) (tax-year Int)) Bool
  :cite ((law "26 U.S.C." "152" "(c)"))
  (withs (age (person-age-end-of-year (. dep 'date_of_birth) tax-year)
          age-ok (any-of (< age 19)
                     (all-of (< age 24) (. dep 'full_time_student))
                     (. dep 'permanently_disabled))
          residency-ok (any-of (> (. dep 'months_lived_with_you) 6)
                           (is (. dep 'custodial_release) 'ret/CUSTODIAL_RELEASE_RELEASED_TO_YOU)))
    (all-of (qualifying-child-relationship? (. dep 'relationship))
         age-ok
         residency-ok
         (not (. dep 'provided_over_half_own_support))
         (passes-joint-return-test? dep)
         (passes-citizen-test? dep))))

(def qualifying-child? ((dep ret/Dependent) (tax-year Int)) Bool
  :cite ((law "26 U.S.C." "152" "(c)") (law "26 U.S.C." "152" "(e)"))
  (all-of (qualifying-child-core? dep tax-year)
       (not (. dep 'not_claimed))
       (not (is (. dep 'custodial_release) 'ret/CUSTODIAL_RELEASE_RELEASED_BY_YOU))))

(def ctc-qualifying-child? ((dep ret/Dependent) (tax-year Int)) Bool
  :cite ((law "26 U.S.C." "24" "(c)") (law "26 U.S.C." "24" "(h)(7)"))
  (all-of (qualifying-child? dep tax-year)
       (< (person-age-end-of-year (. dep 'date_of_birth) tax-year) 17)
       (valid-employment-ssn? (. dep 'tin))))

(def qualifying-relative? ((dep ret/Dependent) (tax-year Int) (p FederalYear)) Bool
  :cite ((law "26 U.S.C." "152" "(d)"))
  (all-of (not (qualifying-child-core? dep tax-year))
       (not (. dep 'qualifying_child_of_another_taxpayer))
       (qualifying-relative-relationship-or-household? dep)
       (< (. dep 'gross_income) (. p 'qr_gross_income_limit))
       (any-of (. dep 'you_provided_over_half_support)
           (. dep 'multiple_support_agreement))
       (passes-joint-return-test? dep)
       (passes-citizen-test? dep)
       (not (. dep 'not_claimed))))

(def odc-qualifying-dependent? ((dep ret/Dependent) (tax-year Int) (p FederalYear)) Bool
  :cite ((law "26 U.S.C." "24" "(h)(4)"))
  (all-of (valid-dependent-tin? (. dep 'tin))
       (any-of (all-of (qualifying-child? dep tax-year)
                (not (ctc-qualifying-child? dep tax-year)))
           (qualifying-relative? dep tax-year p))))

(def claimed-dependent? ((dep ret/Dependent) (tax-year Int) (p FederalYear)) Bool
  :cite ((law "26 U.S.C." "152" "(a)"))
  (all-of (valid-dependent-tin? (. dep 'tin))
       (any-of (qualifying-child? dep tax-year)
           (qualifying-relative? dep tax-year p))))

(def count-ctc-children ((deps (Slice ret/Dependent)) (tax-year Int)) Int
  (len (keep (fn ((d ret/Dependent)) Bool (ctc-qualifying-child? d tax-year)) deps)))

(def count-odc-dependents ((deps (Slice ret/Dependent)) (tax-year Int) (p FederalYear)) Int
  (len (keep (fn ((d ret/Dependent)) Bool (odc-qualifying-dependent? d tax-year p)) deps)))

(def has-hoh-qualifying-person? ((hh ret/Household) (tax-year Int) (p FederalYear)) Bool
  :cite ((law "26 U.S.C." "2" "(b)(1)"))
  (withs (deps (. hh 'dependents))
    (any-of (some (fn ((d ret/Dependent)) Bool
                (all-of (> (. d 'months_lived_with_you) 6)
                     (any-of (qualifying-child-core? d tax-year)
                         (all-of (qualifying-relative? d tax-year p)
                              (not (is (. d 'relationship) 'ret/RELATIONSHIP_NOT_RELATED))))))
              deps)
        (all-of (. hh 'paid_over_half_cost_of_parents_home)
             (some (fn ((d ret/Dependent)) Bool
                     (all-of (is (. d 'relationship) 'ret/RELATIONSHIP_PARENT)
                          (qualifying-relative? d tax-year p)))
                   deps)))))

(def eligible-for-qss? ((hh ret/Household) (tax-year Int)) Bool
  :cite ((law "26 U.S.C." "2" "(a)"))
  (withs (died-yr (date-year (. hh 'earlier_spouse_died_on))
          deps (. hh 'dependents))
    (all-of (is (. hh 'marital_status) 'ret/MARITAL_STATUS_WIDOWED)
         (any-of (is died-yr (- tax-year 1))
             (is died-yr (- tax-year 2)))
         (. hh 'paid_over_half_cost_of_home)
         (some (fn ((d ret/Dependent)) Bool
                 (all-of (is (. d 'months_lived_with_you) 12)
                      (any-of (is (. d 'relationship) 'ret/RELATIONSHIP_CHILD)
                          (is (. d 'relationship) 'ret/RELATIONSHIP_STEPCHILD))
                      (qualifying-child? d tax-year)))
               deps))))

(def considered-unmarried-for-hoh? ((hh ret/Household) (tax-year Int)) Bool
  :cite ((law "26 U.S.C." "7703" "(b)"))
  (all-of (is (. hh 'marital_status) 'ret/MARITAL_STATUS_MARRIED)
       (. hh 'spouse_absent_last_six_months)
       (. hh 'paid_over_half_cost_of_home)
       (some (fn ((d ret/Dependent)) Bool
               (all-of (> (. d 'months_lived_with_you) 6)
                    (any-of (is (. d 'relationship) 'ret/RELATIONSHIP_CHILD)
                        (is (. d 'relationship) 'ret/RELATIONSHIP_STEPCHILD)
                        (is (. d 'relationship) 'ret/RELATIONSHIP_FOSTER_CHILD))
                    (qualifying-child? d tax-year)))
             (. hh 'dependents))))

(def resolve-filing-status
  ((hh ret/Household)
   (elections ret/Elections)
   (tax-year Int)
   (p FederalYear))
  fed/FilingStatus
  :cite ((law "26 U.S.C." "1") (law "26 U.S.C." "2") (law "26 U.S.C." "7703"))
  (withs (elected (. elections 'filing_status)
          marital (. hh 'marital_status))
    (cond
      ((is elected 'ret/FILING_STATUS_ELECTION_SINGLE)
       'fed/FILING_STATUS_SINGLE)
      ((is elected 'ret/FILING_STATUS_ELECTION_MARRIED_FILING_JOINTLY)
       'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
      ((is elected 'ret/FILING_STATUS_ELECTION_MARRIED_FILING_SEPARATELY)
       'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
      ((is elected 'ret/FILING_STATUS_ELECTION_HEAD_OF_HOUSEHOLD)
       'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD)
      ((is elected 'ret/FILING_STATUS_ELECTION_QUALIFYING_SURVIVING_SPOUSE)
       'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE)
      ((is marital 'ret/MARITAL_STATUS_MARRIED)
       (if (considered-unmarried-for-hoh? hh tax-year)
           'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD
           'fed/FILING_STATUS_MARRIED_FILING_JOINTLY))
      ((eligible-for-qss? hh tax-year)
       'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE)
      ((and (. hh 'paid_over_half_cost_of_home)
            (has-hoh-qualifying-person? hh tax-year p))
       'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD)
      (else
       'fed/FILING_STATUS_SINGLE))))

; The name as on the Social Security card: first name, middle initial, last
; name and suffix.
(def person-full-name ((person ret/Person)) String
  (join-words [(. person 'first_name) (. person 'middle_initial)
               (. person 'last_name) (. person 'suffix)]))

; A dependent's name: first name, last name and suffix.
(def dependent-full-name ((d ret/Dependent)) String
  (join-words [(. d 'first_name) (. d 'last_name) (. d 'suffix)]))

(def lookup-dependent-by-id ((hh ret/Household) (dep-id String)) ret/Dependent
  (fold (fn ((acc ret/Dependent) (d ret/Dependent)) ret/Dependent
          (if (is (. d 'id) dep-id) d acc))
        (proto 'ret/Dependent)
        (. hh 'dependents)))

(def build-party-for-person ((person ret/Person)) common/Party
  (proto 'common/Party
    :name (person-full-name person)
    :tin (. person 'tin.number)))

(def build-form1040-dependents
  ((deps (Slice ret/Dependent))
   (tax-year Int)
   (p FederalYear))
  (Slice fed/Dependent)
  (map (fn ((d ret/Dependent)) fed/Dependent
         (proto 'fed/Dependent
           :name (dependent-full-name d)
           :tin (. d 'tin.number)
           :child_tax_credit (ctc-qualifying-child? d tax-year)
           :credit_for_other_dependents (odc-qualifying-dependent? d tax-year p)))
       (keep (fn ((d ret/Dependent)) Bool (claimed-dependent? d tax-year p)) deps)))
