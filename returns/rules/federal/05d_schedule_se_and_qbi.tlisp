; Schedule SE (Self-Employment Tax, 26 U.S.C. §§ 1401, 1402, 164(f)),
; Form 7206 Self-Employed Health Insurance Deduction (26 U.S.C. § 162(l)),
; and Form 8995 / 8995-A Section 199A Qualified Business Income (QBI) Deduction.

; -- Schedule SE: Self-Employment Tax (Per Person) ----------------------------

(def k1-1065-coded-sum ((items (Slice fed/ScheduleK1Form1065.CodedAmount)) (want-code String)) Money
  (round-dollar
    (sum (fn ((c fed/ScheduleK1Form1065.CodedAmount)) Money
           (if (is (. c 'code) want-code)
               (. c 'amount)
               #usd"0.00"))
         items)))

(def k1-1120s-coded-sum ((items (Slice fed/ScheduleK1Form1120S.CodedAmount)) (want-code String)) Money
  (round-dollar
    (sum (fn ((c fed/ScheduleK1Form1120S.CodedAmount)) Money
           (if (is (. c 'code) want-code)
               (. c 'amount)
               #usd"0.00"))
         items)))

(def k1-1065-se-earnings-for-doc
  ((d ret/ScheduleK1Form1065Document)
   (pts (Slice ret/PassThrough)))
  Money
  :cite ((law "26 U.S.C." "1402" "(a)") (doc "us-irs-schedule-k-1-1065-2025" "box-14"))
  (withs (box14 (. d 'form.self_employment_earnings)
          pt (lookup-passthrough pts (. d 'pass_through))
          upe (round-dollar (. pt 'unreimbursed_partner_expenses))
          sec179 (round-dollar (. d 'form.section_179_deduction)))
    (if (not (empty? box14))
        (withs (code-a (k1-1065-coded-sum box14 "A")
                raw-se (if (!= code-a #usd"0.00")
                           code-a
                           (round-dollar
                             (sum (fn ((c fed/ScheduleK1Form1065.CodedAmount)) Money (. c 'amount))
                                  box14))))
          (- raw-se (+ upe sec179)))
        (withs (gp (if (!= (round-dollar (. d 'form.total_guaranteed_payments)) #usd"0.00")
                       (round-dollar (. d 'form.total_guaranteed_payments))
                       (round-dollar (. d 'form.guaranteed_payments_for_services))))
          (if (is (. d 'form.partner_type) 'fed/ScheduleK1Form1065.PARTNER_TYPE_GENERAL_PARTNER_OR_LLC_MEMBER_MANAGER)
              (- (+ (round-dollar (. d 'form.ordinary_business_income)) gp)
                 (+ upe sec179))
              gp)))))

(defstruct IndexedMoney
  (idx Int)
  (total Money))

(def person-schedule-c-se-profit
  ((businesses (Slice ret/Business))
   (sched-cs (Slice fed/ScheduleC))
   (person-id String))
  Money
  :cite ((law "26 U.S.C." "1402" "(a)") (doc "us-irs-schedule-se-instructions-2025"))
  (withs (res (fold (fn ((acc IndexedMoney) (b ret/Business)) IndexedMoney
                      (withs (i (. acc 'idx)
                              c (elt sched-cs i)
                              add (if (and (is (. b 'owner) person-id)
                                           (not (. c 'statutory_employee)))
                                      (. c 'net_profit_or_loss)
                                      #usd"0.00"))
                        (IndexedMoney (+ i 1) (+ (. acc 'total) add))))
                    (IndexedMoney 0 #usd"0.00")
                    businesses))
    (. res 'total)))

(def farm-cash-income-lines
  ((lines fed/ScheduleF)
   (resale-sales Money)
   (resale-cost Money)
   (resale-net Money)
   (raised Money)
   (coop Money)
   (ag Money))
  fed/ScheduleF
  (proto-with lines
    :sales_of_purchased_livestock_and_resale_items resale-sales
    :cost_of_purchased_livestock_and_resale_items resale-cost
    :net_gain_on_purchased_resale_items resale-net
    :sales_of_raised_livestock_and_produce raised
    :taxable_cooperative_distributions coop
    :taxable_agricultural_program_payments ag))

; Schedule F lines for one farm. Under the accrual method the income lines
; are in Part III, which the inputs do not break out, so only line 9 is
; filled. Crop insurance with CCC loans, custom hire with other income, and
; operating expenses are each one input spanning several lines, so those
; lines stay unset and lines 9 and 33 hold the totals.
(def compute-one-farm-net
  ((f ret/FarmBusiness)
   (ctx DepreciationContext))
  fed/ScheduleF
  :cite ((doc "us-irs-schedule-f-instructions-2025"))
  (withs (accrual (is (. f 'accounting_method) 'ret/ACCOUNTING_METHOD_ACCRUAL)
          resale-sales (round-dollar (. f 'resale_livestock_sales))
          resale-cost (round-dollar (. f 'resale_livestock_cost))
          resale-net (- resale-sales resale-cost)
          raised (round-dollar (. f 'raised_products_sales))
          coop (round-dollar (. f 'taxable_cooperative_distributions))
          ag (round-dollar (. f 'taxable_agricultural_program_payments))
          gross (+ resale-net
                   raised
                   coop
                   ag
                   (round-dollar (. f 'crop_insurance_and_ccc_proceeds))
                   (round-dollar (. f 'custom_hire_and_other_income)))
          dep-ded (compute-assets-depreciation (. f 'assets) ctx)
          expenses (+ (round-dollar (. f 'operating_expenses)) dep-ded)
          net (- gross expenses)
          lines (proto 'fed/ScheduleF
                  :principal_crop_or_activity (. f 'principal_product)
                  :accrual_accounting_method accrual
                  :gross_farm_income gross
                  :depreciation_and_section_179 dep-ded
                  :total_farm_expenses expenses
                  :net_farm_profit_or_loss net)
          with-income (if accrual
                          (proto-with lines :accrual_gross_income gross)
                          (farm-cash-income-lines lines resale-sales resale-cost resale-net raised coop ag)))
    (if (has? f 'materially_participated)
        (proto-with with-income :materially_participated (. f 'materially_participated))
        with-income)))

; One Schedule F per farm, filed by the farm's operator.
(def compute-schedule-fs
  ((hh ret/Household)
   (tax-year Int)
   (ctx DepreciationContext)
   (farms (Slice ret/FarmBusiness)))
  (Slice fed/ScheduleF)
  :cite ((doc "us-irs-schedule-f-instructions-2025"))
  (map (fn ((f ret/FarmBusiness)) fed/ScheduleF
         (withs (owner (lookup-person-by-id hh (. f 'owner)))
           (proto-with (compute-one-farm-net f ctx)
             :tax_year tax-year
             :proprietor_name (person-full-name owner)
             :proprietor_tin (. owner 'tin.number))))
       farms))

; Schedule SE line 1a takes Schedule F line 34 for every farm the person
; operates. Material participation (line E) affects only the passive loss
; rules, not self-employment income.
(def person-schedule-f-se-profit
  ((ctx DepreciationContext)
   (farms (Slice ret/FarmBusiness))
   (person-id String))
  Money
  :cite ((law "26 U.S.C." "1402" "(a)") (doc "us-irs-schedule-se-2025" "line-1a"))
  (sum (fn ((f ret/FarmBusiness)) Money
         (if (is (. f 'owner) person-id)
             (. (compute-one-farm-net f ctx) 'net_farm_profit_or_loss)
             #usd"0.00"))
       farms))

; A farm is passive when the owner says they did not materially participate
; (Schedule F line E "No"); an unanswered line E counts as participation.
(def farm-passive? ((f ret/FarmBusiness)) Bool
  :cite ((law "26 U.S.C." "469" "(c)(1)"))
  (all-of (has? f 'materially_participated)
       (not (. f 'materially_participated))))

(defstruct FarmNet
  (passive Bool)
  (net Money))

(defstruct FarmPassiveTotals
  (nonpassive_net Money)
  (passive_income Money)
  (passive_loss Money))

; Splits Schedule F between nonpassive farms and passive farms for Form
; 8582. A passive farm's prior-year unallowed loss is added to its current
; result.
(def compute-farm-passive-totals
  ((ctx DepreciationContext)
   (farms (Slice ret/FarmBusiness))
   (prior ret/PriorYear))
  FarmPassiveTotals
  :cite ((law "26 U.S.C." "469") (doc "us-irs-8582-instructions-2025" "part-v"))
  (withs (nets (map (fn ((f ret/FarmBusiness)) FarmNet
                      (withs (net (. (compute-one-farm-net f ctx) 'net_farm_profit_or_loss)
                              passive (farm-passive? f))
                        (FarmNet passive
                                 (if passive
                                     (- net (activity-prior-passive-carryover prior (. f 'id)))
                                     net))))
                    farms))
    (FarmPassiveTotals
      (sum (fn ((x FarmNet)) Money (if (. x 'passive) #usd"0.00" (. x 'net))) nets)
      (sum (fn ((x FarmNet)) Money
             (if (and (. x 'passive) (> (. x 'net) #usd"0.00")) (. x 'net) #usd"0.00"))
           nets)
      (sum (fn ((x FarmNet)) Money
             (if (and (. x 'passive) (< (. x 'net) #usd"0.00")) (abs-money (. x 'net)) #usd"0.00"))
           nets))))

(def compute-person-se-business-profit
  ((hh ret/Household)
   (docs ret/Documents)
   (businesses (Slice ret/Business))
   (sched-cs (Slice fed/ScheduleC))
   (pts (Slice ret/PassThrough))
   (person-id String))
  Money
  :cite ((law "26 U.S.C." "1402" "(a)") (doc "us-irs-schedule-se-2025" "line-2"))
  (withs (sched-c-se (person-schedule-c-se-profit businesses sched-cs person-id)
          ; Sum Partnership K-1 SE earnings for this person
          k1-se (sum (fn ((d ret/ScheduleK1Form1065Document)) Money
                       (if (is (. d 'person) person-id)
                           (k1-1065-se-earnings-for-doc d pts)
                           #usd"0.00"))
                     (. docs 'partnership_k1s)))
    (+ sched-c-se k1-se)))

(def compute-person-schedule-se
  ((tax-year Int)
   (hh ret/Household)
   (docs ret/Documents)
   (businesses (Slice ret/Business))
   (sched-cs (Slice fed/ScheduleC))
   (dep-ctx DepreciationContext)
   (farms (Slice ret/FarmBusiness))
   (pts (Slice ret/PassThrough))
   (person-id String)
   (p FederalYear))
  (Slice fed/ScheduleSE)
  :cite ((law "26 U.S.C." "1401") (law "26 U.S.C." "1402") (law "26 U.S.C." "164" "(f)") (doc "us-irs-schedule-se-instructions-2025"))
  (if (is person-id "")
      ((inst empty-slice fed/ScheduleSE))
      (withs (person (lookup-person-by-id hh person-id)
              net-farm (person-schedule-f-se-profit dep-ctx farms person-id)
              net-biz (compute-person-se-business-profit hh docs businesses sched-cs pts person-id)
              combined (+ net-farm net-biz)
              after-red (if (> combined #usd"0.00")
                            (round-dollar (* combined 0.9235))
                            #usd"0.00"))
        (if (< after-red #usd"400.00")
            ((inst empty-slice fed/ScheduleSE))
            (withs (total-net after-red
                    wage-base (. p 'oasdi_wage_base)
                    w2-ss (w2-ss-wages-for-person docs person-id)
                    rem-base (clamp-zero (- wage-base w2-ss))
                    ss-taxable (min total-net rem-base)
                    ss-tax (round-dollar (* ss-taxable 0.124))
                    med-tax (round-dollar (* total-net 0.029))
                    se-tax (+ ss-tax med-tax)
                    half-ded (round-dollar (* se-tax 0.50)))
              [(proto 'fed/ScheduleSE
                 :tax_year tax-year
                 :filer_name (person-full-name person)
                 :filer_tin (. person 'tin.number)
                 :net_farm_profit_or_loss net-farm
                 :net_business_profit_or_loss net-biz
                 :combined_profit_or_loss combined
                 :net_earnings_after_reduction after-red
                 :church_employee_income #usd"0.00"
                 :total_net_earnings total-net
                 :social_security_wage_base wage-base
                 :social_security_wages_and_tips w2-ss
                 :wage_base_remaining rem-base
                 :social_security_tax ss-tax
                 :medicare_tax med-tax
                 :self_employment_tax se-tax
                 :one_half_deduction half-ded
                 :used_optional_method false)])))))

(def compute-all-schedule-se
  ((tax-year Int)
   (hh ret/Household)
   (docs ret/Documents)
   (businesses (Slice ret/Business))
   (sched-cs (Slice fed/ScheduleC))
   (dep-ctx DepreciationContext)
   (farms (Slice ret/FarmBusiness))
   (pts (Slice ret/PassThrough))
   (status fed/FilingStatus)
   (p FederalYear))
  (Slice fed/ScheduleSE)
  (withs (tp-se (compute-person-schedule-se tax-year hh docs businesses sched-cs dep-ctx farms pts (. hh 'taxpayer.id) p)
          sp-se (if (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
                    (compute-person-schedule-se tax-year hh docs businesses sched-cs dep-ctx farms pts (. hh 'spouse.id) p)
                    ((inst empty-slice fed/ScheduleSE))))
    (append tp-se sp-se)))

(def total-schedule-se-tax ((ses (Slice fed/ScheduleSE))) Money
  (sum (fn ((s fed/ScheduleSE)) Money (. s 'self_employment_tax)) ses))

(def total-schedule-se-half-deduction ((ses (Slice fed/ScheduleSE))) Money
  (sum (fn ((s fed/ScheduleSE)) Money (. s 'one_half_deduction)) ses))

(def total-schedule-se-net-earnings ((ses (Slice fed/ScheduleSE))) Money
  (sum (fn ((s fed/ScheduleSE)) Money (. s 'total_net_earnings)) ses))

(def person-se-half-deduction ((ses (Slice fed/ScheduleSE)) (person ret/Person)) Money
  (sum (fn ((s fed/ScheduleSE)) Money
         (if (is (. s 'filer_name) (person-full-name person))
             (. s 'one_half_deduction)
             #usd"0.00"))
       ses))

; -- Form 7206: Self-Employed Health Insurance Deduction ----------------------

(def ltc-premium-cap ((tax-year Int) (age Int)) Money
  :cite ((law "26 U.S.C." "213" "(d)(10)") (doc "us-irs-rev-proc-2024-40") (doc "us-irs-rev-proc-2025-32"))
  (if (is tax-year 2026)
      (cond
        ((<= age 40) #usd"500.00")
        ((<= age 50) #usd"930.00")
        ((<= age 60) #usd"1860.00")
        ((<= age 70) #usd"4960.00")
        (else        #usd"6200.00"))
      (cond
        ((<= age 40) #usd"480.00")
        ((<= age 50) #usd"900.00")
        ((<= age 60) #usd"1800.00")
        ((<= age 70) #usd"4810.00")
        (else        #usd"6020.00"))))

(def person-sep-simple-contributions ((retire ret/Retirement) (person-id String)) Money
  (round-dollar
    (sum (fn ((pr ret/PersonRetirement)) Money
           (if (is (. pr 'person) person-id)
               (. pr 'self_employed_plan_contributions)
               #usd"0.00"))
         (. retire 'persons))))

(def compute-one-se-health-insurance-deduction
  ((tax-year Int)
   (hh ret/Household)
   (docs ret/Documents)
   (businesses (Slice ret/Business))
   (sched-cs (Slice fed/ScheduleC))
   (dep-ctx DepreciationContext)
   (farms (Slice ret/FarmBusiness))
   (pts (Slice ret/PassThrough))
   (ses (Slice fed/ScheduleSE))
   (retire ret/Retirement)
   (pol ret/SelfEmployedHealthInsurance))
  Money
  :cite ((law "26 U.S.C." "162" "(l)") (doc "us-irs-7206-instructions-2025"))
  (withs (pid (. pol 'person)
          person (lookup-person-by-id hh pid)
          age (person-age-end-of-year (. person 'date_of_birth) tax-year)
          med-prem (round-dollar (. pol 'health_and_dental_premiums))
          ltc-raw (round-dollar (. pol 'long_term_care_premiums))
          ltc-capped (min ltc-raw (ltc-premium-cap tax-year age))
          total-prem (+ med-prem ltc-capped)
          ; Net earned income from the business(es) minus 50% SE tax and SEP/SIMPLE
          gross-se-profit (+ (compute-person-se-business-profit hh docs businesses sched-cs pts pid)
                             (person-schedule-f-se-profit dep-ctx farms pid))
          half-se (person-se-half-deduction ses person)
          sep-ded (person-sep-simple-contributions retire pid)
          net-profit-limit (clamp-zero (- gross-se-profit (+ half-se sep-ded))))
    (min total-prem net-profit-limit)))

(def compute-se-health-insurance-deduction
  ((tax-year Int)
   (hh ret/Household)
   (docs ret/Documents)
   (businesses (Slice ret/Business))
   (sched-cs (Slice fed/ScheduleC))
   (dep-ctx DepreciationContext)
   (farms (Slice ret/FarmBusiness))
   (pts (Slice ret/PassThrough))
   (ses (Slice fed/ScheduleSE))
   (retire ret/Retirement)
   (health ret/Health))
  Money
  :cite ((law "26 U.S.C." "162" "(l)") (doc "us-irs-schedule-1-2025" "line-17"))
  (round-dollar
    (sum (fn ((pol ret/SelfEmployedHealthInsurance)) Money
           (compute-one-se-health-insurance-deduction tax-year hh docs businesses sched-cs dep-ctx farms pts ses retire pol))
         (. health 'self_employed_health_insurance))))

; -- Form 8995 / Form 8995-A: Section 199A QBI Deduction ----------------------

(defstruct QBIActivity
  (qbi Money)
  (w2_wages Money)
  (ubia Money)
  (sstb Bool))

(def qbi-threshold ((tax-year Int) (status fed/FilingStatus)) Money
  :cite ((law "26 U.S.C." "199A" "(e)(2)") (doc "us-irs-rev-proc-2024-40") (doc "us-irs-rev-proc-2025-32"))
  (if (is tax-year 2026)
      (if (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
          #usd"406000.00"
          #usd"203000.00")
      (if (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
          #usd"394600.00"
          #usd"197300.00")))

(def qbi-phasein-range ((tax-year Int) (status fed/FilingStatus)) Money
  :cite ((law "26 U.S.C." "199A" "(b)(3)(B)") (law "P.L. 119-21" "70105"))
  (if (is tax-year 2026)
      (if (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
          #usd"150000.00"
          #usd"75000.00")
      (if (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
          #usd"100000.00"
          #usd"50000.00")))

(def collect-qbi-activities
  ((hh ret/Household)
   (docs ret/Documents)
   (businesses (Slice ret/Business))
   (sched-cs (Slice fed/ScheduleC))
   (rentals (Slice ret/RentalProperty))
   (sched-e fed/ScheduleE)
   (pts (Slice ret/PassThrough))
   (se-above-line-adjustments Money))
  (Slice QBIActivity)
  :cite ((law "26 U.S.C." "199A" "(c)") (law "26 C.F.R." "1.199A-3" "(b)(1)(vi)"))
  (withs (; Total positive Schedule C + K-1 SE profit for prorating above-the-line SE deductions
          pos-sched-c (sum (fn ((c fed/ScheduleC)) Money
                             (if (and (not (. c 'statutory_employee))
                                      (> (. c 'net_profit_or_loss) #usd"0.00"))
                                 (. c 'net_profit_or_loss)
                                 #usd"0.00"))
                           sched-cs)
          ; 1. Schedule C businesses (excluding statutory employees)
          biz-acts (fold (fn ((acc (Slice QBIActivity)) (b ret/Business)) (Slice QBIActivity)
                           (withs (idx (len acc)
                                   c (elt sched-cs idx)
                                   net (. c 'net_profit_or_loss))
                             (if (. c 'statutory_employee)
                                 acc
                                 (withs (adj-share (if (and (> net #usd"0.00") (> pos-sched-c #usd"0.00"))
                                                       (round-dollar (* se-above-line-adjustments (/ net pos-sched-c)))
                                                       (if (and (> se-above-line-adjustments #usd"0.00")
                                                                (is (len businesses) 1))
                                                           se-above-line-adjustments
                                                           #usd"0.00"))
                                         adj-qbi (- net adj-share)
                                         w2 (if (> (round-dollar (. b 'w2_wages_paid)) #usd"0.00")
                                                (round-dollar (. b 'w2_wages_paid))
                                                (. c 'wages))
                                         ubia (round-dollar (. b 'ubia_qualified_property)))
                                   (append acc [(QBIActivity adj-qbi w2 ubia (. b 'specified_service_business))])))))
                         ((inst empty-slice QBIActivity))
                         businesses)
          ; 2. Qualifying QBI rental properties
          e-props (. sched-e 'properties)
          rent-acts (fold (fn ((acc (Slice QBIActivity)) (r ret/RentalProperty)) (Slice QBIActivity)
                            (withs (idx (- (len acc) (len biz-acts)))
                              acc))
                          biz-acts
                          rentals)
          rent-only (fold (fn ((acc (Slice QBIActivity)) (r ret/RentalProperty)) (Slice QBIActivity)
                            (if (not (. r 'qualifies_for_qbi))
                                acc
                                (withs (matched (keep (fn ((ep fed/ScheduleE.RentalOrRoyaltyProperty)) Bool
                                                        (is (. ep 'physical_address) (. r 'description)))
                                                      e-props)
                                        ep (if (empty? matched)
                                               (proto 'fed/ScheduleE.RentalOrRoyaltyProperty)
                                               (elt matched 0))
                                        net (if (>= (. ep 'net_income_or_loss) #usd"0.00")
                                                (. ep 'net_income_or_loss)
                                                (. ep 'deductible_loss_after_limitation)))
                                  (append acc [(QBIActivity net #usd"0.00" (round-dollar (. r 'ubia_qualified_property)) false)]))))
                          ((inst empty-slice QBIActivity))
                          rentals)
          ; 3. Partnership K-1s (non-PTP)
          k1-1065-acts (fold (fn ((acc (Slice QBIActivity)) (d ret/ScheduleK1Form1065Document)) (Slice QBIActivity)
                               (if (. d 'form.publicly_traded_partnership)
                                   acc
                                   (withs (pt (lookup-passthrough pts (. d 'pass_through))
                                           box20 (. d 'form.other_information)
                                           coded-z (k1-1065-coded-sum box20 "Z")
                                           coded-w (k1-1065-coded-sum box20 "W")
                                           coded-x (k1-1065-coded-sum box20 "X")
                                           raw-qbi (if (!= coded-z #usd"0.00")
                                                       coded-z
                                                       (- (+ (round-dollar (. d 'form.ordinary_business_income))
                                                             (round-dollar (. d 'form.net_rental_real_estate_income)))
                                                          (+ (round-dollar (. d 'form.section_179_deduction))
                                                             (round-dollar (. pt 'unreimbursed_partner_expenses))))))
                                     (append acc [(QBIActivity raw-qbi coded-w coded-x (. pt 'specified_service_business))]))))
                             ((inst empty-slice QBIActivity))
                             (. docs 'partnership_k1s))
          ; 4. S-Corporation K-1s
          k1-1120s-acts (fold (fn ((acc (Slice QBIActivity)) (d ret/ScheduleK1Form1120SDocument)) (Slice QBIActivity)
                                (withs (pt (lookup-passthrough pts (. d 'pass_through))
                                        box17 (. d 'form.other_information)
                                        coded-v (k1-1120s-coded-sum box17 "V")
                                        coded-w (k1-1120s-coded-sum box17 "W")
                                        coded-x (k1-1120s-coded-sum box17 "X")
                                        raw-qbi (if (!= coded-v #usd"0.00")
                                                    coded-v
                                                    (- (+ (round-dollar (. d 'form.ordinary_business_income))
                                                          (round-dollar (. d 'form.net_rental_real_estate_income)))
                                                       (round-dollar (. d 'form.section_179_deduction)))))
                                  (append acc [(QBIActivity raw-qbi coded-w coded-x (. pt 'specified_service_business))])))
                              ((inst empty-slice QBIActivity))
                              (. docs 's_corporation_k1s)))
    (append (append (append biz-acts rent-only) k1-1065-acts) k1-1120s-acts)))

(def compute-one-activity-qbi-component
  ((act QBIActivity)
   (taxable-income-before-qbi Money)
   (thresh Money)
   (phase-range Money))
  Money
  :cite ((law "26 U.S.C." "199A" "(b)(2)") (law "26 U.S.C." "199A" "(d)(3)") (doc "us-irs-8995-a-instructions-2025"))
  (withs (raw-qbi (. act 'qbi))
    (if (<= raw-qbi #usd"0.00")
        ; Negative QBI nets against positive QBI across activities
        (round-dollar (* raw-qbi 0.20))
        (if (<= taxable-income-before-qbi thresh)
            ; At or below threshold: full 20% of QBI, no SSTB or W-2/UBIA limit
            (round-dollar (* raw-qbi 0.20))
            (withs (excess (- taxable-income-before-qbi thresh)
                    above-phase (>= excess phase-range)
                    phase-pct (min 1.0 (/ excess phase-range))
                    app-pct (- 1.0 phase-pct))
              (if (and (. act 'sstb) above-phase)
                  #usd"0.00"
                  (withs (eff-qbi (if (. act 'sstb) (round-dollar (* raw-qbi app-pct)) raw-qbi)
                          eff-w2  (if (. act 'sstb) (round-dollar (* (. act 'w2_wages) app-pct)) (. act 'w2_wages))
                          eff-ubia (if (. act 'sstb) (round-dollar (* (. act 'ubia) app-pct)) (. act 'ubia))
                          tentative-20 (round-dollar (* eff-qbi 0.20))
                          wage-ubia-cap (max (round-dollar (* eff-w2 0.50))
                                             (+ (round-dollar (* eff-w2 0.25))
                                                (round-dollar (* eff-ubia 0.025)))))
                    (if above-phase
                        (min tentative-20 wage-ubia-cap)
                        (withs (excess-over-cap (clamp-zero (- tentative-20 wage-ubia-cap))
                                reduction (round-dollar (* excess-over-cap phase-pct)))
                          (clamp-zero (- tentative-20 reduction)))))))))))

(def total-reit-and-ptp-income ((docs ret/Documents)) Money
  :cite ((law "26 U.S.C." "199A" "(b)(1)(B)") (doc "us-irs-form-1099-div-2025" "box-5") (doc "us-irs-form-8995-2025" "line-6"))
  (withs (reit-divs (round-dollar
                      (sum (fn ((d ret/Form1099DIVDocument)) Money
                             (. d 'form.section_199a_dividends))
                           (. docs 'dividends)))
          ptp-inc (round-dollar
                    (sum (fn ((d ret/ScheduleK1Form1065Document)) Money
                           (if (. d 'form.publicly_traded_partnership)
                               (. d 'form.ordinary_business_income)
                               #usd"0.00"))
                         (. docs 'partnership_k1s))))
    (clamp-zero (+ reit-divs ptp-inc))))

(def compute-qbi-deduction
  ((tax-year Int)
   (hh ret/Household)
   (docs ret/Documents)
   (businesses (Slice ret/Business))
   (sched-cs (Slice fed/ScheduleC))
   (rentals (Slice ret/RentalProperty))
   (sched-e fed/ScheduleE)
   (pts (Slice ret/PassThrough))
   (prior ret/PriorYear)
   (status fed/FilingStatus)
   (se-above-line-adjustments Money)
   (taxable-income-before-qbi Money)
   (net-capital-gain Money))
  Money
  :cite ((law "26 U.S.C." "199A") (doc "us-irs-8995-instructions-2025") (doc "us-irs-8995-a-instructions-2025"))
  (if (<= taxable-income-before-qbi #usd"0.00")
      #usd"0.00"
      (withs (acts (collect-qbi-activities hh docs businesses sched-cs rentals sched-e pts se-above-line-adjustments)
              thresh (qbi-threshold tax-year status)
              phase-range (qbi-phasein-range tax-year status)
              total-net-qbi (- (sum (fn ((a QBIActivity)) Money (. a 'qbi)) acts)
                               (round-dollar (. prior 'qbi_loss_carryover)))
              qbi-component (if (<= total-net-qbi #usd"0.00")
                                #usd"0.00"
                                (if (<= taxable-income-before-qbi thresh)
                                    (round-dollar (* total-net-qbi 0.20))
                                    (clamp-zero
                                      (- (sum (fn ((a QBIActivity)) Money
                                                (compute-one-activity-qbi-component a taxable-income-before-qbi thresh phase-range))
                                              acts)
                                         (round-dollar (* (round-dollar (. prior 'qbi_loss_carryover)) 0.20))))))
              reit-ptp-comp (round-dollar (* (total-reit-and-ptp-income docs) 0.20))
              combined-qbi (+ qbi-component reit-ptp-comp)
              overall-cap (round-dollar (* (clamp-zero (- taxable-income-before-qbi net-capital-gain))
                                           0.20)))
        (min combined-qbi overall-cap))))
