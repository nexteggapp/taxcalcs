; Form 1099-R IRA and pension/annuity distributions, Qualified Charitable
; Distributions (QCDs), the Simplified Method Worksheet (26 U.S.C. § 72(d)),
; Form 5329 early-distribution 10% tax (26 U.S.C. § 72(t)), and the Form 1040
; Social Security Benefits Worksheet (26 U.S.C. § 86).

(def total-ira-distributions-gross ((docs ret/Documents)) Money
  :cite ((law "26 U.S.C." "408" "(d)") (doc "us-irs-1040-instructions-2025" "lines-4a-and-4b"))
  (round-dollar
    (sum (fn ((d ret/Form1099RDocument)) Money
           (if (. d 'form.ira_sep_simple)
               (. d 'form.gross_distribution)
               #usd"0.00"))
         (. docs 'retirement_distributions))))

(def ira-doc-taxable-amount ((d ret/Form1099RDocument)) Money
  :cite ((law "26 U.S.C." "408" "(d)(8)") (doc "us-irs-1040-instructions-2025" "lines-4a-and-4b"))
  (if (not (. d 'form.ira_sep_simple))
      #usd"0.00"
      (withs (base (if (. d 'form.taxable_amount_not_determined)
                       (. d 'form.gross_distribution)
                       (. d 'form.taxable_amount)))
        (round-dollar
          (clamp-zero
            (- base
               (+ (. d 'rolled_over)
                  (. d 'qualified_charitable_distribution))))))))

(def total-ira-distributions-taxable ((docs ret/Documents)) Money
  :cite ((law "26 U.S.C." "408" "(d)") (doc "us-irs-1040-instructions-2025" "lines-4a-and-4b"))
  (round-dollar
    (sum ira-doc-taxable-amount (. docs 'retirement_distributions))))

; -- Simplified Method Worksheet (26 U.S.C. § 72(d)) --------------------------

(def simplified-method-expected-payments ((sm ret/SimplifiedMethod)) Int
  :cite ((law "26 U.S.C." "72" "(d)(1)(B)(iii)-(iv)"))
  (withs (age (. sm 'age_at_start)
          ben-age (. sm 'beneficiary_age_at_start))
    (if (> ben-age 0)
        (withs (combined (+ age ben-age))
          (cond
            ((<= combined 110) 410)
            ((<= combined 120) 360)
            ((<= combined 130) 310)
            ((<= combined 140) 260)
            (else 210)))
        (cond
          ((<= age 55) 360)
          ((<= age 60) 310)
          ((<= age 65) 260)
          ((<= age 70) 210)
          (else 160)))))

(def uses-simplified-method? ((d ret/Form1099RDocument)) Bool
  (all-of (not (. d 'form.ira_sep_simple))
       (> (. d 'simplified_method.cost_in_contract) #usd"0.00")))

(def compute-one-simplified-method
  ((d ret/Form1099RDocument)
   (tax-year Int))
  ret/SimplifiedMethodWorksheet
  :cite ((law "26 U.S.C." "72" "(d)") (doc "us-irs-1040-instructions-2025" "simplified-method-worksheet"))
  (withs (sm (. d 'simplified_method)
          gross (round-dollar (. d 'form.gross_distribution))
          cost (round-dollar (. sm 'cost_in_contract))
          expected-months (simplified-method-expected-payments sm)
          per-month (round-cents (/ cost (int-to-float expected-months)))
          start-yr (date-year (. sm 'annuity_start))
          start-mo (date-month (. sm 'annuity_start))
          months-this-year (if (and (is start-yr tax-year) (> start-mo 0))
                               (- 13 start-mo)
                               12)
          prior-recovered (round-dollar (. sm 'recovered_in_earlier_years))
          remaining-cost (clamp-zero (- cost prior-recovered))
          raw-tax-free (round-cents (* per-month (int-to-float months-this-year)))
          tax-free-this-year (round-dollar (min remaining-cost raw-tax-free))
          pso-excl (min (round-dollar (. d 'public_safety_officer_premiums)) #usd"3000.00")
          rollover (round-dollar (. d 'rolled_over))
          taxable (clamp-zero (- gross (+ tax-free-this-year rollover pso-excl)))
          remaining-next-year (clamp-zero (- remaining-cost tax-free-this-year)))
    (proto 'ret/SimplifiedMethodWorksheet
      :document_id (. d 'id)
      :gross_distribution gross
      :total_cost_in_plan cost
      :expected_monthly_payments expected-months
      :tax_free_per_month per-month
      :current_year_tax_free_portion tax-free-this-year
      :taxable_portion taxable
      :remaining_basis_for_next_year remaining-next-year)))

(def compute-simplified-method-worksheets
  ((docs ret/Documents)
   (tax-year Int))
  (Slice ret/SimplifiedMethodWorksheet)
  (map (fn ((d ret/Form1099RDocument)) ret/SimplifiedMethodWorksheet
         (compute-one-simplified-method d tax-year))
       (keep uses-simplified-method? (. docs 'retirement_distributions))))

(def total-pensions-and-annuities-gross ((docs ret/Documents)) Money
  :cite ((law "26 U.S.C." "72" "(a)") (doc "us-irs-1040-instructions-2025" "lines-5a-and-5b"))
  (round-dollar
    (sum (fn ((d ret/Form1099RDocument)) Money
           (if (. d 'form.ira_sep_simple)
               #usd"0.00"
               (. d 'form.gross_distribution)))
         (. docs 'retirement_distributions))))

(def pension-doc-taxable-amount ((d ret/Form1099RDocument) (tax-year Int)) Money
  (if (. d 'form.ira_sep_simple)
      #usd"0.00"
      (if (uses-simplified-method? d)
          (. (compute-one-simplified-method d tax-year) 'taxable_portion)
          (withs (base (if (. d 'form.taxable_amount_not_determined)
                           (clamp-zero (- (. d 'form.gross_distribution)
                                          (. d 'form.employee_contributions)))
                           (. d 'form.taxable_amount))
                  pso-excl (min (. d 'public_safety_officer_premiums) #usd"3000.00"))
            (round-dollar
              (clamp-zero (- base (+ (. d 'rolled_over) pso-excl))))))))

(def total-pensions-and-annuities-taxable ((docs ret/Documents) (tax-year Int)) Money
  :cite ((law "26 U.S.C." "72") (doc "us-irs-1040-instructions-2025" "lines-5a-and-5b"))
  (round-dollar
    (sum (fn ((d ret/Form1099RDocument)) Money
           (pension-doc-taxable-amount d tax-year))
         (. docs 'retirement_distributions))))

; Form 5329 line 1: the taxable amount of a distribution coded 1 (early,
; no known exception).
(def early-distribution-includible ((d ret/Form1099RDocument) (tax-year Int)) Money
  :cite ((law "26 U.S.C." "72" "(t)") (doc "us-irs-form-5329-2025" "line-1"))
  (if (some (fn ((c String)) Bool (is c "1")) (. d 'form.distribution_codes))
      (round-dollar (if (. d 'form.ira_sep_simple)
                        (ira-doc-taxable-amount d)
                        (pension-doc-taxable-amount d tax-year)))
      #usd"0.00"))

; Form 5329 line 2: the part of line 1 an exception covers.
(def early-distribution-exempt ((d ret/Form1099RDocument) (tax-year Int)) Money
  :cite ((law "26 U.S.C." "72" "(t)(2)") (doc "us-irs-form-5329-2025" "line-2"))
  (withs (taxable (early-distribution-includible d tax-year))
    (if (is (. d 'early_distribution_exception) 'ret/EARLY_DISTRIBUTION_EXCEPTION_UNSPECIFIED)
        #usd"0.00"
        (if (> (. d 'early_distribution_exception_amount) #usd"0.00")
            (min taxable (round-dollar (. d 'early_distribution_exception_amount)))
            taxable))))

; -- Social Security Benefits Worksheet (26 U.S.C. § 86) ----------------------

(= ss-tier1-base (Table fed/FilingStatus Money)
  (table
    'fed/FILING_STATUS_MARRIED_FILING_JOINTLY      #usd"32000.00"
    'fed/FILING_STATUS_SINGLE                      #usd"25000.00"
    'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD           #usd"25000.00"
    'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE #usd"25000.00"
    'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY   #usd"0.00"))

(= ss-tier2-spread (Table fed/FilingStatus Money)
  (table
    'fed/FILING_STATUS_MARRIED_FILING_JOINTLY      #usd"12000.00"
    'fed/FILING_STATUS_SINGLE                      #usd"9000.00"
    'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD           #usd"9000.00"
    'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE #usd"9000.00"
    'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY   #usd"0.00"))

(def sum-ssa-net-benefits ((docs (Slice ret/FormSSA1099Document))) Money
  (sum (fn ((d ret/FormSSA1099Document)) Money
         (. d 'form.net_benefits))
       docs))

; The Social Security Benefits Worksheet, for lines 6a and 6b: up to half of
; the benefits are taxable once half the benefits plus other income pass the
; base amount for the filing status, and up to 85% above a second amount. A
; separate filer who lived with their spouse at any time in the year has no
; base amount.
(defworksheet compute-ss-benefits-worksheet
  ((status fed/FilingStatus)
   (lived-apart-all-year Bool)
   (ssa-docs (Slice ret/FormSSA1099Document))
   (other-income Money)
   (tax-exempt-interest Money)
   (adjustments-excluding-student-loan Money))
  ret/SSBenefitsWorksheet
  :cite ((law "26 U.S.C." "86"))
  (line 1 "Net benefits, from box 5 of the Forms SSA-1099"
        (round-dollar (clamp-zero (sum-ssa-net-benefits ssa-docs))))
  (line 2 "Line 1 times 50%" (round-dollar (* line1 0.50)))
  (line 3 "Other income: Form 1040, lines 1z, 2b, 3b, 4b, 5b, 7a and 8" other-income)
  (line 4 "Tax-exempt interest, from line 2a" tax-exempt-interest)
  (line 5 "Lines 2, 3 and 4 added" (+ line2 line3 line4))
  (line 6 "Adjustments from Schedule 1, other than student loan interest"
        adjustments-excluding-student-loan)
  (line 7 "Line 5 less line 6" (- line5 line6))
  (bind mfs-zero (all-of (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
                         (not lived-apart-all-year)))
  (line 8 "The base amount: $32,000 if married filing jointly, $25,000 for most others"
        (if mfs-zero
            #usd"0.00"
            (lookup-or ss-tier1-base status #usd"25000.00")))
  (line 9 "Line 7 less line 8, not below zero" (clamp-zero (- line7 line8)))
  (line 10 "The second amount: $12,000 if married filing jointly, $9,000 for most others"
        (if mfs-zero
            #usd"0.00"
            (lookup-or ss-tier2-spread status #usd"9000.00")))
  (line 11 "Line 9 less line 10, not below zero" (clamp-zero (- line9 line10)))
  (line 12 "The smaller of line 9 and line 10" (min line9 line10))
  (line 13 "Half of line 12" (round-dollar (* line12 0.50)))
  (line 14 "The smaller of line 2 and line 13" (min line2 line13))
  (line 15 "Line 11 times 85%" (round-dollar (* line11 0.85)))
  (line 16 "Line 14 plus line 15" (+ line14 line15))
  (line 17 "Line 1 times 85%" (round-dollar (* line1 0.85)))
  (line 18 "Taxable benefits: the smaller of line 16 and line 17, or none if line 9 is zero"
        (if (<= line9 #usd"0.00")
            #usd"0.00"
            (min line16 line17)))
  (result
    (proto 'ret/SSBenefitsWorksheet
      :line_1_total_benefits                  line1
      :line_2_half_of_benefits                line2
      :line_3_other_income                    line3
      :line_4_tax_exempt_interest             line4
      :line_5_gross_provisional_income        line5
      :line_6_adjustments                     line6
      :line_7_provisional_income              line7
      :line_8_base_amount                     line8
      :line_9_excess_over_base                line9
      :line_10_tier_1_width                   line10
      :line_11_excess_over_adjusted_base      line11
      :line_12_tier_1_amount                  line12
      :line_13_half_of_tier_1                 line13
      :line_14_taxable_from_tier_1            line14
      :line_15_eighty_five_percent_of_tier_2  line15
      :line_16_combined_tiers                 line16
      :line_17_eighty_five_percent_of_benefits line17
      :line_18_taxable_benefits               line18)))
