    name = "federal",
    srcs = ["federal.go"],
    embedsrcs = glob(["*.tlisp"]),
    importpath = "github.com/nexteggapp/taxcalcs/returns/rules/federal",
    visibility = ["//visibility:public"],
    deps = [
        "//returns/v1",
        "//taxlisp/eval",
