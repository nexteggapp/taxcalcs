    'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD
    [(BracketRow #usd"0.00"       #usd"15700.00"       0.10 #usd"0.00")
     (BracketRow #usd"15700.00"   #usd"59850.00"       0.12 #usd"1570.00")
     (BracketRow #usd"59850.00"   #usd"95350.00"       0.22 #usd"6868.00")
