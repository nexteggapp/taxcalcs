; Statutory parameters, brackets, and phaseout thresholds for Tax Years 2025
; and 2026 (Rev. Proc. 2024-40, Rev. Proc. 2025-32, and P.L. 119-21 OBBBA).

(use-proto 'nexteggapp.taxcalcs.returns.v1 'ret)
(use-proto 'nexteggapp.taxprotos.us.federal.v1 'fed)
(use-proto 'nexteggapp.taxprotos.facts.v1 'facts)
(use-proto 'nexteggapp.taxprotos.common.v1 'common)

(defstruct YearParams
  (tax_year Int)
  (rules_version String)
  (rules_status ret/RulesStatus)
  (std_ded_single Money)
  (std_ded_mfj Money)
  (std_ded_hoh Money)
  (addl_std_ded_unmarried Money)
  (addl_std_ded_married Money)
  (dep_std_ded_min Money)
  (dep_std_ded_earned_add Money)
  (qr_gross_income_limit Money)
  (educator_expense_cap Money)
  (hsa_limit_self Money)
  (hsa_limit_family Money)
  (hsa_catchup_55 Money)
  (ira_limit_under_50 Money)
  (ira_catchup_50 Money)
  (ira_phaseout_single_start Money)
  (ira_phaseout_single_width Money)
  (ira_phaseout_mfj_covered_start Money)
  (ira_phaseout_mfj_covered_width Money)
  (ira_phaseout_mfj_spouse_covered_start Money)
  (ira_phaseout_mfj_spouse_covered_width Money)
  (student_loan_cap Money)
  (student_loan_single_start Money)
  (student_loan_single_width Money)
  (student_loan_mfj_start Money)
  (student_loan_mfj_width Money)
  (salt_cap_default Money)
  (salt_cap_mfs Money)
  (salt_phaseout_start_default Money)
  (salt_phaseout_start_mfs Money)
  (salt_floor_default Money)
  (salt_floor_mfs Money)
  (ctc_per_child Money)
  (odc_per_dependent Money)
  (actc_max_per_child Money)
  (oasdi_wage_base Money)
  (oasdi_max_tax Money))

(defstruct BracketRow
  (floor Money)
  (ceiling Money)
  (rate Quantity)
  (base_tax Money))

