(def cap-gains-zero-threshold ((tax-year Int) (status fed/FilingStatus)) Money
  :cite ("26 U.S.C. § 1(h)(1)(B)" "Rev. Proc. 2024-40" "Rev. Proc. 2025-32")
  (if (is tax-year 2026)
      (cond
        ((or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
             (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
         #usd"98900.00")
        ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD)
         #usd"66200.00")
        (else #usd"49450.00"))
      (cond
        ((or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
             (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
         #usd"96700.00")
        ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD)
         #usd"64750.00")
        (else #usd"48350.00"))))

(def cap-gains-fifteen-threshold ((tax-year Int) (status fed/FilingStatus)) Money
  :cite ("26 U.S.C. § 1(h)(1)(C)" "Rev. Proc. 2024-40" "Rev. Proc. 2025-32")
  (if (is tax-year 2026)
      (cond
        ((or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
             (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
         #usd"613700.00")
        ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD)
         #usd"579600.00")
        ((is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
         #usd"306850.00")
        (else #usd"545500.00"))
      (cond
        ((or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
             (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
         #usd"600050.00")
        ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD)
         #usd"566700.00")
        ((is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
         #usd"300000.00")
        (else #usd"533400.00"))))

(def base-standard-deduction ((p YearParams) (status fed/FilingStatus)) Money
  :cite ("26 U.S.C. § 63(c)(2)")
  (cond
    ((or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
         (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
     (. p 'std_ded_mfj))
    ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD)
     (. p 'std_ded_hoh))
    (else (. p 'std_ded_single))))

(def additional-standard-deduction-per-box ((p YearParams) (status fed/FilingStatus)) Money
  :cite ("26 U.S.C. § 63(f)")
  (if (or (is status 'fed/FILING_STATUS_SINGLE)
          (is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD))
      (. p 'addl_std_ded_unmarried)
      (. p 'addl_std_ded_married)))
