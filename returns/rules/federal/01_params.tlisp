(def year-params ((tax-year Int)) YearParams
  :cite ("Rev. Proc. 2024-40" "Rev. Proc. 2025-32" "P.L. 119-21 (OBBBA)")
  (if (is tax-year 2026)
      params-2026
      params-2025))

