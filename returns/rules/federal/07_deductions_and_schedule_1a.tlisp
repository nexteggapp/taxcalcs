; Standard Deduction Worksheet (26 U.S.C. § 63(c), (f)), Schedule A Itemized
; Deductions (26 U.S.C. §§ 63(e), 163, 164, 165, 170, 213), Standard vs.
; Itemized Election Resolution, and Schedule 1-A Additional Deductions
; (OBBBA, P.L. 119-21; 26 U.S.C. §§ 151(d)(5)(C), 163(h)(4), 224, 225).

(def count-age-and-blindness-boxes
  ((hh ret/Household)
   (status fed/FilingStatus)
   (tax-year Int))
  Int
  :cite ((law "26 U.S.C." "63" "(f)"))
  (withs (tp (. hh 'taxpayer)
          sp (. hh 'spouse)
          b1 (if (born-before-65-cutoff? (. tp 'date_of_birth) tax-year) 1 0)
          b2 (if (. tp 'blind) 1 0)
          include-spouse (and (!= (. sp 'id) "")
                              (or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
                                  (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)))
          b3 (if (and include-spouse (born-before-65-cutoff? (. sp 'date_of_birth) tax-year)) 1 0)
          b4 (if (and include-spouse (. sp 'blind)) 1 0))
    (+ b1 b2 b3 b4)))

; Form 4684 Section A totals before the 10%-of-AGI floor. Since 2018 a
; personal casualty loss is deductible only if it comes from a federally
; declared disaster (a qualified disaster loss or one with a FEMA declaration
; number), except to the extent of personal casualty gains (§ 165(h)(5)).
; Gains offset those other losses first, then federally declared losses,
; then qualified disaster losses. From 2026 a state-declared disaster
; counts like a federal one (P.L. 119-21 § 70109).
(defstruct CasualtyTotals
  (losses_after_floor Money)
  (qualified_net Money)
  (federal_net Money))

(def casualty-federally-declared? ((tax-year Int) (c ret/CasualtyLoss)) Bool
  :cite ((law "26 U.S.C." "165" "(h)(5)") (law "P.L. 119-21" "70109"))
  (any-of (. c 'qualified_disaster_loss)
      (!= (. c 'fema_disaster_number) "")
      (all-of (is tax-year 2026) (. c 'state_declared_disaster))))

(def casualty-loss-after-floor ((c ret/CasualtyLoss)) Money
  :cite ((law "26 U.S.C." "165" "(h)(1)") (doc "us-irs-form-4684-2025" "lines-1-12"))
  (withs (drop (clamp-zero (- (. c 'fmv_before) (. c 'fmv_after)))
          gross (min (. c 'cost_basis) drop)
          net (clamp-zero (- gross (. c 'insurance_reimbursement)))
          floor (if (. c 'qualified_disaster_loss) #usd"500.00" #usd"100.00"))
    (round-dollar (clamp-zero (- net floor)))))

(def casualty-gain ((c ret/CasualtyLoss)) Money
  :cite ((doc "us-irs-form-4684-2025" "line-4"))
  (round-dollar (clamp-zero (- (. c 'insurance_reimbursement) (. c 'cost_basis)))))

(def compute-casualty-totals ((tax-year Int) (losses (Slice ret/CasualtyLoss))) CasualtyTotals
  :cite ((law "26 U.S.C." "165" "(h)(2)") (law "26 U.S.C." "165" "(h)(5)") (doc "us-irs-4684-instructions-2025" "section-a"))
  (withs (qual (sum casualty-loss-after-floor
                    (keep (fn ((c ret/CasualtyLoss)) Bool (. c 'qualified_disaster_loss)) losses))
          fed (sum casualty-loss-after-floor
                   (keep (fn ((c ret/CasualtyLoss)) Bool
                           (and (not (. c 'qualified_disaster_loss))
                                (casualty-federally-declared? tax-year c)))
                         losses))
          other (sum casualty-loss-after-floor
                     (keep (fn ((c ret/CasualtyLoss)) Bool (not (casualty-federally-declared? tax-year c)))
                           losses))
          gains (sum casualty-gain losses)
          gains-after-other (clamp-zero (- gains other))
          fed-net (clamp-zero (- fed gains-after-other))
          gains-after-fed (clamp-zero (- gains-after-other fed))
          qual-net (clamp-zero (- qual gains-after-fed)))
    (CasualtyTotals (+ qual fed other) qual-net fed-net)))

(def compute-net-qualified-disaster-loss ((tax-year Int) (losses (Slice ret/CasualtyLoss))) Money
  :cite ((law "26 U.S.C." "165" "(h)") (doc "us-irs-form-4684-2025" "line-15"))
  (. (compute-casualty-totals tax-year losses) 'qualified_net))

; The standard deduction, line 12e. A filer someone else can claim (or, on a
; joint return, whose spouse someone else can claim) completes the Standard
; Deduction Worksheet for Dependents: earned income plus $450, at least
; $1,350, and no more than the basic standard deduction. Each box checked on
; line 12d for age or blindness adds the additional standard deduction, and
; a net qualified disaster loss from Form 4684 adds to it too. A separate
; filer whose spouse itemizes has none.
(defworksheet compute-standard-deduction-worksheet
  ((hh ret/Household)
   (status fed/FilingStatus)
   (earned-income Money)
   (casualty-losses (Slice ret/CasualtyLoss))
   (tax-year Int)
   (p FederalYear))
  ret/StandardDeductionWorksheet
  :cite ((law "26 U.S.C." "63" "(c)") (law "26 U.S.C." "63" "(f)"))
  (bind claimed (any-of (. hh 'taxpayer.can_be_claimed_as_dependent)
                        (all-of (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
                                (. hh 'spouse.can_be_claimed_as_dependent))))
  (bind dep-earned (if claimed (clamp-zero earned-income) #usd"0.00"))
  (line 1 "Earned income plus $450" (+ dep-earned (. p 'dep_std_ded_earned_add)))
  (line 2 "The minimum standard deduction" (. p 'dep_std_ded_min))
  (line 3 "The larger of line 1 and line 2" (max line1 line2))
  (line 4 "The basic standard deduction for your filing status" (base-standard-deduction p status))
  (line 5 "If someone can claim you, the smaller of line 3 and line 4; otherwise line 4"
        (if claimed (min line3 line4) line4))
  (line 6 "The additional standard deduction for each box checked on line 12d"
        (round-dollar (* (additional-standard-deduction-per-box p status)
                         (int-to-float (count-age-and-blindness-boxes hh status tax-year)))))
  (line 7 "Net qualified disaster loss, from Form 4684"
        (compute-net-qualified-disaster-loss tax-year casualty-losses))
  (line 8 "Standard deduction: lines 5, 6 and 7 added, or none if your spouse itemizes on a separate return"
        (if (all-of (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
                    (. hh 'spouse_itemizes_separately))
            #usd"0.00"
            (+ line5 line6 line7)))
  (result
    (proto 'ret/StandardDeductionWorksheet
      :base_standard_deduction line4
      :dependent_earned_income dep-earned
      :limited_base_deduction line5
      :age_and_blindness_count (count-age-and-blindness-boxes hh status tax-year)
      :additional_age_and_blindness_deduction line6
      :effective_standard_deduction line8)))

; -- Schedule A: Itemized Deductions ------------------------------------------

(def total-state-and-local-withholding ((docs ret/Documents)) Money
  :cite ((law "26 U.S.C." "164" "(a)(3)") (doc "us-irs-schedule-a-instructions-2025" "line-5a"))
  (withs (w2-state (sum (fn ((w ret/W2Document)) Money
                          (+ (sum (fn ((sw common/StateTaxWithholding)) Money (. sw 'tax_withheld))
                                  (. w 'form.state_tax_withholding))
                             (sum (fn ((lw common/LocalTaxWithholding)) Money (. lw 'tax_withheld))
                                  (. w 'form.local_tax_withholding))))
                        (. docs 'w2s))
          int-state (sum (fn ((d ret/Form1099INTDocument)) Money
                           (sum (fn ((sw common/StateTaxWithholding)) Money (. sw 'tax_withheld))
                                (. d 'form.state_tax_withholding)))
                         (. docs 'interest))
          div-state (sum (fn ((d ret/Form1099DIVDocument)) Money
                           (sum (fn ((sw common/StateTaxWithholding)) Money (. sw 'tax_withheld))
                                (. d 'form.state_tax_withholding)))
                         (. docs 'dividends))
          r-state (sum (fn ((d ret/Form1099RDocument)) Money
                         (+ (sum (fn ((sw common/StateTaxWithholding)) Money (. sw 'tax_withheld))
                                 (. d 'form.state_tax_withholding))
                            (sum (fn ((lw common/LocalTaxWithholding)) Money (. lw 'tax_withheld))
                                 (. d 'form.local_tax_withholding))))
                       (. docs 'retirement_distributions)))
    (round-dollar (+ w2-state int-state div-state r-state))))

(def total-state-estimated-paid-in-year ((payments ret/Payments) (tax-year Int)) Money
  (round-dollar
    (sum (fn ((ep ret/EstimatedPayment)) Money
           (if (and (!= (. ep 'jurisdiction) "US")
                    (!= (. ep 'jurisdiction) "")
                    (or (is (date-year (. ep 'date_paid)) tax-year)
                        (and (<= (date-year (. ep 'date_paid)) 0)
                             (is (. ep 'designated_tax_year) tax-year))))
               (. ep 'amount)
               #usd"0.00"))
         (. payments 'estimated_payments))))

(def compute-salt-cap
  ((status fed/FilingStatus)
   (agi Money)
   (p FederalYear))
  Money
  :cite ((law "26 U.S.C." "164" "(b)(6)") (law "P.L. 119-21" "70120"))
  (withs (is-mfs (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
          base-cap (if is-mfs (. p 'salt_cap_mfs) (. p 'salt_cap_default))
          start    (if is-mfs (. p 'salt_phaseout_start_mfs) (. p 'salt_phaseout_start_default))
          floor    (if is-mfs (. p 'salt_floor_mfs) (. p 'salt_floor_default))
          excess   (clamp-zero (- agi start))
          reduction (round-dollar (* excess 0.30)))
    (max floor (clamp-zero (- base-cap reduction)))))

(def home-acquisition-mortgage-doc? ((d ret/Form1098Document)) Bool
  (all-of (is (. d 'activity) "")
       (any-of (is (. d 'use) 'ret/MORTGAGE_USE_HOME_ACQUISITION)
           (is (. d 'use) 'ret/MORTGAGE_USE_UNSPECIFIED))))

(def loan-weighted-acquisition-balance ((d ret/Form1098Document)) Money
  :cite ((law "26 U.S.C." "163" "(h)(3)") (doc "us-irs-pub-936-2025"))
  (withs (raw-bal (round-dollar (. d 'average_balance))
          cash-out (round-dollar (. d 'cash_out_not_for_home_improvement))
          acq-bal (clamp-zero (- raw-bal cash-out))
          months (. d 'months_active)
          weight (if (and (. d 'refinanced_or_paid_off_in_year)
                          (> months 0)
                          (< months 12))
                     (/ (int-to-float months) 12.0)
                     1.0))
    (round-dollar (* acq-bal weight))))

(def loan-acquisition-interest ((d ret/Form1098Document)) Money
  :cite ((law "26 U.S.C." "163" "(h)(3)(F)") (doc "us-irs-pub-936-2025"))
  (withs (raw-int (+ (round-dollar (. d 'form.mortgage_interest_received))
                     (round-dollar (. d 'form.points_paid_on_purchase_of_principal_residence)))
          raw-bal (round-dollar (. d 'average_balance))
          cash-out (round-dollar (. d 'cash_out_not_for_home_improvement))
          acq-bal (clamp-zero (- raw-bal cash-out))
          personal-pct (. d 'personal_use_percent)
          personal-frac (if (> personal-pct 0.0) (min 1.0 (/ personal-pct 100.0)) 1.0)
          acq-frac (if (and (> raw-bal #usd"0.00") (> cash-out #usd"0.00"))
                       (/ acq-bal raw-bal)
                       1.0))
    (round-dollar (* (* raw-int personal-frac) acq-frac))))

(def loan-grandfathered-pre-tcja? ((d ret/Form1098Document)) Bool
  :cite ((law "26 U.S.C." "163" "(h)(3)(F)(i)(III)"))
  (withs (dt (. d 'debt_incurred_on)
          yr (date-year dt)
          mo (date-month dt)
          dy (date-day dt))
    (all-of (> yr 0)
         (any-of (< yr 2017)
             (all-of (is yr 2017) (< mo 12))
             (all-of (is yr 2017) (is mo 12) (<= dy 15))))))

(def compute-mortgage-interest-1098
  ((docs ret/Documents)
   (status fed/FilingStatus))
  Money
  :cite ((law "26 U.S.C." "163" "(h)(3)") (doc "us-irs-pub-936-2025"))
  (withs (home-docs (keep home-acquisition-mortgage-doc? (. docs 'mortgage_interest))
          raw-interest (sum loan-acquisition-interest home-docs)
          avg-bal (sum loan-weighted-acquisition-balance home-docs)
          is-mfs (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
          ; Pub. 936 Table 1: debt from before 2017-12-16 keeps the $1,000,000
          ; limit; later debt shares the $750,000 limit with it (lines 6-13).
          old-cap (if is-mfs #usd"500000.00" #usd"1000000.00")
          new-cap (if is-mfs #usd"375000.00" #usd"750000.00")
          old-bal (sum loan-weighted-acquisition-balance
                       (keep loan-grandfathered-pre-tcja? home-docs))
          new-bal (- avg-bal old-bal)
          old-qualified (min old-bal old-cap)
          new-qualified (min new-bal (clamp-zero (- new-cap old-qualified)))
          qualified (+ old-qualified new-qualified))
    (if (or (<= avg-bal #usd"0.00") (>= qualified avg-bal))
        (round-dollar raw-interest)
        (round-dollar (* raw-interest (/ qualified avg-bal))))))

(def compute-casualty-loss-deduction
  ((tax-year Int)
   (losses (Slice ret/CasualtyLoss))
   (agi Money))
  Money
  :cite ((law "26 U.S.C." "165" "(h)") (doc "us-irs-form-4684-2025"))
  (withs (totals (compute-casualty-totals tax-year losses)
          ten-pct-agi (round-dollar (* (clamp-zero agi) 0.10)))
    (+ (. totals 'qualified_net)
       (clamp-zero (- (. totals 'federal_net) ten-pct-agi)))))

(def compute-schedule-a
  ((tax-year Int)
   (status fed/FilingStatus)
   (docs ret/Documents)
   (ded ret/Deductions)
   (payments ret/Payments)
   (prior ret/PriorYear)
   (elections ret/Elections)
   (agi Money)
   (form4952-deductible Money)
   (p FederalYear))
  fed/ScheduleA
  :cite ((law "26 U.S.C." "63" "(e)") (law "26 U.S.C." "163") (law "26 U.S.C." "164") (law "26 U.S.C." "165") (law "26 U.S.C." "170") (law "26 U.S.C." "213") (doc "us-irs-schedule-a-instructions-2025"))
  (withs (med (. ded 'medical)
          med-miles-amt (round-dollar (* #usd"0.21" (int-to-float (. med 'medical_miles))))
          line1 (round-dollar
                  (+ (. med 'unreimbursed_medical_and_dental)
                     (. med 'after_tax_insurance_premiums)
                     (. med 'taxpayer_long_term_care_premiums)
                     (. med 'spouse_long_term_care_premiums)
                     med-miles-amt
                     (. med 'medical_lodging)))
          line3 (round-dollar (* (clamp-zero agi) 0.075))
          line4 (clamp-zero (- line1 line3))
          salt (. ded 'state_and_local_taxes)
          state-inc-paid (round-dollar
                           (+ (total-state-and-local-withholding docs)
                              (total-state-estimated-paid-in-year payments tax-year)
                              (. salt 'balance_paid_for_prior_years)))
          sales-tax (round-dollar (. salt 'general_sales_taxes))
          salt-elect (. elections 'state_tax_deduction)
          use-sales (cond
                      ((is salt-elect 'ret/STATE_TAX_DEDUCTION_ELECTION_GENERAL_SALES_TAX) true)
                      ((is salt-elect 'ret/STATE_TAX_DEDUCTION_ELECTION_INCOME_TAX) false)
                      (else (> sales-tax state-inc-paid)))
          line5a (if use-sales sales-tax state-inc-paid)
          line5b (round-dollar (. salt 'real_estate_taxes))
          line5c (round-dollar (. salt 'personal_property_taxes))
          line5d (+ line5a line5b line5c)
          salt-cap (compute-salt-cap status agi p)
          line5e (min line5d salt-cap)
          line6 (round-dollar (. salt 'other_deductible_taxes))
          line7 (+ line5e line6)
          line8a (compute-mortgage-interest-1098 docs status)
          line8b (round-dollar
                   (sum (fn ((d ret/Form1098Document)) Money
                          (if (home-acquisition-mortgage-doc? d)
                              (. d 'interest_not_on_form)
                              #usd"0.00"))
                        (. docs 'mortgage_interest)))
          line8c #usd"0.00"
          line8e (+ line8a line8b line8c)
          line9 (round-dollar form4952-deductible)
          line10 (+ line8e line9)
          cash-gifts (round-dollar
                       (sum (fn ((g ret/CharitableGift)) Money
                              (+ (. g 'cash_amount)
                                 (* #usd"0.14" (int-to-float (. g 'charitable_miles)))))
                            (. ded 'charitable_gifts)))
          noncash-gifts (round-dollar
                          (sum (fn ((g ret/CharitableGift)) Money
                                 (. g 'noncash_fair_market_value))
                               (. ded 'charitable_gifts)))
          prior-char (round-dollar
                       (sum (fn ((c ret/CharitableCarryover)) Money
                              (+ (. c 'cash_60_pct_amount)
                                 (. c 'public_charity_50_pct_amount)
                                 (. c 'capital_gain_or_private_30_pct_amount)
                                 (. c 'private_20_pct_amount)))
                            (. prior 'charitable_carryovers)))
          agi-60-cap (round-dollar (* (clamp-zero agi) 0.60))
          ; § 170(b)(1)(I), from 2026: gifts count only above 0.5% of the
          ; contribution base.
          gifts-all (+ cash-gifts noncash-gifts prior-char)
          gift-floor (if (>= tax-year 2026)
                         (min gifts-all (round-dollar (* (clamp-zero agi) 0.005)))
                         #usd"0.00")
          gifts-over-floor (- gifts-all gift-floor)
          line14 (min gifts-over-floor
                      (if (> agi #usd"0.00") agi-60-cap gifts-over-floor))
          line15 (compute-casualty-loss-deduction tax-year (. ded 'casualty_losses) agi)
          other-ded (round-dollar (. ded 'other_itemized_deductions))
          other-items (if (> other-ded #usd"0.00")
                          [(proto 'fed/OtherItemizedDeduction
                             :description "Other itemized deductions"
                             :amount other-ded)]
                          ((inst empty-slice fed/OtherItemizedDeduction)))
          line17 (+ line4 line7 line10 line14 line15 other-ded))
    (proto 'fed/ScheduleA
      :tax_year tax-year
      :medical_and_dental_expenses line1
      :deductible_medical_and_dental line4
      :state_local_income_or_sales_taxes line5a
      :elected_general_sales_taxes use-sales
      :state_local_real_estate_taxes line5b
      :state_local_personal_property_taxes line5c
      :total_state_and_local_taxes line5d
      :state_and_local_taxes_after_cap line5e
      :other_taxes line6
      :total_taxes_paid line7
      :mortgage_interest_reported_on_1098 line8a
      :mortgage_interest_not_reported_on_1098 line8b
      :points_not_reported_on_1098 line8c
      :total_mortgage_interest_and_points line8e
      :investment_interest line9
      :total_interest_paid line10
      :gifts_by_cash_or_check cash-gifts
      :gifts_other_than_cash_or_check noncash-gifts
      :charitable_carryover_from_prior_year prior-char
      :total_gifts_to_charity line14
      :casualty_and_theft_losses line15
      :other_itemized_deductions other-items
      :total_itemized_deductions line17)))

(def choose-itemized-deduction?
  ((hh ret/Household)
   (status fed/FilingStatus)
   (elections ret/Elections)
   (std-ws ret/StandardDeductionWorksheet)
   (sched-a fed/ScheduleA))
  Bool
  :cite ((law "26 U.S.C." "63" "(e)") (law "26 U.S.C." "63" "(c)(6)(A)"))
  (withs (method (. elections 'deduction_method)
          std-amt (. std-ws 'effective_standard_deduction)
          item-amt (. sched-a 'total_itemized_deductions)
          mfs-forced (all-of (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
                          (. hh 'spouse_itemizes_separately)))
    (cond
      (mfs-forced true)
      ((is method 'ret/DEDUCTION_METHOD_ELECTION_ITEMIZED) true)
      ((is method 'ret/DEDUCTION_METHOD_ELECTION_STANDARD) false)
      (else (> item-amt std-amt)))))

; -- Schedule 1-A: OBBBA Additional Deductions (26 U.S.C. §§ 224, 225, 163(h)(4), 151(d)(5)(C))

(def compute-schedule-1a
  ((tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (docs ret/Documents)
   (ded ret/Deductions)
   (agi Money))
  fed/Schedule1A
  :cite ((law "P.L. 119-21" "70103") (law "P.L. 119-21" "70201") (law "P.L. 119-21" "70202") (law "P.L. 119-21" "70203") (law "26 U.S.C." "151" "(d)(5)(C)") (law "26 U.S.C." "163" "(h)(4)") (law "26 U.S.C." "224") (law "26 U.S.C." "225") (doc "us-irs-schedule-1-a-2025"))
  (withs (s1a (. ded 'schedule_1a)
          magi (clamp-zero agi)
          is-mfs (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
          is-mfj (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
          ; 1. Qualified Tips (26 U.S.C. § 224)
          w2-tips (round-dollar
                    (sum (fn ((w ret/W2Document)) Money (. w 'qualified_tips))
                         (. docs 'w2s)))
          emp-tips (+ w2-tips (round-dollar (. s1a 'qualified_tips)))
          biz-tips (round-dollar
                     (sum (fn ((n ret/Form1099NECDocument)) Money (. n 'form.cash_tips))
                          (. docs 'nonemployee_compensation)))
          tips-capped (if (or is-mfs (. s1a 'tips_from_specified_service_business))
                          #usd"0.00"
                          (min (+ emp-tips biz-tips) #usd"25000.00"))
          tips-thresh (if is-mfj #usd"300000.00" #usd"150000.00")
          tips-thousands (floor-float (/ (clamp-zero (- magi tips-thresh)) #usd"1000.00"))
          tips-phaseout (round-dollar (* #usd"100.00" tips-thousands))
          tips-ded (clamp-zero (- tips-capped tips-phaseout))
          ; 2. Qualified Overtime (26 U.S.C. § 225)
          w2-ot (round-dollar
                  (sum (fn ((w ret/W2Document)) Money (. w 'qualified_overtime))
                       (. docs 'w2s)))
          nec-ot (round-dollar
                   (sum (fn ((n ret/Form1099NECDocument)) Money (. n 'form.overtime_compensation))
                        (. docs 'nonemployee_compensation)))
          total-ot (+ w2-ot nec-ot (round-dollar (. s1a 'qualified_overtime_compensation)))
          ot-cap (if is-mfj #usd"25000.00" #usd"12500.00")
          ot-capped (if is-mfs #usd"0.00" (min total-ot ot-cap))
          ot-phaseout (round-dollar (* #usd"100.00" tips-thousands))
          ot-ded (clamp-zero (- ot-capped ot-phaseout))
          ; 3. Passenger Vehicle Loan Interest (26 U.S.C. § 163(h)(4))
          car-int (round-dollar
                    (sum (fn ((loan ret/QualifiedCarLoan)) Money
                           (if (and (. loan 'final_assembly_in_us_new_personal_use)
                                    (> (date-year (. loan 'loan_originated_on)) 2024))
                               (. loan 'interest_paid)
                               #usd"0.00"))
                         (. s1a 'car_loans)))
          car-capped (min car-int #usd"10000.00")
          car-thresh (if is-mfj #usd"200000.00" #usd"100000.00")
          car-thousands (ceil-float (/ (clamp-zero (- magi car-thresh)) #usd"1000.00"))
          car-phaseout (round-dollar (* #usd"200.00" car-thousands))
          car-ded (clamp-zero (- car-capped car-phaseout))
          ; 4. Enhanced Deduction for Seniors (26 U.S.C. § 151(d)(5)(C))
          tp (. hh 'taxpayer)
          sp (. hh 'spouse)
          tp-senior (and (born-before-65-cutoff? (. tp 'date_of_birth) tax-year)
                         (valid-employment-ssn? (. tp 'tin)))
          sp-senior (and is-mfj
                         (!= (. sp 'id) "")
                         (born-before-65-cutoff? (. sp 'date_of_birth) tax-year)
                         (valid-employment-ssn? (. sp 'tin)))
          senior-count (+ (if tp-senior 1 0) (if sp-senior 1 0))
          senior-base (if is-mfs
                          #usd"0.00"
                          (* #usd"6000.00" (int-to-float senior-count)))
          senior-thresh (if is-mfj #usd"150000.00" #usd"75000.00")
          senior-phaseout (round-dollar (* (clamp-zero (- magi senior-thresh)) 0.06))
          senior-ded (clamp-zero (- senior-base senior-phaseout))
          total-1a (+ tips-ded ot-ded car-ded senior-ded))
    (proto 'fed/Schedule1A
      :tax_year tax-year
      :modified_adjusted_gross_income magi
      :excluded_income_added_back #usd"0.00"
      :qualified_tips_as_employee emp-tips
      :qualified_tips_from_trade_or_business biz-tips
      :qualified_tips_deduction tips-ded
      :qualified_overtime_compensation total-ot
      :qualified_overtime_deduction ot-ded
      :passenger_vehicle_loan_interest car-int
      :passenger_vehicle_loan_interest_deduction car-ded
      :valid_ssn_for_senior_deduction (> senior-count 0)
      :enhanced_deduction_for_seniors senior-ded
      :total_additional_deductions total-1a)))
