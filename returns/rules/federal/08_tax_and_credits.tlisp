; Ordinary bracket tax (26 U.S.C. § 1), Qualified Dividends and Capital Gain
; Tax Worksheet (26 U.S.C. § 1(h)), Schedule 8812 Child Tax Credit / Other
; Dependent Credit / Additional Child Tax Credit (26 U.S.C. § 24), Form 8959
; Additional Medicare Tax (26 U.S.C. § 3101(b)(2)), Form 8960 Net Investment
; Income Tax (26 U.S.C. § 1411), Schedule 2, and Schedule 3.

; 2022-2024 serve only as Schedule J base years.
(def bracket-table-for-year ((tax-year Int)) (Table fed/FilingStatus (Slice BracketRow))
  (cond
    ((is tax-year 2026) brackets-2026)
    ((is tax-year 2024) brackets-2024)
    ((is tax-year 2023) brackets-2023)
    ((is tax-year 2022) brackets-2022)
    (else brackets-2025)))

(def default-single-brackets ((tax-year Int)) (Slice BracketRow)
  (lookup-or (bracket-table-for-year tax-year)
             'fed/FILING_STATUS_SINGLE
             ((inst empty-slice BracketRow))))

(def brackets-for-status ((tax-year Int) (status fed/FilingStatus)) (Slice BracketRow)
  (lookup-or (bracket-table-for-year tax-year)
             status
             (default-single-brackets tax-year)))

(def compute-bracket-tax
  ((tax-year Int)
   (status fed/FilingStatus)
   (taxable-income Money))
  Money
  :cite ((law "26 U.S.C." "1") (doc "us-irs-rev-proc-2024-40") (doc "us-irs-rev-proc-2025-32"))
  (withs (ti (clamp-zero taxable-income)
          rows (brackets-for-status tax-year status))
    (if (<= ti #usd"0.00")
        #usd"0.00"
        (round-dollar
          (fold (fn ((acc Money) (row BracketRow)) Money
                  (if (and (> ti (. row 'floor)) (<= ti (. row 'ceiling)))
                      (+ (. row 'base_tax)
                         (* (- ti (. row 'floor)) (. row 'rate)))
                      acc))
                #usd"0.00"
                rows)))))

(def marginal-ordinary-rate
  ((tax-year Int)
   (status fed/FilingStatus)
   (taxable-income Money))
  Float
  :cite ((law "26 U.S.C." "1"))
  (withs (ti (clamp-zero taxable-income)
          rows (brackets-for-status tax-year status))
    (if (<= ti #usd"0.00")
        0.10
        (fold (fn ((acc Float) (row BracketRow)) Float
                (if (and (> ti (. row 'floor)) (<= ti (. row 'ceiling)))
                    (. row 'rate)
                    acc))
              0.10
              rows))))

; -- Qualified Dividends and Capital Gain Tax Worksheet (26 U.S.C. § 1(h)) ----

; The Qualified Dividends and Capital Gain Tax Worksheet, for line 16 when
; there are qualified dividends or a net capital gain: those are taxed at 0%,
; 15% or 20% depending on where they fall above the ordinary income, and the
; ordinary income at the regular rates. The tax is the smaller of that and the
; regular tax on all of taxable income.
(defworksheet compute-qdcgt-worksheet
  ((tax-year Int)
   (status fed/FilingStatus)
   (taxable-income Money)
   (qualified-dividends Money)
   (sched-d fed/ScheduleD)
   (form4952-elected-cap-gain Money))
  ret/QDCGTWorksheet
  :cite ((law "26 U.S.C." "1" "(h)"))
  (line 1 "Taxable income, from Form 1040, line 15" (round-dollar (clamp-zero taxable-income)))
  (line 2 "Qualified dividends, from line 3a, less any elected on Form 4952"
        (round-dollar (clamp-zero (- qualified-dividends form4952-elected-cap-gain))))
  (line 3 "The smaller of Schedule D, line 15 or 16, not below zero"
        (round-dollar (clamp-zero (min (. sched-d 'net_long_term_gain_or_loss)
                                       (. sched-d 'net_gain_or_loss)))))
  (line 4 "Line 2 plus line 3" (+ line2 line3))
  (line 5 "Line 1 less line 4, not below zero" (clamp-zero (- line1 line4)))
  (line 6 "The top of the 0% band for your filing status" (cap-gains-zero-threshold tax-year status))
  (line 7 "The smaller of line 1 and line 6" (min line1 line6))
  (line 8 "The smaller of line 5 and line 7" (min line5 line7))
  (line 9 "Line 7 less line 8: taxed at 0%" (clamp-zero (- line7 line8)))
  (line 10 "The smaller of line 1 and line 4" (min line1 line4))
  (line 11 "The amount from line 9" line9)
  (line 12 "Line 10 less line 11" (clamp-zero (- line10 line11)))
  (line 13 "The top of the 15% band for your filing status" (cap-gains-fifteen-threshold tax-year status))
  (line 14 "The smaller of line 1 and line 13" (min line1 line13))
  (line 15 "Line 5 plus line 9" (+ line5 line9))
  (line 16 "Line 14 less line 15, not below zero" (clamp-zero (- line14 line15)))
  (line 17 "The smaller of line 12 and line 16: taxed at 15%" (min line12 line16))
  (line 18 "Line 17 times 15%" (round-dollar (* line17 0.15)))
  (line 19 "Line 9 plus line 17" (+ line9 line17))
  (line 20 "Line 10 less line 19: taxed at 20%" (clamp-zero (- line10 line19)))
  (line 21 "Line 20 times 20%" (round-dollar (* line20 0.20)))
  (line 22 "The regular tax on line 5" (compute-bracket-tax tax-year status line5))
  (line 23 "Lines 18, 21 and 22 added" (+ line18 line21 line22))
  (line 24 "The regular tax on line 1" (compute-bracket-tax tax-year status line1))
  (line 25 "Tax on all taxable income: the smaller of line 23 and line 24" (min line23 line24))
  (result
    (proto 'ret/QDCGTWorksheet
      :line_1_taxable_income                             line1
      :line_2_qualified_dividends                        line2
      :line_3_net_capital_gain                           line3
      :line_4_total_preferential_income                  line4
      :line_5_ordinary_taxable_income                    line5
      :line_6_zero_rate_threshold                        line6
      :line_7_smaller_of_taxable_or_zero_threshold       line7
      :line_8_ordinary_in_zero_band                      line8
      :line_9_taxed_at_zero_percent                      line9
      :line_10_smaller_of_taxable_or_preferential        line10
      :line_11_zero_rate_amount                          line11
      :line_12_remaining_preferential                    line12
      :line_13_fifteen_rate_threshold                    line13
      :line_14_smaller_of_taxable_or_fifteen_threshold   line14
      :line_15_ordinary_plus_zero_band                   line15
      :line_16_fifteen_band_capacity                     line16
      :line_17_taxed_at_fifteen_percent                  line17
      :line_18_tax_at_fifteen_percent                    line18
      :line_19_zero_and_fifteen_preferential             line19
      :line_20_taxed_at_twenty_percent                   line20
      :line_21_tax_at_twenty_percent                     line21
      :line_22_tax_on_ordinary_income                    line22
      :line_23_combined_preferential_and_ordinary_tax    line23
      :line_24_regular_tax_on_all_taxable_income         line24
      :line_25_tax_on_all_taxable_income                 line25)))

; -- Schedule 8812: Child Tax Credit, ODC, and ACTC (26 U.S.C. § 24) ----------

(defstruct CTCResult
  (nonrefundable_ctc_and_odc Money)
  (additional_child_tax_credit Money))

(def compute-ctc-odc-actc
  ((tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (magi Money)
   (earned-income Money)
   (tax-limit-after-other-credits Money)
   (p FederalYear))
  CTCResult
  :cite ((law "26 U.S.C." "24") (law "P.L. 119-21" "70104") (doc "us-irs-schedule-8812-instructions-2025"))
  (withs (filer-has-ssn (or (valid-employment-ssn? (. hh 'taxpayer.tin))
                            (and (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
                                 (valid-employment-ssn? (. hh 'spouse.tin))))
          ctc-count (if filer-has-ssn
                        (count-ctc-children (. hh 'dependents) tax-year)
                        0)
          odc-count (count-odc-dependents (. hh 'dependents) tax-year p)
          init-ctc (round-dollar (* (. p 'ctc_per_child) (int-to-float ctc-count)))
          init-odc (round-dollar (* (. p 'odc_per_dependent) (int-to-float odc-count)))
          init-total (+ init-ctc init-odc)
          thresh (if (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
                     #usd"400000.00"
                     #usd"200000.00")
          excess-1000s (ceil-float (/ (clamp-zero (- magi thresh)) #usd"1000.00"))
          phaseout (round-dollar (* #usd"50.00" excess-1000s))
          after-phaseout (clamp-zero (- init-total phaseout))
          nonref (min after-phaseout (clamp-zero tax-limit-after-other-credits))
          unused-credit (clamp-zero (- after-phaseout nonref))
          ctc-only-after-odc (clamp-zero (- after-phaseout init-odc))
          unused-ctc (min unused-credit ctc-only-after-odc)
          actc-cap-by-children (round-dollar (* (. p 'actc_max_per_child) (int-to-float ctc-count)))
          max-actc (min unused-ctc actc-cap-by-children)
          earned-actc (round-dollar (* (clamp-zero (- earned-income #usd"2500.00")) 0.15))
          actc (min max-actc earned-actc))
    (CTCResult nonref actc)))

; -- Foreign Tax Credit (Direct Schedule 3 Line 1; 26 U.S.C. §§ 901, 904(j)) -

(def compute-foreign-tax-credit
  ((docs ret/Documents)
   (credits ret/Credits)
   (elections ret/Elections)
   (tax-before-credits Money))
  Money
  :cite ((law "26 U.S.C." "901") (law "26 U.S.C." "904" "(j)") (doc "us-irs-1040-instructions-2025" "schedule-3-line-1"))
  (if (is (. elections 'foreign_tax) 'ret/FOREIGN_TAX_ELECTION_ITEMIZED_DEDUCTION)
      #usd"0.00"
      (withs (int-ft (sum (fn ((d ret/Form1099INTDocument)) Money (. d 'form.foreign_tax_paid))
                          (. docs 'interest))
              div-ft (sum (fn ((d ret/Form1099DIVDocument)) Money (. d 'form.foreign_tax_paid))
                          (. docs 'dividends))
              item-ft (sum (fn ((f ret/ForeignTaxItem)) Money (. f 'foreign_taxes_paid))
                           (. credits 'foreign_taxes))
              total-ft (round-dollar (+ int-ft div-ft item-ft)))
        (min total-ft (clamp-zero tax-before-credits)))))

; -- Form 8959: Additional Medicare Tax (26 U.S.C. § 3101(b)(2)) --------------

(def additional-medicare-threshold ((status fed/FilingStatus)) Money
  :cite ((law "26 U.S.C." "3101" "(b)(2)"))
  (cond
    ((is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY) #usd"250000.00")
    ((is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY) #usd"125000.00")
    (else #usd"200000.00")))

(def compute-additional-medicare-tax
  ((status fed/FilingStatus)
   (docs ret/Documents)
   (net-se-earnings Money))
  Money
  :cite ((law "26 U.S.C." "3101" "(b)(2)") (doc "us-irs-form-8959-2025"))
  (withs (med-wages (sum (fn ((w ret/W2Document)) Money (. w 'form.medicare_wages_and_tips))
                         (. docs 'w2s))
          combined (+ med-wages (clamp-zero net-se-earnings))
          thresh (additional-medicare-threshold status)
          excess (clamp-zero (- combined thresh)))
    (round-dollar (* excess 0.009))))

(def compute-additional-medicare-withheld ((docs ret/Documents)) Money
  :cite ((doc "us-irs-form-8959-2025" "part-v") (doc "us-irs-1040-instructions-2025" "line-25c"))
  (round-dollar
    (sum (fn ((w ret/W2Document)) Money
           (withs (mw (. w 'form.medicare_wages_and_tips)
                   withheld (. w 'form.medicare_tax_withheld)
                   regular-withheld (* mw 0.0145))
             (clamp-zero (- withheld regular-withheld))))
         (. docs 'w2s))))

; -- Form 8960: Net Investment Income Tax (26 U.S.C. § 1411) ------------------

(def niit-threshold ((status fed/FilingStatus)) Money
  :cite ((law "26 U.S.C." "1411" "(b)"))
  (cond
    ((or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
         (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
     #usd"250000.00")
    ((is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
     #usd"125000.00")
    (else #usd"200000.00")))

(def compute-net-investment-income-tax
  ((status fed/FilingStatus)
   (magi Money)
   (taxable-interest Money)
   (ordinary-dividends Money)
   (capital-gain-or-loss Money)
   (passive-net-income Money)
   (investment-interest-deduction Money))
  Money
  :cite ((law "26 U.S.C." "1411") (doc "us-irs-form-8960-2025"))
  (withs (gross-nii (+ taxable-interest
                       ordinary-dividends
                       (clamp-zero capital-gain-or-loss)
                       (clamp-zero passive-net-income))
          nii (clamp-zero (- gross-nii investment-interest-deduction))
          thresh (niit-threshold status)
          magi-excess (clamp-zero (- magi thresh))
          base (min nii magi-excess))
    (round-dollar (* base 0.038))))

; -- Schedule 2 and Schedule 3 ------------------------------------------------

; Schedule 2 (Form 1040), Additional Taxes. Part I adds to the tax on line
; 16; Part II's other taxes go to line 23. The lines the rules leave out,
; such as tax on unreported tips (Form 4137) and the recapture taxes of line
; 17, are zero.
(defform compute-schedule-2
  ((tax-year Int)
   (amt Money)
   (aptc-repayment Money)
   (form8814-child-tax Money)
   (clean-vehicle-recapture Money)
   (se-tax Money)
   (ira-and-hsa-tax Money)
   (household-emp-tax Money)
   (addl-medicare-tax Money)
   (niit Money))
  fed/Schedule2
  :cite ((law "26 U.S.C." "55") (law "26 U.S.C." "1401") (law "26 U.S.C." "1411"))
  (set :tax_year tax-year)
  (part "Part I – Tax"
    (bind items-0 (if (> aptc-repayment #usd"0.00")
                      [(proto 'fed/Schedule2Item
                         :description "Excess advance premium tax credit repayment"
                         :amount aptc-repayment)]
                      ((inst empty-slice fed/Schedule2Item))))
    (bind items-1 (if (> form8814-child-tax #usd"0.00")
                      (append items-0
                              [(proto 'fed/Schedule2Item
                                 :description "Form 8814 tax on child's interest and dividends"
                                 :amount form8814-child-tax)])
                      items-0))
    (set :additions_to_tax (if (> clean-vehicle-recapture #usd"0.00")
                               (append items-1
                                       [(proto 'fed/Schedule2Item
                                          :description "Excess advance clean vehicle payment"
                                          :amount clean-vehicle-recapture)])
                               items-1))
    (line "1z" "Additions to tax: excess advance premium tax credit, the tax on a child's income from Form 8814, and excess advance clean vehicle payments"
          (+ aptc-repayment form8814-child-tax clean-vehicle-recapture))
    (line 2 "Alternative minimum tax, from Form 6251" amt :field alternative_minimum_tax)
    (line 3 "Line 1z plus line 2, to Form 1040, line 17" (+ line2 line1z) :field total_part_one))
  (part "Part II – Other Taxes"
    (line 4 "Self-employment tax, from Schedule SE" se-tax :field self_employment_tax)
    (line 8 "Additional tax on IRAs and other tax-favored accounts, from Form 5329 and Form 8889"
          ira-and-hsa-tax :field tax_on_iras_and_tax_favoured_accounts)
    (line 9 "Household employment taxes, from Schedule H" household-emp-tax
          :field household_employment_taxes)
    (line 11 "Additional Medicare Tax, from Form 8959" addl-medicare-tax
          :field additional_medicare_tax)
    (line 12 "Net investment income tax, from Form 8960" niit :field net_investment_income_tax)
    (line 21 "Total other taxes: lines 4, 8, 9, 11 and 12, to Form 1040, line 23"
          (+ line4 line8 line9 line11 line12) :field total_part_two)))

; Schedule 3 (Form 1040), Additional Credits and Payments. Part I's
; nonrefundable credits go to line 20, and Part II's payments and refundable
; credits to line 31.
(defform compute-schedule-3
  ((tax-year Int)
   (hh ret/Household)
   (docs ret/Documents)
   (payments ret/Payments)
   (ftc Money)
   (care-credit Money)
   (edu-nonref-credit Money)
   (savers-credit Money)
   (clean-energy-credit Money)
   (home-improvement-credit Money)
   (other-nonref-credit Money)
   (net-ptc Money)
   (p FederalYear))
  fed/Schedule3
  :cite ((law "26 U.S.C." "901") (law "26 U.S.C." "21") (law "26 U.S.C." "25A")
         (law "26 U.S.C." "25B") (law "26 U.S.C." "25D") (law "26 U.S.C." "25C")
         (law "26 U.S.C." "36B") (law "26 U.S.C." "31" "(b)"))
  (set :tax_year tax-year)
  (part "Part I – Nonrefundable Credits"
    (line 1 "Foreign tax credit, from Form 1116" ftc :field foreign_tax_credit)
    (line 2 "Credit for child and dependent care expenses, from Form 2441" care-credit
          :field child_and_dependent_care_credit)
    (line 3 "Education credits, from Form 8863" edu-nonref-credit :field education_credits)
    (line 4 "Retirement savings contributions credit, from Form 8880" savers-credit
          :field retirement_savings_contributions_credit)
    (line "5a" "Residential clean energy credit, from Form 5695" clean-energy-credit
          :field residential_clean_energy_credit)
    (line "5b" "Energy efficient home improvement credit, from Form 5695" home-improvement-credit
          :field energy_efficient_home_improvement_credit)
    (line 7 "Total other nonrefundable credits" other-nonref-credit
          :field total_other_nonrefundable_credits)
    (line 8 "Lines 1 through 4, 5a, 5b and 7, to Form 1040, line 20"
          (+ line1 line2 line3 line4 line5a line5b line7) :field total_nonrefundable_credits))
  (part "Part II – Other Payments and Refundable Credits"
    (line 9 "Net premium tax credit, from Form 8962" net-ptc :field net_premium_tax_credit)
    (line 10 "Amount paid with a request for an extension to file"
          (round-dollar (. payments 'federal_extension_payment))
          :field amount_paid_with_extension_request)
    (line 11 "Excess social security tax withheld, for you and your spouse"
          (+ (person-excess-ss-withheld docs (. hh 'taxpayer.id) p)
             (if (!= (. hh 'spouse.id) "")
                 (person-excess-ss-withheld docs (. hh 'spouse.id) p)
                 #usd"0.00"))
          :field excess_social_security_withheld)
    (line 12 "Credit for federal tax on fuels, from Form 4136"
          (round-dollar (. payments 'credit_for_federal_tax_on_fuels))
          :field credit_for_federal_tax_on_fuels)
    (line 15 "Lines 9 through 12, to Form 1040, line 31" (+ line9 line10 line11 line12)
          :field total_refundable_credits_and_payments)))
