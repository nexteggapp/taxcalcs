; Federal tax withholding (Form 1040 lines 25a-25d), estimated tax payments
; (line 26), Earned Income Credit (line 27; 26 U.S.C. § 32), resolved
; elections, Form 1040 assembly, FederalReturn, and ReturnOutputs.

(def compute-withheld-from-w2 ((docs ret/Documents)) Money
  :cite ((law "26 U.S.C." "31" "(a)") "Form 1040 Instructions, Line 25a")
  (round-dollar
    (sum (fn ((w ret/W2Document)) Money (. w 'form.federal_tax_withheld))
         (. docs 'w2s))))

(def compute-withheld-from-1099 ((docs ret/Documents)) Money
  :cite ("Form 1040 Instructions, Line 25b")
  (withs (int-w (sum (fn ((d ret/Form1099INTDocument)) Money (. d 'form.federal_tax_withheld))
                     (. docs 'interest))
          oid-w (sum (fn ((d ret/Form1099OIDDocument)) Money (. d 'form.federal_income_tax_withheld))
                     (. docs 'original_issue_discount))
          div-w (sum (fn ((d ret/Form1099DIVDocument)) Money (. d 'form.federal_tax_withheld))
                     (. docs 'dividends))
          b-w   (sum (fn ((t ret/BrokerTransaction)) Money (. t 'form.federal_tax_withheld))
                     (flatten-broker-transactions (. docs 'brokers)))
          r-w   (sum (fn ((d ret/Form1099RDocument)) Money (. d 'form.federal_tax_withheld))
                     (. docs 'retirement_distributions))
          ssa-w (sum (fn ((d ret/FormSSA1099Document)) Money (. d 'form.federal_tax_withheld))
                     (. docs 'social_security))
          g-w   (sum (fn ((d ret/Form1099GDocument)) Money (. d 'form.federal_tax_withheld))
                     (. docs 'government_payments))
          nec-w (sum (fn ((d ret/Form1099NECDocument)) Money (. d 'form.federal_tax_withheld))
                     (. docs 'nonemployee_compensation))
          misc-w (sum (fn ((d ret/Form1099MISCDocument)) Money (. d 'form.federal_tax_withheld))
                      (. docs 'miscellaneous))
          k-w   (sum (fn ((d ret/Form1099KDocument)) Money (. d 'form.federal_tax_withheld))
                     (. docs 'payment_networks)))
    (round-dollar (+ int-w oid-w div-w b-w r-w ssa-w g-w nec-w misc-w k-w))))

(def compute-withheld-from-other-forms
  ((hh ret/Household)
   (docs ret/Documents)
   (payments ret/Payments))
  Money
  :cite ("Form 1040 Instructions, Line 25c")
  (withs (w2g-w (sum (fn ((d ret/W2GDocument)) Money (. d 'form.federal_tax_withheld))
                     (. docs 'w2gs))
          addl-med-w (compute-additional-medicare-withheld docs)
          other-w (. payments 'other_federal_withholding)
          child-8814-w (sum (fn ((c ret/ChildDividendInclusion)) Money (. c 'federal_income_tax_withheld))
                            (. hh 'form_8814_children)))
    (round-dollar (+ w2g-w addl-med-w other-w child-8814-w))))

(def compute-federal-estimated-payments ((payments ret/Payments) (tax-year Int)) Money
  :cite ("Form 1040 Instructions, Line 26")
  (withs (prior-applied (. payments 'prior_year_federal_overpayment_applied)
          est-sum (sum (fn ((ep ret/EstimatedPayment)) Money
                         (if (and (or (is (. ep 'jurisdiction) "US")
                                      (is (. ep 'jurisdiction) ""))
                                  (or (is (. ep 'designated_tax_year) tax-year)
                                      (<= (. ep 'designated_tax_year) 0)))
                             (. ep 'amount)
                             #usd"0.00"))
                       (. payments 'estimated_payments)))
    (round-dollar (+ prior-applied est-sum))))

(def build-deduction-resolved-election
  ((elections ret/Elections)
   (used-itemized Bool)
   (std-ded Money)
   (item-ded Money)
   (tax-with-std Money)
   (tax-with-item Money))
  ret/ResolvedElection
  :cite ((law "26 U.S.C." "63" "(e)"))
  (withs (auto (is (. elections 'deduction_method) 'ret/DEDUCTION_METHOD_ELECTION_UNSPECIFIED)
          chosen-opt (if used-itemized
                         "DEDUCTION_METHOD_ELECTION_ITEMIZED"
                         "DEDUCTION_METHOD_ELECTION_STANDARD")
          chosen-tax (if used-itemized tax-with-item tax-with-std)
          alt-std (proto 'ret/Alternative
                    :option "DEDUCTION_METHOD_ELECTION_STANDARD"
                    :option_amount std-ded
                    :resulting_total_tax tax-with-std
                    :tax_difference (- tax-with-std chosen-tax))
          alt-item (proto 'ret/Alternative
                     :option "DEDUCTION_METHOD_ELECTION_ITEMIZED"
                     :option_amount item-ded
                     :resulting_total_tax tax-with-item
                     :tax_difference (- tax-with-item chosen-tax)))
    (proto 'ret/ResolvedElection
      :election_path "federal.elections.deduction_method"
      :chosen_automatically auto
      :chosen_option chosen-opt
      :alternatives [alt-std alt-item]
      :citations [(proto 'ret/Citation :authority "26 U.S.C. § 63(e)")])))

(def compute-tax-for-deduction-amount
  ((tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (docs ret/Documents)
   (credits ret/Credits)
   (prior ret/PriorYear)
   (elections ret/Elections)
   (agi Money)
   (deduction-amt Money)
   (qbi-ded Money)
   (sched-1a-ded Money)
   (qual-div Money)
   (sched-d fed/ScheduleD)
   (form4952-elected Money)
   (earned-income Money)
   (sched-2 fed/Schedule2)
   (other-sched3-nonref Money)
   (p FederalYear))
  Money
  (withs (total-ded (+ deduction-amt qbi-ded sched-1a-ded)
          ti (clamp-zero (- agi total-ded))
          has-pref (or (> qual-div #usd"0.00")
                       (> (min (. sched-d 'net_long_term_gain_or_loss)
                               (. sched-d 'net_gain_or_loss))
                          #usd"0.00"))
          qdcgt (compute-qdcgt-worksheet tax-year status ti qual-div sched-d form4952-elected)
          line16 (if has-pref
                     (. qdcgt 'line_25_tax_on_all_taxable_income)
                     (compute-bracket-tax tax-year status ti))
          line17 (. sched-2 'total_part_one)
          line18 (+ line16 line17)
          ftc (. (compute-form-1116
                   hh tax-year status docs credits prior elections agi deduction-amt ti qdcgt line18)
                 'total_credit)
          sched3-nonref (+ ftc other-sched3-nonref)
          ctc-res (compute-ctc-odc-actc
                    tax-year status hh agi earned-income
                    (clamp-zero (- line18 sched3-nonref))
                    p)
          line19 (. ctc-res 'nonrefundable_ctc_and_odc)
          line21 (+ line19 sched3-nonref)
          line22 (clamp-zero (- line18 line21))
          line23 (. sched-2 'total_part_two))
    (+ line22 line23)))

; The qualified dividends of the children whose income is reported on
; Form 8814, which the parent's lines 3a and 3b include.
(def form-8814-qualified-dividends ((forms (Slice fed/Form8814))) Money
  (sum (fn ((f fed/Form8814)) Money (. f 'parent_included_qualified_dividends)) forms))

; Line 16: the tax on taxable income. The Foreign Earned Income Tax
; Worksheet, Schedule J farm income averaging and Form 8615 for a child's
; unearned income each replace the ordinary computation when they apply;
; otherwise the Qualified Dividends and Capital Gain Tax Worksheet gives the
; tax when there are qualified dividends or a net capital gain, and the tax
; rate schedules give it when there are not.
(def tax-on-taxable-income
  ((tax-year Int)
   (status fed/FilingStatus)
   (taxable-income Money)
   (has-preferential Bool)
   (qdcgt-ws ret/QDCGTWorksheet)
   (feitw ret/ForeignEarnedIncomeTaxWorksheet)
   (sched-j fed/ScheduleJ)
   (form-8615 fed/Form8615))
  Money
  :cite ((law "26 U.S.C." "1"))
  (cond
    ((> (. feitw 'line_2a_exclusions_and_housing_deduction) #usd"0.00")
     (. feitw 'line_6_tax))
    ((> (. sched-j 'elected_farm_income) #usd"0.00")
     (. sched-j 'averaged_income_tax))
    ((> (. form-8615 'net_unearned_income) #usd"0.00")
     (. form-8615 'child_tax))
    (has-preferential (. qdcgt-ws 'line_25_tax_on_all_taxable_income))
    (else (compute-bracket-tax tax-year status taxable-income))))

; Form 1040, the U.S. Individual Income Tax Return.
;
; The return is prepared in the order the schedules depend on each other,
; which is not the form's order: Schedule 1 needs the IRA deduction, which
; needs modified AGI, and the itemized deductions need AGI. Those schedules
; and worksheets are prepared first and given to the form, which then adds
; up its lines as printed, working out for itself the Social Security
; Benefits Worksheet, the standard deduction, the tax on line 16 and
; Schedule 8812.
;
; Line 32 here includes line 26's estimated payments, and line 33 adds line
; 32 to line 25d; the totals are the same as the printed lines 32 and 33
; give between them. Line 30, the refundable adoption credit, is not
; computed. The penalty on line 38 reduces the overpayment on line 34, or
; is added to the amount owed on line 37, as the line 38 instructions say.
(defform fed-form-1040
  ((tax-year Int)
   (p FederalYear)
   (status fed/FilingStatus)
   (fed-in ret/Federal1040Inputs)
   (form-8814s (Slice fed/Form8814))
   (sched-b fed/ScheduleB)
   (ira-taxable Money)
   (ss-adjustments Money)
   (sched-d fed/ScheduleD)
   (sched-1 fed/Schedule1)
   (sched-1a fed/Schedule1A)
   (sched-a fed/ScheduleA)
   (use-itemized Bool)
   (qbi-deduction Money)
   (has-preferential Bool)
   (form4952-elected Money)
   (feitw ret/ForeignEarnedIncomeTaxWorksheet)
   (sched-j fed/ScheduleJ)
   (form-8615 fed/Form8615)
   (sched-2 fed/Schedule2)
   (sched-3 fed/Schedule3)
   (earned-income Money)
   (investment-income Money)
   (education EducationCreditsResult)
   (estimated-tax-penalty Money))
  fed/Form1040
  :cite ((law "26 U.S.C." "1") (law "26 U.S.C." "6012"))
  (bind hh (. fed-in 'household))
  (bind docs (. fed-in 'documents))
  (bind tp (. hh 'taxpayer))
  (bind sp (. hh 'spouse))
  (set :tax_year tax-year)
  (set :filing_status status)
  (set :filer (build-party-for-person tp))
  (set :spouse (build-party-for-person sp))
  (set :dependents (build-form1040-dependents (. hh 'dependents) tax-year p))
  (set :digital_assets_answered true)
  (set :digital_assets_yes (. hh 'digital_assets))

  (part "Income"
    (line "1a" "Wages, from box 1 of the Forms W-2" (total-w2-wages docs) :field w2_wages)
    (line "1c" "Tip income not reported on line 1a" (total-unreported-or-allocated-tips docs)
          :field unreported_tip_income)
    (line "1i" "Nontaxable combat pay elected to be treated as earned income"
          (total-nontaxable-combat-pay docs) :field nontaxable_combat_pay_election)
    (line "1z" "Total wages: lines 1a through 1h; lines 1b and 1d to 1h are not computed"
          (+ line1a line1c) :field total_wages)
    (line "2a" "Tax-exempt interest" (total-tax-exempt-interest docs) :field tax_exempt_interest)
    (line "2b" "Taxable interest, from Schedule B" (. sched-b 'taxable_interest)
          :field taxable_interest)
    (line "3a" "Qualified dividends, with any of a child's from Form 8814"
          (+ (total-qualified-dividends docs) (form-8814-qualified-dividends form-8814s))
          :field qualified_dividends)
    (line "3b" "Ordinary dividends, from Schedule B, with a child's qualified dividends from Form 8814"
          (+ (. sched-b 'total_ordinary_dividends) (form-8814-qualified-dividends form-8814s))
          :field ordinary_dividends)
    (line "4a" "IRA distributions, with Roth conversions"
          (compute-total-ira-gross-with-conversions docs (. fed-in 'retirement))
          :field ira_distributions)
    (line "4b" "Taxable IRA distributions, after Form 8606" ira-taxable
          :field ira_distributions_taxable)
    (line "5a" "Pensions and annuities" (total-pensions-and-annuities-gross docs)
          :field pensions_and_annuities)
    (line "5b" "Taxable pensions and annuities" (total-pensions-and-annuities-taxable docs tax-year)
          :field pensions_and_annuities_taxable)
    (bind capital-gain (form1040-line7-capital-gain-or-loss sched-d))
    (bind additional-income (. sched-1 'total_additional_income))
    (attach ss-ws "Social Security Benefits Worksheet"
            (compute-ss-benefits-worksheet
              status (not (. hh 'lived_with_spouse_any_time)) (. docs 'social_security)
              (+ line1z line2b line3b line4b line5b capital-gain additional-income)
              line2a ss-adjustments))
    (line "6a" "Social security benefits, from line 1 of the Social Security Benefits Worksheet"
          (. ss-ws 'line_1_total_benefits) :field social_security_benefits)
    (line "6b" "Taxable social security benefits, from its line 18"
          (. ss-ws 'line_18_taxable_benefits) :field social_security_benefits_taxable)
    (line "7a" "Capital gain or (loss), from Schedule D" capital-gain :field capital_gain_or_loss)
    (line 8 "Additional income, from Schedule 1, line 10" additional-income
          :field additional_income)
    (line 9 "Total income: lines 1z, 2b, 3b, 4b, 5b, 6b, 7a and 8"
          (+ line1z line2b line3b line4b line5b line6b line7a line8) :field total_income)
    (line 10 "Adjustments to income, from Schedule 1, line 26" (. sched-1 'total_adjustments)
          :field adjustments_to_income)
    (line "11a" "Adjusted gross income: line 9 less line 10" (- line9 line10)
          :field adjusted_gross_income))

  (part "Tax and credits"
    (line "11b" "The amount from line 11a" line11a)
    (line "12a" "Someone can claim you as a dependent" (. tp 'can_be_claimed_as_dependent)
          :field claimed_as_dependent)
    (set :spouse_claimed_as_dependent (. sp 'can_be_claimed_as_dependent))
    (set :filer_born_before_cutoff (born-before-65-cutoff? (. tp 'date_of_birth) tax-year))
    (set :filer_blind (. tp 'blind))
    (set :spouse_born_before_cutoff (all-of (!= (. sp 'id) "")
                                            (born-before-65-cutoff? (. sp 'date_of_birth) tax-year)))
    (set :spouse_blind (. sp 'blind))
    (set :itemized use-itemized)
    (attach std-ws "Standard Deduction Worksheet"
            (compute-standard-deduction-worksheet
              hh status earned-income (. fed-in 'deductions.casualty_losses) tax-year p))
    (line "12e" "Itemized deductions from Schedule A if you itemize, otherwise the standard deduction"
          (if use-itemized
              (. sched-a 'total_itemized_deductions)
              (. std-ws 'effective_standard_deduction))
          :field deduction)
    (line "13a" "Qualified business income deduction, from Form 8995 or 8995-A" qbi-deduction
          :field qualified_business_income_deduction)
    (line "13b" "Additional deductions, from Schedule 1-A, line 38"
          (. sched-1a 'total_additional_deductions) :field additional_deductions)
    (line 14 "Total deductions: lines 12e, 13a and 13b" (+ line12e line13a line13b)
          :field total_deductions)
    (line 15 "Taxable income: line 11b less line 14, not below zero" (clamp-zero (- line11b line14))
          :field taxable_income)
    (attach qdcgt-ws "Qualified Dividends and Capital Gain Tax Worksheet"
            (compute-qdcgt-worksheet tax-year status line15 line3a sched-d form4952-elected))
    (line 16 "Tax"
          (tax-on-taxable-income tax-year status line15 has-preferential qdcgt-ws feitw sched-j form-8615)
          :field tax)
    (line 17 "Amount from Schedule 2, line 3" (. sched-2 'total_part_one)
          :field additional_tax_from_schedule_2)
    (line 18 "Line 16 plus line 17" (+ line16 line17) :field tax_plus_additional)
    (bind credit-limit (clamp-zero (- line18 (. sched-3 'total_nonrefundable_credits))))
    (attach sched-8812 "Schedule 8812"
            (compute-ctc-odc-actc tax-year status hh line11a earned-income credit-limit p))
    (line 19 "Child tax credit or credit for other dependents, from Schedule 8812"
          (. sched-8812 'nonrefundable_ctc_and_odc) :field child_tax_credit)
    (line 20 "Amount from Schedule 3, line 8" (. sched-3 'total_nonrefundable_credits)
          :field nonrefundable_credits)
    (line 21 "Line 19 plus line 20" (+ line19 line20) :field total_credits)
    (line 22 "Line 18 less line 21, not below zero" (clamp-zero (- line18 line21))
          :field tax_after_credits)
    (line 23 "Other taxes, including self-employment tax, from Schedule 2, line 21"
          (. sched-2 'total_part_two) :field other_taxes)
    (line 24 "Total tax: line 22 plus line 23" (+ line22 line23) :field total_tax))

  (part "Payments and refundable credits"
    (line "25a" "Federal income tax withheld on Forms W-2" (compute-withheld-from-w2 docs)
          :field withheld_from_w2)
    (line "25b" "Federal income tax withheld on Forms 1099" (compute-withheld-from-1099 docs)
          :field withheld_from_1099)
    (line "25c" "Federal income tax withheld on other forms"
          (compute-withheld-from-other-forms hh docs (. fed-in 'payments))
          :field withheld_from_other_forms)
    (line "25d" "Lines 25a through 25c" (+ line25a line25b line25c) :field total_withheld)
    (line 26 "Estimated tax payments, and the overpayment applied from last year"
          (compute-federal-estimated-payments (. fed-in 'payments) tax-year)
          :field estimated_tax_payments)
    (line "27a" "Earned income credit"
          (compute-earned-income-credit tax-year status hh (. fed-in 'credits) line11a
                                        earned-income investment-income)
          :field earned_income_credit)
    (line 28 "Additional child tax credit, from Schedule 8812"
          (. sched-8812 'additional_child_tax_credit) :field additional_child_tax_credit)
    (line 29 "American opportunity credit, from Form 8863" (. education 'refundable_aotc)
          :field american_opportunity_credit)
    (line 31 "Amount from Schedule 3, line 15" (. sched-3 'total_refundable_credits_and_payments)
          :field other_refundable_credits)
    (line 32 "Estimated payments and refundable credits: lines 26, 27a, 28, 29 and 31"
          (+ line26 line27a line28 line29 line31) :field total_other_payments)
    (line 33 "Total payments: line 25d plus line 32" (+ line25d line32) :field total_payments))

  (part "Refund"
    (line 34 "Overpaid: line 33 less line 24, less the penalty on line 38"
          (clamp-zero (- (clamp-zero (- line33 line24)) estimated-tax-penalty)) :field overpaid)
    (bind applied (min line34 (round-dollar (. fed-in 'elections.overpayment_applied_to_next_year))))
    (line "35a" "Refunded: line 34 less line 36" (clamp-zero (- line34 applied)) :field refunded)
    (line 36 "Applied to next year's estimated tax, as elected, up to line 34" applied
          :field applied_to_next_year))

  (part "Amount you owe"
    (line 37 "Amount you owe: line 24 less line 33, plus any of line 38 the overpayment does not cover"
          (+ (clamp-zero (- line24 line33))
             (clamp-zero (- estimated-tax-penalty (clamp-zero (- line33 line24)))))
          :field amount_owed)
    (line 38 "Estimated tax penalty, from Form 2210" estimated-tax-penalty
          :field estimated_tax_penalty)))

(def prepare-federal-return ((inputs ret/ReturnInputs)) ret/FederalReturn
  :cite ("26 U.S.C. Subtitle A, Chapter 1" "Form 1040 Instructions")
  (withs (tax-year (if (> (. inputs 'tax_year) 0) (. inputs 'tax_year) 2025)
          p (year-params tax-year)
          fed-in (. inputs 'federal)
          hh (. fed-in 'household)
          docs (. fed-in 'documents)
          businesses (. fed-in 'businesses)
          rentals (. fed-in 'rentals)
          pts (. fed-in 'pass_throughs)
          farms (. fed-in 'farms)
          feis (. fed-in 'foreign_earned_income)
          inv (. fed-in 'investments)
          retire (. fed-in 'retirement)
          health (. fed-in 'health)
          ded (. fed-in 'deductions)
          adj (. ded 'adjustments)
          credits (. fed-in 'credits)
          payments (. fed-in 'payments)
          prior (. fed-in 'prior_year)
          elections (. fed-in 'elections)
          status (resolve-filing-status hh elections tax-year p)
          ; 1. Wages, Form 8814 Child Income, Schedule B, Dispositions (Forms 4562, 4797, 6252, 8824, 7203), Capital Gains & Retirement
          w2-wages (total-w2-wages docs)
          tips-unrep (total-unreported-or-allocated-tips docs)
          combat-pay (total-nontaxable-combat-pay docs)
          total-wages (+ w2-wages tips-unrep)
          form-8814s (compute-form-8814s hh tax-year p)
          f8814-ord (sum (fn ((f fed/Form8814)) Money (. f 'parent_included_ordinary_income)) form-8814s)
          f8814-qual (form-8814-qualified-dividends form-8814s)
          f8814-cap (sum (fn ((f fed/Form8814)) Money (. f 'parent_included_capital_gain_distributions)) form-8814s)
          f8814-tax (sum (fn ((f fed/Form8814)) Money (. f 'tax_on_child_income)) form-8814s)
          sched-b (compute-schedule-b tax-year docs)
          tax-exempt-int (total-tax-exempt-interest docs)
          taxable-int (. sched-b 'taxable_interest)
          qual-div (+ (total-qualified-dividends docs) f8814-qual)
          ord-div (+ (. sched-b 'total_ordinary_dividends) f8814-qual)
          ira-gross (compute-total-ira-gross-with-conversions docs retire)
          ira-taxable-prelim (compute-total-ira-taxable-with-form-8606 hh docs retire status #usd"0.00" #usd"0.00")
          pension-gross (total-pensions-and-annuities-gross docs)
          pension-taxable (total-pensions-and-annuities-taxable docs tax-year)
          simplified-pensions (compute-simplified-method-worksheets docs tax-year)
          ; Depreciation: one context for every form. The § 179 business
          ; income limit needs Schedule C figured without § 179 first. Form
          ; 4797 does not depend on the limit (no § 179 on disposed assets).
          all-assets (gather-all-return-assets businesses rentals farms)
          dep-ctx-no-179 (depreciation-context-without-section-179 tax-year all-assets)
          form-8824s (compute-form-8824s hh tax-year inv)
          form-6252s (compute-form-6252s hh tax-year inv)
          f4797-res (compute-form-4797 hh dep-ctx-no-179 docs inv businesses rentals farms prior form-8824s)
          form-7203s (compute-form-7203s hh tax-year docs pts)
          sec179-income (section-179-business-income
                          total-wages
                          (compute-all-schedule-c tax-year hh docs dep-ctx-no-179 businesses)
                          (. f4797-res 'form))
          dep-ctx (apply-section-179-income-limit dep-ctx-no-179 all-assets sec179-income)
          form-4562s (compute-form-4562s hh dep-ctx businesses rentals farms)
          f4797-ord (. f4797-res 'form.total_ordinary_gain_or_loss)
          form-8949s (compute-form-8949 tax-year docs inv status)
          sched-d (compute-schedule-d tax-year docs inv prior status (. f4797-res 'form) (. f4797-res 'unrecaptured_1250_gain) (scorp-basis-capital-gain docs pts) f8814-cap)
          cap-loss-ws (compute-capital-loss-carryover-worksheet prior sched-d)
          line7-cap-gain (form1040-line7-capital-gain-or-loss sched-d)
          ; 2. HSA (Form 8889), Schedule C, Schedule F, Form 2555 Prelim, Schedule SE, Form 7206 / Pub. 974, and Schedule E
          form-8889s (compute-form-8889s tax-year hh docs health p)
          state-refund-ws (compute-state-tax-refund-worksheet docs prior)
          sched-cs (compute-all-schedule-c tax-year hh docs dep-ctx businesses)
          sched-c-net (total-schedule-c-net-profit sched-cs)
          sched-fs (compute-schedule-fs hh tax-year dep-ctx farms)
          ; Schedule F losses of farms without material participation are
          ; passive: MAGI for § 469(i) leaves them out, and Form 8582 limits them.
          farm-passive (compute-farm-passive-totals dep-ctx farms prior)
          sched-f-before-pal (+ (. farm-passive 'nonpassive_net) (. farm-passive 'passive_income))
          form-2555s (compute-form-2555s hh tax-year docs feis)
          feie-excl (form-2555-total-exclusion form-2555s)
          feie-h-ded (form-2555-total-housing-deduction form-2555s)
          sched-ses (compute-all-schedule-se tax-year hh docs businesses sched-cs dep-ctx farms pts status p)
          se-tax (total-schedule-se-tax sched-ses)
          se-tax-ded (total-schedule-se-half-deduction sched-ses)
          se-net-earnings (total-schedule-se-net-earnings sched-ses)
          max-se-health (compute-se-health-insurance-deduction
                          tax-year hh docs businesses sched-cs dep-ctx farms pts sched-ses retire health)
          sep-ded (compute-self-employed-retirement-plans retire)
          other-inc-prelim (compute-schedule-1-other-income-items
                             docs credits form-8889s #usd"0.00" feie-excl f8814-ord)
          sched1-other-prelim (sum (fn ((it fed/Schedule1Item)) Money (. it 'amount)) other-inc-prelim)
          ; 3. Base Adjustments before IRA & Student Loan, Schedule E, and Pub. 974 Iterative SEHI-PTC
          base-adj-without-sehi (+ (compute-educator-expenses adj p)
                                   (round-dollar (. adj 'reservist_artist_official_expenses))
                                   (total-hsa-deduction form-8889s)
                                   (round-dollar (. adj 'military_moving_expenses))
                                   se-tax-ded
                                   sep-ded
                                   (compute-early-withdrawal-penalty docs adj)
                                   (compute-alimony-paid adj)
                                   (round-dollar (. adj 'archer_msa_deduction))
                                   (compute-total-other-adjustments adj)
                                   feie-h-ded)
          base-adj-prelim (+ base-adj-without-sehi max-se-health)
          magi-before-schedule-e (- (+ total-wages
                                       taxable-int
                                       ord-div
                                       ira-taxable-prelim
                                       pension-taxable
                                       line7-cap-gain
                                       (. state-refund-ws 'taxable_refund)
                                       sched-c-net
                                       f4797-ord
                                       sched-f-before-pal
                                       (total-unemployment-compensation docs)
                                       sched1-other-prelim)
                                    base-adj-prelim)
          f8582-res (compute-form-8582
                      hh tax-year docs rentals pts farms prior status magi-before-schedule-e dep-ctx)
          pal-cf (. f8582-res 'carryforward_worksheet)
          ; A passive farm's loss less its Form 8582 unallowed loss.
          sched-f-net (- sched-f-before-pal
                         (- (. farm-passive 'passive_loss)
                            (sum (fn ((f ret/FarmBusiness)) Money
                                   (if (farm-passive? f)
                                       (activity-unallowed-passive-loss pal-cf (. f 'id))
                                       #usd"0.00"))
                                 farms)))
          sched-e (compute-schedule-e
                    tax-year hh docs rentals pts prior dep-ctx pal-cf)
          sched-e-net (. sched-e 'total_supplemental_income_or_loss)
          income-before-nol (+ total-wages
                               taxable-int
                               ord-div
                               ira-taxable-prelim
                               pension-taxable
                               line7-cap-gain
                               (. state-refund-ws 'taxable_refund)
                               sched-c-net
                               f4797-ord
                               sched-e-net
                               sched-f-net
                               (total-unemployment-compensation docs)
                               sched1-other-prelim)
          nol-ded (compute-nol-deduction prior (- income-before-nol base-adj-prelim))
          other-inc-items (compute-schedule-1-other-income-items
                            docs credits form-8889s nol-ded feie-excl f8814-ord)
          sched1-other-inc (sum (fn ((it fed/Schedule1Item)) Money (. it 'amount)) other-inc-items)
          sched1-addl-inc (+ (. state-refund-ws 'taxable_refund)
                             sched-c-net
                             f4797-ord
                             sched-e-net
                             sched-f-net
                             (total-unemployment-compensation docs)
                             sched1-other-inc)
          income-before-ss-prelim (+ total-wages
                                     taxable-int
                                     ord-div
                                     ira-taxable-prelim
                                     pension-taxable
                                     line7-cap-gain
                                     sched1-addl-inc)
          lived-apart (not (. hh 'lived_with_spouse_any_time))
          ss-ws-prelim (compute-ss-benefits-worksheet
                         status lived-apart (. docs 'social_security)
                         income-before-ss-prelim tax-exempt-int base-adj-prelim)
          ss-untaxed-prelim (clamp-zero (- (. ss-ws-prelim 'line_1_total_benefits)
                                           (. ss-ws-prelim 'line_18_taxable_benefits)))
          base-agi-without-sehi (- (+ income-before-ss-prelim (. ss-ws-prelim 'line_18_taxable_benefits))
                                   base-adj-without-sehi)
          se-health-ded (compute-pub974-se-health-deduction
                          tax-year status hh docs max-se-health base-agi-without-sehi
                          tax-exempt-int ss-untaxed-prelim feie-excl)
          base-adj (+ base-adj-without-sehi se-health-ded)
          ; 4. IRA Deduction Worksheet -> Form 8606 -> final SS Benefits Worksheet -> Student Loan Worksheet
          magi-for-ira (clamp-zero (- (+ income-before-ss-prelim (. ss-ws-prelim 'line_18_taxable_benefits))
                                      base-adj))
          net-se-for-earned (clamp-zero (- se-net-earnings (+ se-tax-ded sep-ded se-health-ded)))
          earned-income (clamp-zero (- (+ total-wages net-se-for-earned) feie-excl))
          ira-ws (compute-ira-deduction-worksheet
                   tax-year status hh docs retire magi-for-ira earned-income p)
          ira-taxable (compute-total-ira-taxable-with-form-8606
                        hh docs retire status
                        (. ira-ws 'taxpayer_nondeductible)
                        (. ira-ws 'spouse_nondeductible))
          income-before-ss (+ total-wages
                              taxable-int
                              ord-div
                              ira-taxable
                              pension-taxable
                              line7-cap-gain
                              sched1-addl-inc)
          adj-with-ira (+ base-adj (. ira-ws 'total_ira_deduction))
          ss-ws (compute-ss-benefits-worksheet
                  status lived-apart (. docs 'social_security)
                  income-before-ss tax-exempt-int adj-with-ira)
          ss-gross (. ss-ws 'line_1_total_benefits)
          ss-taxable (. ss-ws 'line_18_taxable_benefits)
          ss-untaxed (clamp-zero (- ss-gross ss-taxable))
          total-income (+ income-before-ss ss-taxable)
          magi-before-sli (clamp-zero (- total-income adj-with-ira))
          sli-ws (compute-student-loan-interest-worksheet
                   status hh docs adj magi-before-sli p)
          sched-1 (compute-schedule-1
                    tax-year docs credits adj retire state-refund-ws form-8889s
                    sched-c-net f4797-ord sched-e-net sched-f-net
                    nol-ded feie-excl f8814-ord
                    se-tax-ded se-health-ded
                    ira-ws sli-ws feie-h-ded p)
          total-adjustments (. sched-1 'total_adjustments)
          agi (- total-income total-adjustments)
          ; 5. Standard Deduction, Form 4684, Form 4952, Schedule A, Schedule 1-A, Form 8995 QBI, and Deduction Election
          form-4684s (compute-form-4684s hh tax-year (. ded 'casualty_losses) agi)
          std-ws (compute-standard-deduction-worksheet
                   hh status earned-income (. ded 'casualty_losses) tax-year p)
          form-4952 (compute-form-4952
                      hh tax-year docs ded taxable-int ord-div qual-div sched-d)
          sched-a-prelim (compute-schedule-a
                           tax-year status docs ded payments prior elections agi
                           (. form-4952 'investment_interest_expense_deduction) p)
          sched-1a (compute-schedule-1a tax-year status hh docs ded agi)
          sched-1a-ded (. sched-1a 'total_additional_deductions)
          form4952-elected (. form-4952 'elected_qualified_dividends_and_capital_gain)
          ; 6. Form 5329, Schedule H, Form 8962 PTC, and Schedule 2 Part II Taxes
          form-5329s (compute-form-5329s
                       tax-year status hh docs retire health agi earned-income p)
          ira-hsa-tax (+ (sum form-5329-total-tax form-5329s)
                         (total-hsa-additional-taxes form-8889s))
          sched-h (compute-schedule-h hh tax-year)
          household-emp-tax (. sched-h 'total_household_employment_taxes)
          ptc-res (compute-form-8962-ptc
                    tax-year status hh docs agi tax-exempt-int ss-untaxed feie-excl)
          net-ptc (. ptc-res 'net_ptc)
          aptc-repay (. ptc-res 'excess_aptc_repayment)
          addl-med-tax (compute-additional-medicare-tax status docs se-net-earnings)
          niit (compute-net-investment-income-tax
                 status agi taxable-int ord-div line7-cap-gain (schedule-e-passive-nii sched-e)
                 (. sched-a-prelim 'investment_interest))
          veh-recapture (compute-clean-vehicle-recapture-tax status credits prior agi)
          sched-2-prelim (compute-schedule-2
                           tax-year #usd"0.00" aptc-repay f8814-tax veh-recapture
                           se-tax ira-hsa-tax household-emp-tax addl-med-tax niit)
          ; 7. Compare Standard vs Itemized Deduction (including QBI under each)
          std-amt (. std-ws 'effective_standard_deduction)
          item-amt (. sched-a-prelim 'total_itemized_deductions)
          ti-before-qbi-std (clamp-zero (- agi (+ std-amt sched-1a-ded)))
          ti-before-qbi-item (clamp-zero (- agi (+ item-amt sched-1a-ded)))
          se-above-line (+ se-tax-ded sep-ded se-health-ded)
          net-cap-gain (+ qual-div
                          (clamp-zero (min (. sched-d 'net_long_term_gain_or_loss)
                                           (. sched-d 'net_gain_or_loss))))
          qbi-std (compute-qbi-deduction
                    tax-year hh docs businesses sched-cs rentals sched-e pts prior
                    status se-above-line ti-before-qbi-std net-cap-gain)
          qbi-item (compute-qbi-deduction
                     tax-year hh docs businesses sched-cs rentals sched-e pts prior
                     status se-above-line ti-before-qbi-item net-cap-gain)
          tax-std (compute-tax-for-deduction-amount
                    tax-year status hh docs credits prior elections agi
                    std-amt qbi-std sched-1a-ded qual-div sched-d form4952-elected
                    earned-income sched-2-prelim #usd"0.00" p)
          tax-item (compute-tax-for-deduction-amount
                     tax-year status hh docs credits prior elections agi
                     item-amt qbi-item sched-1a-ded qual-div sched-d form4952-elected
                     earned-income sched-2-prelim #usd"0.00" p)
          use-itemized (choose-itemized-deduction? hh status elections std-ws sched-a-prelim)
          chosen-ded (if use-itemized item-amt std-amt)
          qbi-ded (if use-itemized qbi-item qbi-std)
          smaller-itemized (and use-itemized (< item-amt std-amt))
          sched-a (proto 'fed/ScheduleA
                    :tax_year tax-year
                    :medical_and_dental_expenses (. sched-a-prelim 'medical_and_dental_expenses)
                    :deductible_medical_and_dental (. sched-a-prelim 'deductible_medical_and_dental)
                    :state_local_income_or_sales_taxes (. sched-a-prelim 'state_local_income_or_sales_taxes)
                    :elected_general_sales_taxes (. sched-a-prelim 'elected_general_sales_taxes)
                    :state_local_real_estate_taxes (. sched-a-prelim 'state_local_real_estate_taxes)
                    :state_local_personal_property_taxes (. sched-a-prelim 'state_local_personal_property_taxes)
                    :total_state_and_local_taxes (. sched-a-prelim 'total_state_and_local_taxes)
                    :state_and_local_taxes_after_cap (. sched-a-prelim 'state_and_local_taxes_after_cap)
                    :other_taxes (. sched-a-prelim 'other_taxes)
                    :total_taxes_paid (. sched-a-prelim 'total_taxes_paid)
                    :mortgage_interest_reported_on_1098 (. sched-a-prelim 'mortgage_interest_reported_on_1098)
                    :mortgage_interest_not_reported_on_1098 (. sched-a-prelim 'mortgage_interest_not_reported_on_1098)
                    :points_not_reported_on_1098 (. sched-a-prelim 'points_not_reported_on_1098)
                    :total_mortgage_interest_and_points (. sched-a-prelim 'total_mortgage_interest_and_points)
                    :investment_interest (. sched-a-prelim 'investment_interest)
                    :total_interest_paid (. sched-a-prelim 'total_interest_paid)
                    :gifts_by_cash_or_check (. sched-a-prelim 'gifts_by_cash_or_check)
                    :gifts_other_than_cash_or_check (. sched-a-prelim 'gifts_other_than_cash_or_check)
                    :charitable_carryover_from_prior_year (. sched-a-prelim 'charitable_carryover_from_prior_year)
                    :total_gifts_to_charity (. sched-a-prelim 'total_gifts_to_charity)
                    :casualty_and_theft_losses (. sched-a-prelim 'casualty_and_theft_losses)
                    :other_itemized_deductions (. sched-a-prelim 'other_itemized_deductions)
                    :total_itemized_deductions item-amt
                    :elected_to_itemize_smaller_total smaller-itemized)
          total-deductions (+ chosen-ded qbi-ded sched-1a-ded)
          taxable-income (clamp-zero (- agi total-deductions))
          ; 8. Tax, QDCGT, Form 2555 Stacking, Schedule J Averaging, Form 8615 Kiddie Tax, Form 6251 AMT, Form 1116 FTC, Credits, Schedule 2 & 3
          has-pref (or (> qual-div #usd"0.00")
                       (> (min (. sched-d 'net_long_term_gain_or_loss)
                               (. sched-d 'net_gain_or_loss))
                          #usd"0.00"))
          qdcgt-ws (compute-qdcgt-worksheet
                     tax-year status taxable-income qual-div sched-d form4952-elected)
          base-line16-tax (if has-pref
                              (. qdcgt-ws 'line_25_tax_on_all_taxable_income)
                              (compute-bracket-tax tax-year status taxable-income))
          feitw (compute-foreign-earned-income-tax-worksheet
                  tax-year status form-2555s taxable-income qual-div sched-d form4952-elected)
          sched-j (compute-schedule-j
                    hh tax-year status prior taxable-income qual-div sched-d form4952-elected)
          form-8615 (compute-form-8615
                      hh tax-year status total-income earned-income taxable-income
                      qual-div sched-d base-line16-tax p)
          line16-tax (tax-on-taxable-income
                       tax-year status taxable-income has-pref qdcgt-ws feitw sched-j form-8615)
          ftc-prelim (. (compute-form-1116
                          hh tax-year status docs credits prior elections total-income chosen-ded
                          taxable-income qdcgt-ws line16-tax)
                        'total_credit)
          amt-cap-gain-adj (compute-amt-capital-gain-adjustment docs inv prior status sched-d)
          form-6251 (compute-form-6251
                      hh tax-year status docs agi total-deductions
                      (. sched-1a 'enhanced_deduction_for_seniors)
                      use-itemized std-amt (. sched-a 'total_taxes_paid)
                      amt-cap-gain-adj (total-amt-depreciation-adjustment dep-ctx all-assets)
                      qual-div sched-d form4952-elected line16-tax
                      (+ aptc-repay f8814-tax veh-recapture) ftc-prelim)
          amt (. form-6251 'alternative_minimum_tax)
          sched-2 (compute-schedule-2
                    tax-year amt aptc-repay f8814-tax veh-recapture
                    se-tax ira-hsa-tax household-emp-tax addl-med-tax niit)
          line17-sched2 (. sched-2 'total_part_one)
          line18-tax-plus-addl (+ line16-tax line17-sched2)
          f1116-res (compute-form-1116
                      hh tax-year status docs credits prior elections total-income chosen-ded
                      taxable-income qdcgt-ws line18-tax-plus-addl)
          ftc (. f1116-res 'total_credit)
          rem-after-ftc (clamp-zero (- line18-tax-plus-addl ftc))
          care-credit (compute-dependent-care-credit
                        tax-year status hh docs businesses sched-cs pts
                        (. credits 'dependent_care) agi rem-after-ftc p)
          rem-after-care (clamp-zero (- rem-after-ftc care-credit))
          edu-res (compute-education-credits
                    tax-year status hh docs credits agi rem-after-care)
          edu-nonref (. edu-res 'nonrefundable_credit)
          rem-after-edu (clamp-zero (- rem-after-care edu-nonref))
          savers-credit (compute-savers-credit
                          tax-year status hh docs retire agi rem-after-edu)
          rem-after-savers (clamp-zero (- rem-after-edu savers-credit))
          home-imp-credit (compute-home-improvement-credit credits rem-after-savers)
          rem-after-home-imp (clamp-zero (- rem-after-savers home-imp-credit))
          clean-energy-credit (compute-clean-energy-credit credits rem-after-home-imp)
          rem-after-energy (clamp-zero (- rem-after-home-imp clean-energy-credit))
          ; Form 8801 line 22: regular tax less the credits taken before
          ; the minimum tax credit.
          form-8801 (compute-form-8801
                      hh tax-year status prior
                      (- rem-after-energy
                         (+ amt
                            (compute-clean-vehicle-nonref-credit status credits prior agi)
                            (compute-adoption-credit tax-year status credits agi)))
                      (. form-6251 'tentative_minimum_tax))
          other-nonref-credit (compute-other-nonrefundable-credits
                                tax-year status credits prior agi
                                (. form-8801 'minimum_tax_credit) rem-after-energy)
          sched-3 (compute-schedule-3
                    tax-year hh docs payments ftc
                    care-credit edu-nonref savers-credit
                    clean-energy-credit home-imp-credit other-nonref-credit
                    net-ptc p)
          line20-sched3 (. sched-3 'total_nonrefundable_credits)
          ctc-res (compute-ctc-odc-actc
                    tax-year status hh agi earned-income
                    (clamp-zero (- line18-tax-plus-addl line20-sched3))
                    p)
          line19-ctc (. ctc-res 'nonrefundable_ctc_and_odc)
          line21-total-credits (+ line19-ctc line20-sched3)
          line22-tax-after-credits (clamp-zero (- line18-tax-plus-addl line21-total-credits))
          line23-other-taxes (. sched-2 'total_part_two)
          line24-total-tax (+ line22-tax-after-credits line23-other-taxes)
          ; 9. Payments, Refund / Amount Owed, and Form 2210 Estimated Tax Penalty
          line25a (compute-withheld-from-w2 docs)
          line25b (compute-withheld-from-1099 docs)
          line25c (compute-withheld-from-other-forms hh docs payments)
          line25d (+ line25a line25b line25c)
          line26-est (compute-federal-estimated-payments payments tax-year)
          inv-inc-for-eic (+ taxable-int
                             tax-exempt-int
                             ord-div
                             (clamp-zero line7-cap-gain)
                             (clamp-zero (schedule-e-passive-nii sched-e)))
          line27-eic (compute-earned-income-credit
                       tax-year status hh credits agi earned-income inv-inc-for-eic)
          line28-actc (. ctc-res 'additional_child_tax_credit)
          line29-aotc (. edu-res 'refundable_aotc)
          line31-sched3 (. sched-3 'total_refundable_credits_and_payments)
          line32-other-pay (+ line26-est line27-eic line28-actc line29-aotc line31-sched3)
          line33-total-pay (+ line25d line32-other-pay)
          overpaid-before-penalty (clamp-zero (- line33-total-pay line24-total-tax))
          owed-before-penalty (clamp-zero (- line24-total-tax line33-total-pay))
          refundable-credits-for-2210 (+ line27-eic
                                         line28-actc
                                         line29-aotc
                                         net-ptc
                                         (round-dollar (. payments 'credit_for_federal_tax_on_fuels)))
          f2210-res (compute-form-2210
                      hh tax-year status payments prior std-amt sched-1a-ded
                      line21-total-credits line22-tax-after-credits line23-other-taxes
                      se-tax
                      (sum (fn ((s fed/ScheduleSE)) Money (. s 'social_security_wages_and_tips)) sched-ses)
                      (. p 'oasdi_wage_base)
                      line25d refundable-credits-for-2210)
          est-penalty (. f2210-res 'penalty)
          ; Line 38's penalty comes off line 34's overpayment, or is added
          ; to line 37.
          overpaid (clamp-zero (- overpaid-before-penalty est-penalty))
          amount-owed (+ owed-before-penalty (clamp-zero (- est-penalty overpaid-before-penalty)))
          ; 10. Assemble Form 1040, Workpapers, Summary, AmendmentResult, and FederalReturn
          form-1040 (fed-form-1040
                      tax-year p status fed-in form-8814s sched-b ira-taxable adj-with-ira sched-d
                      sched-1 sched-1a sched-a use-itemized qbi-ded has-pref form4952-elected
                      feitw sched-j form-8615 sched-2 sched-3 earned-income inv-inc-for-eic
                      edu-res est-penalty)
          eff-rate (if (> total-income #usd"0.00")
                       (round-rate4 (/ line24-total-tax total-income))
                       0.0000)
          marg-rate (marginal-ordinary-rate tax-year status taxable-income)
          fed-summary (proto 'ret/Summary
                        :jurisdiction "US"
                        :filing_status status
                        :total_income total-income
                        :adjusted_gross_income agi
                        :total_deductions total-deductions
                        :taxable_income taxable-income
                        :total_tax line24-total-tax
                        :total_payments_and_refundable_credits line33-total-pay
                        :refund overpaid
                        :amount_owed amount-owed
                        :effective_tax_rate eff-rate
                        :marginal_ordinary_rate marg-rate)
          fed-forms (proto 'facts/FederalReturn
                      :form_1040 form-1040
                      :schedule_1 sched-1
                      :schedule_1a sched-1a
                      :schedule_2 sched-2
                      :schedule_3 sched-3
                      :schedule_a sched-a
                      :schedule_b sched-b
                      :schedule_c sched-cs
                      :schedule_d sched-d
                      :schedule_e sched-e
                      :schedule_se sched-ses
                      :form_8949 form-8949s
                      :form_4562 form-4562s
                      :form_4797 (if (. f4797-res 'filed) (. f4797-res 'form) nil)
                      :form_6252 form-6252s
                      :form_8824 form-8824s
                      ; Form 6251 when there is AMT, when line 7 exceeds line 10, or
                      ; when any adjustment or preference is figured.
                      :form_6251 (if (or (> amt #usd"0.00")
                                         (> (. form-6251 'tentative_minimum_tax_before_ftc)
                                            (. form-6251 'regular_tax_for_amt_comparison))
                                         (!= (. form-6251 'private_activity_bond_interest) #usd"0.00")
                                         (!= (. form-6251 'disposition_of_property_adjustment) #usd"0.00")
                                         (!= (. form-6251 'post_1986_depreciation_adjustment) #usd"0.00"))
                                     form-6251
                                     nil)
                      :form_8801 (if (> (. form-8801 'total_available_minimum_tax_credit) #usd"0.00")
                                     form-8801
                                     nil)
                      :form_8582 (if (. f8582-res 'filed) (. f8582-res 'form) nil)
                      :form_7203 form-7203s
                      :form_4952 (if (> (. form-4952 'total_investment_interest_expense) #usd"0.00")
                                     form-4952
                                     nil)
                      :form_1116 (. f1116-res 'forms)
                      :form_2555 form-2555s
                      :schedule_f sched-fs
                      :schedule_h (if (> (. sched-h 'tax_year) 0) sched-h nil)
                      :schedule_j (if (> (. sched-j 'elected_farm_income) #usd"0.00") sched-j nil)
                      :form_5329 form-5329s
                      :form_8615 (if (> (. form-8615 'net_unearned_income) #usd"0.00") form-8615 nil)
                      :form_8814 form-8814s
                      :form_4684 form-4684s
                      :form_2210 (if (. f2210-res 'filed) (. f2210-res 'form) nil))
          workpapers (proto 'ret/FederalWorkpapers
                       :qdcgt qdcgt-ws
                       :ss_benefits ss-ws
                       :capital_loss_carryover cap-loss-ws
                       :standard_deduction std-ws
                       :ira_deduction ira-ws
                       :student_loan_interest sli-ws
                       :state_tax_refund state-refund-ws
                       :simplified_method_pensions simplified-pensions
                       :section_1231_lookback (. f4797-res 'lookback_worksheet)
                       :passive_loss_carryforward (. f8582-res 'carryforward_worksheet)
                       :foreign_tax_credit_carryforward (. f1116-res 'carryforward)
                       :foreign_earned_income_tax feitw)
          ded-election (build-deduction-resolved-election
                         elections use-itemized std-amt item-amt tax-std tax-item)
          transcribed-w2s (map (fn ((w ret/W2Document)) fed/FormW2 (. w 'form))
                               (. docs 'w2s))
          amend-res (compute-federal-amendment-result (. inputs 'amendment) form-1040))
    (proto 'ret/FederalReturn
      :status 'ret/RETURN_STATUS_COMPLETE
      :summary fed-summary
      :elections [ded-election]
      :amendment amend-res
      :forms fed-forms
      :form_8889s form-8889s
      :w2s transcribed-w2s
      :workpapers workpapers)))

(def prepare-return ((inputs ret/ReturnInputs)) ret/ReturnOutputs
  :cite ("26 U.S.C. Subtitle A, Chapter 1")
  (withs (tax-year (if (> (. inputs 'tax_year) 0) (. inputs 'tax_year) 2025)
          p (year-params tax-year)
          fed-ret (prepare-federal-return inputs)
          fed-sum (. fed-ret 'summary)
          state-rets (prepare-state-returns inputs fed-ret tax-year)
          state-sums (map state-return-summary state-rets)
          total-tax (+ (. fed-sum 'total_tax)
                       (sum (fn ((s ret/Summary)) Money (. s 'total_tax)) state-sums))
          total-payments (+ (. fed-sum 'total_payments_and_refundable_credits)
                            (sum (fn ((s ret/Summary)) Money (. s 'total_payments_and_refundable_credits)) state-sums))
          refunds (+ (. fed-sum 'refund)
                     (sum (fn ((s ret/Summary)) Money (. s 'refund)) state-sums))
          owed (+ (. fed-sum 'amount_owed)
                  (sum (fn ((s ret/Summary)) Money (. s 'amount_owed)) state-sums))
          total-income (. fed-sum 'total_income)
          rv (proto 'ret/RulesVersion
               :tax_year tax-year
               :version (rules-version tax-year)
               :status (rules-status tax-year)
               :published_on (proto 'common/Date :year tax-year :month 1 :day 1))
          hdr (proto 'ret/Header
                :tax_year tax-year
                :rules_version rv)
          hh-sum (proto 'ret/HouseholdSummary
                   :combined_total_tax total-tax
                   :combined_total_payments total-payments
                   :combined_refunds refunds
                   :combined_amounts_owed owed
                   :net_refund_or_owed (- refunds owed)
                   :combined_effective_tax_rate (if (> total-income #usd"0.00")
                                                    (round-rate4 (/ total-tax total-income))
                                                    0.0000)))
    (proto 'ret/ReturnOutputs
      :header hdr
      :federal fed-ret
      :states state-rets
      :summary hh-sum)))

; The summary of a prepared state return, whichever state it is.
(def state-return-summary ((s ret/StateReturn)) ret/Summary
  (cond
    ((has? s 'ca) (. s 'ca.summary))
    ((has? s 'or) (. s 'or.summary))
    ((has? s 'wa) (. s 'wa.summary))
    (else (. s 'unsupported.summary))))
