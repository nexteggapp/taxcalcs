# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Washington tax computation to the printed 2025 capital gains excise tax rates.
# Each status runs as a parallel subtest with its own engine.
go_test(
    name = "wa_test",
    size = "large",
    srcs = ["wa_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
        "//taxprotosgo:common_go_proto",
        "//taxprotosgo:form_1099_b_go_proto",
    ],
)
