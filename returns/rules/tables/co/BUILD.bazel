# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Colorado tax computation to the printed 2025 Colorado Income Tax
# Table and the worksheet beneath it for income over $50,000. Each status runs
# as a parallel subtest with its own engine.
go_test(
    name = "co_test",
    size = "large",
    srcs = ["co_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
