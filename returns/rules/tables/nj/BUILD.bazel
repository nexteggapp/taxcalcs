# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the New Jersey tax computation to the 2025 Tax Table and Tax Rate
# Schedules printed in the Form NJ-1040 instructions. Each status runs as a
# parallel subtest with its own engine.
go_test(
    name = "nj_test",
    size = "medium",
    srcs = ["nj_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
