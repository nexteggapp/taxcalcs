# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the North Dakota tax computation to the 2025 Tax Table and Tax Rate
# Schedules printed in the individual income tax booklet. Each status runs as
# a parallel subtest with its own engine.
go_test(
    name = "nd_test",
    size = "medium",
    srcs = ["nd_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
