# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Virginia tax computation to the printed 2025 tax table and tax rate schedule.
# Each status runs as a parallel subtest with its own engine.
go_test(
    name = "va_test",
    size = "large",
    srcs = ["va_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
        "//taxprotosgo:common_go_proto",
    ],
)
