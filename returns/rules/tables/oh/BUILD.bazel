# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Ohio tax computation to the printed 2025 income tax brackets. Each
# status runs as a parallel subtest with its own engine.
go_test(
    name = "oh_test",
    size = "large",
    srcs = ["oh_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
