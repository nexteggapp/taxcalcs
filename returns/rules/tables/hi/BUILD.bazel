# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Hawaii tax computation to the printed 2025 Tax Table and Tax Rate
# Schedules in the Form N-11 instructions. Each status runs as a parallel
# subtest with its own engine.
go_test(
    name = "hi_test",
    size = "medium",
    srcs = ["hi_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
