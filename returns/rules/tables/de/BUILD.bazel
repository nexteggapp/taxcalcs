# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Delaware tax computation to the printed 2025 State Income Tax
# Table and the schedule for income of $60,000 or more. Each status runs as a
# parallel subtest with its own engine.
go_test(
    name = "de_test",
    size = "large",
    srcs = ["de_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
