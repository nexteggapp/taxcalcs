# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Oklahoma tax computation to the printed 2025 tax table and worksheets. Each
# status runs as a parallel subtest with its own engine.
go_test(
    name = "ok_test",
    size = "large",
    srcs = ["ok_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
