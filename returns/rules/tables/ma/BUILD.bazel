# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Massachusetts tax computation to the 2025 tax table, the 5.0%
# rate and the 4% surtax printed in the Form 1 instructions. Each status runs
# as a parallel subtest with its own engine.
go_test(
    name = "ma_test",
    size = "small",
    srcs = ["ma_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
        "//taxprotosgo:ma_form_1_go_proto",
    ],
)
