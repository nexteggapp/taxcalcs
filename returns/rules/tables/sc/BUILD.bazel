# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the South Carolina tax computation to the printed 2025 tax tables and tax rate schedule.
# Each status runs as a parallel subtest with its own engine.
go_test(
    name = "sc_test",
    size = "medium",
    srcs = ["sc_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
