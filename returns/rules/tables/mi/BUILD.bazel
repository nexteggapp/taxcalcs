# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Michigan tax computation to the flat rate printed on the 2025
# Form MI-1040. Each status runs as a parallel subtest with its own engine.
go_test(
    name = "mi_test",
    size = "small",
    srcs = ["mi_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
