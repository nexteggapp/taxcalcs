# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Vermont tax computation to the printed 2025 tax tables and tax rate schedules.
# Each status runs as a parallel subtest with its own engine.
go_test(
    name = "vt_test",
    size = "large",
    srcs = ["vt_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
