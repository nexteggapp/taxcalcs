# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Missouri tax computation to the 2025 Tax Chart printed in the
# Form MO-1040 instructions. Each status runs as a parallel subtest
# with its own engine.
go_test(
    name = "mo_test",
    size = "small",
    srcs = ["mo_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
        "//taxprotosgo:common_go_proto",
    ],
)
