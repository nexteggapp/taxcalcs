# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Kansas tax computation to the printed 2025 Kansas Tax Table and Tax
# Computation Worksheet in the Form K-40 instructions. Each status runs as a parallel
# subtest with its own engine.
go_test(
    name = "ks_test",
    size = "large",
    srcs = ["ks_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
