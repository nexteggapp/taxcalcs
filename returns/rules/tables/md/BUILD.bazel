# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Maryland state tax computation to the 2025 Maryland Tax Table and
# tax computation worksheet schedules. Each status runs as a parallel subtest
# with its own engine.
go_test(
    name = "md_test",
    size = "medium",
    srcs = ["md_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
        "//taxprotosgo:common_go_proto",
    ],
)
