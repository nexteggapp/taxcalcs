# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Montana tax computation to the 2025 Ordinary Income Tax Rates
# printed in the Form 2 instructions. Each status runs as a parallel subtest
# with its own engine.
go_test(
    name = "mt_test",
    size = "small",
    srcs = ["mt_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
