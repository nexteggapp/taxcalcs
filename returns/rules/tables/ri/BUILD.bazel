# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Rhode Island tax computation to the printed 2025 tax table and tax computation worksheet.
# Each status runs as a parallel subtest with its own engine.
go_test(
    name = "ri_test",
    size = "medium",
    srcs = ["ri_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
