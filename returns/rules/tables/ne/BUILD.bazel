# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Nebraska tax computation to the printed 2025 Tax Calculation
# Schedule, Tax Table and the worksheet above the table. Each status runs as
# a parallel subtest with its own engine.
go_test(
    name = "ne_test",
    size = "large",
    srcs = ["ne_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
