# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the California tax computation to the printed 2025 California Tax
# Table and Tax Rate Schedules. Each status runs as a parallel subtest with
# its own engine.
go_test(
    name = "ca_test",
    size = "large",
    srcs = ["ca_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//returns/v1",
    ],
)
