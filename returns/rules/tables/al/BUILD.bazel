# gazelle:ignore

load("@rules_go//go:def.bzl", "go_test")

# Holds the Alabama tax computation to the printed 2025 Form 40 Tax Table and
# its worksheet for taxable income over $100,000. Each status runs as a
# parallel subtest with its own engine.
go_test(
    name = "al_test",
    size = "small",
    srcs = ["al_test.go"],
    data = [
        "//sources/pdfs",
        "//sources/tables",
    ],
    deps = [
        "//returns/rules/federal",
        "//returns/rules/tables/tablefile",
        "//taxlisp/eval",
    ],
)
