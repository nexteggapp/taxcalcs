; West Virginia published figures for each tax year this build carries, from
; the 2025 Form IT-140 booklet. Sources are catalogued under
; sources/catalog/wv/2025.

(defstruct WestVirginiaYear
  (tax_year Int)
  ; W. Va. Code § 11-21-16: $2,000 for each exemption, $500 when there are none.
  (exemption Money)
  (no_exemption_allowance Money)
  ; W. Va. Code § 11-21-10: the low-income earned income exclusion, and the
  ; federal AGI above which it is not allowed.
  (low_income_limit Money)
  (low_income_limit_separate Money)
  ; W. Va. Code § 11-21-12: Social Security benefits are subtracted in full
  ; up to these federal AGI limits, and at the partial rate above them.
  (social_security_limit_single Money)
  (social_security_limit_joint Money)
  (social_security_partial_bp Int)
  ; W. Va. Code § 11-21-12: the senior citizen or disability modification,
  ; at most this much for each eligible person.
  (senior_modification_max Money)
  ; The Tax Table is used below this taxable income.
  (tax_table_limit Money))

; West Virginia's 2025 figures.
(deffigures wv-year-2025 WestVirginiaYear 2025
  (from wv-tax-it-140-booklet-2025
    (exemption                     #usd"2000.00"   :at exemptions-instructions)
    (no_exemption_allowance        #usd"500.00"    :at exemptions-instructions)
    (low_income_limit              #usd"10000.00"  :at low-income-exclusion-worksheet)
    (low_income_limit_separate     #usd"5000.00"   :at low-income-exclusion-worksheet)
    (social_security_limit_single  #usd"50000.00"  :at line-34-instructions)
    (social_security_limit_joint   #usd"100000.00" :at line-34-instructions)
    (social_security_partial_bp    6500            :at line-34-instructions)
    (senior_modification_max       #usd"8000.00"   :at line-47)
    (tax_table_limit               #usd"100000.00" :at tax-table)))

; W. Va. Code § 11-21-4i, Rate Schedule I: single, head of household, married
; filing jointly, and widow(er) with dependent child.
(deffigure wv-schedule-i-2025 (Slice StateBracket) 2025
  :src wv-tax-it-140-booklet-2025 :at rate-schedules
  [(StateBracket #usd"0.00"     #usd"10000.00"      222)
   (StateBracket #usd"10000.00" #usd"25000.00"      296)
   (StateBracket #usd"25000.00" #usd"40000.00"      333)
   (StateBracket #usd"40000.00" #usd"60000.00"      444)
   (StateBracket #usd"60000.00" #usd"9999999999.00" 482)])

; W. Va. Code § 11-21-4i, Rate Schedule II: married filing separately.
(deffigure wv-schedule-ii-2025 (Slice StateBracket) 2025
  :src wv-tax-it-140-booklet-2025 :at rate-schedules
  [(StateBracket #usd"0.00"     #usd"5000.00"       222)
   (StateBracket #usd"5000.00"  #usd"12500.00"      296)
   (StateBracket #usd"12500.00" #usd"20000.00"      333)
   (StateBracket #usd"20000.00" #usd"30000.00"      444)
   (StateBracket #usd"30000.00" #usd"9999999999.00" 482)])

; Whether West Virginia published figures cover this year.
(def wv-has-year? ((tax-year Int)) Bool
  :cite ((law "W. Va. Code" "11-21-3"))
  (is tax-year 2025))

; West Virginia figures for the year.
(def wv-year ((tax-year Int)) WestVirginiaYear
  :cite ((law "W. Va. Code" "11-21-3"))
  wv-year-2025)

; The rate schedule for a filing status: Schedule II for married filing
; separately, Schedule I for everyone else.
(def wv-schedule ((status fed/FilingStatus)) (Slice StateBracket)
  :cite ((law "W. Va. Code" "11-21-4i"))
  (if (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
      wv-schedule-ii-2025
      wv-schedule-i-2025))

; The mapping from federal filing status to Form IT-140 filing status.
(= wv-filing-statuses (Table fed/FilingStatus wvit140/FilingStatus)
  (table
    'fed/FILING_STATUS_SINGLE 'wvit140/FILING_STATUS_SINGLE
    'fed/FILING_STATUS_MARRIED_FILING_JOINTLY 'wvit140/FILING_STATUS_MARRIED_FILING_JOINTLY
    'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY 'wvit140/FILING_STATUS_MARRIED_FILING_SEPARATELY
    'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD 'wvit140/FILING_STATUS_HEAD_OF_HOUSEHOLD
    'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE 'wvit140/FILING_STATUS_WIDOW_WITH_DEPENDENT_CHILD))
