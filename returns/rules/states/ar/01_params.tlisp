; Look up Arkansas published figures for the given tax year.
(def ar-year ((tax-year Int)) ArkansasYear
  :cite ((law "Ark. Code Ann." "26-51-201"))
  ar-year-2025)

; Whether Arkansas rules are built for the given tax year.
(def ar-has-year? ((tax-year Int)) Bool
  :cite ((law "Ark. Code Ann." "26-51-201"))
  (is tax-year 2025))

(= ar-filing-statuses (Table fed/FilingStatus ar1000f/FilingStatus)
  (table
    'fed/FILING_STATUS_SINGLE 'ar1000f/FILING_STATUS_SINGLE
    'fed/FILING_STATUS_MARRIED_FILING_JOINTLY 'ar1000f/FILING_STATUS_MARRIED_FILING_JOINTLY
    'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY 'ar1000f/FILING_STATUS_MARRIED_FILING_SEPARATELY_DIFFERENT_RETURNS
    'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD 'ar1000f/FILING_STATUS_HEAD_OF_HOUSEHOLD
    'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE 'ar1000f/FILING_STATUS_SURVIVING_SPOUSE))
