; Arkansas published figures for each tax year this build carries.
; Figures are from the Form AR1000F and AR1000NR instructions.
;
; Sources are catalogued under sources/catalog/ar/2025.

(defstruct ArkansasYear
  (tax_year Int)
  ; Ark. Code Ann. 26-51-430: standard deduction for each filer
  (standard_deduction Money)
  ; Ark. Code Ann. 26-51-501: personal tax credit for each box and dependent
  (personal_credit Money)
  ; Ark. Code Ann. 26-51-307: exclusion of retirement income for each person
  (retirement_exclusion Money)
  ; Ark. Code Ann. 26-51-201: the rate above the regular table
  (top_rate_bp Int)
  ; The regular table's last row: the tax at its top, which the rate applies
  ; above
  (table_ceiling Money)
  (table_ceiling_tax Money))

; Arkansas published figures for 2025.
(deffigures ar-year-2025 ArkansasYear 2025
  (from ar-dfa-form-ar1000f-instructions-2025
    (standard_deduction    #usd"2470.00"    :at line-27)
    (personal_credit       #usd"29.00"      :at line-7a)
    (retirement_exclusion  #usd"6000.00"    :at line-18a)
    (top_rate_bp           390              :at regular-tax-table)
    (table_ceiling         #usd"100000.00"  :at regular-tax-table)
    (table_ceiling_tax     #usd"3809.00"    :at regular-tax-table)))

; One row of the regular income tax table: net taxable income from floor up
; to the next row's floor is taxed at tax.
(defstruct ArkansasTaxRow
  (floor Money)
  (tax Money))

; The 2025 Regular Income Tax Table, every row as printed, up to $100,000.
; Generated from the text of the instructions' pages 26 to 30.
(deffigure ar-regular-table-2025 (Slice ArkansasTaxRow) 2025
