           ((has? s 'wv)
            (proto 'ret/StateReturn
              :state "WV"
              :wv (prepare-west-virginia-return inputs (. s 'wv) fed-ret tax-year)))
           ; END GENERATED (dispatch)
           ((or (has? s 'wa) (is (. s 'state) "WA"))
            (proto 'ret/StateReturn
              :state "WA"
              :wa (prepare-washington-return inputs
                    (if (has? s 'wa) (. s 'wa) (proto 'ret/WashingtonInputs))
                    fed-ret tax-year)))
           ((no-income-tax-state? (. s 'state))
            (proto 'ret/StateReturn
              :state (. s 'state)
              :no_income_tax (prepare-no-income-tax-return (. s 'state) fed-ret)))
           (else
            (proto 'ret/StateReturn
              :state (. s 'state)
              :unsupported (proto 'ret/UnsupportedStateReturn
                             :status 'ret/RETURN_STATUS_INCOMPLETE
                             :diagnostics [(state-diagnostic
                                             "STATE_UNSUPPORTED"
                                             'ret/SEVERITY_WARNING
                                             (join-words ["No return rules are built for" (. s 'state) "yet."])
                                             "taxcalcs")])))))
       (. inputs 'states)))

; One state's estimated tax answer, by its rules: the dispatch from a postal
; code to the rule in the state's NN_estimated.tlisp. A state whose rules
; haven't landed is answered ESTIMATED_OUTCOME_UNSUPPORTED.
(def state-estimated-answer ((inputs ret/ReturnInputs) (jurisdiction String)) ret/EstimatedAnswer
  :cite ()
  (cond
    ; BEGIN GENERATED (estimated-dispatch) by tools/stategen from returns/rules/states/<st>/NN_estimated.tlisp: do not edit.
    ((is jurisdiction "AL") (alabama-estimated-answer inputs))
    ((is jurisdiction "AZ") (arizona-estimated-answer inputs))
    ((is jurisdiction "CO") (colorado-estimated-answer inputs))
    ((is jurisdiction "IA") (iowa-estimated-answer inputs))
    ((is jurisdiction "KS") (kansas-estimated-answer inputs))
    ((is jurisdiction "KY") (kentucky-estimated-answer inputs))
    ((is jurisdiction "MN") (minnesota-estimated-answer inputs))
    ((is jurisdiction "MT") (montana-estimated-answer inputs))
    ((is jurisdiction "NC") (north-carolina-estimated-answer inputs))
    ((is jurisdiction "NE") (nebraska-estimated-answer inputs))
    ((is jurisdiction "NM") (new-mexico-estimated-answer inputs))
    ((is jurisdiction "OK") (oklahoma-estimated-answer inputs))
    ((is jurisdiction "OR") (oregon-estimated-answer inputs))
    ((is jurisdiction "RI") (rhode-island-estimated-answer inputs))
    ((is jurisdiction "SC") (south-carolina-estimated-answer inputs))
    ((is jurisdiction "WV") (west-virginia-estimated-answer inputs))
    ; END GENERATED (estimated-dispatch)
    (else (estimated-unsupported jurisdiction))))
