; Alabama's estimated tax: Code of Ala. § 40-18-80, which adopts 26 U.S.C.
; § 6654 with a $500 threshold in place of $1,000, worked through on Form
; 2210AL, which follows federal Form 2210 line for line. It is written on the
; shared machinery in returns/rules/federal/10_estimated_lib.tlisp and
; reproduces the Go rules in the removed alabamataxcalc, whose answers
; golden/testdata/estimated/AL.json.gz holds.
;
; The figures follow the Department of Revenue's forms: the 2026 Form 40ES
; and the 2025 Form 2210AL, the latest penalty form. Those forms leave out
; three rules § 6654 grants and give a late starter a schedule § 6654 does
; not; the answer's divergences say where. A year with no figures is answered
; ESTIMATED_OUTCOME_NO_RULES.

; One tax year's figures, as the 2026 Form 40ES instructions and the
; Department of Revenue's rates page print them.
(defstruct AlabamaEstimatedYear
  (tax_year Int)
  ; § 6654(e)(1) as § 40-18-80(a)(2) amends it: no penalty when tax less
  ; withholding is under it.
  (threshold Money)
  ; § 6654(d)(1)(B) and (C): 90% of this year's tax, 100% of last year's,
  ; and 110% of last year's above the AGI step, in basis points.
  (this_year_rate Int)
  (last_year_rate Int)
  (high_income_rate Int)
  ; Last year's Alabama AGI above which the 110% applies, and the step for
  ; married filing separately.
  (high_income_agi Money)
  (high_income_agi_separate Money)
  ; The four due dates, before moving.
  (due_dates (Slice Date))
  ; The first days of the Form 40ES schedule's second, third and fourth
  ; rows: a requirement first met on or after the nth of them starts, on
  ; that schedule, at instalment n + 1.
  (late_groups (Slice Date))
  ; The department's rate, quarter by quarter, as far as it is published, in
  ; millionths.
  (rates (Slice EstRate)))

; The 2026 figures. The first quarter of 2026 is left out because no 2026
; underpayment runs before April 16, and the rate from January 1, 2027 isn't
; published: the rates end on December 31, 2026, and the penalty says so.
(deffigures al-estimated-2026 AlabamaEstimatedYear 2026
  (from al-dor-form-40es-instructions-2026
    (threshold #usd"500.00" :at general-rule)
    (this_year_rate 9000 :at general-rule)
    (last_year_rate 10000 :at general-rule)
    (high_income_rate 11000 :at higher-income)
    (high_income_agi #usd"150000.00" :at higher-income)
    (high_income_agi_separate #usd"75000.00" :at higher-income)
    (due_dates [#date"2026-04-15" #date"2026-06-15" #date"2026-09-15" #date"2027-01-15"]
               :at payment-of-estimated-tax)
    (late_groups [#date"2026-04-02" #date"2026-06-02" #date"2026-09-02"] :at changes-in-tax))
  (from al-dor-quarterly-interest-rates-2026
    (rates [(EstRate #date"2026-04-01" #date"2026-06-30" 60000 "ADOR, Quarterly Interest Rates: 2026, 2nd quarter")
            (EstRate #date"2026-07-01" #date"2026-09-30" 70000 "ADOR, Quarterly Interest Rates: 2026, 3rd quarter")
            (EstRate #date"2026-10-01" #date"2026-12-31" 70000 "ADOR, Quarterly Interest Rates: 2026, 4th quarter")]
           :at rates-2026)))

; A tax year's rules: its figures, and what the penalty form and the statute
; give it.
(defstruct AlabamaEstimatedRules
  (figures AlabamaEstimatedYear)
  ; Form 2210AL Part III line 1: each instalment's share of the required
  ; annual payment, and the share of the year's withholding counted on each
  ; due date, in basis points.
  (shares (Slice Int))
  ; Form 2210AL Schedule AI: the period ends and line 17's applicable
  ; percentages.
  (period_ends (Slice Date))
  (annualised_shares (Slice Int))
  ; § 6654(h)'s January 31, which no Alabama form prints.
  (file_and_pay_by Date)
  ; Form 2210AL Part III line 11: the penalty runs no later than April 15 of
  ; the next year.
  (stop Date)
  ; The one rate Form 2210AL line 11 prints for every day.
  (form_rate Int)
  (explanation ret/EstimatedExplanation))

; How Alabama's estimated tax works, written by hand for the years these
; rules carry.
(= al-estimated-explanation ret/EstimatedExplanation
  (est-explanation
    "Alabama uses the federal estimated tax rules, with a $500 threshold, not $1,000. The penalty is interest on each quarter's shortfall."
    ["Withholding and estimated payments avoid the penalty if they reach a target. The target is the smaller of 90% of this year's tax or 100% of last year's. The second is 110% if last year's Alabama AGI was over $150,000. The AGI limit is $75,000 for married filing separately. Last year's figure is open only if you filed a return for a full twelve months. There is no penalty if this year's tax less withholding is under $500."
     "Pay a quarter each by April 15, June 15, September 15 and the next January 15. A date on a Saturday, Sunday or State holiday shifts to the next business day. Withholding counts as paid evenly on the four dates. You can instead show when it was actually withheld. The department sends no record of your payments, so keep your own."
     "The penalty is interest on each shortfall for the days it stays unpaid. The department's rate follows the federal underpayment rate each quarter. Interest stops on April 15 of the next year. A payment goes first to the oldest shortfall. The 2025 penalty form prints 7% for the whole year. For 2026 the rate is 6% from April to June and 7% after. If income came unevenly, Schedule AI's annualised method can cut early payments. The department can waive the penalty for a casualty or disaster. It can also do so for retirement after 62 or disability, with reasonable cause."
     "By adopting the federal rules, the statute grants two things the forms omit. The January payment has no penalty if you file and pay in full by January 31. There is no penalty after a full year with no Alabama tax liability. The department's forms apply neither. If you first need to pay after April 1, Form 40ES says a third by June 15. After June 1 it says half by September 15. The penalty form still charges a quarter by every date."]
    "Alabama's threshold is $500 rather than $1,000, the federal figure. The 110% test reads last year's Alabama AGI. Alabama's State holidays move a due date. The forms charge the January payment even if you file and pay by January 31. They also charge someone who had no tax last year. The statute excuses both."
    ["Code of Ala. §§ 40-18-80, 40-1-44 and 1-3-8; 26 U.S.C. § 6654"
     "Form 40ES and its instructions, 2026"
     "Form 2210AL and its instructions, 2025"
     "Alabama Department of Revenue, Quarterly Interest Rates"]))

; The 2026 rules. The 2026 Form 2210AL is not published, so its figures are
; the 2025 form's, with the 2026 dates: the 25% instalments, the Schedule AI
; periods and percentages, the April 15 stop and the 7% the form prints. A
; figure's source must be for its year, so these are written out rather than
; deffigures. No State holiday is listed: the four 2026 due dates are
; weekdays, and none is a State holiday under Code of Ala. § 1-3-8.
(= al-estimated-rules-2026 AlabamaEstimatedRules
  (make-struct AlabamaEstimatedRules
    :figures al-estimated-2026
    :shares [2500 2500 2500 2500]
    :period_ends [#date"2026-03-31" #date"2026-05-31" #date"2026-08-31" #date"2026-12-31"]
    :annualised_shares [2250 4500 6750 9000]
    :file_and_pay_by #date"2027-01-31"
    :stop #date"2027-04-15"
    :form_rate 70000
    :explanation al-estimated-explanation))

(= al-estimated-years (Table Int AlabamaEstimatedRules)
  (table 2026 al-estimated-rules-2026))

; The form the worksheet holds.
(= al-estimated-form String "Form 2210AL, Underpayment of Estimated Tax by Individuals")

; Alabama's own facts, from EstimatedTaxInputs.state_inputs, or none.
(def al-estimated-inputs ((inputs ret/ReturnInputs)) ret/AlabamaEstimatedInputs
  :cite ()
  (withs (given (keep (fn ((s ret/EstimatedStateInputs)) Bool (has? s 'al))
                      (. inputs 'estimated_tax.state_inputs)))
    (if (empty? given) (proto 'ret/AlabamaEstimatedInputs) (. (elt given 0) 'al))))

; "Jan 31, 2027": a date outside the tax year with its year, as the Go rules'
; shortDate writes it, and "Aug 31" inside it.
(def al-short-date ((d Date) (year Int)) String
  :cite ()
  (if (is (date-year d) year)
      (concat [(elt est-short-month-names (- (date-month d) 1)) " " (int-to-string (date-day d))])
      (est-short-date d)))

; Which divergences change these facts' figures or answers.
(defstruct AlabamaAffected
  (rate Bool)
  (agi_year Bool)
  (january Bool)
  (no_liability Bool)
  (late_start Bool))

(def al-divergence ((rule String) (form String) (form-source String) (statute String)
                    (statute-source String) (uses ret/DivergenceReading) (affects Bool))
  ret/EstimatedDivergence
  :cite ()
  (proto 'ret/EstimatedDivergence
    :rule rule :form form :form_source form-source :statute statute :statute_source statute-source
    :uses uses :affects_household affects))

; Where the Department of Revenue's forms and § 40-18-80, through the § 6654
; it adopts, part ways, and whether each changes these facts' figures.
(def al-estimated-divergences ((r AlabamaEstimatedRules) (year Int) (in AlabamaAffected))
  (Slice ret/EstimatedDivergence)
  :cite ((law "Ala. Code" "40-18-80" "(a)") (law "26 U.S.C." "6654"))
  (withs (y-s (int-to-string year)
          last-s (int-to-string (- year 1))
          next-s (int-to-string (+ year 1)))
    [(al-divergence "The interest rate"
       (concat ["The " last-s " Form 2210AL prints one rate, " (est-percent (/ (. r 'form_rate) 100))
                ", for every day of the penalty. That was the rate for every quarter of " last-s ". "
                "For " y-s " the department publishes a rate for each quarter. It is 6% from April to June and 7% after."])
       "Form 2210AL (2025), Part III line 11; ADOR, Quarterly Interest Rates"
       "The penalty is interest at the federal underpayment rate. It runs for the time the payment is late. When the rate changes, each rate applies to the days it covers."
       "Code of Ala. §§ 40-18-80(a), 40-1-44(a); 26 U.S.C. § 6654(a)"
       'ret/DIVERGENCE_READING_STATUTE (. in 'rate))
     (al-divergence "Which year's AGI sets the 110% test"
       (concat ["The " last-s " Form 2210AL instructions test the penalty year's own AGI. For the " last-s
                " penalty they ask for \"AGI for " last-s "\". The " y-s " Form 40ES tests your " last-s
                " Alabama AGI for " y-s "."])
       "Form 2210AL instructions (2025), Higher income taxpayers; Form 40ES instructions (2026), Special Rule for Higher Income Taxpayers"
       "110% applies if last year's AGI was over $150,000, or $75,000 filing separately."
       "Code of Ala. § 40-18-80(a); 26 U.S.C. § 6654(d)(1)(C)"
       'ret/DIVERGENCE_READING_STATUTE (. in 'agi_year))
     (al-divergence "A return filed and paid by January 31"
       (concat ["Neither form excuses the January payment for a return filed early. That means filed and paid in full by "
                (al-short-date (. r 'file_and_pay_by) year) "."])
       "Form 40ES instructions (2026); Form 2210AL (2025) and its instructions"
       "The January payment has no penalty if you file and pay in full by January 31. That January 31 is in the next year."
       "Code of Ala. § 40-18-80(a); 26 U.S.C. § 6654(h)"
       'ret/DIVERGENCE_READING_FORM (. in 'january))
     (al-divergence "No tax liability last year"
       "Form 2210AL has no exception for a year with no tax liability before it. A full-year return showing no tax already makes the target $0. The gap matters only if you had no return to file."
       "Form 2210AL (2025), Part I, and its instructions"
       "No penalty follows a full 12-month year with no Alabama income tax liability. You must also have been a U.S. citizen or resident all that year."
       "Code of Ala. § 40-18-80(a), (b)(1); 26 U.S.C. § 6654(e)(2)"
       'ret/DIVERGENCE_READING_FORM (. in 'no_liability))
     (al-divergence "A requirement first met after April 1"
       (concat ["The 40ES covers a requirement that first arises after April 1. It says to pay a third of your estimated tax by June 15. "
                "After June 1 it says half by Sep 15, and after Sep 1 all of it by Jan 15, " next-s ". "
                "Form 2210AL still requires 25% by every date."])
       "Form 40ES instructions (2026), Changes In Tax and the voucher schedule; Form 2210AL (2025), Part III line 1"
       "There are four payments, each 25% of the required annual payment. No rule covers a requirement that first arises late in the year."
       "Code of Ala. § 40-18-80(a); 26 U.S.C. § 6654(c), (d)(1)(A)"
       'ret/DIVERGENCE_READING_STATUTE (. in 'late_start))
     (al-divergence "Nonresident aliens"
       "Neither form has separate rules for a nonresident alien."
       "Form 40ES instructions (2026); Form 2210AL (2025) and its instructions"
       (concat ["Some nonresident aliens have three payments: June 15, Sep 15 and Jan 15, " next-s
                ". Half of the required annual payment is due in the first."])
       "Code of Ala. § 40-18-80(a); 26 U.S.C. § 6654(j)"
       'ret/DIVERGENCE_READING_FORM false)]))

; The requirement, the due dates, each instalment's own amount and the
; questions and divergences the requirement reports.
(defstruct AlabamaAssessment
  (req EstRequirement)
  (exempt Bool)
  (dues (Slice Date))
  (installments (Slice Money))
  (ai (Slice fed/Form2210.AnnualizationPeriod))
  (credits (Slice EstCredit))
  (ledger (Slice EstLedgerEntry))
  (questions (Slice ret/EstimatedQuestion))
  (divergences (Slice ret/EstimatedDivergence)))

; Whether testing this year's Alabama AGI against the step, as the 2025 Form
; 2210AL does, would give a different target than last year's at rate. Without
; this year's AGI, whether the other percentage would.
(def al-agi-year-matters ((y AlabamaEstimatedYear) (al ret/AlabamaEstimatedInputs) (rate Int)
                          (prior-tax Money) (step Money) (this-known Bool) (this-amount Money))
  Bool
  :cite ((law "26 U.S.C." "6654" "(d)(1)(C)"))
  (withs (other (if (has? al 'alabama_agi)
                    (if (> (. al 'alabama_agi) step) (. y 'high_income_rate) (. y 'last_year_rate))
                    (if (is rate (. y 'last_year_rate)) (. y 'high_income_rate) (. y 'last_year_rate)))
          lesser (fn ((a Money)) Money (if (and this-known (< this-amount a)) this-amount a)))
    (and (!= other rate)
         (!= (lesser (est-rate-of rate prior-tax)) (lesser (est-rate-of other prior-tax))))))

; Whether estimated payments are needed and the required annual payment
; (§ 40-18-80(a); § 6654(d)(1) and (e)(1); Form 2210AL Part I), the due dates
; (§ 6654(c)), each instalment (§ 6654(d)(1)(A), or Schedule AI under
; § 6654(d)(2)), and the credits applied to them (§ 6654(b)(3) and (g)).
(def al-estimated-assess ((inputs ret/ReturnInputs) (f EstFacts) (r AlabamaEstimatedRules)) AlabamaAssessment
  :cite ((law "Ala. Code" "40-18-80" "(a)") (law "26 U.S.C." "6654" "(d)(1)") (law "26 U.S.C." "6654" "(e)(1)")
         (doc "al-dor-form-40es-instructions-2026" "general-rule")
         (doc "al-dor-form-40es-instructions-2026" "higher-income")
         (doc "al-dor-form-40es-instructions-2026" "payment-of-estimated-tax")
         (doc "al-dor-form-40es-instructions-2026" "changes-in-tax"))
  (withs (y (. r 'figures)
          al (al-estimated-inputs inputs)
          year (. f 'tax_year)
          year-s (int-to-string year)
          last-s (int-to-string (- year 1))
          none ((inst empty-slice ret/EstimatedQuestion))
          dues (est-move-dates (. y 'due_dates) ((inst empty-slice Date)))
          step (if (is (. f 'filing_status) 'ret/FILING_STATUS_ELECTION_MARRIED_FILING_SEPARATELY)
                   (. y 'high_income_agi_separate)
                   (. y 'high_income_agi))
          known (. f 'tax_known)
          tax (. f 'tax)
          withheld (. f 'withheld)
          threshold (. y 'threshold)
          this-rate (. y 'this_year_rate)
          last-rate (. y 'last_year_rate)
          p (. f 'prior)
          has-prior (. p 'on_record)
          status (. p 'status)
          full-year (and has-prior (is status 'ret/EstimatedTaxInputs.PRIOR_RETURN_FULL_YEAR))
          prior-tax (. p 'tax)
          agi-known (. p 'agi_known)
          agi (. p 'agi)
          ; Form 2210AL Part I line 4: 90% of this year's tax.
          this-amount (est-rate-of this-rate tax)
          this-option (if known
                          (est-this-year-option this-rate this-amount "Form 2210AL (2025), Part I line 4")
                          (est-unavailable (est-this-year-option this-rate #usd"0.00" "Form 2210AL (2025), Part I line 4")
                                           est-needs-this-year-tax))
          ; Form 2210AL Part I line 7: last year's tax, at 110% above the
          ; step, or without last year's AGI.
          prior-rate (if (or (not agi-known) (> agi step)) (. y 'high_income_rate) last-rate)
          closed (fn ((why String)) ret/EstimatedTargetOption
                   (est-unavailable (est-last-year-option last-rate #usd"0.00" "Form 2210AL (2025), Part I line 7") why))
          prior-option (if (not has-prior)
                           (closed (concat ["Needs your " last-s " Alabama return"]))
                           (is status 'ret/EstimatedTaxInputs.PRIOR_RETURN_NOT_REQUIRED)
                           (closed (concat ["You weren't required to file a " last-s " Alabama return"]))
                           (!= status 'ret/EstimatedTaxInputs.PRIOR_RETURN_FULL_YEAR)
                           (if (is status 'ret/EstimatedTaxInputs.PRIOR_RETURN_SHORT_YEAR)
                               (closed (concat ["Your " last-s " Alabama return covered less than 12 months, not a full year"]))
                               (closed (concat ["You didn't file a " last-s " Alabama return"])))
                           (est-last-year-option prior-rate (est-rate-of prior-rate prior-tax) "Form 2210AL (2025), Part I line 7"))
          prior-open (is (. prior-option 'status) 'ret/OPTION_STATUS_AVAILABLE)
          prior-amount (. prior-option 'amount)
          ; Asked at once: whose AGI § 6654(d)(1)(C) reads, when it could
          ; change the percentage.
          fed-py (. inputs 'federal.prior_year)
          fed-known (has? fed-py 'prior_year_agi)
          fed-agi (. fed-py 'prior_year_agi)
          agi-questions
            (if (not (and full-year agi-known))
                none
                (not fed-known)
                [(est-ask "adjusted gross income" (concat ["What was your " last-s " federal AGI?"])
                          (concat ["Alabama law doesn't say if the " (est-whole step)
                                   " test reads federal or Alabama AGI. Until then, the figures use the Alabama AGI the "
                                   year-s " Form 40ES reads."]))]
                (!= (> fed-agi step) (> agi step))
                [(est-ask "unsettled rule" ""
                          (concat ["With your " last-s " federal AGI of " (est-whole fed-agi) ", the " (est-whole step)
                                   " test would give " (est-percent (if (> fed-agi step) (. y 'high_income_rate) last-rate))
                                   ". The law doesn't say which AGI; the " year-s " Form 40ES and the figures use Alabama's."]))]
                none)
          ; Asked unless an exception sets the target.
          target-questions
            (append
              (if (not has-prior)
                  [(est-ask "prior year return" (concat ["Did you file a " last-s " Alabama return, and what was its tax?"])
                            (concat ["With it, last year's tax could set the target. " (est-percent last-rate)
                                     " of it may be lower than " (est-percent this-rate) " of this year's tax."]))]
                  (and full-year (not agi-known))
                  [(est-ask "adjusted gross income" (concat ["What was your " last-s " Alabama AGI?"])
                            (concat ["Until then, the target is " (est-percent (. y 'high_income_rate))
                                     " of last year's tax. That is the rate over " (est-whole step) ", rather than "
                                     (est-percent last-rate) "."]))]
                  none)
              (if known
                  none
                  [(est-ask "this year's tax" (concat ["What do you expect your " year-s " Alabama tax to be?"])
                            (if prior-open
                                "Without it, the target can only come from last year's tax."
                                (concat ["Without it, there's no target, because your " last-s " return can't set one."])))]))
          use-prior (and prior-open (or (not known) (< prior-amount this-amount)))
          chosen-id (if use-prior (. prior-option 'id) (. this-option 'id))
          target (if use-prior prior-amount this-amount)
          options [this-option prior-option]
          left (- tax withheld)
          req (if (and (not known) (not prior-open))
                  (est-no-target options
                    (concat ["Your target needs your " year-s " Alabama tax, because your " last-s " return can't set one."]))
                  (and (not known) (>= withheld target))
                  (est-choose options chosen-id false
                    (concat ["Your withholding of " (est-whole withheld) " covers " (est-percent prior-rate)
                             " of your " last-s " Alabama tax, " (est-whole target)
                             ". No estimated payments are needed, whatever your " year-s " tax turns out to be."]))
                  (not known)
                  (est-choose options chosen-id true
                    (concat ["Your target is " (est-percent prior-rate) " of your " last-s " Alabama tax, "
                             (est-whole target) ". It keeps you clear of a penalty whatever your " year-s
                             " tax turns out to be. After " (est-whole withheld) " of withholding, that's "
                             (est-whole (- target withheld)) " of estimated payments. Pay a quarter by each date."]))
                  (< left threshold)
                  (est-exempt options
                    (est-exception-below "exception-under-threshold" "Tax less withholding" threshold
                                         "Code of Ala. § 40-18-80(a)(2); 26 U.S.C. § 6654(e)(1)")
                    (concat ["Your Alabama tax is " (est-whole tax) ", and " (est-whole withheld) " is withheld. That "
                             (est-leaves left) (if (< tax withheld) "" (concat [", under " (est-whole threshold)]))
                             ". No estimated payments are needed."]))
                  (>= withheld target)
                  (est-choose options chosen-id false
                    (concat ["Your Alabama withholding of " (est-whole withheld) " covers the " (est-whole target)
                             " required for the year. No estimated payments are needed."]))
                  (est-choose options chosen-id true
                    (concat ["Your Alabama tax of " (est-whole tax) " less " (est-whole withheld) " withheld leaves "
                             (est-whole left) ". That is at least " (est-whole threshold) ". Withholding falls short of the "
                             (est-whole target) " required. You need " (est-whole (- target withheld))
                             " of estimated payments, a quarter by each date."])))
          exempt (is (. req 'status) 'ret/REQUIREMENT_STATUS_EXEMPT)
          ; Form 2210AL Part IV is for a farmer or fisherman; the core's
          ; farming and fishing figures answer whether it applies.
          farmer-questions
            (if (or exempt (has? (. inputs 'estimated_tax) 'farming_and_fishing))
                none
                [(est-ask "jurisdiction fact"
                          (concat ["Was two-thirds of your " last-s " gross income from farming or fishing?"])
                          "If so, Form 2210AL Part IV applies; until then the figures assume not.")])
          regular (est-increments (est-cumulative (. req 'target) (. r 'shares)))
          periods (. f 'periods)
          ai (if (or exempt (empty? periods))
                 ((inst empty-slice fed/Form2210.AnnualizationPeriod))
                 (est-schedule-ai
                   (map (fn ((pt ret/EstimatedTaxInputs.CallerEstimate.PeriodTax)) Money (. pt 'annualised_tax))
                        periods)
                   (. r 'annualised_shares)
                   regular))
          installments (if exempt
                           (map (fn ((d Date)) Money #usd"0.00") dues)
                           (empty? ai)
                           regular
                           (map (fn ((ap fed/Form2210.AnnualizationPeriod)) Money (. ap 'required_installment)) ai))
          credits (est-credits f dues (. r 'shares))
          ledger (est-apply dues installments credits)
          short (keep (fn ((e EstLedgerEntry)) Bool (> (. e 'shortfall) #usd"0.00")) ledger)
          met (. (. inputs 'estimated_tax) 'requirement_first_met)
          late (and (has? (. inputs 'estimated_tax) 'requirement_first_met) (not exempt)
                    (some (fn ((g Date)) Bool (>= met g)) (. y 'late_groups)))
          in (make-struct AlabamaAffected
               ; A shortfall running into a quarter whose rate isn't the one
               ; Form 2210AL prints.
               :rate (and (not exempt)
                          (some (fn ((e EstLedgerEntry)) Bool
                                  (some (fn ((q EstRate)) Bool
                                          (and (!= (. q 'rate) (. r 'form_rate)) (> (. q 'last) (. e 'due))))
                                        (. y 'rates)))
                                short))
               :agi_year (and full-year
                              (al-agi-year-matters y al prior-rate prior-tax step known this-amount))
               :january (and (not exempt) (. f 'return_filed_set)
                             (<= (. f 'return_filed) (. r 'file_and_pay_by))
                             (> (. (elt ledger (- (len ledger) 1)) 'shortfall) #usd"0.00"))
               :no_liability (and has-prior (is status 'ret/EstimatedTaxInputs.PRIOR_RETURN_NOT_REQUIRED)
                                  (not exempt))
               :late_start late))
    (make-struct AlabamaAssessment
      :req req
      :exempt exempt
      :dues dues
      :installments installments
      :ai ai
      :credits credits
      :ledger ledger
      :questions (append agi-questions (append (if exempt none target-questions) farmer-questions))
      :divergences (al-estimated-divergences r year in))))

; Each instalment's running totals.
(def al-estimated-schedule ((a AlabamaAssessment)) (Slice ret/EstimatedInstallment)
  :cite ()
  (withs (needed (running-totals (. a 'installments)))
    (map (fn ((i Int)) ret/EstimatedInstallment
           (withs (e (elt (. a 'ledger) i))
             (est-installment (+ i 1) (. e 'due) (elt needed i) (. e 'credited_by) (. e 'shortfall) false)))
         (est-range (len (. a 'ledger))))))

; The penalty to as_of: simple interest on each shortfall at the
; department's rate for each quarter, by the day, from its due date until
; paid, the return was filed with the balance, or April 15 of the next year,
; whichever is earliest (§ 40-1-44(a); § 6654(a), (b)(2); Form 2210AL Part
; III lines 10 to 12). Without this year's tax it is figured against last
; year's option alone, so it can only be too high.
(def al-estimated-penalty ((f EstFacts) (r AlabamaEstimatedRules) (a AlabamaAssessment)) EstPenaltyResult
  :cite ((law "Ala. Code" "40-1-44" "(a)") (law "26 U.S.C." "6654" "(a)") (law "26 U.S.C." "6654" "(b)(2)")
         (doc "al-dor-quarterly-interest-rates-2026" "rates-2026"))
  (withs (latest (min (. f 'as_of) (. r 'stop))
          stop (if (and (. f 'return_filed_set) (< (. f 'return_filed) latest)) (. f 'return_filed) latest))
    (if (. a 'exempt)
        (EstPenaltyResult (est-penalty stop (est-no-lines stop) false "" est-no-waiver)
                          ((inst empty-slice ret/EstimatedQuestion)))
        (withs (pl (est-simple-penalty (est-apply (. a 'dues) (. a 'installments) (est-credits f (. a 'dues) (. r 'shares)))
                                       stop (. (. r 'figures) 'rates))
                penalty (est-penalty stop pl (not (. f 'tax_known)) ""
                                     (est-standard-waiver f "The Alabama Department of Revenue" 62)))
          (EstPenaltyResult
            penalty
            (append (est-unpublished-rate-question-short pl)
                    (if (and (> (. penalty 'total) #usd"0.00") (not (. f 'waiver_answered)))
                        [(est-ask "penalty waiver" "Will you ask the department to waive the penalty?"
                                  "It can waive it for a casualty, disaster or other unusual event. Retiring after 62 or becoming disabled also counts, with reasonable cause.")]
                        ((inst empty-slice ret/EstimatedQuestion)))))))))

; Why these facts can't be answered under these rules, or "": the annualised
; method's periods must be Schedule AI's.
(def al-estimated-refusal ((f EstFacts) (r AlabamaEstimatedRules)) String
  :cite ((law "26 U.S.C." "6654" "(d)(2)"))
  (withs (periods (. f 'periods)
          ends (. r 'period_ends))
    (if (> (len periods) (len ends))
        (concat ["alabamataxcalc: Schedule AI has " (int-to-string (len ends)) " periods, not " (int-to-string (len periods))])
        (fold (fn ((acc String) (i Int)) String
                (withs (given (. (elt periods i) 'end))
                  (if (or (!= acc "") (is given (elt ends i)))
                      acc
                      (concat ["alabamataxcalc: Schedule AI period " (int-to-string (+ i 1)) " ends on "
                               (est-iso-date (elt ends i)) ", not " (est-iso-date given)]))))
              ""
              (est-range (len periods))))))

; Alabama's answer under one year's rules.
(def al-estimated-answer-for ((inputs ret/ReturnInputs) (r AlabamaEstimatedRules)) ret/EstimatedAnswer
  :cite ((law "Ala. Code" "40-18-80"))
  (withs (f (est-facts inputs "AL" (est-state-prior inputs "AL"))
          refusal (al-estimated-refusal f r))
    (if (!= refusal "")
        (est-not-answered "AL" 'ret/ESTIMATED_OUTCOME_REFUSED refusal)
        (withs (a (al-estimated-assess inputs f r)
                explanation (. r 'explanation))
          (if (not (est-target-known (. a 'req)))
              (est-answer-unknown "AL" (. a 'req) (. f 'tax_known) (. a 'questions) (. a 'divergences) explanation)
              (withs (pen (al-estimated-penalty f r a))
                (proto-with
                  (est-answer "AL" (. f 'as_of) (. a 'req) (. f 'tax_known)
                    (al-estimated-schedule a)
                    (. pen 'penalty)
                    (if (est-nothing-planned f)
                        (. pen 'penalty)
                        (. (al-estimated-penalty (est-facts-made f) r a) 'penalty))
                    (append (. a 'questions) (. pen 'questions))
                    (. a 'divergences)
                    explanation)
                  :pattern (est-pattern al-estimated-form
                             (est-form-2210 f (. a 'req) (. a 'dues) (. a 'installments) (. a 'credits)
                                            (. a 'ai) (. pen 'penalty))))))))))

; Alabama's answer: no rules for a year with no figures, and a farmer or
; fisherman, who files Form 2210AL Part IV, not yet covered.
(def alabama-estimated-answer ((inputs ret/ReturnInputs)) ret/EstimatedAnswer
  :cite ((law "Ala. Code" "40-18-80"))
  (withs (year (. inputs 'tax_year)
          r (lookup al-estimated-years year)
          problem (est-input-problem inputs))
    (if (nil? r)
        (est-no-rules "AL" year)
        (!= problem "")
        (est-not-answered "AL" (est-input-outcome inputs) problem)
        (est-farmer-or-fisher inputs)
        (est-not-answered "AL" 'ret/ESTIMATED_OUTCOME_UNSUPPORTED
          "estimated: these facts need rules this build does not implement: a farmer or fisherman with two-thirds of gross income from farming or fishing files Form 2210AL Part IV, which is not built")
        (al-estimated-answer-for inputs r))))
