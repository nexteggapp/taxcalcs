# gazelle:ignore

load("@rules_go//go:def.bzl", "go_library", "go_test")

# The rule sources as files, for the golden vectors and the Rust crates.
filegroup(
    name = "rules",
    srcs = glob(["**/*.tlisp"]),
    visibility = ["//visibility:public"],
)

go_library(
    name = "states",
    srcs = ["states.go"],
    embedsrcs = glob(["**/*.tlisp"]),
    importpath = "github.com/nexteggapp/taxcalcs/returns/rules/states",
    visibility = ["//visibility:public"],
)

go_test(
    name = "states_test",
    size = "small",
    srcs = glob(["*_test.go"]),
    deps = [
        "//californiataxcalc",
        "//filing",
