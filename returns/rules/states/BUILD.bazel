# gazelle:ignore

load("@rules_go//go:def.bzl", "go_library", "go_test")

# The rule sources as files, for the golden vectors and the Rust crates.
filegroup(
    name = "rules",
    srcs = glob(["**/*.tlisp"]),
    visibility = ["//visibility:public"],
)

go_library(
    name = "states",
    srcs = ["states.go"],
    embedsrcs = glob(["**/*.tlisp"]),
    importpath = "github.com/nexteggapp/taxcalcs/returns/rules/states",
    visibility = ["//visibility:public"],
)

go_test(
    name = "states_test",
    size = "small",
    srcs = glob(["*_test.go"]),
    deps = [
        "//californiataxcalc",
        "//filing",
        "//money",
        "//oregontaxcalc",
        "//returns/rules/federal",
        "//returns/v1",
        "//taxprotosgo:common_go_proto",
        "//taxprotosgo:facts_go_proto",
        "//taxprotosgo:form_140_go_proto",
        "//taxprotosgo:form_d400_go_proto",
        "//taxprotosgo:form_dr0104_go_proto",
        "//taxprotosgo:form_il1040_go_proto",
        "//taxprotosgo:form_1040_go_proto",
        "//taxprotosgo:form_w2_go_proto",
    ],
)
