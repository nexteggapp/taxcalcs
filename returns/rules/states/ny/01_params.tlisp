   (NyBand #usd"60000.00" #usd"2176.00" 3876)])

; Whether New York published figures cover this year.
(def ny-has-year? ((tax-year Int)) Bool
  :cite ((law "N.Y. Tax Law" "601"))
  (is tax-year 2025))

; New York figures for the year.
(def ny-year ((tax-year Int)) NewYorkYear
  :cite ((law "N.Y. Tax Law" "601") (law "N.Y. Tax Law" "614"))
  ny-year-2025)

; Which schedule a status uses: the joint one, the single one (also for a
; separate return), or the head of household one.
(def ny-joint-schedule? ((status fed/FilingStatus)) Bool
  :cite ((law "N.Y. Tax Law" "601"))
  (or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
      (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE)))

(def ny-head-of-household? ((status fed/FilingStatus)) Bool
  :cite ((law "N.Y. Tax Law" "601"))
  (is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD))

; The New York State rate schedule for a status.
(def ny-schedule ((status fed/FilingStatus)) (Slice NyBand)
  :cite ((law "N.Y. Tax Law" "601"))
  (cond
    ((ny-joint-schedule? status) ny-schedule-joint-2025)
    ((ny-head-of-household? status) ny-schedule-head-of-household-2025)
    (else ny-schedule-single-2025)))

; The tax computation worksheets above the first, for a status.
(def ny-recapture ((status fed/FilingStatus)) (Slice NyRecapture)
  :cite ((law "N.Y. Tax Law" "601"))
  (cond
    ((ny-joint-schedule? status) ny-recapture-joint-2025)
    ((ny-head-of-household? status) ny-recapture-head-of-household-2025)
    (else ny-recapture-single-2025)))

; The New York City rate schedule for a status.
(def nyc-schedule ((status fed/FilingStatus)) (Slice NyBand)
  :cite ((law "N.Y. Tax Law" "1304"))
  (cond
    ((ny-joint-schedule? status) nyc-schedule-joint-2025)
    ((ny-head-of-household? status) nyc-schedule-head-of-household-2025)
    (else nyc-schedule-single-2025)))

(= ny-filing-statuses (Table fed/FilingStatus nyit201/FilingStatus)
  (table
    'fed/FILING_STATUS_SINGLE 'nyit201/FILING_STATUS_SINGLE
    'fed/FILING_STATUS_MARRIED_FILING_JOINTLY 'nyit201/FILING_STATUS_MARRIED_FILING_JOINTLY
    'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY 'nyit201/FILING_STATUS_MARRIED_FILING_SEPARATELY
    'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD 'nyit201/FILING_STATUS_HEAD_OF_HOUSEHOLD
    'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE 'nyit201/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
