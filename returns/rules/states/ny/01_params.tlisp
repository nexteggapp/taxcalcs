; New York City tax rate schedule, head of household.
(deffigure nyc-schedule-head-of-household-2025 (Slice NyBand) 2025
  :src ny-dtf-form-it-201-instructions-2025 :at nyc-rate-schedule
  [(NyBand #usd"0.00"     #usd"0.00"    3078)
   (NyBand #usd"14400.00" #usd"443.00"  3762)
