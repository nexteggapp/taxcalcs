; Tax computation worksheets 2 to 5, married filing jointly and qualifying
; surviving spouse.
(deffigure ny-recapture-joint-2025 (Slice NyRecapture) 2025
  :src ny-dtf-form-it-201-instructions-2025 :at tax-computation
  [(NyRecapture #usd"161550.00"  #usd"333.00"   #usd"807.00")
