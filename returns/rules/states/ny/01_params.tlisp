; New York City tax rate schedule, married filing jointly and qualifying
; surviving spouse.
(deffigure nyc-schedule-joint-2025 (Slice NyBand) 2025
  :src ny-dtf-form-it-201-instructions-2025 :at nyc-rate-schedule
  [(NyBand #usd"0.00"     #usd"0.00"    3078)
   (NyBand #usd"21600.00" #usd"665.00"  3762)
   (NyBand #usd"45000.00" #usd"1545.00" 3819)
   (NyBand #usd"90000.00" #usd"3264.00" 3876)])

; New York City tax rate schedule, single and married filing separately.
(deffigure nyc-schedule-single-2025 (Slice NyBand) 2025
  :src ny-dtf-form-it-201-instructions-2025 :at nyc-rate-schedule
  [(NyBand #usd"0.00"     #usd"0.00"    3078)
