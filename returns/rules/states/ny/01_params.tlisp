; New York published figures for each tax year this build carries, from the
; Form IT-201 instructions. They are catalogued under sources/catalog/ny/2025.
;
; Rates are held in thousandths of a percent (rate_pcm), since New York City's
; rates have three decimal places: 3.078% is 3078.

; One row of a rate schedule as the instructions print it: on taxable income
; over floor, the tax is base plus rate_pcm of the excess over floor.
(defstruct NyBand
  (floor Money)
  (base Money)
  (rate_pcm Int))

; One of the tax computation worksheets for New York AGI over $107,650 whose
; taxable income is above the first worksheet's ceiling: the tax on the rate
; schedule plus the recapture base, plus the incremental benefit phased in over
; $50,000 of New York AGI above threshold.
(defstruct NyRecapture
  (threshold Money)
  (recapture_base Money)
  (incremental_benefit Money))

(defstruct NewYorkYear
  (tax_year Int)
  ; Tax Law § 614: standard deduction by filing status.
  (standard_deduction_single_dependent Money)
  (standard_deduction_single Money)
  (standard_deduction_joint Money)
  (standard_deduction_separate Money)
  (standard_deduction_head_of_household Money)
  (standard_deduction_surviving_spouse Money)
  ; Tax Law § 616: the exemption for each dependent.
  (dependent_exemption Money)
  ; Tax Law § 601(d-1): the recapture of the lower brackets' benefit starts
  ; above this New York AGI, phases in over phase_in_width, and above
  ; flat_rate_agi all taxable income is taxed at top_rate_pcm.
  (recapture_agi_floor Money)
  (recapture_agi_full Money)
  (phase_in_width Money)
  (flat_rate_agi Money)
  (top_rate_pcm Int)
  ; The first tax computation worksheet's flat rate and taxable income ceiling
  ; for each schedule.
  (first_rate_joint_pcm Int)
  (first_ceiling_joint Money)
  (first_rate_single_pcm Int)
  (first_ceiling_single Money)
  (first_rate_head_of_household_pcm Int)
  (first_ceiling_head_of_household Money))

; New York's 2025 figures.
(deffigures ny-year-2025 NewYorkYear 2025
  (from ny-dtf-form-it-201-instructions-2025
    (standard_deduction_single_dependent   #usd"3100.00"     :at line-34)
    (standard_deduction_single             #usd"8000.00"     :at line-34)
    (standard_deduction_joint              #usd"16050.00"    :at line-34)
    (standard_deduction_separate           #usd"8000.00"     :at line-34)
    (standard_deduction_head_of_household  #usd"11200.00"    :at line-34)
    (standard_deduction_surviving_spouse   #usd"16050.00"    :at line-34)
    (dependent_exemption                   #usd"1000.00"     :at line-36)
    (recapture_agi_floor                   #usd"107650.00"   :at tax-computation)
    (recapture_agi_full                    #usd"157650.00"   :at tax-computation)
    (phase_in_width                        #usd"50000.00"    :at tax-computation)
    (flat_rate_agi                         #usd"25000000.00" :at tax-computation)
    (top_rate_pcm                          10900             :at tax-computation)
    (first_rate_joint_pcm                  5500              :at tax-computation)
    (first_ceiling_joint                   #usd"161550.00"   :at tax-computation)
    (first_rate_single_pcm                 6000              :at tax-computation)
    (first_ceiling_single                  #usd"215400.00"   :at tax-computation)
    (first_rate_head_of_household_pcm      6000              :at tax-computation)
    (first_ceiling_head_of_household       #usd"269300.00"   :at tax-computation)))

; New York State tax rate schedule, married filing jointly and qualifying
; surviving spouse.
(deffigure ny-schedule-joint-2025 (Slice NyBand) 2025
  :src ny-dtf-form-it-201-instructions-2025 :at nys-rate-schedule
  [(NyBand #usd"0.00"        #usd"0.00"       4000)
   (NyBand #usd"17150.00"    #usd"686.00"     4500)
   (NyBand #usd"23600.00"    #usd"976.00"     5250)
