; Oregon Form OR-40, for a full-year resident.
;
; The return starts from the prepared federal return: federal AGI, the
; federal filing status, the federal tax liability, the federal Schedule A and
; the dependents the federal return claims. A part-year resident files Form
; OR-40-P and a non-resident Form OR-40-N, which are not computed here.

; The Federal tax liability subtraction worksheet, lines 1 to 10: Form 1040
; line 22 less any excess advance premium tax credit repaid, plus the other
; income taxes on Schedule 2 (lines 8 and 16; the federal rules put nothing on
; line 17 that is an income tax), less the refundable American opportunity
; and adoption credits and the premium tax credit allowed on Form 8962 line
; 24. The earned income credit is not subtracted.
(def or-federal-tax-liability ((fed-ret ret/FederalReturn) (docs ret/Documents)) Money
  :cite ("Or. Rev. Stat. § 316.685" "Form OR-40 Instructions (2025), Federal tax liability subtraction worksheet")
  (withs (f (. fed-ret 'forms.form_1040)
          s2 (. fed-ret 'forms.schedule_2)
          repaid (sum (fn ((i fed/Schedule2Item)) Money
                        (if (is (. i 'description) "Excess advance premium tax credit repayment")
                            (. i 'amount)
                            #usd"0.00"))
                      (. s2 'additions_to_tax))
          line3 (clamp-zero (- (. f 'tax_after_credits) repaid))
          line4 (+ (. s2 'tax_on_iras_and_tax_favoured_accounts)
                   (. s2 'recapture_of_low_income_housing_credit))
          advance (sum doc-1095a-total-aptc (. docs 'marketplace_coverage))
          premium-credit (clamp-zero (- (+ advance (. fed-ret 'forms.schedule_3.net_premium_tax_credit))
                                        repaid)))
    (clamp-zero (- (+ line3 line4)
                   (. f 'american_opportunity_credit)
                   (. f 'refundable_adoption_credit)
                   premium-credit))))

; The subtraction for federal tax: the liability, capped by the most allowed
; at the filer's federal AGI.
(def or-federal-tax-subtraction
  ((tax-year Int)
   (status fed/FilingStatus)
   (liability Money)
   (federal-agi Money))
  Money
  :cite ("Or. Rev. Stat. § 316.680(1)(b)")
  (withs (maximum (fold (fn ((acc Money) (step SubtractionStep)) Money
                          (if (>= federal-agi (. step 'at_least)) (. step 'maximum) acc))
                        #usd"0.00"
                        (or-federal-tax-subtraction-steps tax-year status)))
    (min (clamp-zero liability) maximum)))

; The standard deduction and the additions for age and blindness. A separate
; filer whose spouse itemises gets none. A filer someone else can claim takes
; the standard deduction worksheet for dependents: the larger of the minimum
; and earned income plus the addition, no more than the basic deduction, with
; the additions for age and blindness on top.
(def or-standard-deduction
  ((y OregonYear)
   (status fed/FilingStatus)
   (boxes Int)
   (spouse-itemizes Bool)
   (claimable Bool)
   (earned Money))
  Money
  :cite ("Or. Rev. Stat. § 316.695(9)" "Form OR-40 Instructions (2025), Standard deduction worksheet for single dependents")
  (withs (base (cond
                 ((or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
                      (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
                  (. y 'standard_deduction_joint))
                 ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD) (. y 'standard_deduction_hoh))
                 (else (. y 'standard_deduction_single)))
          basic (if claimable
                    (state-dependent-standard-deduction earned
                      (. y 'dependent_minimum_deduction) (. y 'dependent_earned_addition) base)
                    base)
          per-box (if (or (is status 'fed/FILING_STATUS_SINGLE)
                          (is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD))
                      (. y 'additional_unmarried)
                      (. y 'additional_married)))
    (if (and (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY) spouse-itemizes)
        #usd"0.00"
        (+ basic (* per-box (int-to-float boxes))))))

; Schedule OR-A: the federal itemised deductions less the state income tax
; they include, which Oregon does not allow. When the federal return deducted
; general sales tax instead there is no income tax to remove.
(def or-itemized ((fed-ret ret/FederalReturn)) Money
  :cite ("Or. Rev. Stat. § 316.695(1)(c)" "Schedule OR-A Instructions")
  (withs (a (. fed-ret 'forms.schedule_a)
          income-tax (if (. a 'elected_general_sales_taxes)
                         #usd"0.00"
                         (min (. a 'state_local_income_or_sales_taxes)
                              (. a 'state_and_local_taxes_after_cap))))
    (clamp-zero (- (. a 'total_itemized_deductions) income-tax))))

(def or-exemption-credit
  ((y OregonYear)
   (status fed/FilingStatus)
   (federal-agi Money)
   (exemptions Int))
  Money
  :cite ("Or. Rev. Stat. § 316.085")
  (withs (limit (if (or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
                        (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE))
                    (. y 'exemption_agi_limit_joint)
                    (. y 'exemption_agi_limit_single)))
    (if (> federal-agi limit)
        #usd"0.00"
        (* (. y 'exemption_credit) (int-to-float exemptions)))))

; Line 26, the political contribution credit: contributions up to the
; limit, when federal AGI is no more than the ceiling.
(def or-political-credit
  ((y OregonYear)
   (status fed/FilingStatus)
   (federal-agi Money)
   (contributions Money))
  Money
  :cite ("Or. Rev. Stat. § 316.102" "Form OR-40 Instructions (2025), Line 26")
  (withs (joint (state-joint? status)
          ceiling (if joint (. y 'political_agi_limit_joint) (. y 'political_agi_limit_single))
          most (if joint (. y 'political_credit_joint) (. y 'political_credit_single)))
    (if (> federal-agi ceiling)
        #usd"0.00"
        (min (clamp-zero contributions) most))))

; The refundable credit for contributions to an Oregon higher education
; savings or ABLE account (credit codes 896 and 897, on Schedule OR-ASC): the
; Table 14 percentage of the contributions, up to the most allowed. The inputs
; give one total for both kinds of account, so it is capped once. A separate
; filer would share the joint credit by each spouse's part of their combined
; AGI, which the inputs do not give; the single filer's figure is used.
(def or-savings-credit
  ((y OregonYear)
   (status fed/FilingStatus)
   (federal-agi Money)
   (contributions Money))
  Money
  :cite ("Or. Rev. Stat. § 315.650" "Publication OR-17 (2025), Refundable credits")
  (withs (most (if (state-joint? status) (. y 'savings_credit_joint) (. y 'savings_credit_single)))
    (min (round-dollar (/ (* (clamp-zero contributions) (int-to-float (or-savings-percent federal-agi))) 100.0))
         most)))

; Line 32, the surplus credit (kicker): the year's percentage of the prior
; year's total personal income tax liability, rounded to the dollar. The
; inputs ask for that liability as the prior Form OR-40 states it, before
; credits other than the credit for tax paid to another state.
(def or-kicker ((y OregonYear) (prior-liability Money)) Money
  :cite ("Or. Rev. Stat. § 291.349" "Form OR-40 Instructions (2025), Kicker worksheet")
  (round-dollar (/ (* (clamp-zero prior-liability) (int-to-float (. y 'kicker_rate_ppm))) 1000000.0)))

(def or-diagnostics
  ((or-in ret/OregonInputs)
   (status fed/FilingStatus))
  (Slice ret/Diagnostic)
  (if (and (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)
           (> (. or-in 'oregon_529_or_able_contributions) #usd"0.00"))
      [(state-info "OR_SAVINGS_CREDIT_SEPARATE"
         "On a separate return the savings and ABLE credit is your share of the joint credit by AGI; the single filer's limit is used instead."
         "Publication OR-17, ABLE account contributions")]
      ((inst empty-slice ret/Diagnostic))))

(def prepare-oregon-return
  ((inputs ret/ReturnInputs)
   (or-in ret/OregonInputs)
   (fed-ret ret/FederalReturn)
   (tax-year Int))
  ret/OregonReturn
  :cite ("Or. Rev. Stat. ch. 316" "Form OR-40 Instructions")
  (if (not (or-has-year? tax-year))
      (proto 'ret/OregonReturn
        :status 'ret/RETURN_STATUS_INCOMPLETE
        :diagnostics [(state-diagnostic "OR_NO_RULES_FOR_YEAR" 'ret/SEVERITY_ERROR
                        "No Oregon rules are built for this tax year."
                        "Or. Rev. Stat. § 316.037")])
      (withs (y (or-year tax-year)
              hh (. inputs 'federal.household)
              docs (. inputs 'federal.documents)
              status (. fed-ret 'summary.filing_status)
              federal-agi (. fed-ret 'summary.adjusted_gross_income)
              ; Exemptions.
              ; A person someone else can claim checks no "Regular" box.
              claimable (. hh 'taxpayer.can_be_claimed_as_dependent)
              self-count (if claimable 0 1)
              spouse-count (if (and (state-joint? status) (not (. hh 'spouse.can_be_claimed_as_dependent))) 1 0)
              dependent-count (state-dependent-count hh tax-year)
              total-exemptions (+ self-count spouse-count dependent-count)
              ; Lines 7 to 15: income after additions and subtractions.
              additions (. or-in 'other_additions)
              income-after-additions (+ federal-agi additions)
              liability (or-federal-tax-liability fed-ret docs)
              fed-tax-sub (or-federal-tax-subtraction tax-year status liability federal-agi)
              ss (. fed-ret 'forms.form_1040.social_security_benefits_taxable)
              other-subs (. or-in 'other_subtractions)
              total-subs (+ fed-tax-sub ss other-subs)
              income-after-subs (- income-after-additions total-subs)
              ; Lines 16 to 19: deduction and taxable income.
              boxes (+ (state-senior-count hh status tax-year) (state-blind-count hh status))
              standard (or-standard-deduction y status boxes (. hh 'spouse_itemizes_separately)
                         (or claimable (and (state-joint? status) (. hh 'spouse.can_be_claimed_as_dependent)))
                         (state-earned-income fed-ret))
              itemized (or-itemized fed-ret)
              election (. or-in 'deduction_method)
              use-itemized (state-uses-itemized? election standard itemized)
              deduction (if use-itemized itemized standard)
              taxable (clamp-zero (- income-after-subs deduction))
              ; Lines 20 to 25: tax, each band rounded to a whole dollar.
              rows (or-chart tax-year status)
              tax (state-bracket-tax rows taxable true)
              total-before-credits tax
              exemption-credit (or-exemption-credit y status federal-agi total-exemptions)
              political-credit (or-political-credit y status federal-agi (. or-in 'political_contributions))
              total-standard-credits (+ exemption-credit political-credit)
              after-standard (clamp-zero (- total-before-credits total-standard-credits))
              after-all after-standard
              ; Payments.
              withheld (state-tax-withheld docs "OR")
              prior-applied (. or-in 'prior_year_overpayment_applied)
              estimated (. or-in 'extension_payment)
              ; Line 32 and the refundable credits.
              kicker (or-kicker y (. or-in 'prior_even_year_oregon_tax_liability))
              savings-credit (or-savings-credit y status federal-agi (. or-in 'oregon_529_or_able_contributions))
              total-payments (+ withheld prior-applied estimated kicker savings-credit)
              overpayment (clamp-zero (- total-payments after-all))
              net-tax (clamp-zero (- after-all total-payments))
              diagnostics (or-diagnostics or-in status)
              form (proto 'or40/FormOR40
                     :tax_year tax-year
                     :filing_status (lookup-or or-filing-statuses status 'or40/FILING_STATUS_UNSPECIFIED)
                     :exemptions_self self-count
                     :exemptions_spouse spouse-count
                     :dependents dependent-count
                     :total_exemptions total-exemptions
                     :federal_adjusted_gross_income federal-agi
                     :total_additions additions
                     :income_after_additions income-after-additions
                     :federal_tax_liability fed-tax-sub
                     :social_security_benefits ss
                     :other_subtractions other-subs
                     :total_subtractions total-subs
                     :income_after_subtractions income-after-subs
                     :itemized_deductions (if use-itemized itemized #usd"0.00")
                     :standard_deduction (if use-itemized #usd"0.00" standard)
                     :deduction deduction
                     :taxable_income taxable
                     :tax tax
                     :total_tax_before_credits total-before-credits
                     :exemption_credit exemption-credit
                     :political_contribution_credit political-credit
                     :total_standard_credits total-standard-credits
                     :tax_after_standard_credits after-standard
                     :tax_after_all_credits after-all
                     :oregon_tax_withheld withheld
                     :prior_year_refund_applied prior-applied
                     :estimated_tax_payments estimated
                     :kicker kicker
                     :other_refundable_credits savings-credit
                     :total_payments_and_refundable_credits total-payments
                     :overpayment overpayment
                     :net_tax net-tax
                     :net_tax_including_penalty net-tax
                     :overpayment_less_penalty overpayment
                     :net_refund overpayment))
        (proto 'ret/OregonReturn
          :status (state-return-status diagnostics)
          :summary (proto 'ret/Summary
                     :jurisdiction "OR"
                     :filing_status status
                     :total_income income-after-additions
                     :adjusted_gross_income income-after-subs
                     :total_deductions deduction
                     :taxable_income taxable
                     :total_tax after-all
                     :total_payments_and_refundable_credits total-payments
                     :refund overpayment
                     :amount_owed net-tax
                     :effective_tax_rate (state-effective-rate after-all income-after-subs)
                     :marginal_ordinary_rate (/ (int-to-float (state-marginal-rate-bp rows taxable)) 10000.0))
          :diagnostics diagnostics
          :elections [(state-deduction-election "states.or.deduction_method" election use-itemized
                        standard itemized "Or. Rev. Stat. § 316.695")]
          :forms (proto 'facts/OregonReturn :form_or40 form)))))
