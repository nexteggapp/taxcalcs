; California Form 540 and Schedule CA (540), for a full-year resident.
;
; The return starts from the prepared federal return: federal AGI, the
; federal filing status, the federal Schedule A and the dependents the
; federal return claims. A part-year resident or non-resident files Form
; 540NR, which is not computed here.
;
; The rules cite the law. The parts of the year's booklet and form they
; implement name them in sources/catalog/ca.

; Schedule CA (540): federal AGI less the California subtractions plus the
; additions. California taxes no social security benefits, so the taxable
; part the federal return included is subtracted (Schedule CA line 6b,
; column B).
(def ca-schedule-ca
  ((ca-in ret/CaliforniaInputs)
   (fed-ret ret/FederalReturn)
   (adjusted-itemized Money))
  ca540/ScheduleCA
  :cite ((law "Cal. Rev. & Tax. Code" "17087"))
  (withs (ss (. fed-ret 'forms.form_1040.social_security_benefits_taxable))
    (proto 'ca540/ScheduleCA
      :federal_total (. fed-ret 'summary.adjusted_gross_income)
      :total_subtractions (+ ss (. ca-in 'other_schedule_ca_subtractions))
      :total_additions (. ca-in 'other_schedule_ca_additions)
      :adjusted_itemized_deductions adjusted-itemized)))

; Schedule CA Part II: the federal itemized deductions as California allows
; them. California allows no deduction for state income or sales tax and does
; not cap state and local taxes, so the federal SALT line is replaced by the
; real estate and personal property taxes alone.
(def ca-adjusted-itemized ((fed-ret ret/FederalReturn)) Money
  :cite ((law "Cal. Rev. & Tax. Code" "17220"))
  (withs (a (. fed-ret 'forms.schedule_a))
    (clamp-zero
      (+ (- (. a 'total_itemized_deductions) (. a 'state_and_local_taxes_after_cap))
         (. a 'state_local_real_estate_taxes)
         (. a 'state_local_personal_property_taxes)))))

; The limitation on itemized deductions above the AGI threshold: the smaller
; of 6% of the excess and 80% of the deductions other than medical,
; investment interest and casualty losses.
(def ca-itemized-limitation
  ((y CaliforniaYear)
   (status fed/FilingStatus)
   (federal-agi Money)
   (itemized Money)
   (fed-ret ret/FederalReturn))
  Money
  :cite ((law "Cal. Rev. & Tax. Code" "17077"))
  (withs (excess (- federal-agi (ca-phaseout-agi y status))
          a (. fed-ret 'forms.schedule_a)
          limited (clamp-zero (- itemized
                                 (. a 'deductible_medical_and_dental)
                                 (. a 'investment_interest)
                                 (. a 'casualty_and_theft_losses))))
    (if (<= excess #usd"0.00")
        #usd"0.00"
        (min (round-cents (/ (* excess 6.0) 100.0))
             (round-cents (/ (* limited 80.0) 100.0))))))

; California's itemized deductions after the limitation for high incomes.
(def ca-itemized
  ((y CaliforniaYear)
   (status fed/FilingStatus)
   (fed-ret ret/FederalReturn))
  Money
  :cite ((law "Cal. Rev. & Tax. Code" "17077"))
  (withs (adjusted (ca-adjusted-itemized fed-ret))
    (- adjusted
       (ca-itemized-limitation y status (. fed-ret 'summary.adjusted_gross_income) adjusted fed-ret))))

; The exemption credits are reduced when federal AGI is over the threshold
; for the filing status: by $6 for each $2,500 of the excess, or part of it,
; for every exemption. On a separate return the step is $1,250, so the
; reduction comes twice as fast. No credit goes below zero.
(defworksheet ca-agi-limitation
  ((y CaliforniaYear)
   (status fed/FilingStatus)
   (federal-agi Money)
   (exemptions Int)
   (dependents Int))
  Money
  :cite ((law "Cal. Rev. & Tax. Code" "17054.1"))
  (line "a" "Federal AGI, from Form 540, line 13" federal-agi)
  (line "b" "The threshold for your filing status" (ca-phaseout-agi y status))
  (line "c" "Line a less line b" (- linea lineb))
  (line "d" "Steps of $2,500, or part of one, over the threshold"
        (if (> linec #usd"0.00")
            (ceil-float (/ linec (ca-phaseout-step y status)))
            0.0))
  (line "e" "The reduction per exemption: $6 for each step"
        (* (. y 'phaseout_per_step) lined))
  (line "f" "Personal, blind and senior exemptions, from lines 7 to 9" exemptions)
  (line "g" "Their reduction: line e times line f" (* linee (int-to-float linef)))
  (line "h" "Their credits" (* (. y 'personal_exemption_credit) (int-to-float linef)))
  (line "i" "Line h less line g, not below zero" (clamp-zero (- lineh lineg)))
  (line "j" "Dependent exemptions, from line 10" dependents)
  (line "k" "Their reduction: line e times line j" (* linee (int-to-float linej)))
  (line "l" "Their credits" (* (. y 'dependent_exemption_credit) (int-to-float linej)))
  (line "m" "Line l less line k, not below zero" (clamp-zero (- linel linek)))
  (line "n" "Exemption credits: line i plus line m" (+ linei linem))
  (result linen))

; Line 62: one per cent of taxable income above one million dollars.
(def ca-behavioral-health-tax ((y CaliforniaYear) (taxable Money)) Money
  :cite ((law "Cal. Rev. & Tax. Code" "17043"))
  (withs (excess (- taxable (. y 'behavioral_health_threshold)))
    (if (<= excess #usd"0.00")
        #usd"0.00"
        (round-cents (/ (* excess (int-to-float (. y 'behavioral_health_rate_bp))) 10000.0)))))

; Someone else can claim you, or on a joint return your spouse, as a
; dependent.
(def ca-claimable? ((hh ret/Household) (status fed/FilingStatus)) Bool
  :cite ((law "Cal. Rev. & Tax. Code" "17054"))
  (any-of (. hh 'taxpayer.can_be_claimed_as_dependent)
          (and (state-joint? status) (. hh 'spouse.can_be_claimed_as_dependent))))

; One personal exemption for each of the filer and, on a joint return or for
; a surviving spouse, the spouse. When line 6 is checked the Dependent
; Exemption Worksheet gives none for a filer someone else can claim, and on a
; joint return one for the spouse who cannot be claimed.
(def ca-personal-count ((hh ret/Household) (status fed/FilingStatus)) Int
  :cite ((law "Cal. Rev. & Tax. Code" "17054" "(a)"))
  (withs (tp (if (. hh 'taxpayer.can_be_claimed_as_dependent) 0 1)
          sp (if (. hh 'spouse.can_be_claimed_as_dependent) 0 1))
    (cond
      ((state-joint? status) (+ tp sp))
      ((is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE) (* 2 tp))
      (else tp))))

; The blind exemptions, which a person someone else can claim does not take.
(def ca-blind-count ((hh ret/Household) (status fed/FilingStatus)) Int
  :cite ((law "Cal. Rev. & Tax. Code" "17054"))
  (+ (if (and (. hh 'taxpayer.blind) (not (. hh 'taxpayer.can_be_claimed_as_dependent))) 1 0)
     (if (and (state-joint? status) (. hh 'spouse.blind)
              (not (. hh 'spouse.can_be_claimed_as_dependent)))
         1 0)))

; The senior exemptions, for each of the filer and spouse 65 or older, which
; a person someone else can claim does not take.
(def ca-senior-count ((hh ret/Household) (status fed/FilingStatus) (tax-year Int)) Int
  :cite ((law "Cal. Rev. & Tax. Code" "17054"))
  (+ (if (and (born-before-65-cutoff? (. hh 'taxpayer.date_of_birth) tax-year)
              (not (. hh 'taxpayer.can_be_claimed_as_dependent)))
         1 0)
     (if (and (state-joint? status)
              (born-before-65-cutoff? (. hh 'spouse.date_of_birth) tax-year)
              (not (. hh 'spouse.can_be_claimed_as_dependent)))
         1 0)))

; The standard deduction: the chart amount, or for a filer someone else can
; claim, the California Standard Deduction Worksheet for Dependents.
(def ca-standard-for-filer
  ((y CaliforniaYear)
   (status fed/FilingStatus)
   (claimable Bool)
   (earned Money))
  Money
  :cite ((law "Cal. Rev. & Tax. Code" "17073.5"))
  (withs (ordinary (ca-standard-deduction y status))
    (if claimable
        (state-dependent-standard-deduction earned
          (. y 'dependent_minimum_deduction) (. y 'dependent_earned_addition) ordinary)
        ordinary)))

; Line 31: the tax on taxable income from the rate schedule for the filing
; status.
(def ca-rate-schedule-tax ((tax-year Int) (status fed/FilingStatus) (taxable Money)) Money
  :cite ((law "Cal. Rev. & Tax. Code" "17041"))
  (state-bracket-tax (ca-schedule tax-year status) taxable false))

; Your California AGI is within the renter's credit limit for your filing
; status.
(def ca-within-renters-agi-limit? ((y CaliforniaYear) (status fed/FilingStatus) (ca-agi Money)) Bool
  :cite ((law "Cal. Rev. & Tax. Code" "17053.5"))
  (<= ca-agi (if (ca-single-or-separate? status)
                 (. y 'renters_agi_limit_single)
                 (. y 'renters_agi_limit_joint))))

; You file as single or married filing separately.
(def ca-single-or-separate? ((status fed/FilingStatus)) Bool
  (any-of (is status 'fed/FILING_STATUS_SINGLE)
          (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY)))

; You qualify for the renter's credit: you rented your California home for
; at least half the year on property not exempt from property tax, no one
; else can claim you, and your California AGI is within the limit. The
; credit is barred to a filer someone else can claim who lived more than
; half the year with that person, which the inputs do not say, so a filer
; someone else can claim is given none and an informational note says so.
(def ca-qualifies-for-renters-credit?
  ((y CaliforniaYear)
   (status fed/FilingStatus)
   (ca-agi Money)
   (rented Bool)
   (claimable Bool))
  Bool
  :cite ((law "Cal. Rev. & Tax. Code" "17053.5"))
  (all-of rented
          (not claimable)
          (ca-within-renters-agi-limit? y status ca-agi)))

; Line 46, the Nonrefundable Renter's Credit: $60 for a single or separate
; filer and $120 for every other, if you qualify. Line 48 keeps the credit
; from taking tax below zero.
(def ca-renters-credit
  ((y CaliforniaYear)
   (status fed/FilingStatus)
   (ca-agi Money)
   (rented Bool)
   (claimable Bool))
  Money
  :cite ((law "Cal. Rev. & Tax. Code" "17053.5"))
  (if (ca-qualifies-for-renters-credit? y status ca-agi rented claimable)
      (if (ca-single-or-separate? status)
          (. y 'renters_credit_single)
          (. y 'renters_credit_joint))
      #usd"0.00"))

; The members of the applicable household 18 or older at the end of the year:
; the filer, the spouse on a joint return, and each dependent claimed who is.
(def ca-isr-adults ((hh ret/Household) (status fed/FilingStatus) (tax-year Int)) Int
  (+ 1
     (if (state-joint? status) 1 0)
     (len (keep (fn ((d ret/Dependent)) Bool
                  (and (claimed-dependent? d tax-year (year-params tax-year))
                       (>= (person-age-end-of-year (. d 'date_of_birth) tax-year) 18)))
                (. hh 'dependents)))))

; The household owes the Individual Shared Responsibility Penalty: it said
; it did not have coverage all year, and no one else can claim the filer.
(def ca-owes-penalty? ((ca-in ret/CaliforniaInputs) (claimable Bool)) Bool
  :cite ((law "Cal. Gov. Code" "100705"))
  (all-of (has? ca-in 'full_year_health_coverage)
          (not (. ca-in 'full_year_health_coverage))
          (not claimable)))

; The Individual Shared Responsibility Penalty, for a household without
; minimum essential coverage or an exemption in any month: the larger of the
; flat amount (each adult and half as much for each child, capped) and 2.5%
; of household income above the filing threshold, never more than the state
; average bronze premium for the household. A household with coverage or an
; exemption for some months completes Worksheets A and B of Form FTB 3853
; month by month, which the inputs do not describe, so the full-year figure
; is used and an informational note says so.
(def ca-shared-responsibility-penalty
  ((y CaliforniaYear)
   (tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (fed-ret ret/FederalReturn)
   (ca-agi Money)
   (seniors Int)
   (dependents Int))
  Money
  :cite ((law "Cal. Gov. Code" "100705") (law "Cal. Rev. & Tax. Code" "61015"))
  (withs (adults (ca-isr-adults hh status tax-year)
          size (+ (if (state-joint? status) 2 1) dependents)
          children (max 0 (- size adults))
          flat (min (+ (* (. y 'isr_adult) (int-to-float adults))
                       (* (. y 'isr_child) (int-to-float children)))
                    (. y 'isr_flat_cap))
          household-income (+ ca-agi (. fed-ret 'forms.form_1040.tax_exempt_interest))
          excess (- household-income (ca-isr-filing-threshold tax-year status seniors dependents))
          percentage (round-dollar (/ (* excess (int-to-float (. y 'isr_rate_bp))) 10000.0))
          cap (* (. y 'isr_bronze_annual) (int-to-float (min size (. y 'isr_household_cap)))))
    (if (<= excess #usd"0.00")
        #usd"0.00"
        (min (max flat percentage) cap))))

; Line 92: the penalty, if the household owes it.
(def ca-penalty
  ((y CaliforniaYear)
   (tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (fed-ret ret/FederalReturn)
   (ca-in ret/CaliforniaInputs)
   (claimable Bool)
   (ca-agi Money)
   (dependents Int))
  Money
  :cite ((law "Cal. Gov. Code" "100705"))
  (if (ca-owes-penalty? ca-in claimable)
      (ca-shared-responsibility-penalty y tax-year status hh fed-ret ca-agi
        (state-senior-count hh status tax-year) dependents)
      #usd"0.00"))

; Form 540, the California Resident Income Tax Return. The lines the rules
; leave out, such as the child and dependent care credit and the credits on
; Schedule P, are zero.
(defform ca-form-540
  ((y CaliforniaYear)
   (inputs ret/ReturnInputs)
   (ca-in ret/CaliforniaInputs)
   (fed-ret ret/FederalReturn)
   (tax-year Int))
  ca540/Form540
  :cite ((law "Cal. Rev. & Tax. Code" "17041"))
  (bind hh (. inputs 'federal.household))
  (bind status (. fed-ret 'summary.filing_status))
  (set :tax_year tax-year)
  (set :filing_status (lookup-or ca-filing-statuses status 'ca540/FILING_STATUS_UNSPECIFIED))

  (part "Exemptions"
    (line 6 "Someone else can claim you as a dependent" (ca-claimable? hh status)
          :field claimed_as_dependent)
    (line 7 "Personal exemptions" (ca-personal-count hh status) :field personal_exemptions)
    (line 8 "Blind exemptions" (ca-blind-count hh status) :field blind_exemptions)
    (line 9 "Senior exemptions" (ca-senior-count hh status tax-year) :field senior_exemptions)
    (line 10 "Dependent exemptions" (state-dependent-count hh tax-year)
          :field dependent_exemptions))

  (part "Taxable income"
    (attach sched-ca "Schedule CA (540)"
            (ca-schedule-ca ca-in fed-ret (ca-adjusted-itemized fed-ret)))
    (line 13 "Federal adjusted gross income" (. fed-ret 'summary.adjusted_gross_income)
          :field federal_adjusted_gross_income)
    (line 14 "California subtractions, from Schedule CA" (. sched-ca 'total_subtractions)
          :field california_subtractions)
    (line 15 "Line 13 less line 14" (- line13 line14) :field subtotal)
    (line 16 "California additions, from Schedule CA" (. sched-ca 'total_additions)
          :field california_additions)
    (line 17 "California adjusted gross income" (+ line15 line16)
          :field california_adjusted_gross_income)
    (bind standard (ca-standard-for-filer y status line6 (state-earned-income fed-ret)))
    (bind itemized (ca-itemized y status fed-ret))
    (bind use-itemized (state-uses-itemized? (. ca-in 'deduction_method) standard itemized))
    (set :itemized use-itemized)
    (line 18 "Your standard deduction, or your itemized deductions if larger or elected"
          (if use-itemized itemized standard) :field deduction)
    (line 19 "Taxable income: line 17 less line 18, not below zero"
          (clamp-zero (- line17 line18)) :field taxable_income))

  (part "Tax"
    (line 31 "Tax, from the rate schedule" (ca-rate-schedule-tax tax-year status line19)
          :field tax_before_exemption_credits)
    (line 32 "Exemption credits, after the AGI limitation"
          (ca-agi-limitation y status line13 (+ line7 line8 line9) line10)
          :field exemption_credits)
    (set :exemption_amount line32)
    (line 33 "Line 31 less line 32, not below zero" (clamp-zero (- line31 line32))
          :field tax_after_exemption_credits)
    (line 35 "Line 33 plus line 34; line 34 is not computed" line33
          :field tax_before_credits))

  (part "Special credits"
    (line 46 "Nonrefundable renter's credit"
          (ca-renters-credit y status line17 (. ca-in 'qualified_for_renters_credit) line6)
          :field renters_credit)
    (line 47 "Total credits" line46 :field total_credits)
    (line 48 "Line 35 less line 47, not below zero" (clamp-zero (- line35 line47))
          :field tax_after_credits))

  (part "Other taxes"
    (line 62 "Behavioral health services tax" (ca-behavioral-health-tax y line19)
          :field behavioral_health_services_tax)
    (line 64 "Total tax" (+ line48 line62) :field total_tax))

  (part "Payments"
    (line 71 "California income tax withheld" (state-tax-withheld (. inputs 'federal.documents) "CA")
          :field california_tax_withheld)
    (line 72 "Estimated tax and other payments"
          (+ (. ca-in 'prior_year_overpayment_applied) (. ca-in 'extension_payment))
          :field estimated_tax_payments)
    (line 78 "Total payments" (+ line71 line72) :field total_payments))

  (part "Use tax, penalty and refund"
    (line 91 "Use tax" (. ca-in 'use_tax) :field use_tax)
    (set :full_year_health_care_coverage (. ca-in 'full_year_health_coverage))
    (line 92 "Individual Shared Responsibility Penalty"
          (ca-penalty y tax-year status hh fed-ret ca-in line6 line17 line10))
    (line 93 "Payments balance: line 78 less line 91" (clamp-zero (- line78 line91))
          :field payments_balance)
    (line 94 "Use tax balance: line 91 less line 78" (clamp-zero (- line91 line78))
          :field use_tax_balance)
    (line 95 "Payments after the penalty: line 93 less line 92" (clamp-zero (- line93 line92))
          :field payments_after_shared_responsibility_penalty)
    (line 96 "Penalty balance: line 92 less line 93" (clamp-zero (- line92 line93))
          :field shared_responsibility_penalty_balance)
    (line 97 "Overpaid tax: line 95 less line 64" (clamp-zero (- line95 line64))
          :field overpaid_tax)
    (set :overpaid_tax_available line97)
    (set :refund line97)
    (line 100 "Tax due: line 64 less line 95" (clamp-zero (- line64 line95)) :field tax_due)
    (bind owed (+ line94 line96 line100))
    (set :amount_you_owe owed)
    (set :total_amount_due owed)))

(def ca-diagnostics
  ((ca-in ret/CaliforniaInputs)
   (claimable Bool)
   (penalty-applies Bool))
  (Slice ret/Diagnostic)
  (append
    (if (and claimable (. ca-in 'qualified_for_renters_credit))
        [(state-info "CA_RENTERS_CREDIT_DEPENDENT"
           "The renter's credit is not taken: a filer someone else can claim does not qualify if they lived with that person for more than half the year."
           "Cal. Rev. & Tax. Code § 17053.5")]
        ((inst empty-slice ret/Diagnostic)))
    (if penalty-applies
        [(state-info "CA_SHARED_RESPONSIBILITY_FULL_YEAR"
           "The shared responsibility penalty assumes no one in the household had coverage or an exemption in any month. Coverage for some months, or an exemption on Form FTB 3853, lowers it."
           "Form FTB 3853 Instructions, Part IV")]
        ((inst empty-slice ret/Diagnostic)))))

; The California return: Form 540 and Schedule CA, its summary, its
; diagnostics and the deduction election.
(def prepare-california-return
  ((inputs ret/ReturnInputs)
   (ca-in ret/CaliforniaInputs)
   (fed-ret ret/FederalReturn)
   (tax-year Int))
  ret/CaliforniaReturn
  :cite ((law "Cal. Rev. & Tax. Code" "17041"))
  (if (not (ca-has-year? tax-year))
      (proto 'ret/CaliforniaReturn
        :status 'ret/RETURN_STATUS_INCOMPLETE
        :diagnostics [(state-diagnostic "CA_NO_RULES_FOR_YEAR" 'ret/SEVERITY_ERROR
                        "No California rules are built for this tax year."
                        "Cal. Rev. & Tax. Code § 17041(h)")])
      (withs (y (ca-year tax-year)
              hh (. inputs 'federal.household)
              status (. fed-ret 'summary.filing_status)
              form (ca-form-540 y inputs ca-in fed-ret tax-year)
              claimable (. form 'claimed_as_dependent)
              ca-agi (. form 'california_adjusted_gross_income)
              taxable (. form 'taxable_income)
              total-tax (. form 'total_tax)
              standard (ca-standard-for-filer y status claimable (state-earned-income fed-ret))
              itemized (ca-itemized y status fed-ret)
              penalty (ca-penalty y tax-year status hh fed-ret ca-in claimable ca-agi
                        (. form 'dependent_exemptions))
              diagnostics (ca-diagnostics ca-in claimable (> penalty #usd"0.00")))
        (proto 'ret/CaliforniaReturn
          :status (state-return-status diagnostics)
          :summary (proto 'ret/Summary
                     :jurisdiction "CA"
                     :filing_status status
                     :total_income ca-agi
                     :adjusted_gross_income ca-agi
                     :total_deductions (. form 'deduction)
                     :taxable_income taxable
                     :total_tax total-tax
                     :total_payments_and_refundable_credits (. form 'total_payments)
                     :refund (. form 'refund)
                     :amount_owed (. form 'amount_you_owe)
                     :effective_tax_rate (state-effective-rate total-tax ca-agi)
                     :marginal_ordinary_rate
                       (/ (int-to-float (state-marginal-rate-bp (ca-schedule tax-year status) taxable)) 10000.0))
          :diagnostics diagnostics
          :elections [(state-deduction-election "states.ca.deduction_method"
                        (. ca-in 'deduction_method) (. form 'itemized)
                        standard itemized "Cal. Rev. & Tax. Code § 17073.5")]
          :forms (proto 'facts/CaliforniaReturn
                   :form_540 form
                   :schedule_ca (ca-schedule-ca ca-in fed-ret (ca-adjusted-itemized fed-ret)))))))
