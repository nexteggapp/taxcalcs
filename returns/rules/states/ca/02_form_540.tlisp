; California Form 540 and Schedule CA (540), for a full-year resident.
;
; The return starts from the prepared federal return: federal AGI, the
; federal filing status, the federal Schedule A and the dependents the
; federal return claims. A part-year resident or non-resident files Form
; 540NR, which is not computed here.

; Federal AGI less the California subtractions plus the additions. California
; taxes no social security benefits, so the taxable part the federal return
; included is subtracted (Schedule CA line 6b, column B).
(def ca-schedule-ca
  ((ca-in ret/CaliforniaInputs)
   (fed-ret ret/FederalReturn)
   (adjusted-itemized Money))
  ca540/ScheduleCA
  :cite ("Cal. Rev. & Tax. Code § 17087" "Schedule CA (540) Instructions")
  (withs (ss (. fed-ret 'forms.form_1040.social_security_benefits_taxable))
    (proto 'ca540/ScheduleCA
      :federal_total (. fed-ret 'summary.adjusted_gross_income)
      :total_subtractions (+ ss (. ca-in 'other_schedule_ca_subtractions))
      :total_additions (. ca-in 'other_schedule_ca_additions)
      :adjusted_itemized_deductions adjusted-itemized)))

; Schedule CA Part II: the federal itemised deductions as California allows
; them. California allows no deduction for state income or sales tax and does
; not cap state and local taxes, so the federal SALT line is replaced by the
; real estate and personal property taxes alone.
(def ca-adjusted-itemized ((fed-ret ret/FederalReturn)) Money
  :cite ("Cal. Rev. & Tax. Code § 17220" "Schedule CA (540) Instructions, Part II")
  (withs (a (. fed-ret 'forms.schedule_a))
    (clamp-zero
      (+ (- (. a 'total_itemized_deductions) (. a 'state_and_local_taxes_after_cap))
         (. a 'state_local_real_estate_taxes)
         (. a 'state_local_personal_property_taxes)))))

; The § 17077 limitation on itemised deductions above the AGI threshold: the
; smaller of 6% of the excess and 80% of the deductions other than medical,
; investment interest and casualty losses.
(def ca-itemized-limitation
  ((y CaliforniaYear)
   (status fed/FilingStatus)
   (federal-agi Money)
   (itemized Money)
   (fed-ret ret/FederalReturn))
  Money
  :cite ("Cal. Rev. & Tax. Code § 17077")
  (withs (excess (- federal-agi (ca-phaseout-agi y status))
          a (. fed-ret 'forms.schedule_a)
          limited (clamp-zero (- itemized
                                 (. a 'deductible_medical_and_dental)
                                 (. a 'investment_interest)
                                 (. a 'casualty_and_theft_losses))))
    (if (<= excess #usd"0.00")
        #usd"0.00"
        (min (round-cents (/ (* excess 6.0) 100.0))
             (round-cents (/ (* limited 80.0) 100.0))))))

; Form 540 line 32: the exemption credits, reduced by the per-exemption
; amount for each step, whole or part, of federal AGI above the threshold.
(def ca-exemption-credits
  ((y CaliforniaYear)
   (status fed/FilingStatus)
   (federal-agi Money)
   (personal-count Int)
   (dependent-count Int))
  Money
  :cite ("Cal. Rev. & Tax. Code § 17054" "Form 540 Instructions, AGI Limitation Worksheet")
  (withs (personal (* (. y 'personal_exemption_credit) (int-to-float personal-count))
          dependent (* (. y 'dependent_exemption_credit) (int-to-float dependent-count))
          excess (- federal-agi (ca-phaseout-agi y status))
          steps (if (> excess #usd"0.00")
                    (ceil-float (/ excess (ca-phaseout-step y status)))
                    0.0)
          per-exemption (* (. y 'phaseout_per_step) steps))
    (+ (clamp-zero (- personal (* per-exemption (int-to-float personal-count))))
       (clamp-zero (- dependent (* per-exemption (int-to-float dependent-count)))))))

; Form 540 line 62: one per cent of taxable income above one million dollars.
(def ca-behavioral-health-tax ((y CaliforniaYear) (taxable Money)) Money
  :cite ("Cal. Rev. & Tax. Code § 17043")
  (withs (excess (- taxable (. y 'behavioral_health_threshold)))
    (if (<= excess #usd"0.00")
        #usd"0.00"
        (round-cents (/ (* excess (int-to-float (. y 'behavioral_health_rate_bp))) 10000.0)))))

; Whether the filer, or on a joint return either spouse, can be claimed as
; someone else's dependent: Form 540 line 6.
(def ca-claimable? ((hh ret/Household) (status fed/FilingStatus)) Bool
  (or (. hh 'taxpayer.can_be_claimed_as_dependent)
      (and (state-joint? status) (. hh 'spouse.can_be_claimed_as_dependent))))

; Line 7: one personal exemption for each of the filer and, on a joint return
; or for a surviving spouse, the spouse. When line 6 is checked the Dependent
; Exemption Worksheet gives none for a filer someone else can claim, and on a
; joint return one for the spouse who cannot be claimed.
(def ca-personal-count ((hh ret/Household) (status fed/FilingStatus)) Int
  :cite ("Cal. Rev. & Tax. Code § 17054(a)" "Form 540 Instructions, Line 7")
  (withs (tp (if (. hh 'taxpayer.can_be_claimed_as_dependent) 0 1)
          sp (if (. hh 'spouse.can_be_claimed_as_dependent) 0 1))
    (cond
      ((state-joint? status) (+ tp sp))
      ((is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE) (* 2 tp))
      (else tp))))

; Lines 8 and 9: the blind and senior exemptions, which a person someone else
; can claim does not take.
(def ca-blind-count ((hh ret/Household) (status fed/FilingStatus)) Int
  :cite ("Form 540 Instructions, Line 8")
  (+ (if (and (. hh 'taxpayer.blind) (not (. hh 'taxpayer.can_be_claimed_as_dependent))) 1 0)
     (if (and (state-joint? status) (. hh 'spouse.blind)
              (not (. hh 'spouse.can_be_claimed_as_dependent)))
         1 0)))

(def ca-senior-count ((hh ret/Household) (status fed/FilingStatus) (tax-year Int)) Int
  :cite ("Form 540 Instructions, Line 9")
  (+ (if (and (born-before-65-cutoff? (. hh 'taxpayer.date_of_birth) tax-year)
              (not (. hh 'taxpayer.can_be_claimed_as_dependent)))
         1 0)
     (if (and (state-joint? status)
              (born-before-65-cutoff? (. hh 'spouse.date_of_birth) tax-year)
              (not (. hh 'spouse.can_be_claimed_as_dependent)))
         1 0)))

; Line 18's standard deduction: the chart amount, or for a filer someone else
; can claim, the California Standard Deduction Worksheet for Dependents.
(def ca-standard-for-filer
  ((y CaliforniaYear)
   (status fed/FilingStatus)
   (claimable Bool)
   (earned Money))
  Money
  :cite ("Cal. Rev. & Tax. Code § 17073.5" "Form 540 Instructions, California Standard Deduction Worksheet for Dependents")
  (withs (ordinary (ca-standard-deduction y status))
    (if claimable
        (state-dependent-standard-deduction earned
          (. y 'dependent_minimum_deduction) (. y 'dependent_earned_addition) ordinary)
        ordinary)))

; Line 46, the Nonrefundable Renter's Credit: $60 for a single or separate
; filer and $120 for every other, when the filer answered that they rented
; their California home for at least half the year on property not exempt
; from property tax, and California AGI is within the limit. A filer someone
; else can claim is given none: the credit is barred to one who lived more
; than half the year with the person who can claim them, which the inputs do
; not say, and an informational note says so. Line 48 keeps the credit from
; taking tax below zero.
(def ca-renters-credit
  ((y CaliforniaYear)
   (status fed/FilingStatus)
   (ca-agi Money)
   (qualified Bool)
   (claimable Bool))
  Money
  :cite ("Cal. Rev. & Tax. Code § 17053.5" "Form 540 Instructions, Nonrefundable Renter's Credit Qualification Record")
  (withs (single (or (is status 'fed/FILING_STATUS_SINGLE)
                     (is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY))
          limit (if single (. y 'renters_agi_limit_single) (. y 'renters_agi_limit_joint))
          credit (if single (. y 'renters_credit_single) (. y 'renters_credit_joint)))
    (if (and qualified (not claimable) (<= ca-agi limit)) credit #usd"0.00")))

; The members of the applicable household 18 or older at the end of the year:
; the filer, the spouse on a joint return, and each dependent claimed who is.
(def ca-isr-adults ((hh ret/Household) (status fed/FilingStatus) (tax-year Int)) Int
  (+ 1
     (if (state-joint? status) 1 0)
     (len (keep (fn ((d ret/Dependent)) Bool
                  (and (claimed-dependent? d tax-year (year-params tax-year))
                       (>= (person-age-end-of-year (. d 'date_of_birth) tax-year) 18)))
                (. hh 'dependents)))))

; Line 92, the Individual Shared Responsibility Penalty, for a household
; without minimum essential coverage or an exemption in any month: the larger
; of the flat amount (each adult and half as much for each child, capped) and
; 2.5% of household income above the filing threshold, never more than the
; state average bronze premium for the household. A household with coverage
; or an exemption for some months completes Worksheets A and B of Form FTB
; 3853 month by month, which the inputs do not describe, so the full-year
; figure is used and an informational note says so.
(def ca-shared-responsibility-penalty
  ((y CaliforniaYear)
   (tax-year Int)
   (status fed/FilingStatus)
   (hh ret/Household)
   (fed-ret ret/FederalReturn)
   (ca-agi Money)
   (seniors Int)
   (dependents Int))
  Money
  :cite ("Cal. Gov. Code § 100705" "Cal. Rev. & Tax. Code § 61015" "Form FTB 3853 Instructions, Part IV")
  (withs (adults (ca-isr-adults hh status tax-year)
          size (+ (if (state-joint? status) 2 1) dependents)
          children (max 0 (- size adults))
          flat (min (+ (* (. y 'isr_adult) (int-to-float adults))
                       (* (. y 'isr_child) (int-to-float children)))
                    (. y 'isr_flat_cap))
          household-income (+ ca-agi (. fed-ret 'forms.form_1040.tax_exempt_interest))
          excess (- household-income (ca-isr-filing-threshold tax-year status seniors dependents))
          percentage (round-dollar (/ (* excess (int-to-float (. y 'isr_rate_bp))) 10000.0))
          cap (* (. y 'isr_bronze_annual) (int-to-float (min size (. y 'isr_household_cap)))))
    (if (<= excess #usd"0.00")
        #usd"0.00"
        (min (max flat percentage) cap))))

(def ca-diagnostics
  ((ca-in ret/CaliforniaInputs)
   (claimable Bool)
   (penalty-applies Bool))
  (Slice ret/Diagnostic)
  (append
    (if (and claimable (. ca-in 'qualified_for_renters_credit))
        [(state-info "CA_RENTERS_CREDIT_DEPENDENT"
           "The renter's credit is not taken: a filer someone else can claim does not qualify if they lived with that person for more than half the year."
           "Cal. Rev. & Tax. Code § 17053.5")]
        ((inst empty-slice ret/Diagnostic)))
    (if penalty-applies
        [(state-info "CA_SHARED_RESPONSIBILITY_FULL_YEAR"
           "The shared responsibility penalty assumes no one in the household had coverage or an exemption in any month. Coverage for some months, or an exemption on Form FTB 3853, lowers it."
           "Form FTB 3853 Instructions, Part IV")]
        ((inst empty-slice ret/Diagnostic)))))

(def prepare-california-return
  ((inputs ret/ReturnInputs)
   (ca-in ret/CaliforniaInputs)
   (fed-ret ret/FederalReturn)
   (tax-year Int))
  ret/CaliforniaReturn
  :cite ("Cal. Rev. & Tax. Code Part 10" "Form 540 Instructions")
  (if (not (ca-has-year? tax-year))
      (proto 'ret/CaliforniaReturn
        :status 'ret/RETURN_STATUS_INCOMPLETE
        :diagnostics [(state-diagnostic "CA_NO_RULES_FOR_YEAR" 'ret/SEVERITY_ERROR
                        "No California rules are built for this tax year."
                        "Cal. Rev. & Tax. Code § 17041(h)")])
      (withs (y (ca-year tax-year)
              hh (. inputs 'federal.household)
              docs (. inputs 'federal.documents)
              status (. fed-ret 'summary.filing_status)
              federal-agi (. fed-ret 'summary.adjusted_gross_income)
              ; Lines 7 to 11: exemptions.
              claimable (ca-claimable? hh status)
              personal-count (ca-personal-count hh status)
              blind-count (ca-blind-count hh status)
              senior-count (ca-senior-count hh status tax-year)
              dependent-count (state-dependent-count hh tax-year)
              ; Lines 13 to 17: California AGI.
              adjusted-itemized (ca-adjusted-itemized fed-ret)
              sched-ca (ca-schedule-ca ca-in fed-ret adjusted-itemized)
              subtractions (. sched-ca 'total_subtractions)
              additions (. sched-ca 'total_additions)
              subtotal (- federal-agi subtractions)
              ca-agi (+ subtotal additions)
              ; Line 18: the larger of the standard and itemised deductions,
              ; or the one elected.
              standard (ca-standard-for-filer y status claimable (state-earned-income fed-ret))
              itemized (- adjusted-itemized
                          (ca-itemized-limitation y status federal-agi adjusted-itemized fed-ret))
              election (. ca-in 'deduction_method)
              use-itemized (state-uses-itemized? election standard itemized)
              deduction (if use-itemized itemized standard)
              ; Lines 19 to 35: tax.
              taxable (clamp-zero (- ca-agi deduction))
              rows (ca-schedule tax-year status)
              line31 (state-bracket-tax rows taxable false)
              line32 (ca-exemption-credits y status federal-agi
                                           (+ personal-count blind-count senior-count)
                                           dependent-count)
              line33 (clamp-zero (- line31 line32))
              line35 line33
              ; Lines 40 to 48: credits. The renter's credit is the one
              ; computed; the child and dependent care credit and the
              ; credits on Schedule P are not modelled.
              line46 (ca-renters-credit y status ca-agi (. ca-in 'qualified_for_renters_credit) claimable)
              line47 line46
              line48 (clamp-zero (- line35 line47))
              ; Lines 61 to 64: other taxes.
              line62 (ca-behavioral-health-tax y taxable)
              line64 (+ line48 line62)
              ; Lines 71 to 78: payments.
              line71 (state-tax-withheld docs "CA")
              line72 (+ (. ca-in 'prior_year_overpayment_applied) (. ca-in 'extension_payment))
              line78 (+ line71 line72)
              ; Lines 91 to 100: use tax, the shared responsibility penalty,
              ; overpayment and tax due. A filer someone else can claim owes
              ; no penalty.
              line91 (. ca-in 'use_tax)
              penalty-applies (and (has? ca-in 'full_year_health_coverage)
                                   (not (. ca-in 'full_year_health_coverage))
                                   (not claimable))
              line92 (if penalty-applies
                         (ca-shared-responsibility-penalty y tax-year status hh fed-ret ca-agi
                           (state-senior-count hh status tax-year) dependent-count)
                         #usd"0.00")
              line93 (clamp-zero (- line78 line91))
              line94 (clamp-zero (- line91 line78))
              line95 (clamp-zero (- line93 line92))
              line96 (clamp-zero (- line92 line93))
              line97 (clamp-zero (- line95 line64))
              line100 (clamp-zero (- line64 line95))
              owed (+ line94 line96 line100)
              diagnostics (ca-diagnostics ca-in claimable (> line92 #usd"0.00"))
              form (proto 'ca540/Form540
                     :tax_year tax-year
                     :filing_status (lookup-or ca-filing-statuses status 'ca540/FILING_STATUS_UNSPECIFIED)
                     :claimed_as_dependent claimable
                     :personal_exemptions personal-count
                     :blind_exemptions blind-count
                     :senior_exemptions senior-count
                     :dependent_exemptions dependent-count
                     :exemption_amount line32
                     :federal_adjusted_gross_income federal-agi
                     :california_subtractions subtractions
                     :subtotal subtotal
                     :california_additions additions
                     :california_adjusted_gross_income ca-agi
                     :deduction deduction
                     :itemized use-itemized
                     :taxable_income taxable
                     :tax_before_exemption_credits line31
                     :exemption_credits line32
                     :tax_after_exemption_credits line33
                     :tax_before_credits line35
                     :renters_credit line46
                     :total_credits line47
                     :tax_after_credits line48
                     :behavioral_health_services_tax line62
                     :total_tax line64
                     :california_tax_withheld line71
                     :estimated_tax_payments line72
                     :total_payments line78
                     :use_tax line91
                     :full_year_health_care_coverage (. ca-in 'full_year_health_coverage)
                     :payments_balance line93
                     :use_tax_balance line94
                     :payments_after_shared_responsibility_penalty line95
                     :shared_responsibility_penalty_balance line96
                     :overpaid_tax line97
                     :overpaid_tax_available line97
                     :tax_due line100
                     :amount_you_owe owed
                     :total_amount_due owed
                     :refund line97))
        (proto 'ret/CaliforniaReturn
          :status (state-return-status diagnostics)
          :summary (proto 'ret/Summary
                     :jurisdiction "CA"
                     :filing_status status
                     :total_income ca-agi
                     :adjusted_gross_income ca-agi
                     :total_deductions deduction
                     :taxable_income taxable
                     :total_tax line64
                     :total_payments_and_refundable_credits line78
                     :refund line97
                     :amount_owed owed
                     :effective_tax_rate (state-effective-rate line64 ca-agi)
                     :marginal_ordinary_rate (/ (int-to-float (state-marginal-rate-bp rows taxable)) 10000.0))
          :diagnostics diagnostics
          :elections [(state-deduction-election "states.ca.deduction_method" election use-itemized
                        standard itemized "Cal. Rev. & Tax. Code § 17073.5")]
          :forms (proto 'facts/CaliforniaReturn
                   :form_540 form
                   :schedule_ca sched-ca)))))
