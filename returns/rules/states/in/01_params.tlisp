;; The county rate for a two-digit code, in millionths, or -1 when the code
;; is not an Indiana county.
(def in-county-rate-ppm ((code String)) Int
  :cite ((law "IC" "6-3.6-8-3") (doc "in-dor-schedule-ct-40-2025" "county-rates"))
  (lookup-or in-county-rates-2025 code -1))
