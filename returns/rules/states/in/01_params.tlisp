;; Indiana published figures for each tax year this build carries.
;; Figures are from Form IT-40, its Schedules 3 and CT-40, and the IT-40
;; instruction booklet.
;;
;; Sources are catalogued under sources/catalog/in/2025.

(defstruct IndianaYear
  (tax_year Int)
  ; IC 6-3-2-1: the adjusted gross income tax rate, in basis points
  (flat_rate_bp Int)
  ; IC 6-3-1-3.5(a)(3): each filer, and each spouse on a joint return
  (personal_exemption Money)
  ; IC 6-3-1-3.5(a)(3): each dependent
  (dependent_exemption Money)
  ; IC 6-3-1-3.5(a)(5): each dependent child under 19, or a student under 24
  (additional_child_exemption Money)
  ; IC 6-3-1-3.5(a)(4): each filer or spouse 65 or older, and each blind
  (age_blind_exemption Money)
  ; IC 6-3-1-3.5(a)(5): 65 or older with federal AGI under the threshold
  (low_income_senior_exemption Money)
  (low_income_senior_threshold Money)
  (low_income_senior_threshold_separate Money)
  ; IC 6-3-1-3.5(a)(4): each adopted child, in addition
  (adopted_child_exemption Money)
  ; IC 6-3.1-21-6: Indiana earned income credit, as a share of the federal
  (eitc_rate_bp Int))

;; Indiana published figures for 2025.
(deffigures in-year-2025 IndianaYear 2025
  (from in-dor-form-it-40-2025
    (flat_rate_bp 300 :at line-8))
  (from in-dor-schedule-3-2025
    (personal_exemption                   #usd"1000.00"  :at line-1)
    (dependent_exemption                  #usd"1000.00"  :at line-2)
    (additional_child_exemption           #usd"1500.00"  :at line-3)
    (age_blind_exemption                  #usd"1000.00"  :at line-4)
    (low_income_senior_exemption          #usd"500.00"   :at line-5)
    (low_income_senior_threshold          #usd"40000.00" :at line-5)
    (low_income_senior_threshold_separate #usd"20000.00" :at line-5)
    (adopted_child_exemption              #usd"3000.00"  :at line-6))
  (from in-dor-form-it-40-instructions-2025
    (eitc_rate_bp 1000 :at schedule-5-line-6)))

;; Look up Indiana published figures for the given tax year.
(def in-year ((tax-year Int)) IndianaYear
  :cite ((law "IC" "6-3-2-1") (law "IC" "6-3-1-3.5"))
  in-year-2025)

;; Whether Indiana rules are built for the given tax year.
(def in-has-year? ((tax-year Int)) Bool
  :cite ((law "IC" "6-3-2-1"))
  (is tax-year 2025))

