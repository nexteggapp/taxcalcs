; Connecticut published figures for each tax year this build carries.
;
; The rates come from Conn. Gen. Stat. § 12-700(a), as amended for taxable
; years beginning on or after January 1, 2024, which cut the two lowest rates
; to 2% and 4.5%. The schedules for joint filers and heads of household are
; the single schedule with wider bands.
;
; The Tax Calculation Schedule of the Form CT-1040 instructions reads four
; more figures from tables keyed by filing status and Connecticut AGI:
; Table A, the personal exemption (§ 12-702); Table C, the 2% tax rate
; phase-out add-back, and Table D, the tax recapture (§ 12-700(a)); and
; Table E, the personal tax credit decimal (§ 12-703). The rules hold each
; table as the instructions print it.
;
; Sources are catalogued under sources/catalog/ct/2025.

; One row of a table keyed by Connecticut AGI: for AGI more than over, up to
; and including the next row's over, the table gives amount. The first row's
; over is the table's lowest bound, and the last row runs on "and up".
(defstruct ConnecticutAgiRow
  (over Money)
  (amount Money))

; One row of Table E: for AGI more than over, up to and including the next
; row's over, the personal tax credit decimal, in hundredths (75 for .75).
(defstruct ConnecticutDecimalRow
  (over Money)
  (hundredths Int))

; Figures the Form CT-1040 instructions print outside the tables.
(defstruct ConnecticutYear
  (tax_year Int)
  ; Line 6: Connecticut AGI at or below which no income tax is due, by
  ; filing status. Each is the status's full Table A exemption.
  (no_tax_ceiling_single Money)
  (no_tax_ceiling_joint Money)
  (no_tax_ceiling_separate Money)
  (no_tax_ceiling_head_of_household Money))

; Connecticut's 2025 figures.
(deffigures ct-year-2025 ConnecticutYear 2025
  (from ct-drs-form-ct-1040-instructions-2025
    (no_tax_ceiling_single            #usd"15000.00" :at line-6)
    (no_tax_ceiling_joint             #usd"24000.00" :at line-6)
    (no_tax_ceiling_separate          #usd"12000.00" :at line-6)
    (no_tax_ceiling_head_of_household #usd"19000.00" :at line-6)))

; Conn. Gen. Stat. § 12-700(a): a single filer or a married individual filing
; separately.
(deffigure ct-schedule-single-2025 (Slice StateBracket) 2025
  :src ct-cgs-2025 :at section-12-700-a-single
  [(StateBracket #usd"0.00"      #usd"10000.00"      200)
   (StateBracket #usd"10000.00"  #usd"50000.00"      450)
   (StateBracket #usd"50000.00"  #usd"100000.00"     550)
   (StateBracket #usd"100000.00" #usd"200000.00"     600)
   (StateBracket #usd"200000.00" #usd"250000.00"     650)
   (StateBracket #usd"250000.00" #usd"500000.00"     690)
   (StateBracket #usd"500000.00" #usd"9999999999.00" 699)])

; Conn. Gen. Stat. § 12-700(a): married individuals filing jointly and a
; qualifying surviving spouse.
(deffigure ct-schedule-joint-2025 (Slice StateBracket) 2025
  :src ct-cgs-2025 :at section-12-700-a-joint
  [(StateBracket #usd"0.00"       #usd"20000.00"      200)
   (StateBracket #usd"20000.00"   #usd"100000.00"     450)
   (StateBracket #usd"100000.00"  #usd"200000.00"     550)
   (StateBracket #usd"200000.00"  #usd"400000.00"     600)
   (StateBracket #usd"400000.00"  #usd"500000.00"     650)
   (StateBracket #usd"500000.00"  #usd"1000000.00"    690)
   (StateBracket #usd"1000000.00" #usd"9999999999.00" 699)])

; Conn. Gen. Stat. § 12-700(a): a head of household.
(deffigure ct-schedule-head-of-household-2025 (Slice StateBracket) 2025
  :src ct-cgs-2025 :at section-12-700-a-head-of-household
  [(StateBracket #usd"0.00"      #usd"16000.00"      200)
