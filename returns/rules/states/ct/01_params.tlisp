; The rate schedule for a filing status.
(def ct-schedule ((status fed/FilingStatus)) (Slice StateBracket)
  :cite ((law "Conn. Gen. Stat." "12-700"))
  (cond
    ((is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY) ct-schedule-joint-2025)
    ((is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE) ct-schedule-joint-2025)
    ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD) ct-schedule-head-of-household-2025)
    (else ct-schedule-single-2025)))

; Whether a filing status reads the joint columns of the tables: married
; filing jointly and a qualifying surviving spouse share them.
(def ct-joint-columns? ((status fed/FilingStatus)) Bool
  (or (is status 'fed/FILING_STATUS_MARRIED_FILING_JOINTLY)
      (is status 'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE)))

; The amount a table keyed by Connecticut AGI gives: that of the last row
; whose over the AGI is more than. AGI at or below the first row's over, which
; for Tables A, C and D is $0, gives nothing.
(def ct-agi-row-amount ((rows (Slice ConnecticutAgiRow)) (agi Money)) Money
  (. (fold (fn ((acc ConnecticutAgiRow) (r ConnecticutAgiRow)) ConnecticutAgiRow
             (if (> agi (. r 'over)) r acc))
           (ConnecticutAgiRow #usd"0.00" #usd"0.00")
           rows)
     'amount))

; Table A, Personal Exemptions: the exemption for the filing status and
; Connecticut AGI.
(def ct-personal-exemption ((status fed/FilingStatus) (agi Money)) Money
  :cite ((law "Conn. Gen. Stat." "12-702")
         (doc "ct-drs-form-ct-1040-instructions-2025" "table-a"))
  (ct-agi-row-amount
    (cond
      ((ct-joint-columns? status) ct-table-a-joint-2025)
      ((is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY) ct-table-a-separate-2025)
      ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD) ct-table-a-head-of-household-2025)
      (else ct-table-a-single-2025))
    agi))

; Table C, 2% Tax Rate Phase-Out Add-Back: the add-back for the filing status
; and Connecticut AGI.
(def ct-phase-out-add-back ((status fed/FilingStatus) (agi Money)) Money
  :cite ((law "Conn. Gen. Stat." "12-700")
         (doc "ct-drs-form-ct-1040-instructions-2025" "table-c"))
  (ct-agi-row-amount
    (cond
      ((ct-joint-columns? status) ct-table-c-joint-2025)
      ((is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY) ct-table-c-separate-2025)
      ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD) ct-table-c-head-of-household-2025)
      (else ct-table-c-single-2025))
    agi))

; Table D, Tax Recapture: the recapture for the filing status and Connecticut
; AGI. A married individual filing separately reads the single column.
(def ct-tax-recapture ((status fed/FilingStatus) (agi Money)) Money
  :cite ((law "Conn. Gen. Stat." "12-700")
         (doc "ct-drs-form-ct-1040-instructions-2025" "table-d"))
  (ct-agi-row-amount
    (cond
      ((ct-joint-columns? status) ct-table-d-joint-2025)
      ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD) ct-table-d-head-of-household-2025)
      (else ct-table-d-single-2025))
    agi))

; Table E, Personal Tax Credits: the decimal for the filing status and
; Connecticut AGI, in hundredths. The table starts above each status's
; no-tax ceiling, where the exemption already leaves no taxable income, so
; AGI at or below its first row gives nothing.
(def ct-personal-credit-hundredths ((status fed/FilingStatus) (agi Money)) Int
  :cite ((law "Conn. Gen. Stat." "12-703")
         (doc "ct-drs-form-ct-1040-instructions-2025" "table-e"))
  (. (fold (fn ((acc ConnecticutDecimalRow) (r ConnecticutDecimalRow)) ConnecticutDecimalRow
             (if (> agi (. r 'over)) r acc))
           (ConnecticutDecimalRow #usd"0.00" 0)
           (cond
             ((ct-joint-columns? status) ct-table-e-joint-2025)
             ((is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY) ct-table-e-separate-2025)
             ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD) ct-table-e-head-of-household-2025)
             (else ct-table-e-single-2025)))
     'hundredths))

; Line 6: Connecticut AGI at or below which no income tax is due.
(def ct-no-tax-ceiling ((y ConnecticutYear) (status fed/FilingStatus)) Money
  :cite ((doc "ct-drs-form-ct-1040-instructions-2025" "line-6"))
  (cond
    ((ct-joint-columns? status) (. y 'no_tax_ceiling_joint))
    ((is status 'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY) (. y 'no_tax_ceiling_separate))
    ((is status 'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD) (. y 'no_tax_ceiling_head_of_household))
    (else (. y 'no_tax_ceiling_single))))

; Connecticut figures for the year.
(def ct-year ((tax-year Int)) ConnecticutYear
  :cite ((law "Conn. Gen. Stat." "12-700"))
  ct-year-2025)

; Whether Connecticut rules are built for the given tax year.
(def ct-has-year? ((tax-year Int)) Bool
  :cite ((law "Conn. Gen. Stat." "12-700"))
  (is tax-year 2025))

(= ct-filing-statuses (Table fed/FilingStatus ct1040/FilingStatus)
  (table
    'fed/FILING_STATUS_SINGLE 'ct1040/FILING_STATUS_SINGLE
    'fed/FILING_STATUS_MARRIED_FILING_JOINTLY 'ct1040/FILING_STATUS_MARRIED_FILING_JOINTLY
    'fed/FILING_STATUS_MARRIED_FILING_SEPARATELY 'ct1040/FILING_STATUS_MARRIED_FILING_SEPARATELY
    'fed/FILING_STATUS_HEAD_OF_HOUSEHOLD 'ct1040/FILING_STATUS_HEAD_OF_HOUSEHOLD
    'fed/FILING_STATUS_QUALIFYING_SURVIVING_SPOUSE 'ct1040/FILING_STATUS_SURVIVING_SPOUSE))
