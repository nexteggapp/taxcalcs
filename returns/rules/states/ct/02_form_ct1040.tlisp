; Form CT-1040, Connecticut Resident Income Tax Return, for full-year residents.
;
; The return starts from the prepared federal return: federal AGI and the
; federal filing status. Schedule 1's additions and subtractions, the figures
; the instructions' Tables A, C, D and E give, and the credits come in as
; ConnecticutInputs.
;
; The rules cite the law (Conn. Gen. Stat. Chapter 229). The parts of the
; form they implement name them in sources/catalog/ct/2025.

; The Tax Calculation Schedule in the Form CT-1040 instructions, which gives
; line 6: the personal exemption comes off Connecticut AGI, the rate schedule
; taxes the rest, the 3% phase-out add-back and the benefit recapture are
; added, and the personal tax credit takes its decimal share off the total.
(defworksheet ct-tax-calculation
  ((status fed/FilingStatus)
   (ct-agi Money)
   (ct-in ret/ConnecticutInputs))
  Money
  :cite ((law "Conn. Gen. Stat." "12-700") (law "Conn. Gen. Stat." "12-702")
         (law "Conn. Gen. Stat." "12-703"))
  (line 1 "Connecticut AGI" ct-agi)
  (line 2 "Personal exemption from Table A" (clamp-zero (. ct-in 'personal_exemption)))
  (line 3 "Taxable income: line 1 minus line 2" (clamp-zero (- line1 line2)))
  (line 4 "Initial tax from the rate schedule"
        (state-bracket-tax (ct-schedule status) line3 false))
  (line 5 "3% phase-out add-back from Table C" (clamp-zero (. ct-in 'phase_out_add_back)))
  (line 6 "Benefit recapture from Table D" (clamp-zero (. ct-in 'benefit_recapture)))
  (line 7 "Add lines 4, 5 and 6" (+ line4 line5 line6))
  (line 8 "Personal tax credit: line 7 times the Table E decimal"
        (round-cents (/ (* line7 (int-to-float (. ct-in 'personal_tax_credit_hundredths))) 100.0)))
  (line 9 "Connecticut income tax: line 7 minus line 8" (clamp-zero (- line7 line8)))
  (result line9))

; Form CT-1040, Connecticut Resident Income Tax Return.
(defform ct-form-ct1040
  ((inputs ret/ReturnInputs)
   (ct-in ret/ConnecticutInputs)
   (fed-ret ret/FederalReturn)
   (tax-year Int))
  ct1040/FormCT1040
  :cite ((law "Conn. Gen. Stat." "12-700") (law "Conn. Gen. Stat." "12-701"))
  (bind docs (. inputs 'federal.documents))
  (bind status (. fed-ret 'summary.filing_status))
  (set :tax_year tax-year)
  (set :filing_status (lookup-or ct-filing-statuses status 'ct1040/FILING_STATUS_UNSPECIFIED))

  (part "Income"
    (line 1 "Federal adjusted gross income" (. fed-ret 'summary.adjusted_gross_income)
          :field federal_adjusted_gross_income)
    (line 2 "Additions to federal adjusted gross income from Schedule 1, line 38"
          (clamp-zero (. ct-in 'additions)) :field additions)
    (line 3 "Add line 1 and line 2" (+ line1 line2) :field income_with_additions)
    (line 4 "Subtractions from federal adjusted gross income from Schedule 1, line 50"
          (clamp-zero (. ct-in 'subtractions)) :field subtractions)
    (line 5 "Connecticut adjusted gross income: line 3 minus line 4" (- line3 line4)
          :field connecticut_adjusted_gross_income))

  (part "Tax"
    (line 6 "Income tax from the tax tables or Tax Calculation Schedule"
          (ct-tax-calculation status line5 ct-in) :field income_tax_before_credits)
    (line 7 "Credit for income taxes paid to qualifying jurisdictions" #usd"0.00"
          :field credit_for_tax_paid_to_other_jurisdictions)
    (line 8 "Line 6 minus line 7, not below zero" (clamp-zero (- line6 line7))
          :field tax_after_other_jurisdictions_credit)
    (line 9 "Connecticut alternative minimum tax from Form CT-6251" #usd"0.00"
          :field alternative_minimum_tax)
    (line 10 "Add line 8 and line 9" (+ line8 line9) :field tax_with_alternative_minimum_tax)
    (line 11 "Credit for property taxes paid from Schedule 3"
          (min line10 (clamp-zero (. ct-in 'property_tax_credit))) :field property_tax_credit)
    (line 12 "Line 10 minus line 11, not below zero" (clamp-zero (- line10 line11))
          :field tax_after_property_tax_credit)
    (line 13 "Total allowable credits from Schedule CT-IT Credit"
          (min line12 (clamp-zero (. ct-in 'other_credits))) :field other_credits)
    (line 14 "Connecticut income tax: line 12 minus line 13, not below zero"
          (clamp-zero (- line12 line13)) :field income_tax)
    (line 15 "Individual use tax from Schedule 4" #usd"0.00" :field use_tax)
    (line 16 "Add line 14 and line 15" (+ line14 line15) :field total_tax)
    (line 17 "Amount from line 16" line16))

  (part "Payments"
    (line 18 "Total Connecticut income tax withheld" (state-tax-withheld docs "CT")
          :field withholding)
    (line 19 "2025 estimated tax payments" (clamp-zero (. ct-in 'estimated_payments))
          :field estimated_payments)
    (line 20 "Payments made with Form CT-1040 EXT" #usd"0.00" :field extension_payment)
    (line "20a" "Connecticut earned income tax credit from Schedule CT-EITC"
          (clamp-zero (. ct-in 'earned_income_tax_credit)) :field earned_income_tax_credit)
    (line "20b" "Claim of right credit from Form CT-1040 CRC" #usd"0.00"
          :field claim_of_right_credit)
    (line "20c" "Pass-Through Entity Tax Credit from Schedule CT-PE"
          (clamp-zero (. ct-in 'pass_through_entity_tax_credit))
          :field pass_through_entity_tax_credit)
    (line "20d" "Historic Home Rehabilitation Credit" #usd"0.00"
          :field historic_home_rehabilitation_credit)
    (line 21 "Total payments and refundable credits: add lines 18 through 20d"
          (+ line18 line19 line20 line20a line20b line20c line20d) :field total_payments))

  (part "Refund"
    (line 22 "Overpayment: line 21 minus line 17" (clamp-zero (- line21 line17))
          :field overpayment)
    (line 23 "Overpayment applied to 2026 estimated tax" #usd"0.00"
          :field overpayment_applied_to_estimated_tax)
    (line 24 "Overpayment applied as a CHET contribution" #usd"0.00"
          :field higher_education_trust_contribution)
    (line "24a" "Contributions to designated charities from Schedule 5" #usd"0.00"
          :field charitable_contributions)
    (line 25 "Refund: line 22 minus lines 23, 24 and 24a"
          (clamp-zero (- line22 (+ line23 line24 line24a))) :field refund))

  (part "Amount you owe"
    (line 26 "Tax due: line 17 minus line 21" (clamp-zero (- line17 line21)) :field tax_due)
    (line 27 "Late payment penalty" #usd"0.00" :field late_filing_penalty)
    (line 28 "Late payment interest" #usd"0.00" :field late_filing_interest)
    (line 29 "Interest on underpayment of estimated tax from Form CT-2210" #usd"0.00"
          :field estimated_tax_interest)
    (line 30 "Total amount due: add lines 26 through 29" (+ line26 line27 line28 line29)
          :field total_amount_due)))

; Prepare the Connecticut return: Form CT-1040, its summary and diagnostics.
(def prepare-connecticut-return
  ((inputs ret/ReturnInputs)
   (ct-in ret/ConnecticutInputs)
   (fed-ret ret/FederalReturn)
   (tax-year Int))
  ret/ConnecticutReturn
  :cite ((law "Conn. Gen. Stat." "12-700"))
  (if (not (ct-has-year? tax-year))
      (proto 'ret/ConnecticutReturn
        :status 'ret/RETURN_STATUS_INCOMPLETE
        :diagnostics [(state-diagnostic "CT_NO_RULES_FOR_YEAR" 'ret/SEVERITY_ERROR
                        "No Connecticut rules are built for this tax year."
                        "Conn. Gen. Stat. § 12-700")])
      (withs (status (. fed-ret 'summary.filing_status)
              form (ct-form-ct1040 inputs ct-in fed-ret tax-year)
              ct-agi (. form 'connecticut_adjusted_gross_income)
              taxable (clamp-zero (- ct-agi (clamp-zero (. ct-in 'personal_exemption))))
              tax (. form 'total_tax)
              diagnostics [(state-info "CT_TABLES_ARE_INPUTS"
                             "The personal exemption, 3% phase-out, benefit recapture and personal tax credit are taken as entered from Tables A, C, D and E of the instructions."
                             "Conn. Gen. Stat. §§ 12-700, 12-702, 12-703")])
        (proto 'ret/ConnecticutReturn
          :status (state-return-status diagnostics)
          :summary (proto 'ret/Summary
                     :jurisdiction "CT"
                     :filing_status status
                     :total_income (. form 'income_with_additions)
                     :adjusted_gross_income ct-agi
                     :total_deductions (clamp-zero (. ct-in 'personal_exemption))
                     :taxable_income taxable
                     :total_tax tax
                     :total_payments_and_refundable_credits (. form 'total_payments)
                     :refund (. form 'refund)
                     :amount_owed (. form 'total_amount_due)
                     :effective_tax_rate (state-effective-rate tax ct-agi)
                     :marginal_ordinary_rate
                       (/ (int-to-float (state-marginal-rate-bp (ct-schedule status) taxable)) 10000.0))
          :diagnostics diagnostics
          :forms (proto 'facts/ConnecticutReturn :form_ct1040 form)))))
