# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_grpc_library")

# ReturnInputs, ReturnOutputs, and the ReturnPreparer service: the foundation
# contract for preparing federal and state tax returns from complete or partial
# information.
proto_library(
    name = "returns_proto",
    # Imported as taxcalcs/returns/v1/..., as //us/v1 and //scenarios/v1 are.
    import_prefix = "taxcalcs",
    srcs = [
        "activities.proto",
        "amendment.proto",
        "common.proto",
        "credits.proto",
        "deductions.proto",
        "documents.proto",
        "elections.proto",
        "federal_inputs.proto",
        "filing.proto",
        "health.proto",
        "household.proto",
        "identity.proto",
        "input_spec.proto",
        "inputs.proto",
        "investments.proto",
        "outputs.proto",
        "payments.proto",
        "prior_year.proto",
        "retirement.proto",
        "service.proto",
        "state_inputs.proto",
        "working.proto",
        "workpapers.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@nexteggapp_taxprotos//common/v1:common_proto",
        "@nexteggapp_taxprotos//facts/v1:facts_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1040:form_1040_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1095_a:form_1095_a_proto",
