        "@nexteggapp_taxprotos//us/federal/v1/form_1099_b:form_1099_b_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_c:form_1099_c_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_div:form_1099_div_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_g:form_1099_g_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_int:form_1099_int_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_k:form_1099_k_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_misc:form_1099_misc_proto",
        "@nexteggapp_taxprotos//us/federal/v1/form_1099_nec:form_1099_nec_proto",
