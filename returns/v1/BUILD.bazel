        "//taxprotosgo:form_1099_r_go_proto",
        "//taxprotosgo:form_1099_s_go_proto",
        "//taxprotosgo:form_1099_sa_go_proto",
        "//taxprotosgo:form_540_go_proto",
        "//taxprotosgo:form_5498_go_proto",
        "//taxprotosgo:form_5498_sa_go_proto",
        "//taxprotosgo:form_8889_go_proto",
