load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//rust:defs.bzl", "EDITION", "RUSTC_FLAGS")

rust_library(
    name = "working",
    edition = EDITION,
    srcs = glob(["src/**/*.rs"]),
    aliases = {"//rust/money": "money"},
    crate_name = "taxcalcs_working",
    rustc_flags = RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [
        "//rust/money",
        "@taxcalcs_crates//:thiserror",
    ],
)

rust_test(
    name = "working_test",
    edition = EDITION,
    size = "small",
    crate = ":working",
    rustc_flags = RUSTC_FLAGS,
)

# Each file under tests/ is its own test crate, as under Cargo.
[rust_test(
    name = f[len("tests/"):-len(".rs")],
    size = "small",
    srcs = [f],
    aliases = {"//rust/money": "money"},
    rustc_flags = RUSTC_FLAGS,
    deps = [
        ":working",
        "//rust/money",
    ],
) for f in glob(["tests/*.rs"])]

exports_files(["Cargo.toml"])
