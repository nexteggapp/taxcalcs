load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//rust:defs.bzl", "EDITION", "GOLDEN_DATA", "GOLDEN_ENV", "RUSTC_FLAGS")

rust_library(
    name = "taxyear",
    edition = EDITION,
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "//rust/filing": "filing",
        "//rust/money": "money",
        "//rust/proto": "proto",
        "//rust/protodiffgen": "protodiffgen",
        "//rust/returns": "returns",
        "//rust/taxlisp": "taxlisp",
    },
    crate_name = "taxcalcs_taxyear",
    rustc_flags = RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [
        "//rust/filing",
        "//rust/money",
        "//rust/proto",
        "//rust/protodiffgen",
        "//rust/returns",
        "//rust/taxlisp",
        "@taxcalcs_crates//:base64",
        "@taxcalcs_crates//:buffa",
        "@taxcalcs_crates//:buffa-descriptor",
        "@taxcalcs_crates//:buffa-types",
        "@taxcalcs_crates//:regex",
        "@taxcalcs_crates//:serde_json",
        "@taxcalcs_crates//:sha2",
        "@taxcalcs_crates//:thiserror",
    ],
)

# The test cases the tests read, and the example they include.
TESTDATA = GOLDEN_DATA + [
    "//scenarios/v1:testdata/example.jsonc",
    "//taxyear:testdata",
]

# The unit tests compute every test case, unoptimised.
rust_test(
    name = "taxyear_test",
    edition = EDITION,
    size = "medium",
    aliases = {"//rust/golden": "golden"},
    compile_data = ["//taxyear:testdata"],
    crate = ":taxyear",
    data = TESTDATA,
    env = GOLDEN_ENV,
    rustc_flags = RUSTC_FLAGS,
    deps = ["//rust/golden"],
)

# Each file under tests/ is its own test crate, as under Cargo. The golden
# tests compute every test case, unoptimised.
[rust_test(
    name = f[len("tests/"):-len(".rs")],
    size = "medium",
    srcs = [f],
    aliases = {
        "//rust/filing": "filing",
        "//rust/golden": "golden",
        "//rust/money": "money",
        "//rust/proto": "proto",
        "//rust/protodiffgen": "protodiffgen",
    },
    compile_data = ["//taxyear:testdata"],
    data = TESTDATA,
    env = GOLDEN_ENV,
    rustc_flags = RUSTC_FLAGS,
    deps = [
        ":taxyear",
        "//rust/filing",
        "//rust/golden",
        "//rust/money",
        "//rust/proto",
        "//rust/protodiffgen",
        "@taxcalcs_crates//:buffa",
        "@taxcalcs_crates//:buffa-descriptor",
        "@taxcalcs_crates//:flate2",
        "@taxcalcs_crates//:serde",
        "@taxcalcs_crates//:serde_json",
    ],
) for f in glob(["tests/*.rs"])]

exports_files(["Cargo.toml"])
