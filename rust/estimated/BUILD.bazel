load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//rust:defs.bzl", "GOLDEN_DATA", "GOLDEN_ENV", "RUSTC_FLAGS")

rust_library(
    name = "estimated",
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "//rust/filing": "filing",
        "//rust/money": "money",
        "//rust/working": "working",
    },
    crate_name = "taxcalcs_estimated",
    rustc_flags = RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [
        "//rust/filing",
        "//rust/money",
        "//rust/working",
        "@crates//:num-bigint",
        "@crates//:num-integer",
        "@crates//:num-traits",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "estimated_test",
    size = "small",
    crate = ":estimated",
    rustc_flags = RUSTC_FLAGS,
)

# Each file under tests/ is its own test crate, as under Cargo, with the
# helpers in tests/common.
[rust_test(
    name = f[len("tests/"):-len(".rs")],
    size = "small",
    srcs = [f] + glob(["tests/common/*.rs"]),
    aliases = {
        "//rust/filing": "filing",
        "//rust/golden": "golden",
        "//rust/money": "money",
        "//rust/working": "working",
    },
    crate_root = f,
    data = GOLDEN_DATA,
    env = GOLDEN_ENV,
    rustc_flags = RUSTC_FLAGS,
    deps = [
        ":estimated",
        "//rust/filing",
        "//rust/golden",
        "//rust/money",
        "//rust/working",
        "@crates//:num-bigint",
    ],
) for f in glob(["tests/*.rs"])]

# estimated/all has no code yet, so no package of its own.
exports_files([
    "Cargo.toml",
    "all/Cargo.toml",
])
