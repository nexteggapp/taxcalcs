load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//rust:defs.bzl", "EDITION", "GOLDEN_DATA", "GOLDEN_ENV", "RUSTC_FLAGS")

# Checks a jurisdiction's estimated tax rules and compares them with its
# golden vectors, for that jurisdiction's tests.
rust_library(
    name = "estimatedtest",
    edition = EDITION,
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "//rust/estimated": "estimated",
        "//rust/filing": "filing",
        "//rust/golden": "golden",
        "//rust/money": "money",
        "//rust/working": "working",
    },
    crate_name = "taxcalcs_estimatedtest",
    rustc_flags = RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [
        "//rust/estimated",
        "//rust/filing",
        "//rust/golden",
        "//rust/money",
        "//rust/working",
        "@taxcalcs_crates//:flate2",
        "@taxcalcs_crates//:regex",
        "@taxcalcs_crates//:serde_json",
        "@taxcalcs_crates//:thiserror",
    ],
)

rust_test(
    name = "estimatedtest_test",
    edition = EDITION,
    size = "small",
    crate = ":estimatedtest",
    data = GOLDEN_DATA,
    env = GOLDEN_ENV,
    rustc_flags = RUSTC_FLAGS,
)

exports_files(["Cargo.toml"])
