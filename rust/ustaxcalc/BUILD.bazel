load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//rust:defs.bzl", "GOLDEN_DATA", "GOLDEN_ENV", "RUSTC_FLAGS")

rust_library(
    name = "ustaxcalc",
    srcs = glob(["src/**/*.rs"]),
    aliases = {
        "//rust/estimated": "estimated",
        "//rust/filing": "filing",
        "//rust/money": "money",
        "//rust/working": "working",
    },
    crate_name = "taxcalcs_ustaxcalc",
    rustc_flags = RUSTC_FLAGS,
    visibility = ["//visibility:public"],
    deps = [
        "//rust/estimated",
        "//rust/filing",
        "//rust/money",
        "//rust/working",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "ustaxcalc_test",
    size = "small",
    crate = ":ustaxcalc",
    rustc_flags = RUSTC_FLAGS,
)

# Each file under tests/ is its own test crate, as under Cargo.
[rust_test(
    name = f[len("tests/"):-len(".rs")],
    size = "small",
    srcs = [f],
    aliases = {
        "//rust/estimated": "estimated",
        "//rust/estimated/estimatedtest": "estimatedtest",
        "//rust/filing": "filing",
        "//rust/golden": "golden",
        "//rust/money": "money",
        "//rust/working": "working",
    },
    data = GOLDEN_DATA,
    env = GOLDEN_ENV,
    rustc_flags = RUSTC_FLAGS,
    deps = [
        ":ustaxcalc",
        "//rust/estimated",
        "//rust/estimated/estimatedtest",
        "//rust/filing",
        "//rust/golden",
        "//rust/money",
        "//rust/working",
        "@crates//:serde_json",
    ],
) for f in glob(["tests/*.rs"])]

exports_files(["Cargo.toml"])
