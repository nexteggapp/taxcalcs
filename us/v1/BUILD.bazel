# gazelle:ignore

load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

# The estimated tax answer type //scenarios/v1 reports.
proto_library(
    name = "us_proto",
    # Imported as taxcalcs/us/v1/..., so a consumer writes the same import
    # path whichever module is the root.
    import_prefix = "taxcalcs",
    srcs = [
        "estimated.proto",
    ],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "us_go_proto",
    importpath = "github.com/nexteggapp/taxcalcs/us/v1",
    protos = [":us_proto"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "v1",
    embed = [":us_go_proto"],
    importpath = "github.com/nexteggapp/taxcalcs/us/v1",
    visibility = ["//visibility:public"],
)
