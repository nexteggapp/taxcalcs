load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

# Wisconsin estimated individual income tax and its underpayment interest.
#
# No income tax calculator yet, and no dependency on //ustaxcalc or a sibling
# state. See doc.go.
go_library(
    name = "wisconsintaxcalc",
    srcs = [
        "doc.go",
        "estimated.go",
        "estimated_y2026.go",
    ],
    importpath = "github.com/nexteggapp/taxcalcs/wisconsintaxcalc",
    visibility = ["//visibility:public"],
    deps = [
        "//estimated",
        "//money",
        "//working",
    ],
)

# The tests are an external package, so they reach only what a caller
# reaches. export_test.go hands them the holiday calendar and rate series.
go_test(
    name = "wisconsintaxcalc_test",
    size = "small",
    srcs = [
        "estimated_test.go",
        "export_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":wisconsintaxcalc"],
    deps = [
        "//estimated",
        "//filing",
        "//money",
        "//working",
    ],
)

# The estimated-tax copy, which //estimated/all checks sentence by sentence.
filegroup(
    name = "estimated_srcs",
    srcs = glob(["estimated*.go"], exclude = ["*_test.go"]),
    visibility = ["//estimated/all:__pkg__"],
)
