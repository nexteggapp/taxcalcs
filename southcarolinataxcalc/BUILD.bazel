load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

# South Carolina estimated individual income tax and its underpayment penalty.
#
# No income tax calculator yet, and no dependency on //ustaxcalc or a sibling
# state, although S.C. Code § 12-54-55 adopts the federal rules. See doc.go.
go_library(
    name = "southcarolinataxcalc",
    srcs = [
        "doc.go",
        "estimated.go",
        "estimated_y2026.go",
    ],
    importpath = "github.com/nexteggapp/taxcalcs/southcarolinataxcalc",
    visibility = ["//visibility:public"],
    deps = [
        "//estimated",
        "//filing",
        "//money",
        "//working",
    ],
)

# An external test package, so the tests reach only what a caller reaches.
go_test(
    name = "southcarolinataxcalc_test",
    size = "small",
    srcs = ["estimated_test.go"],
    data = glob(["testdata/**"]),
    deps = [
        ":southcarolinataxcalc",
        "//estimated",
        "//filing",
        "//money",
        "//working",
    ],
)

# The estimated-tax copy, which //estimated/all checks sentence by sentence.
filegroup(
    name = "estimated_srcs",
    srcs = glob(["estimated*.go"], exclude = ["*_test.go"]),
    visibility = ["//estimated/all:__pkg__"],
)
