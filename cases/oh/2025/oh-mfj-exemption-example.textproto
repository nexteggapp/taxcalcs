# proto-file: cases/v1/case.proto
# proto-message: nexteggapp.taxcalcs.cases.v1.TestCase

id: "oh-mfj-exemption-example"
title: "Married couple and a son, the booklet's exemption example, MAGI $75,000"
tags: ["wages", "exemptions", "dependents", "published-example"]
origin {
  kind: ORIGIN_KIND_AGENCY_EXAMPLE
  source { id: "oh-dot-it-1040-instructions-2025" page: 17 }
  note: "The booklet's John and Mary example gives the family and MAGI; the wages, withholding and $60 credit are made up."
}
note: "Moved from TestOhioMarriedFilingJointly in returns/rules/states/oh_test.go."

inputs {
  schema_version:  1
  tax_year:  2025
  federal:  {
    household:  {
