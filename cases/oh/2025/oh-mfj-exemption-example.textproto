            minor:  400000
            currency:  "USD"
          }
        }
      }
      w2s:  {
        id:  "w2_1"
        person:  "mary"
        form:  {
          state_tax_withholding:  {
            state:  "OH"
            tax_withheld:  {
              minor:  50000
              currency:  "USD"
            }
            state_income:  {
              minor:  2500000
