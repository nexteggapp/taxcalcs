expected {
  form: "oh-form-it1040" line: "4" cents: 645000
  provenance: PROVENANCE_PUBLISHED_EXAMPLE
  source { id: "oh-dot-it-1040-instructions-2025" page: 17 }
  working { what: "Three exemptions at MAGI $75,000, as the booklet states" arithmetic: "6,450" source { id: "oh-dot-it-1040-instructions-2025" page: 17 } }
}

expected {
  form: "oh-form-it1040" line: "7" cents: 6855000
  provenance: PROVENANCE_HAND_WORKED
  source { id: "oh-dot-it-1040-2025" anchor: "line-7" }
  working { what: "Ohio AGI less the exemptions" arithmetic: "75,000 - 6,450 = 68,550" }
}

expected {
  form: "oh-form-it1040" line: "8a" cents: 151100
  provenance: PROVENANCE_HAND_WORKED
  source { id: "oh-dot-it-1040-instructions-2025" page: 18 }
  working { what: "Tax on the first $26,050, then 2.75% of the rest" arithmetic: "342 + (68,550 - 26,050) x 0.0275 = 1,510.75, so 1,511" source { id: "oh-dot-it-1040-instructions-2025" page: 18 } }
}

expected {
  form: "oh-form-it1040" line: "13" cents: 145100
  provenance: PROVENANCE_HAND_WORKED
  source { id: "oh-dot-it-1040-2025" anchor: "line-13" }
  working { what: "Less the $60 of nonrefundable credits" arithmetic: "1,511 - 60 = 1,451" }
}

expected {
  form: "oh-form-it1040" line: "26" cents: 14900
  provenance: PROVENANCE_HAND_WORKED
  source { id: "oh-dot-it-1040-2025" anchor: "line-26" }
  working { what: "Withholding less tax" arithmetic: "1,600 - 1,451 = 149" }
}
